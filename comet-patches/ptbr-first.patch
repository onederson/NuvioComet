+def _trophy(h: int, color=(17, 17, 17)) -> Image.Image:
+    """Estatueta (silhueta do Oscar) simplificada."""
+    h = max(4, int(h))
+    w = int(round(h * 0.5))
+    im = Image.new("RGBA", (w, h), (0, 0, 0, 0))
+    d = ImageDraw.Draw(im)
+    c = _rgba(color)
+    cx = w / 2
+    hr = h * 0.075
+    d.ellipse((cx - hr, h * 0.02, cx + hr, h * 0.02 + 2 * hr), fill=c)
+    d.polygon([(cx - w * 0.24, h * 0.19), (cx + w * 0.24, h * 0.19), (cx + w * 0.17, h * 0.42),
+               (cx + w * 0.11, h * 0.74), (cx - w * 0.11, h * 0.74), (cx - w * 0.17, h * 0.42)], fill=c)
+    d.rounded_rectangle((cx - w * 0.3, h * 0.76, cx + w * 0.3, h * 0.84), radius=h * 0.015, fill=c)
+    d.rounded_rectangle((cx - w * 0.44, h * 0.86, cx + w * 0.44, h * 0.99), radius=h * 0.02, fill=c)
+    return im
