+"""Notas IMDb / Rotten Tomatoes / Metacritic e prêmios (OMDb), com cache e orçamento diário.
+
+- get_omdb(imdb_id): consulta (cache SQLite 30 dias, 3 para lançamentos, 7 para "não achou").
+- oscar_won(imdb_id) / cached(imdb_id): só memória, sem rede (para capas e catálogos).
+- ratings_line(data): "⭐ IMDb 9,3 · 🍅 89% · Ⓜ️ 82" + "🏆 Venceu 3 Oscars".
+"""
+from __future__ import annotations
+
+import asyncio
+import json
+import re
+import time
+from pathlib import Path
+
+import aiohttp
+
+from comet.core.database import database
+from comet.core.logger import logger, log_swallowed
+from comet.core.models import settings
+
+_MEM: dict[str, dict] = {}
+_LOADED = False
+_LOAD_LOCK = asyncio.Lock()
+_SEM = asyncio.Semaphore(4)
+_BUDGET_FILE = Path("/opt/comet/data/omdb_budget.json")
+_budget = {"day": "", "used": 0}
+
+
+def _key() -> str | None:
+    k = getattr(settings, "OMDB_API_KEY", None)
+    if k:
+        return str(k)
+    try:
+        for line in open("/opt/comet/.env", encoding="utf-8"):
+            if line.startswith("OMDB_API_KEY="):
+                return line.split("=", 1)[1].strip().strip('"') or None
+    except OSError:
+        pass
+    return None
+
+
+def _daily_budget() -> int:
+    try:
+        return int(getattr(settings, "OMDB_DAILY_BUDGET", 900) or 900)
+    except (TypeError, ValueError):
+        return 900
+
+
+def _budget_ok() -> bool:
+    today = time.strftime("%Y-%m-%d")
+    if _budget["day"] != today:
+        try:
+            saved = json.loads(_BUDGET_FILE.read_text())
+            _budget.update(saved if saved.get("day") == today else {"day": today, "used": 0})
+        except Exception:
+            _budget.update({"day": today, "used": 0})
+    return _budget["used"] < _daily_budget()
+
+
+def _spend() -> None:
+    _budget["used"] += 1
+    try:
+        _BUDGET_FILE.write_text(json.dumps(_budget))
+    except Exception as _e:
+        log_swallowed("omdb._spend", _e)
+
+
+def budget_status() -> dict:
+    _budget_ok()
+    return {"day": _budget["day"], "used": _budget["used"], "limit": _daily_budget(), "cached": len(_MEM)}
+
+
+async def _ensure_loaded() -> None:
+    global _LOADED
+    if _LOADED:
+        return
+    async with _LOAD_LOCK:
+        if _LOADED:
+            return
+        try:
+            await database.execute(
+                "CREATE TABLE IF NOT EXISTS omdb_cache (imdb_id TEXT PRIMARY KEY, data TEXT, fetched_at INTEGER)"
+            )
+            rows = await database.fetch_all("SELECT imdb_id, data, fetched_at FROM omdb_cache")
+            for r in rows:
+                try:
+                    d = json.loads(r["data"])
+                    d["_fetched_at"] = r["fetched_at"]
+                    _MEM[r["imdb_id"]] = d
+                except Exception as _e:
+                    log_swallowed("omdb._ensure_loaded", _e)
+            logger.info(f"🏆 OMDb: {len(_MEM)} títulos em cache")
+        except Exception as e:
+            logger.warning(f"OMDb: cache indisponível: {type(e).__name__}")
+        _LOADED = True
+
+
+def _ttl(d: dict) -> int:
+    if d.get("Response") == "False":
+        return 7 * 86400
+    year = re.match(r"\d{4}", str(d.get("Year") or ""))
+    if year and int(year.group(0)) >= int(time.strftime("%Y")) - 1:
+        return 3 * 86400
+    return 30 * 86400
+
+
+def cached(imdb_id: str) -> dict | None:
+    d = _MEM.get(imdb_id)
+    return d if d and d.get("Response") != "False" else None
+
+
+def oscar_won(imdb_id: str | None) -> bool:
+    if not imdb_id:
+        return False
+    d = cached(imdb_id)
+    return bool(d and re.search(r"\bWon \d+ Oscars?\b", str(d.get("Awards") or "")))
+
+
+async def get_omdb(imdb_id: str, allow_network: bool = True) -> dict | None:
+    if not imdb_id or not imdb_id.startswith("tt"):
+        return None
+    await _ensure_loaded()
+    d = _MEM.get(imdb_id)
+    if d and time.time() - d.get("_fetched_at", 0) < _ttl(d):
+        return d if d.get("Response") != "False" else None
+    key = _key()
+    if not allow_network or not key or not _budget_ok():
+        return d if d and d.get("Response") != "False" else None
+    async with _SEM:
+        if not _budget_ok():
+            return cached(imdb_id)
+        try:
+            _spend()
+            async with aiohttp.ClientSession(timeout=aiohttp.ClientTimeout(total=8)) as s:
+                async with s.get("https://www.omdbapi.com/", params={"i": imdb_id, "apikey": key}) as r:
+                    data = await r.json(content_type=None)
+        except Exception as e:
+            logger.debug(f"OMDb {imdb_id}: {type(e).__name__}")
+            return cached(imdb_id)
+    if not isinstance(data, dict):
+        return cached(imdb_id)
+    if data.get("Error") and "limit" in str(data.get("Error")).lower():
+        _budget["used"] = _daily_budget()
+        return cached(imdb_id)
+    keep = {k: data.get(k) for k in ("Response", "Title", "Year", "imdbRating", "imdbVotes", "Metascore", "Ratings", "Awards")}
+    now = int(time.time())
+    keep["_fetched_at"] = now
+    _MEM[imdb_id] = keep
+    try:
+        await database.execute(
+            "INSERT OR REPLACE INTO omdb_cache (imdb_id, data, fetched_at) VALUES (:i, :d, :t)",
+            {"i": imdb_id, "d": json.dumps({k: v for k, v in keep.items() if k != "_fetched_at"}), "t": now},
+        )
+    except Exception as _e:
+        log_swallowed("omdb.get_omdb", _e)
+    return keep if keep.get("Response") != "False" else None
+
+
+def _num(v) -> str | None:
+    if not v or str(v).upper() == "N/A":
+        return None
+    return str(v)
+
+
+def ratings_line(d: dict | None) -> str | None:
+    if not d:
+        return None
+    parts = []
+    imdb = _num(d.get("imdbRating"))
+    if imdb:
+        parts.append(f"⭐ IMDb {imdb.replace('.', ',')}")
+    rt = next((r.get("Value") for r in (d.get("Ratings") or []) if r.get("Source") == "Rotten Tomatoes"), None)
+    if _num(rt):
+        parts.append(f"🍅 {rt}")
+    mc = _num(d.get("Metascore"))
+    if mc:
+        parts.append(f"Ⓜ️ {mc}")
+    awards = str(d.get("Awards") or "")
+    m_won = re.search(r"\bWon (\d+) Oscars?\b", awards)
+    m_nom = re.search(r"\bNominated for (\d+) Oscars?\b", awards)
+    if m_won:
+        n = int(m_won.group(1))
+        parts.append(f"🏆 Venceu {n} Oscar" + ("s" if n > 1 else ""))
+    elif m_nom:
+        n = int(m_nom.group(1))
+        parts.append(f"🏆 Indicado a {n} Oscar" + ("s" if n > 1 else ""))
+    return " · ".join(parts) if parts else None
+
+
+async def warm(imdb_ids: list[str], limit: int = 200) -> int:
+    """Aquece o cache (madrugada). Respeita o orçamento. Devolve quantas consultas fez."""
+    await _ensure_loaded()
+    done = 0
+    for imdb_id in imdb_ids:
+        if done >= limit or not _budget_ok():
+            break
+        d = _MEM.get(imdb_id)
+        if d and time.time() - d.get("_fetched_at", 0) < _ttl(d):
+            continue
+        await get_omdb(imdb_id)
+        done += 1
+        await asyncio.sleep(0.3)
+    return done
