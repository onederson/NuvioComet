+def detect_kinds(st: dict) -> list[str]:
+    hay = " " + norm((st.get("tags") or "") + " , " + (st.get("name") or "")) + " "
+    out: list[str] = []
+    for kind, keys in KIND_RULES:
+        for k in keys:
+            if len(k) <= 3:
+                hit = re.search(r"(?<![a-z])" + re.escape(k) + r"(?![a-z])", hay)
+            else:
+                hit = k in hay
+            if hit:
+                out.append(kind)
+                break
+    if not out or any(k in MUSIC_KINDS for k in out):
+        out.append("Música")
+    return [k for k in KINDS if k in out]
