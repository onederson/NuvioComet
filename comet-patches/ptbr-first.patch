+def _parse_last_watched_dt(val: Any) -> datetime.datetime | None:
+    if val is None:
+        return None
+    if isinstance(val, (int, float)):
+        try:
+            return datetime.datetime.fromtimestamp(
+                val / 1000 if val > 1e11 else val, datetime.timezone.utc
+            )
+        except Exception:
+            return None
+    if isinstance(val, str):
+        try:
+            clean = val.strip().replace("Z", "+00:00")
+            if "." in clean:
+                base, frac = clean.split(".", 1)
+                frac_part = re.split(r"[+-]", frac)[0]
+                tz_part = clean[len(base) + 1 + len(frac_part) :]
+                clean = f"{base}.{frac_part[:6]}{tz_part}"
+            dt = datetime.datetime.fromisoformat(clean)
+            if dt.tzinfo is None:
+                dt = dt.replace(tzinfo=datetime.timezone.utc)
+            return dt
+        except Exception:
+            return None
+    return None
