+def _record_play_bg(media_id, info_hash, name, torrent_name, service, resolution, season=None, episode=None, ep_key=None):
+    """Guarda o play para o motor de gosto (comet/services/taste.py), sem atrasar o player."""
+    try:
+        # o media_id da URL de play é só o IMDb; temporada e episódio vêm separados
+        if media_id and media_id.startswith("tt") and ":" not in media_id and season is not None and episode is not None:
+            media_id = f"{media_id}:{season}:{episode}"
+        try:
+            from comet.services.failed_sources import note_play
+            note_play(ep_key or media_id or "", info_hash)
+        except Exception as _fs_err:
+            logger.debug(f"failed_sources: {_fs_err}")
+        import asyncio as _aio
+        from comet.services.taste import record_play
+        _txt = f"{name} {torrent_name}".lower()
+        _is_pt = any(k in _txt for k in ("dublado", "dual", "pt-br", "ptbr", "nacional", "portugu"))
+        t = _aio.create_task(record_play(media_id or "", info_hash, name, torrent_name, service, resolution, None, _is_pt))
+        _TASTE_TASKS.add(t)
+        t.add_done_callback(_TASTE_TASKS.discard)
+    except Exception:
+        pass
