+
+def _compose_rank(svc: dict, rank: int, art, w=960, h=540):
+    """Card do Top 10: número gigante com contorno à esquerda, a arte do título à direita."""
+    from PIL import Image, ImageDraw, ImageFilter, ImageFont
+    c1, c2 = svc["c1"], svc["c2"]
+    base = _lin_gradient((w, h), tuple(min(255, int(v * 1.4)) for v in c1), (0, 0, 0), horizontal=True).convert("RGBA")
+    base.alpha_composite(_radial((w, h), (w * 0.2, h * 0.75), w * 0.45, c2, 0.55))
+    # arte à direita, sumindo para a esquerda
+    aw = int(w * 0.66)
+    a = art.convert("RGB")
+    sc = max(aw / a.width, h / a.height)
+    a = a.resize((int(a.width * sc) + 1, int(a.height * sc) + 1), Image.LANCZOS)
+    a = a.crop(((a.width - aw) // 2, (a.height - h) // 2, (a.width - aw) // 2 + aw, (a.height - h) // 2 + h))
+    fade = _lin_gradient((aw, h), (0, 0, 0), (255, 255, 255), horizontal=True).convert("L")
+    fade = fade.point(lambda v: min(255, int(v * 2.2)))
+    layer = a.convert("RGBA")
+    layer.putalpha(fade)
+    base.alpha_composite(layer, (w - aw, 0))
+    # número
+    font = ImageFont.truetype(_FONT_BOLD, int(h * (0.95 if rank < 10 else 0.78)))
+    try:
+        font.set_variation_by_name("Black")
+    except Exception:
+        pass
+    txt = str(rank)
+    l, t, r, b = font.getbbox(txt)
+    tw, th = r - l, b - t
+    x = int(w * 0.20 - tw / 2) - l
+    y = int(h - th - h * 0.04) - t
+    mask = Image.new("L", (w, h), 0)
+    ImageDraw.Draw(mask).text((x, y), txt, font=font, fill=255)
+    outline = mask.filter(ImageFilter.MaxFilter(9))
+    glow = Image.new("RGBA", (w, h), c2 + (0,))
+    glow.putalpha(outline.filter(ImageFilter.GaussianBlur(14)).point(lambda v: int(v * 0.7)))
+    base.alpha_composite(glow)
+    ring = Image.new("RGBA", (w, h), (255, 255, 255, 0))
+    ring.putalpha(outline)
+    base.alpha_composite(ring)
+    fill = _lin_gradient((w, h), (28, 28, 34), (0, 0, 0)).convert("RGBA")
+    fill.putalpha(mask)
+    base.alpha_composite(fill)
+    d = ImageDraw.Draw(base)
+    d.rounded_rectangle((1, 1, w - 2, h - 2), radius=24, outline=(255, 255, 255, 40), width=2)
+    return base.convert("RGB")
+
+
+async def _ensure_rank(svc: dict, rank: int, src: str) -> str:
+    import aiohttp
+    from PIL import Image
+    os.makedirs(DATA_DIR, exist_ok=True)
+    key = re.sub(r"[^A-Za-z0-9]", "", src)[-60:]
+    path = os.path.join(DATA_DIR, f"rank_{svc['key']}_{rank}_{key}_v{_ART_VERSION}.jpg")
+    if os.path.exists(path):
+        return path
+    async with aiohttp.ClientSession(timeout=aiohttp.ClientTimeout(total=40)) as sess:
+        async with sess.get(f"http://127.0.0.1:8000{src}") as r:
+            if r.status != 200:
+                raise HTTPException(status_code=404)
+            raw = await r.read()
+    art = Image.open(io.BytesIO(raw))
+    img = await asyncio.to_thread(_compose_rank, svc, rank, art)
+    data = _jpeg(img.resize((640, 360), Image.LANCZOS), 88)
+    with open(path + ".tmp", "wb") as f:
+        f.write(data)
+    os.replace(path + ".tmp", path)
+    return path
+
+
+def _cleanup_ranks() -> None:
+    try:
+        now = time.time()
+        for f in os.listdir(DATA_DIR):
+            fp = os.path.join(DATA_DIR, f)
+            if f.startswith("rank_") and now - os.path.getmtime(fp) > 3 * 86400:
+                os.unlink(fp)
+    except OSError:
+        pass
+
+
+async def _warm_ranks() -> None:
+    from urllib.parse import parse_qs, urlparse
+    base = (getattr(settings, "PUBLIC_BASE_URL", None) or "").rstrip("/")
+    for s in SERVICES:
+        for tab, mt in (("top10s", "series"), ("top10m", "movie")):
+            try:
+                metas = await get_catalog(mt, CATALOG_PREFIX + tab, {"genre": s["key"]}, base)
+            except Exception as e:
+                log_swallowed("streamings._warm_ranks", e)
+                continue
+            for i, m in enumerate(metas, start=1):
+                q = parse_qs(urlparse(m.get("landscapePoster") or "").query).get("s")
+                if q:
+                    try:
+                        await _ensure_rank(s, i, q[0])
+                    except Exception as e:
+                        log_swallowed("streamings._warm_ranks", e)
+    _cleanup_ranks()
+
+
+@router.get("/art/svc/rank/{name}")
+async def svc_rank(name: str, s: str):
+    """Arte do Top 10 (número + fundo do título). `s` = caminho /art/land/<fundo> do Comet."""
+    m = re.fullmatch(r"([a-z0-9]+)-(\d{1,2})\.jpg", name)
+    if not m or not s.startswith("/art/land/") or ".." in s:
+        raise HTTPException(status_code=404)
+    path = await _ensure_rank(_svc(m.group(1)), int(m.group(2)), s)
+    return FileResponse(path, media_type="image/jpeg", headers={"Cache-Control": "public, max-age=86400"})
+
+
+@router.get("/art/svc/{kind}/{name}")
+async def svc_art(kind: str, name: str):
+    key, _, ext = name.partition(".")
+    if kind not in ("tile", "focus", "hero", "logo", "video") or ext not in _MEDIA:
+        raise HTTPException(status_code=404)
+    start_warm()
+    path = await make_art(kind, key)
+    return FileResponse(path, media_type=_MEDIA[ext],
+                        headers={"Cache-Control": "public, max-age=86400"})
+
+
+@router.get("/nuvio/colecoes.json")
+async def nuvio_collections():
+    """Sem token: a coleção só tem links das artes e o id do addon (nada secreto). O Nuvio
+    importa por URL em Ajustes > Conteúdo e Descoberta > Addons > Coleções > Importar > De URL."""
+    start_warm()
+    base = (getattr(settings, "PUBLIC_BASE_URL", None) or "").rstrip("/")
+    return JSONResponse(build_collections(base), headers={"Cache-Control": "no-store"})
