+async def render_animation(
+    media_type: str,
+    tmdb_id: str | int,
+    ext: str,
+    kind: str = "backdrop",
+) -> tuple[bytes, str]:
+    ext = ext.lower().strip()
+    if ext not in ("webp", "gif"):
+        raise ArtworkNotFound(f"Unsupported format: {ext}")
+    clean_type = "tv" if media_type in ("tv", "series") else "movie"
+    try:
+        clean_id = int(str(tmdb_id).strip())
+    except (ValueError, TypeError):
+        raise ArtworkNotFound(f"Invalid tmdb_id: {tmdb_id}")
+
+    is_poster = (kind == "poster")
+    if is_poster:
+        cache_filename = f"anim-poster-{clean_type}-{clean_id}.{ext}"
+    else:
+        cache_filename = f"anim-{clean_type}-{clean_id}.{ext}"
+    cache_path = os.path.join(CACHE_DIR, cache_filename)
+
+    if os.path.isfile(cache_path):
+        try:
+            with open(cache_path, "rb") as f:
+                return f.read(), f"image/{ext}"
+        except Exception as _e:
+            log_swallowed("artwork.render_animation", _e)
+
+    async with _ANIM_SEMAPHORE:
+        if os.path.isfile(cache_path):
+            try:
+                with open(cache_path, "rb") as f:
+                    return f.read(), f"image/{ext}"
+            except Exception as _e:
+                log_swallowed("artwork.render_animation", _e)
+
+        t0 = time.time()
+        timeout = aiohttp.ClientTimeout(total=20.0)
+        async with aiohttp.ClientSession(timeout=timeout) as session:
+            from comet.metadata.tmdb import TMDBApi
+            tmdb = TMDBApi(session)
+            data = await tmdb._get_json(
+                f"{clean_type}/{clean_id}/images?include_image_language=null,pt,en",
+                f"anim {clean_id}",
+            )
+            if not isinstance(data, dict):
+                raise ArtworkNotFound(f"Failed to fetch TMDB images for {clean_type}/{clean_id}")
+
+            if is_poster:
+                W, H = 342, 513
+                target_size = 1572864
+                candidates = data.get("posters") or []
+                if len(candidates) < 4:
+                    bds = [b for b in data.get("backdrops", []) if b.get("iso_639_1") in (None, "null", "")]
+                    candidates.extend(bds or data.get("backdrops", []))
+                candidates = sorted(
+                    candidates,
+                    key=lambda x: (x.get("vote_average") or 0.0, x.get("vote_count") or 0),
+                    reverse=True,
+                )
+                selected_meta = candidates[:4]
+                img_size_pref = "w500"
+            else:
+                W, H = 780, 439
+                target_size = 1572864 if ext == "webp" else 3145728
+                all_bds = data.get("backdrops") or []
+                no_text = [b for b in all_bds if b.get("iso_639_1") in (None, "null", "")]
+                candidates = no_text if no_text else all_bds
+                candidates = sorted(
+                    candidates,
+                    key=lambda x: (x.get("vote_average") or 0.0, x.get("vote_count") or 0),
+                    reverse=True,
+                )
+                max_scenes = 6 if ext == "webp" else 3
+                selected_meta = candidates[:max_scenes]
+                img_size_pref = "w780"
+
+            if not selected_meta:
+                raise ArtworkNotFound(f"No suitable images for {clean_type}/{clean_id}")
+
+            raw_scenes = []
+            for item in selected_meta:
+                fpath = (item.get("file_path") or "").lstrip("/")
+                if not fpath:
+                    continue
+                try:
+                    url = f"{TMDB_IMAGE_BASE}/{img_size_pref}/{fpath}"
+                    async with session.get(url) as resp:
+                        if resp.status == 200:
+                            raw = await resp.read()
+                            raw_scenes.append(Image.open(io.BytesIO(raw)).convert("RGB"))
+                except Exception as e:
+                    logger.warning(f"Failed to download image {fpath}: {e}")
+
+            if not raw_scenes:
+                raise ArtworkNotFound(f"Could not download images for {clean_type}/{clean_id}")
+
+        def generate_and_encode() -> bytes:
+            scenes = list(raw_scenes)
+            if ext == "webp":
+                fps = 10
+                duration_ms = 100
+                frames = _build_animation_frames(scenes, W, H, fps, 1.2, 0.3)
+                data = _encode_webp(frames, duration_ms, quality=70)
+                if len(data) > target_size and len(scenes) > 3:
+                    fps = 8
+                    duration_ms = 125
+                    frames = _build_animation_frames(scenes[:4], W, H, fps, 1.2, 0.3)
+                    data = _encode_webp(frames, duration_ms, quality=65)
+                return data
+            else:
+                fps = 5
+                duration_ms = 200
+                gif_scenes = scenes[:3]
+                frames = _build_animation_frames(gif_scenes, W, H, fps, 1.2, 0.2)
+                data = _encode_gif(frames, duration_ms, colors=64)
+                if len(data) > target_size:
+                    frames = _build_animation_frames(gif_scenes[:2], W, H, 4, 1.2, 0.25)
+                    data = _encode_gif(frames, 250, colors=32)
+                return data
+
+        encoded_data = await asyncio.to_thread(generate_and_encode)
+
+        _save_atomic(cache_path, encoded_data)
+        _cleanup_cache_if_needed()
+        elapsed = time.time() - t0
+        kb = len(encoded_data) // 1024
+        n_cenas = len(raw_scenes) if ext == "webp" else min(len(raw_scenes), 3)
+        logger.info(f"🎞️ fundo animado {clean_id}: {n_cenas} cenas, {kb} KB em {elapsed:.1f}s")
+        return encoded_data, f"image/{ext}"
