+# ---------------------------------------------------------------------------
+# Stremio: catálogo, meta, streams
+# ---------------------------------------------------------------------------
+def _poster(s: dict) -> str:
+    if s.get("favicon"):
+        return s["favicon"]
+    if _fallback_poster is not None:
+        try:
+            u = _fallback_poster(s.get("name") or "Rádio")
+            if isinstance(u, str) and u.startswith(("http://", "https://")):
+                return u
+        except Exception as _e:
+            log_swallowed("radio._poster", _e)
+    return DEFAULT_RADIO_POSTER
+
+
+def _place(s: dict) -> str:
+    uf, city = s.get("uf") or "", s.get("city") or ""
+    if city and uf:
+        return f"{city}/{uf}"
+    if uf:
+        return UFS[uf][0] if uf in UFS else uf
+    return "Brasil"
+
+
+def _quality(s: dict) -> str:
+    codec = s.get("codec") or ("HLS" if s.get("hls") else "")
+    br = int(s.get("bitrate") or 0)
+    return " ".join(x for x in (codec, f"{br}kbps" if br else "") if x)
+
+
+def _description(s: dict) -> str:
+    parts = [f"📍 {_place(s)}"]
+    kinds = [k for k in (s.get("kinds") or []) if k != "Música"] or ["Música"]
+    parts.append(", ".join(kinds))
+    q = _quality(s)
+    if q:
+        parts.append(q)
+    return " · ".join(parts) + "\nRádio ao vivo."
+
+
+def _meta_preview(s: dict) -> dict:
+    mid = ID_PREFIX + s["id"]
+    poster = _poster(s)
+    return {
+        "id": mid,
+        "type": "tv",
+        "name": s.get("name") or "Rádio",
+        "poster": poster,
+        "posterShape": "square",
+        "background": poster,
+        "description": _description(s),
+        "genres": station_genres(s),
+        "releaseInfo": "Ao vivo",
+        "behaviorHints": {"defaultVideoId": mid, "hasScheduledVideos": False},
+    }
+
+
+def _strip_none(o):
+    if isinstance(o, dict):
+        return {k: _strip_none(v) for k, v in o.items() if v is not None}
+    if isinstance(o, list):
+        return [_strip_none(v) for v in o if v is not None]
+    return o
+
+
+def _station_from_id(media_id: str) -> Optional[dict]:
+    sid = (media_id or "").split(":")[-1] if media_id.startswith(ID_PREFIX) else media_id
+    return _by_id.get(sid)
+
+
+def _matches(s: dict, q: str) -> bool:
+    hay = norm(" ".join([s.get("name") or "", s.get("city") or "", _place(s), s.get("tags") or "",
+                         " ".join(s.get("kinds") or [])]))
+    return all(w in hay for w in q.split())
+
+
+async def get_radio_catalog(extra: Optional[dict] = None, base: str = "") -> list[dict]:
+    extra = extra or {}
+    genre = (extra.get("genre") or "").strip()
+    search = norm(extra.get("search") or "")
+    try:
+        skip = max(0, int(str(extra.get("skip") or 0)))
+    except ValueError:
+        skip = 0
+    items = _stations
+    if genre:
+        items = [s for s in items if genre in station_genres(s)]
+    if search:
+        items = [s for s in items if _matches(s, search)]
+    return [_strip_none(_meta_preview(s)) for s in items[skip:skip + PAGE_SIZE]]
+
+
+async def get_radio_meta(media_id: str) -> Optional[dict]:
+    s = _station_from_id(media_id)
+    if not s:
+        return None
+    m = _meta_preview(s)
+    released = s.get("checked") or _state["updated"] or datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
+    m["logo"] = m["poster"]
+    now = await now_playing(s)
+    if now:
+        m["description"] = f"🎵 Tocando agora: {now}\n" + (m.get("description") or "")
+    m["videos"] = [{
+        "id": m["id"],
+        "title": "📻 Ouvir ao vivo",
+        "released": released,
+        "thumbnail": m["poster"],
+        "overview": (f"🎵 Tocando agora: {now}\n" if now else "") + _description(s),
+    }]
+    if (s.get("homepage") or "").startswith("http"):
+        m["website"] = s["homepage"]
+    return _strip_none(m)
+
+
+_NOW_CACHE: dict[str, tuple[float, str]] = {}
+
+
+async def now_playing(s: dict, timeout: float = 3.0) -> str:
+    """Música/programa do momento, lido do metadado ICY (StreamTitle) do próprio sinal. '' se não houver."""
+    if s.get("hls"):
+        return ""
+    sid = s.get("id") or ""
+    hit = _NOW_CACHE.get(sid)
+    if hit and time.time() - hit[0] < 120:
+        return hit[1]
+    title = ""
+    resp = None
+    try:
+        async def _read():
+            nonlocal resp
+            resp = await open_stream(s.get("stream_url") or s.get("https_url") or "", {"Icy-MetaData": "1"}, timeout=timeout)
+            metaint = int(resp.headers.get("icy-metaint") or 0)
+            if resp.status != 200 or not (0 < metaint <= 65536):
+                return ""
+            await resp._r.readexactly(metaint)
+            n = (await resp._r.readexactly(1))[0] * 16
+            if not n:
+                return ""
+            raw = (await resp._r.readexactly(n)).rstrip(b"\0")
+            for enc in ("utf-8", "latin-1"):
+                try:
+                    txt = raw.decode(enc)
+                    break
+                except UnicodeDecodeError:
+                    continue
+            if "Ã" in txt or "Â" in txt:  # UTF-8 codificado duas vezes pela emissora
+                try:
+                    txt = txt.encode("latin-1").decode("utf-8")
+                except (UnicodeEncodeError, UnicodeDecodeError):
+                    pass
+            m = re.search(r"StreamTitle='(.*?)';", txt)
+            return (m.group(1).strip() if m else "")[:120]
+        title = await asyncio.wait_for(_read(), timeout + 1)
+    except Exception:
+        title = ""
+    finally:
+        try:
+            if resp is not None:
+                resp._w.close()
+        except Exception as _e:
+            log_swallowed("radio.now_playing", _e)
+    if title.lower() in ("", "-", "unknown", "live", "ao vivo") or title.lower() == (s.get("name") or "").lower():
+        title = ""
+    _NOW_CACHE[sid] = (time.time(), title)
+    return title
+
+
+async def get_radio_stream(media_id: str, base: str = "", video: bool = False) -> list[dict]:
+    s = _station_from_id(media_id)
+    if not s:
+        return []
+    desc = " · ".join(x for x in (s.get("name") or "Rádio", _place(s), _quality(s)) if x)
+    base = (base or "").rstrip("/")
+    if video and base and _ffmpeg_path():
+        # Nuvio: o player espera um quadro de vídeo ("Iniciando vídeo…" eterno com só áudio).
+        # Primeira opção = a rádio com a capa parada como vídeo (gerado no A71 com ffmpeg).
+        tv = await get_radio_stream(media_id, base, video=False)
+        return [{"name": "📻 Ao vivo", "description": desc + "\ncom capa na tela",
+                 "url": f"{base}/radio/{s['id']}/tv.ts", "behaviorHints": {"notWebReady": False}}] + [
+            dict(x, name=f"📻 Ao vivo ({i + 2})") for i, x in enumerate(tv)]
+    relay = {"name": "📻 Ao vivo", "description": desc + "\nvia servidor",
+             "url": f"{base}/radio/{s['id']}" + (".m3u8" if s.get("hls") else ""),
+             "behaviorHints": {"notWebReady": False}} if base else None
+    out: list[dict] = []
+    direct = s.get("https_url") or ""
+    # O ExoPlayer decide HLS pela extensão da URL: HLS sem ".m3u8" no caminho vai pelo relay primeiro.
+    hls_no_ext = bool(s.get("hls")) and not urlsplit(direct).path.lower().endswith(".m3u8")
+    if direct and not (hls_no_ext and relay):
+        out.append({"name": "📻 Ao vivo", "description": desc, "url": direct,
+                    "behaviorHints": {"notWebReady": False}})
+        if relay:
+            relay["name"] = "📻 Ao vivo (2)"
+            out.append(relay)
+    else:
+        if relay:
+            out.append(relay)
+        http = direct or s.get("stream_url") or ""
+        if http:
+            out.append({"name": "📻 Ao vivo (2)" if relay else "📻 Ao vivo", "description": desc + ("\ndireto" if direct else "\ndireto (http)"),
+                        "url": http, "behaviorHints": {"notWebReady": False}})
+    return out
+
+
+# ---------------------------------------------------------------------------
+# Rádio como vídeo (capa parada + som), para players que exigem vídeo (Nuvio)
+# ---------------------------------------------------------------------------
+_FFMPEG: dict = {"path": None, "checked": False}
+_VIDEO_PROCS: list = []  # processos ffmpeg ativos (no máximo _VIDEO_MAX)
+_VIDEO_MAX = 2
+
+
+def _ffmpeg_path() -> Optional[str]:
+    if not _FFMPEG["checked"]:
+        import shutil
+        _FFMPEG["path"] = shutil.which("ffmpeg")
+        _FFMPEG["checked"] = True
+    return _FFMPEG["path"]
+
+
+def _lower_oom() -> None:
+    # o watchdog protege o Comet e os filhos (-1000); o ffmpeg deve ser o primeiro a morrer
+    try:
+        with open("/proc/self/oom_score_adj", "w") as f:
+            f.write("500")
+    except OSError:
+        pass
+
+
+async def relay_radio_video(station_id: str, request):
+    """GET /radio/{id}/tv.ts: MPEG-TS com a capa da rádio (1 quadro/s) e o áudio em AAC."""
+    from fastapi.responses import Response, StreamingResponse
+
+    s = _by_id.get((station_id or "").split(":")[-1])
+    ff = _ffmpeg_path()
+    if not s or not ff:
+        return Response("indisponível", status_code=404)
+    src = s.get("https_url") or s.get("stream_url") or ""
+    if not src:
+        return Response("rádio sem endereço", status_code=404)
+    cover = f"/tmp/comet_radio_{s['id']}.png"
+    if not os.path.exists(cover):
+        from comet.api.endpoints.live_routes import _draw_radio
+        png = await asyncio.to_thread(_draw_radio, (s.get("name") or "Rádio")[:60], _place(s)[:40])
+        with open(cover, "wb") as f:
+            f.write(png)
+    # limite de processos: o mais antigo cai (a TV trocou de rádio)
+    for p in [p for p in _VIDEO_PROCS if p.returncode is not None]:
+        _VIDEO_PROCS.remove(p)
+    while len(_VIDEO_PROCS) >= _VIDEO_MAX:
+        old = _VIDEO_PROCS.pop(0)
+        try:
+            old.kill()
+        except ProcessLookupError:
+            pass
+    proc = await asyncio.create_subprocess_exec(
+        ff, "-hide_banner", "-loglevel", "error", "-nostdin",
+        "-loop", "1", "-framerate", "1", "-i", cover,
+        "-reconnect", "1", "-reconnect_streamed", "1", "-reconnect_delay_max", "5",
+        "-user_agent", "Mozilla/5.0", "-i", src,
+        "-map", "0:v", "-map", "1:a",
+        "-c:v", "libx264", "-preset", "ultrafast", "-tune", "stillimage", "-pix_fmt", "yuv420p",
+        "-vf", "scale=512:512", "-r", "1", "-g", "2",
+        "-c:a", "aac", "-b:a", "128k", "-ac", "2",
+        "-f", "mpegts", "-muxdelay", "0", "pipe:1",
+        stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.DEVNULL,
+        preexec_fn=_lower_oom,
+    )
+    _VIDEO_PROCS.append(proc)
+    logger.info(f"📻🎬 rádio em vídeo: {s.get('name')} (pid {proc.pid})")
+
+    async def body() -> AsyncIterator[bytes]:
+        try:
+            while True:
+                if request is not None and await request.is_disconnected():
+                    break
+                try:
+                    chunk = await asyncio.wait_for(proc.stdout.read(32768), timeout=30)
+                except asyncio.TimeoutError:
+                    break
+                if not chunk:
+                    break
+                yield chunk
+        finally:
+            if proc.returncode is None:
+                try:
+                    proc.kill()
+                except ProcessLookupError:
+                    pass
+            try:
+                await asyncio.wait_for(proc.wait(), 5)
+            except Exception as _e:
+                log_swallowed("radio.body", _e)
+            if proc in _VIDEO_PROCS:
+                _VIDEO_PROCS.remove(proc)
+
+    return StreamingResponse(body(), media_type="video/mp2t",
+                             headers={"Cache-Control": "no-cache, no-store", "X-Accel-Buffering": "no"})
+
+
+# ---------------------------------------------------------------------------
+# Relay
+# ---------------------------------------------------------------------------
+_PASS_HEADERS = ("content-type", "icy-name", "icy-genre", "icy-br", "icy-description", "icy-url",
+                 "icy-metaint", "icy-pub", "icy-sr", "icy-audio-info", "ice-audio-info")
+
+
+def _seg_ext(u: str) -> str:
+    p = urlsplit(u).path.lower()
+    for ext in (".m3u8", ".aac", ".mp4", ".m4s", ".mp3", ".ts"):
+        if p.endswith(ext):
+            return ext
+    return ".ts"
+
+
+async def relay_radio(station_id: str, request):
+    """Proxy do áudio (FastAPI/Starlette). Rota sugerida: GET /radio/{station_id}."""
+    from fastapi.responses import Response, StreamingResponse
+
+    sid = (station_id or "").split(":")[-1]
+    for ext in (".m3u8", ".ts", ".aac", ".mp4", ".m4s", ".mp3"):
+        if sid.endswith(ext):
+            sid = sid[: -len(ext)]
+            break
+    s = _by_id.get(sid)
+    if not s:
+        return Response("estação desconhecida", status_code=404)
+    target = s.get("stream_url") or ""
+    sub = request.query_params.get("u") if request is not None else None
+    if s.get("hls"):
+        if sub:
+            sub = unquote(sub)
+            host = urlsplit(sub).hostname or ""
+            if host not in _hls_hosts.get(sid, {urlsplit(target).hostname or ""}):
+                return Response("host não permitido", status_code=403)
+            target = sub
+    elif sub:
+        return Response("parâmetro inválido", status_code=400)
+
+    hdrs = {}
+    if request is not None:
+        icy = request.headers.get("icy-metadata")
+        if icy and not s.get("hls"):
+            hdrs["Icy-MetaData"] = icy
+    try:
+        up = await open_stream(target, extra_headers=hdrs, timeout=8.0)
+    except Exception as e:
+        logger.warning(f"Rádio relay {s.get('name')}: {type(e).__name__}: {e}")
+        return Response("rádio fora do ar", status_code=502)
+    if up.status >= 400:
+        up.close()
+        return Response("rádio fora do ar", status_code=502)
+
+    ctype = up.headers.get("content-type", "audio/mpeg").split(";")[0].strip() or "audio/mpeg"
+    if s.get("hls") and (ctype in PLAYLIST_TYPES or target.lower().split("?")[0].endswith(".m3u8")
+                         or ctype.startswith("text/")):
+        try:
+            body = await up.read_upto(524288, time.monotonic() + 8)
+        finally:
+            up.close()
+        text = body.decode("utf-8", "replace")
+        allowed = _hls_hosts.setdefault(sid, {urlsplit(s.get("stream_url") or "").hostname or ""})
+        lines = []
+        for line in text.splitlines():
+            ls = line.strip()
+            if ls and not ls.startswith("#"):
+                absu = urljoin(up.url, ls)
+                allowed.add(urlsplit(absu).hostname or "")
+                line = f"/radio/{sid}{_seg_ext(absu)}?u={quote(absu, safe='')}"
+            elif 'URI="' in line:
+                def _rw(m):
+                    absu = urljoin(up.url, m.group(1))
+                    allowed.add(urlsplit(absu).hostname or "")
+                    return f'URI="/radio/{sid}{_seg_ext(absu)}?u={quote(absu, safe="")}"'
+                line = re.sub(r'URI="([^"]+)"', _rw, line)
+            lines.append(line)
+        if len(allowed) > 32:
+            _hls_hosts[sid] = set(list(allowed)[-32:])
+        return Response("\n".join(lines) + "\n", media_type="application/vnd.apple.mpegurl",
+                        headers={"Cache-Control": "no-cache"})
+
+    out_headers = {k: up.headers[k] for k in _PASS_HEADERS if k in up.headers and k != "content-type"}
+    out_headers["Cache-Control"] = "no-cache, no-store"
+    out_headers["X-Accel-Buffering"] = "no"
+
+    async def body_iter() -> AsyncIterator[bytes]:
+        try:
+            while True:
+                if request is not None and await request.is_disconnected():
+                    break
+                try:
+                    chunk = await up.read(16384, timeout=20.0)
+                except (asyncio.TimeoutError, OSError, ssl.SSLError):
+                    break
+                if not chunk:
+                    break
+                yield chunk
+        finally:
+            up.close()
+
+    return StreamingResponse(body_iter(), media_type=ctype, headers=out_headers)
+
+
+def radio_router():
+    """APIRouter opcional com GET /radio/{station_id} (para ``app.include_router``)."""
+    from fastapi import APIRouter, Request
+
+    globals()["Request"] = Request  # anotações viram string (__future__); o FastAPI resolve aqui
+    router = APIRouter()
+
+    @router.get("/radio/{station_id}")
+    async def _radio(station_id: str, request: Request):
+        return await relay_radio(station_id, request)
+
+    return router
+
+
+# ---------------------------------------------------------------------------
+# Status
+# ---------------------------------------------------------------------------
+def genre_counts(stations: Optional[list[dict]] = None) -> dict[str, int]:
+    sts = _stations if stations is None else stations
+    out = {g: 0 for g in RADIO_GENRES}
+    for s in sts:
+        for g in station_genres(s):
+            out[g] = out.get(g, 0) + 1
+    return out
+
+
+async def radio_status() -> dict:
+    return {
+        "stations": len(_stations),
+        "pernambuco": sum(1 for s in _stations if is_pe(s)),
+        "https_direct": sum(1 for s in _stations if s.get("https_url")),
+        "relay_only": sum(1 for s in _stations if not s.get("https_url")),
+        "updated": _state["updated"],
+        "age_h": round((time.time() - _state["updated_ts"]) / 3600, 1) if _state["updated_ts"] else -1,
+        "running": _state["running"],
+        "checked": _state["checked"],
+        "candidates": _state["candidates"],
+        "duration_s": _state["duration_s"],
+        "api_server": _state["api_server"],
+        "last_error": _state["last_error"],
+        "path": _state["path"],
+        "genres": genre_counts(),
+    }
