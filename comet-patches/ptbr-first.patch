+                c_fidx = cand.get("file_index", "n")
+                c_name = cand.get("title", "")
+                c_key = str(c_fidx) if c_fidx and str(c_fidx) != "n" else str(c_name or "")
+                c_exist = await get_probe_result(c_hash, c_key)
+                if c_exist:
+                    continue
+
+                c_idx = cand.get("entry_index", 0)
+                if c_idx >= len(debrid_entries):
+                    continue
+                c_ent = debrid_entries[c_idx]
+                c_svc = c_ent.get("service")
+                c_tok = c_ent.get("token") or c_ent.get("apiKey")
+                if not c_svc or not c_tok:
