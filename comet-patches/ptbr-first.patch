+def _logo_image(raw: bytes | None, white: bool):
+    from PIL import Image
+    if not raw:
+        return None
+    im = Image.open(io.BytesIO(raw)).convert("RGBA")
+    bbox = im.getchannel("A").getbbox()
+    if bbox:
+        im = im.crop(bbox)
+    if white:
+        a = im.getchannel("A")
+        im = Image.new("RGBA", im.size, (255, 255, 255, 0))
+        im.putalpha(a)
+    return im
+
+
+def _text_logo(text: str, height: int = 160, gradient: tuple | None = None):
+    from PIL import Image, ImageDraw, ImageFont
+    font = ImageFont.truetype(_FONT_BOLD, height)
+    try:
+        font.set_variation_by_name("ExtraBold")
+    except Exception:
+        pass
+    l, t, r, b = font.getbbox(text)
+    im = Image.new("RGBA", (r - l + 20, b - t + 20), (0, 0, 0, 0))
+    d = ImageDraw.Draw(im)
+    d.text((10 - l, 10 - t), text, font=font, fill=(255, 255, 255, 255))
+    if gradient:
+        g = _lin_gradient(im.size, gradient[0], gradient[1], horizontal=True).convert("RGBA")
+        g.putalpha(im.getchannel("A"))
+        im = g
+    return im
+
+
+async def _logo_for(svc: dict):
+    if svc["key"] == FORYOU_ID:
+        return _text_logo("Para Você", 150, gradient=((255, 255, 255), (255, 190, 235)))
+    if svc.get("logo"):
+        raw = await _tmdb_image("w500", svc["logo"])
+        img = _logo_image(raw, svc.get("white", True))
+        if img is not None:
+            return img
+    return _text_logo(svc["name"], 150)
+
+
+def _lin_gradient(size, c_a, c_b, horizontal=False):
+    from PIL import Image
+    w, h = size
+    n = w if horizontal else h
+    line = Image.new("RGB", (n, 1))
+    for i in range(n):
+        f = i / max(1, n - 1)
+        line.putpixel((i, 0), tuple(int(c_a[k] + (c_b[k] - c_a[k]) * f) for k in range(3)))
+    if horizontal:
+        return line.resize((w, h))
+    return line.resize((h, 1)).rotate(-90, expand=True).resize((w, h))
+
+
+def _radial(size, center, radius, color, strength=1.0):
+    """Brilho radial: camada RGBA com a cor no centro sumindo nas bordas."""
+    from PIL import Image
+    w, h = size
+    small = Image.new("L", (64, 64))
+    cx, cy = center[0] / w * 64, center[1] / h * 64
+    rx, ry = radius / w * 64, radius / h * 64
+    for y in range(64):
+        for x in range(64):
+            d = math.hypot((x - cx) / max(rx, 1e-3), (y - cy) / max(ry, 1e-3))
+            small.putpixel((x, y), int(max(0.0, 1 - d) ** 1.8 * 255 * strength))
+    mask = small.resize((w, h), Image.BICUBIC)
+    layer = Image.new("RGBA", (w, h), color + (0,))
+    layer.putalpha(mask)
+    return layer
+
+
+def _noise(size, amount=10, seed=7):
+    from PIL import Image
+    rnd = random.Random(seed)
+    w, h = size[0] // 2, size[1] // 2
+    im = Image.new("L", (w, h))
+    im.putdata([128 + rnd.randint(-amount, amount) for _ in range(w * h)])
+    return im.resize(size)
+
+
+def _compose_tile(svc: dict, logo, backdrop=None, w=960, h=540):
+    """Bloco 16:9: vidro escuro na cor do serviço, brilho atrás do logo, borda de luz."""
+    from PIL import Image, ImageChops, ImageDraw, ImageFilter, ImageEnhance
+    c1, c2 = svc["c1"], svc["c2"]
+    base = _lin_gradient((w, h), tuple(min(255, int(v * 1.6)) for v in c1), c1)
+    if backdrop is not None:
+        bd = backdrop.convert("RGB").resize((w, h), Image.LANCZOS).filter(ImageFilter.GaussianBlur(10))
+        bd = ImageEnhance.Brightness(bd).enhance(0.55)
+        base = Image.blend(base, bd, 0.45)
+        tint = Image.new("RGB", (w, h), c1)
+        base = Image.blend(base, tint, 0.35)
+    base = base.convert("RGBA")
+    base.alpha_composite(_radial((w, h), (w * 0.5, h * 0.58), w * 0.55, c2, 0.85))
+    if svc.get("c3"):
+        base.alpha_composite(_radial((w, h), (w * 0.85, h * 0.15), w * 0.45, svc["c3"], 0.55))
+    # luz no alto (vidro)
+    gloss = _lin_gradient((w, h // 2), (255, 255, 255), (0, 0, 0)).convert("L")
+    gloss = gloss.point(lambda v: int(v * 0.10))
+    top = Image.new("RGBA", (w, h // 2), (255, 255, 255, 0))
+    top.putalpha(gloss)
+    base.alpha_composite(top, (0, 0))
+    # vinheta
+    vig = _radial((w, h), (w / 2, h / 2), w * 0.9, (0, 0, 0), 1.0).getchannel("A")
+    vig = ImageChops.invert(vig).point(lambda v: int(v * 0.55))
+    dark = Image.new("RGBA", (w, h), (0, 0, 0, 0))
+    dark.putalpha(vig)
+    base.alpha_composite(dark)
+    # grão sutil
+    n = _noise((w, h), 9).convert("RGB")
+    base = Image.blend(base.convert("RGB"), ImageChops.overlay(base.convert("RGB"), n), 0.25).convert("RGBA")
+    # logo com sombra e brilho
+    if logo is not None:
+        max_w, max_h = int(w * 0.62), int(h * 0.36)
+        sc = min(max_w / logo.width, max_h / logo.height)
+        lg = logo.resize((max(1, int(logo.width * sc)), max(1, int(logo.height * sc))), Image.LANCZOS)
+        x, y = (w - lg.width) // 2, (h - lg.height) // 2 + int(h * 0.02)
+        glow = Image.new("RGBA", (w, h), (0, 0, 0, 0))
+        ga = Image.new("L", (w, h), 0)
+        ga.paste(lg.getchannel("A"), (x, y))
+        ga = ga.filter(ImageFilter.GaussianBlur(18)).point(lambda v: int(v * 0.9))
+        glow = Image.new("RGBA", (w, h), c2 + (0,))
+        glow.putalpha(ga)
+        base.alpha_composite(glow)
+        sh = Image.new("RGBA", (w, h), (0, 0, 0, 0))
+        sa = Image.new("L", (w, h), 0)
+        sa.paste(lg.getchannel("A"), (x, y + 6))
+        sh.putalpha(sa.filter(ImageFilter.GaussianBlur(8)).point(lambda v: int(v * 0.6)))
+        base.alpha_composite(sh)
+        base.alpha_composite(lg, (x, y))
+    # borda de luz
+    d = ImageDraw.Draw(base)
+    d.rounded_rectangle((1, 1, w - 2, h - 2), radius=28, outline=(255, 255, 255, 46), width=2)
+    return base
+
+
+def _sweep_frames(tile, n=18):
+    """Brilho que atravessa o bloco na diagonal (GIF do foco)."""
+    from PIL import Image, ImageFilter
+    w, h = tile.size
+    frames = []
+    band = Image.new("L", (w * 2, h * 2), 0)
+    from PIL import ImageDraw
+    bd = ImageDraw.Draw(band)
+    bd.rectangle((w - 70, 0, w + 70, h * 2), fill=150)
+    band = band.filter(ImageFilter.GaussianBlur(40)).rotate(-22, resample=Image.BICUBIC)
+    for i in range(n):
+        f = i / (n - 1)
+        off = int(-w * 1.2 + f * w * 2.0)
+        m = Image.new("L", (w, h), 0)
+        m.paste(band, (off - w // 2, -h // 2))
+        light = Image.new("RGBA", (w, h), (255, 255, 255, 0))
+        light.putalpha(m)
+        fr = tile.copy()
+        fr.alpha_composite(light)
+        frames.append(fr.convert("RGB"))
+    # pausa no fim (o brilho passa e o bloco descansa)
+    frames += [tile.convert("RGB")] * 8
+    return frames
+
+
+def _compose_hero(svc: dict, backdrops: list, w=1920, h=1080):
+    """Fundo do destaque: o título em alta no serviço, lavado na cor da marca à esquerda/embaixo."""
+    from PIL import Image, ImageEnhance, ImageFilter
+    c1, c2 = svc["c1"], svc["c2"]
+    if backdrops:
+        bg = backdrops[0].convert("RGB").resize((w, h), Image.LANCZOS)
+        bg = ImageEnhance.Contrast(ImageEnhance.Color(bg).enhance(1.1)).enhance(1.05)
+    else:
+        bg = _lin_gradient((w, h), c2, c1, horizontal=True)
+    base = bg.convert("RGBA")
+    # lavagem de cor da marca, mais forte à esquerda (onde o Nuvio põe o logo e o texto)
+    left = _lin_gradient((w, h), c1, (0, 0, 0), horizontal=True).convert("RGBA")
+    a = _lin_gradient((w, h), (150, 150, 150), (0, 0, 0), horizontal=True).convert("L")
+    a = a.point(lambda v: int(v * (v / 150.0)))  # some rápido: o meio e a direita ficam vivos
+    left.putalpha(a)
+    base.alpha_composite(left)
+    base.alpha_composite(_radial((w, h), (w * 0.08, h * 0.9), w * 0.55, c2, 0.40))
+    bottom = Image.new("RGBA", (w, h), (0, 0, 0, 0))
+    ba = _lin_gradient((w, h), (0, 0, 0), (110, 110, 110)).convert("L")
+    ba = ba.point(lambda v: int(v * (v / 110.0)))
+    bottom.putalpha(ba)
+    base.alpha_composite(bottom)
+    return base.convert("RGB")
+
+
+def _jpeg(im, q=88) -> bytes:
+    buf = io.BytesIO()
+    im.convert("RGB").save(buf, "JPEG", quality=q, optimize=True, progressive=True)
+    return buf.getvalue()
+
+
+def _path(kind: str, key: str, ext: str, daily: bool) -> str:
+    os.makedirs(DATA_DIR, exist_ok=True)
+    stamp = f"_{datetime.date.today():%Y%m%d}" if daily else ""
+    return os.path.join(DATA_DIR, f"{kind}_{key}_v{_ART_VERSION}{stamp}.{ext}")
+
+
+def _cleanup_old(prefix: str, keep: str) -> None:
+    try:
+        for f in os.listdir(DATA_DIR):
+            if f.startswith(prefix) and os.path.join(DATA_DIR, f) != keep:
+                os.unlink(os.path.join(DATA_DIR, f))
+    except OSError:
+        pass
+
+
+async def _open_backdrops(key: str, n: int, size: str = "w1280"):
+    from PIL import Image
+    imgs = []
+    for p in await _top_backdrops(key, n):
+        raw = await _tmdb_image(size, p)
+        if raw:
+            try:
+                imgs.append(Image.open(io.BytesIO(raw)).convert("RGB"))
+            except Exception as e:
+                log_swallowed("streamings._open_backdrops", e)
+    return imgs
+
