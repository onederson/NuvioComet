+"""Sessão de hoje à noite: 3 sugestões diárias (filmes dublados prontos + próximo episódio)."""
+import asyncio
+import datetime
+import json
+import os
+import time
+from collections import Counter
+
+import aiohttp
+
+from comet.core.logger import logger
+from comet.core.models import settings
+
+STATE_PATH = "/opt/comet/data/evening.json"
+_LOCAL = "http://127.0.0.1:8000"
+try:
+    from zoneinfo import ZoneInfo
+    TZ = ZoneInfo("America/Recife")
+except Exception:  # sem tzdata no chroot: Recife é UTC-3 fixo
+    TZ = datetime.timezone(datetime.timedelta(hours=-3))
+
+ID_PREFIX = None
+ROWS = [{"type": "movie", "id": "comet_tonight", "name": "🌙 Para hoje à noite"}]
+HELP = "/hoje — 3 sugestões para hoje à noite (também chegam às 19h)"
+
+# fileiras do Comet usadas como fonte de filmes (id, bônus de ordem)
+SOURCES = [("comet_foryou", 1.0), ("comet_ready", 0.6), ("comet_top10", 0.3)]
+MAX_STREAM_CHECKS = 12
+MAX_MOVIE_CANDIDATES = 36
+SERIES_CHECKS = 2  # parte do orçamento de consultas reservada à série
+ROW_FROM_HOUR = 17
+
+_lock = asyncio.Lock()
+_tmdb_cache: dict[str, dict] = {}
+
+
+def _cfg_int(key: str, default: int) -> int:
+    from comet.services.telegram_bot import _env
+    try:
+        return int(str(_env(key) or default).strip())
+    except ValueError:
+        return default
+
+
+# ───────────────────────── funções puras ─────────────────────────
+
+def evening_day(now: datetime.datetime) -> str:
+    """Data da 'noite' a que o instante pertence (até 02h ainda é a noite anterior)."""
+    return (now.astimezone(TZ) - datetime.timedelta(hours=2)).strftime("%Y-%m-%d")
+
+
+def row_hours_ok(now: datetime.datetime) -> bool:
+    h = now.astimezone(TZ).hour
+    return h >= ROW_FROM_HOUR or h < 2
+
+
+def dedupe_plays(rows: list[dict], window_s: int = 3 * 3600) -> list[dict]:
+    """Um play por (media_id, janela de 3 h)."""
+    out, last = [], {}
+    for r in sorted(rows, key=lambda r: r["ts"]):
+        k = r["media_id"]
+        if k in last and r["ts"] - last[k] < window_s:
+            continue
+        last[k] = r["ts"]
+        out.append(r)
+    return out
+
+
+def genre_weights(genres_lists: list[list[str]]) -> dict[str, float]:
+    c = Counter(g for gl in genres_lists for g in set(gl))
+    top = max(c.values()) if c else 0
+    return {g: n / top for g, n in c.items()} if top else {}
+
+
+def fmt_hm(minutes: int) -> str:
+    return f"{minutes // 60}h{minutes % 60:02d}"
+
+
+def fmt_clock(h: int, m: int) -> str:
+    return f"{h}h" if m == 0 else f"{h}h{m:02d}"
+
+
+def end_clock(start_h: int, runtime: int) -> str:
+    total = start_h * 60 + runtime
+    total = int(round(total / 5.0)) * 5
+    return fmt_clock((total // 60) % 24, total % 60)
+
+
+def runtime_limit(start_h: int, end_h: int) -> int:
+    return min(180, max(0, (end_h - start_h) * 60))
+
+
+def score_movie(c: dict, weights: dict[str, float], weekday: int) -> float:
+    """c: {genres, runtime, bonus, idx}. weekday: 0=segunda."""
+    g = sum(weights.get(x, 0.0) for x in c.get("genres") or [])
+    rt = c.get("runtime") or 0
+    if weekday <= 3:
+        length = 1.0 if rt < 130 else -1.0
+    elif weekday in (4, 5):
+        length = 0.2 if rt >= 110 else 0.0
+    else:
+        length = 0.5 if rt < 150 else 0.0
+    return 2 * g + length + c.get("bonus", 0.0) - 0.02 * c.get("idx", 0)
+
+
+def pick_movies(cands: list[dict], seen: set[str], weights: dict[str, float], weekday: int,
+                limit_min: int) -> list[dict]:
+    """Filtra (não visto, com duração dentro do limite) e ordena por pontuação."""
+    ok = [c for c in cands if c["imdb"] not in seen and 0 < (c.get("runtime") or 0) <= limit_min]
+    return sorted(ok, key=lambda c: score_movie(c, weights, weekday), reverse=True)
+
+
+def next_episode(plays: list[dict], now_ts: float, days: int = 14) -> tuple[str, int, int] | None:
+    """(imdb, temporada, próximo episódio) da série mais vista nos últimos `days` dias."""
+    recent = [p for p in dedupe_plays([p for p in plays if p.get("season") is not None
+                                       and p.get("episode") is not None])
+              if p["ts"] >= now_ts - days * 86400]
+    if not recent:
+        return None
+    cnt = Counter(p["imdb"] for p in recent)
+    best = max(cnt, key=lambda k: (cnt[k], max(p["ts"] for p in recent if p["imdb"] == k)))
+    last = max((p for p in recent if p["imdb"] == best), key=lambda p: p["ts"])
+    return best, int(last["season"]), int(last["episode"]) + 1
+
+
+def watch_tag(name: str) -> str | None:
+    """'🇧🇷 ⚡ pronto' / '🇧🇷 🌐' a partir do nome da opção; None se não serve."""
+    if "🇧🇷" not in name:
+        return None
+    if "⚡" in name:
+        return "🇧🇷 ⚡ pronto"
+    if "🌐" in name:
+        return "🇧🇷 🌐"
+    return None
+
+
+def stream_tag(streams: list[dict]) -> str | None:
+    """Usa o '▶ Assistir' (1ª opção ▶); se ele não traz a bandeira, cai no 1º 🇧🇷 pronto."""
+    for s in streams:
+        name = str(s.get("name") or "")
+        if name.startswith("▶"):
+            t = watch_tag(name)
+            if t:
+                return t
+            break
+    for s in streams:
+        name = str(s.get("name") or "")
+        if not name.startswith("▶"):
+            t = watch_tag(name)
+            if t:
+                return t
+    return None
+
+
+def format_item(it: dict, start_h: int) -> tuple[str, str]:
+    """(texto da linha, link)."""
+    if it["type"] == "series":
+        text = f"{it['name']} S{it['season']:02d}E{it['episode']:02d} · próximo episódio · {it['tag']}"
+        return text, f"stremio:///detail/series/{it['imdb']}"
+    year = f" ({it['year']})" if it.get("year") else ""
+    text = (f"{it['name']}{year} · {fmt_hm(it['runtime'])} · termina ~{end_clock(start_h, it['runtime'])} "
+            f"se começar às {start_h}h · {it['tag']}")
+    return text, f"stremio:///detail/movie/{it['imdb']}"
+
+
+def format_message(items: list[dict], start_h: int) -> str:
+    if not items:
+        return "🌙 Hoje não achei nada dublado e pronto que caiba na noite."
+    lines = ["🌙 Para hoje à noite:"]
+    for i, it in enumerate(items, 1):
+        text, link = format_item(it, start_h)
+        lines.append(f"{i}. {text}\n   {link}")
+    return "\n".join(lines)
+
+
+def item_description(it: dict, start_h: int) -> str:
+    text, _ = format_item(it, start_h)
+    return text
+
+
+# ───────────────────────── estado ─────────────────────────
+
+def _load() -> dict:
+    try:
+        with open(STATE_PATH, encoding="utf-8") as f:
+            d = json.load(f)
+        if isinstance(d, dict):
+            return d
+    except (OSError, ValueError):
+        pass
+    return {}
+
+
+def _save(d: dict) -> None:
+    tmp = STATE_PATH + ".tmp"
+    with open(tmp, "w", encoding="utf-8") as f:
+        json.dump(d, f, ensure_ascii=False)
+    os.replace(tmp, STATE_PATH)
+
+
+def _today_items(now: datetime.datetime | None = None) -> list[dict]:
+    now = now or datetime.datetime.now(TZ)
+    st = _load()
+    return st.get("items") or [] if st.get("date") == evening_day(now) else []
+
+
+# ───────────────────────── I/O ─────────────────────────
+
+async def _play_rows() -> list[dict]:
+    from comet.core.database import database
+    rows = await database.fetch_all("SELECT ts, media_id, imdb, season, episode FROM play_log")
+    return [{"ts": r["ts"], "media_id": r["media_id"], "imdb": r["imdb"],
+             "season": r["season"], "episode": r["episode"]} for r in rows]
+
+
+async def _tmdb_info(session: aiohttp.ClientSession, imdb: str) -> dict:
+    """{kind, name, year, runtime, genres} (cache em memória)."""
+    if imdb in _tmdb_cache:
+        return _tmdb_cache[imdb]
+    from comet.metadata.tmdb import TMDBApi
+    api = TMDBApi(session)
+    info: dict = {}
+    try:
+        f = await api._get_json(f"find/{imdb}?external_source=imdb_id&language=pt-BR", f"evening find {imdb}") or {}
+        if f.get("movie_results"):
+            kind, r = "movie", f["movie_results"][0]
+        elif f.get("tv_results"):
+            kind, r = "tv", f["tv_results"][0]
+        else:
+            kind, r = None, None
+        if r:
+            d = await api._get_json(f"{kind}/{r['id']}?language=pt-BR", f"evening {kind} {r['id']}") or {}
+            rt = d.get("runtime") or (d.get("episode_run_time") or [0])[0] or 0
+            info = {"kind": kind, "name": d.get("title") or d.get("name") or "",
+                    "year": (d.get("release_date") or d.get("first_air_date") or "")[:4],
+                    "runtime": int(rt), "genres": [g["name"] for g in d.get("genres") or []]}
+    except Exception as e:
+        logger.debug(f"evening tmdb {imdb}: {type(e).__name__}")
+    if info:
+        _tmdb_cache[imdb] = info
+    return info
+
+
+async def _catalog(session: aiohttp.ClientSession, cat_id: str) -> list[dict]:
+    token = settings.PERSONAL_LINK_TOKEN
+    try:
+        async with session.get(f"{_LOCAL}/{token}/catalog/movie/{cat_id}.json",
+                               timeout=aiohttp.ClientTimeout(total=90)) as r:
+            if r.status != 200:
+                return []
+            data = await r.json(content_type=None)
+            return [m for m in (data or {}).get("metas") or [] if str(m.get("id", "")).startswith("tt")]
+    except Exception as e:
+        logger.debug(f"evening catalog {cat_id}: {type(e).__name__}")
+        return []
+
+
+async def build_suggestions(plays: list[dict], now: datetime.datetime | None = None,
+                            catalogs: dict[str, list[dict]] | None = None) -> list[dict]:
+    """Escolhe até 3 itens. `plays` vem do play_log (lista de dicts)."""
+    from comet.services.telegram_bot import _streams
+    now = (now or datetime.datetime.now(TZ)).astimezone(TZ)
+    start_h = _cfg_int("EVENING_START", 20)
+    end_h = _cfg_int("EVENING_END", 23)
+    limit = runtime_limit(start_h, end_h)
+    seen = {p["imdb"] for p in plays}
+    now_ts = now.timestamp()
+    sem = asyncio.Semaphore(4)
+    items: list[dict] = []
+    async with aiohttp.ClientSession() as session:
+        async def info(imdb):
+            async with sem:
+                return await _tmdb_info(session, imdb)
+
+        # gêneros preferidos: últimos 30 dias
+        recent_imdbs = []
+        for p in sorted(dedupe_plays(plays), key=lambda p: -p["ts"]):
+            if p["ts"] >= now_ts - 30 * 86400 and p["imdb"] not in recent_imdbs:
+                recent_imdbs.append(p["imdb"])
+        infos = await asyncio.gather(*[info(i) for i in recent_imdbs[:15]])
+        weights = genre_weights([i.get("genres") or [] for i in infos if i])
+
+        # candidatos de filme
+        cands: list[dict] = []
+        ids_seen: set[str] = set()
+        for cat_id, bonus in SOURCES:
+            metas = (catalogs or {}).get(cat_id) if catalogs else await _catalog(session, cat_id)
+            for idx, m in enumerate(metas or []):
+                if m["id"] in ids_seen or m["id"] in seen:
+                    continue
+                ids_seen.add(m["id"])
+                cands.append({"imdb": m["id"], "name": m.get("name") or "", "bonus": bonus, "idx": idx})
+        cands = cands[:MAX_MOVIE_CANDIDATES * 2]
+        cinfos = await asyncio.gather(*[info(c["imdb"]) for c in cands])
+        movies = []
+        for c, i in zip(cands, cinfos):
+            if not i or i.get("kind") != "movie":
+                continue
+            movies.append({**c, "name": i["name"] or c["name"], "year": i["year"],
+                           "runtime": i["runtime"], "genres": i["genres"]})
+        ranked = pick_movies(movies, seen, weights, now.weekday(), limit)[:MAX_MOVIE_CANDIDATES]
+
+        budget = MAX_STREAM_CHECKS
+        # 1 série: próximo episódio da mais vista em 14 dias
+        nxt = next_episode(plays, now_ts)
+        if nxt:
+            imdb, s, e = nxt
+            for _ in range(SERIES_CHECKS):
+                if budget <= 0:
+                    break
+                budget -= 1
+                try:
+                    tag = stream_tag(await _streams(session, "series", f"{imdb}:{s}:{e}"))
+                except Exception:
+                    tag = None
+                if tag:
+                    si = await info(imdb)
+                    items.append({"type": "series", "imdb": imdb, "name": si.get("name") or imdb,
+                                  "season": s, "episode": e, "tag": tag,
+                                  "year": si.get("year") or "", "runtime": 0})
+                    break
+                if e > 1:  # pode ter acabado a temporada: tenta o 1º da próxima
+                    s, e = s + 1, 1
+                else:
+                    break
+
+        want_movies = 3 - len(items)
+        movie_items = []
+        for c in ranked:
+            if len(movie_items) >= want_movies or budget <= 0:
+                break
+            budget -= 1
+            try:
+                tag = stream_tag(await _streams(session, "movie", c["imdb"]))
+            except Exception:
+                tag = None
+            if tag:
+                movie_items.append({"type": "movie", "imdb": c["imdb"], "name": c["name"], "year": c["year"],
+                                    "runtime": c["runtime"], "tag": tag})
+        items = movie_items + items  # série por último
+    return items[:3]
+
+
+async def generate(force: bool = False) -> list[dict]:
+    """Sugestões do dia (do arquivo, ou calculadas agora)."""
+    async with _lock:
+        now = datetime.datetime.now(TZ)
+        st = _load()
+        day = evening_day(now)
+        if not force and st.get("date") == day and st.get("items") is not None:
+            return st["items"]
+        t0 = time.time()
+        items = await build_suggestions(await _play_rows(), now)
+        sent = bool(st.get("sent")) if st.get("date") == day else False
+        _save({"date": day, "items": items, "sent": sent})
+        logger.info(f"evening: {len(items)} sugestões em {time.time() - t0:.0f}s")
+        return items
+
+
+# ───────────────────────── fileira ─────────────────────────
+
+def row_visible(catalog_id: str) -> bool:
+    if catalog_id != "comet_tonight":
+        return True
+    now = datetime.datetime.now(TZ)
+    return row_hours_ok(now) and bool(_today_items(now))
+
+
+async def catalog_items(catalog_id: str, base_url: str) -> list[dict]:
+    if catalog_id != "comet_tonight":
+        return []
+    start_h = _cfg_int("EVENING_START", 20)
+    metas = []
+    for it in _today_items():
+        metas.append({"id": it["imdb"], "type": it["type"], "name": it["name"],
+                      "poster": f"https://images.metahub.space/poster/medium/{it['imdb']}/img",
+                      "description": item_description(it, start_h)})
+    return metas
+
+
+# ───────────────────────── bot ─────────────────────────
+
+async def handle_command(text: str) -> str | None:
+    cmd = (text or "").strip().split()[0].lower().split("@")[0] if (text or "").strip() else ""
+    if cmd != "/hoje":
+        return None
+    items = await generate()
+    return format_message(items, _cfg_int("EVENING_START", 20))
+
+
+async def status_lines() -> list[str]:
+    n = len(_today_items())
+    return [f"🌙 Hoje à noite: {n} sugestão(ões)"] if n else []
+
+
+async def _tick() -> None:
+    now = datetime.datetime.now(TZ)
+    h = now.hour
+    send_h = _cfg_int("EVENING_HOUR", 19)
+    if h < ROW_FROM_HOUR and h >= 2:
+        return
+    st = _load()
+    day = evening_day(now)
+    if st.get("date") != day or st.get("items") is None:
+        await generate()
+        st = _load()
+    if h >= send_h and h < 24 and st.get("date") == day and not st.get("sent"):
+        from comet.services.telegram_bot import send_telegram
+        await send_telegram(format_message(st.get("items") or [], _cfg_int("EVENING_START", 20)))
+        st["sent"] = True
+        _save(st)
+
+
+async def start_service() -> None:
+    await asyncio.sleep(120)
+    while True:
+        try:
+            await _tick()
+        except Exception as e:
+            logger.warning(f"evening: {type(e).__name__}: {e}")
+        await asyncio.sleep(300)
