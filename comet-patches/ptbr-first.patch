+
+# ───────────────────────── funções puras ─────────────────────────
+
+def _round5(minutes: float | int | None) -> int:
+    try:
+        m = float(minutes)
+    except (TypeError, ValueError):
+        m = DEFAULT_RUNTIME
+    if m <= 0:
+        m = DEFAULT_RUNTIME
+    return int(math.ceil(m / 5.0) * 5)
+
+
+def aired_episodes(videos: list[dict], now_utc: datetime) -> list[tuple[int, int, str]]:
+    """Episódios já lançados (ignora temporada 0 e futuros): [(temporada, episódio, título)]."""
+    out: dict[tuple[int, int], str] = {}
+    for v in videos or []:
+        if not isinstance(v, dict):
+            continue
+        try:
+            s = int(v.get("season"))
+            e = int(v.get("episode", v.get("number")))
+        except (TypeError, ValueError):
+            continue
+        if s <= 0 or e <= 0:
+            continue
+        rel = v.get("released") or v.get("firstAired")
+        if not rel or not isinstance(rel, str):
+            continue
+        try:
+            dt = datetime.fromisoformat(rel.strip().replace("Z", "+00:00"))
+            if dt.tzinfo is None:
+                dt = dt.replace(tzinfo=timezone.utc)
+        except ValueError:
+            continue
+        if dt > now_utc:
+            continue
+        out[(s, e)] = str(v.get("title") or v.get("name") or "").strip()
+    return [(s, e, t) for (s, e), t in sorted(out.items())]
+
+
+def rank_series(rows: list[dict]) -> list[dict]:
+    """rows do play_log (imdb, season, episode) -> [{imdb, weight}] pelo nº de episódios distintos."""
+    eps: dict[str, set] = {}
+    for r in rows:
+        imdb = r.get("imdb") or ""
+        if not imdb.startswith("tt") or r.get("season") is None or r.get("episode") is None:
+            continue
+        eps.setdefault(imdb, set()).add((int(r["season"]), int(r["episode"])))
+    out = [{"imdb": k, "weight": len(v)} for k, v in eps.items()]
+    out.sort(key=lambda x: (-x["weight"], x["imdb"]))
+    return out
+
+
+def build_schedule(day: date, series: list[dict], recent: set, runtime: Callable) -> list[dict]:
+    """Grade de 24 h. series: [{imdb, name, weight, episodes:[(s,e,título)]}].
+    recent: {(imdb,s,e)} vistos há pouco. runtime(imdb,s,e) -> minutos ou None."""
+    pool = sorted((s for s in series if s.get("episodes")), key=lambda s: s["imdb"])
+    if not pool:
+        return []
+    rng = random.Random(f"mytv:{day.isoformat()}")
+    used: set = set()
+    start0 = datetime(day.year, day.month, day.day, tzinfo=TZ)
+    out: list[dict] = []
+    t = 0
+    last = None
+    while t < DAY_MIN and len(out) < 200:
+        cands = [s for s in pool if any((s["imdb"], a, b) not in used for a, b, _ in s["episodes"])]
+        if not cands:
+            break
+        if len(cands) > 1 and last is not None:
+            cands = [s for s in cands if s["imdb"] != last] or cands
+        ser = rng.choices(cands, weights=[max(1, int(s.get("weight") or 1)) for s in cands])[0]
+        free = [x for x in ser["episodes"] if (ser["imdb"], x[0], x[1]) not in used]
+        fresh = [x for x in free if (ser["imdb"], x[0], x[1]) not in recent]
+        s_, e_, title = rng.choice(fresh or free)
+        used.add((ser["imdb"], s_, e_))
+        dur = _round5(runtime(ser["imdb"], s_, e_) or DEFAULT_RUNTIME)
+        out.append({
+            "imdb": ser["imdb"], "series": ser["name"], "season": s_, "episode": e_, "title": title,
+            "start": start0 + timedelta(minutes=t), "end": start0 + timedelta(minutes=t + dur),
+        })
+        t += dur
+        last = ser["imdb"]
+    return out
+
+
+def current_index(schedule: list[dict], now: datetime) -> int | None:
+    for i, p in enumerate(schedule):
+        if p["start"] <= now < p["end"]:
+            return i
+    return None
+
+
+def prog_label(p: dict) -> str:
+    base = f"{p['series']} T{p['season']}E{p['episode']}"
+    return f"{base} · {p['title']}" if p.get("title") else base
+
+
+def describe(schedule: list[dict], idx: int, now: datetime, upcoming: int = 8) -> str:
+    p = schedule[idx]
+    verbo = "começou" if p["start"] <= now else "começa"
+    lines = [f"Agora: {prog_label(p)} ({verbo} {p['start']:%H:%M}, termina {p['end']:%H:%M})"]
+    for q in schedule[idx + 1: idx + 1 + upcoming]:
+        lines.append(f"{'Depois: ' if q is schedule[idx + 1] else ''}{q['start']:%H:%M} {prog_label(q)}")
+    return "\n".join(lines)
+
+
+# ───────────────────────── I/O ─────────────────────────
+
+def _local_now() -> datetime:
+    return datetime.now(TZ)
+
+
+def _base_art() -> str:
+    return (getattr(settings, "PUBLIC_BASE_URL", None) or "").rstrip("/")
+
+
+async def _play_rows() -> list[dict]:
+    from comet.core.database import database
+
+    since = int(time.time()) - LOOKBACK_DAYS * 86400
+    rows = await database.fetch_all(
+        "SELECT imdb, season, episode, ts FROM play_log "
+        "WHERE season IS NOT NULL AND episode IS NOT NULL AND ts > :since",
+        {"since": since},
+    )
+    return [{"imdb": r["imdb"], "season": r["season"], "episode": r["episode"], "ts": r["ts"]} for r in rows]
+
+
+async def _fetch_series(session: aiohttp.ClientSession, imdb: str) -> dict | None:
+    meta = None
+    try:
+        from comet.services.meta_ptbr import get_meta_ptbr
+
+        meta = await get_meta_ptbr("series", imdb)
+    except Exception as e:
+        logger.warning(f"mytv: meta_ptbr {imdb}: {type(e).__name__}")
+    if not (isinstance(meta, dict) and meta.get("videos")):
+        try:
+            async with session.get(f"https://v3-cinemeta.strem.io/meta/series/{imdb}.json",
+                                   timeout=aiohttp.ClientTimeout(total=10)) as resp:
+                if resp.status == 200:
+                    meta = (await resp.json()).get("meta") or {}
+        except Exception as e:
+            logger.warning(f"mytv: cinemeta {imdb}: {type(e).__name__}")
+    if not isinstance(meta, dict) or not meta.get("videos"):
+        return None
+    return {"name": meta.get("name") or imdb, "videos": meta["videos"]}
+
+
+async def _library_series() -> list[str]:
+    try:
+        from comet.services.stremio_library import get_stremio_library
+
+        items = await get_stremio_library()
+    except Exception:
+        return []
+    # A pessoa assiste sem salvar na biblioteca (itens ficam "removed"/temp): vale o histórico.
+    cand = []
+    for it in items or []:
+        if it.get("type") != "series" or not str(it.get("_id", "")).startswith("tt"):
+            continue
+        st = it.get("state") or {}
+        last = str(st.get("lastWatched") or it.get("_mtime") or "")
+        watched = bool(st.get("lastWatched")) or float(st.get("overallTimeWatched") or st.get("timeWatched") or 0) > 0
+        if watched or not it.get("removed"):
+            cand.append((last, it["_id"]))
+    cand.sort(reverse=True)
+    return [i for _, i in cand]
+
+
+async def _load_series(session: aiohttp.ClientSession) -> tuple[list[dict], set]:
+    rows = await _play_rows()
+    ranked = rank_series(rows)
+    cut = int(time.time()) - RECENT_DAYS * 86400
+    recent = {(r["imdb"], int(r["season"]), int(r["episode"])) for r in rows if r["ts"] >= cut}
+    ids = [(x["imdb"], x["weight"]) for x in ranked[:MAX_SERIES]]
+    if len(ids) < MIN_SERIES:
+        have = {i for i, _ in ids}
+        for imdb in await _library_series():
+            if imdb not in have:
+                ids.append((imdb, 1))
+                have.add(imdb)
+            if len(ids) >= MAX_SERIES:
+                break
+    sem = asyncio.Semaphore(4)
+    now_utc = datetime.now(timezone.utc)
+
+    async def one(imdb: str, w: int):
+        async with sem:
+            data = await _fetch_series(session, imdb)
+        if not data:
+            return None
+        eps = aired_episodes(data["videos"], now_utc)
+        return {"imdb": imdb, "name": data["name"], "weight": w, "episodes": eps} if eps else None
+
+    res = await asyncio.gather(*(one(i, w) for i, w in ids))
+    return [r for r in res if r], recent
+
+
+async def _tmdb_id(tmdb, imdb: str) -> int | None:
+    if imdb in _TMDB_IDS:
+        return _TMDB_IDS[imdb]
+    data = await tmdb._get_json(f"find/{imdb}?external_source=imdb_id&language=pt-BR", f"mytv find {imdb}")
+    tid = None
+    if isinstance(data, dict) and data.get("tv_results"):
+        tid = data["tv_results"][0].get("id")
+    _TMDB_IDS[imdb] = tid
+    return tid
+
+
+async def _fetch_season_runtimes(session: aiohttp.ClientSession, misses: set) -> None:
+    from comet.metadata.tmdb import TMDBApi
+
+    tmdb = TMDBApi(session)
+    sem = asyncio.Semaphore(4)
+
+    async def one(imdb: str, season: int):
+        out: dict[int, int] = {}
+        try:
+            async with sem:
+                tid = await _tmdb_id(tmdb, imdb)
+                data = await tmdb._get_json(f"tv/{tid}/season/{season}?language=pt-BR", f"mytv {imdb} S{season}") if tid else None
+            for ep in (data or {}).get("episodes") or []:
+                if ep.get("runtime") and ep.get("episode_number") is not None:
+                    out[int(ep["episode_number"])] = int(ep["runtime"])
+        except Exception as e:
+            logger.warning(f"mytv: runtime {imdb} S{season}: {type(e).__name__}")
+        _RUNTIMES[(imdb, season)] = out
+
+    await asyncio.gather(*(one(i, s) for i, s in misses))
+
+
+async def _build_today(session: aiohttp.ClientSession, day: date, series: list[dict], recent: set) -> list[dict]:
+    """Roda a grade até não faltar runtime de temporada (máx. 4 rodadas)."""
+    sched: list[dict] = []
+    for _ in range(4):
+        misses: set = set()
+
+        def rt(imdb, s, e):
+            v = _RUNTIMES.get((imdb, s))
+            if v is None:
+                misses.add((imdb, s))
+                return None
+            return v.get(e)
+
+        sched = build_schedule(day, series, recent, rt)
+        if not misses:
+            break
+        await _fetch_season_runtimes(session, misses)
+    return sched
+
+
+async def _ensure() -> list[dict]:
+    """Grade de hoje (cache em memória por dia)."""
+    now = _local_now()
+    day = now.date()
+    if _STATE["day"] == day and _STATE["schedule"]:
+        return _STATE["schedule"]
+    if _STATE["day"] == day and time.time() < _STATE["retry"]:
+        return []
+    async with _lock:
+        if _STATE["day"] == day and _STATE["schedule"]:
+            return _STATE["schedule"]
+        try:
+            async with aiohttp.ClientSession() as session:
+                series, recent = await _load_series(session)
+                _STATE["n"] = len(series)
+                sched = await _build_today(session, day, series, recent) if len(series) >= MIN_SERIES else []
+        except Exception as e:
+            logger.warning(f"mytv: falha ao montar a grade: {type(e).__name__}: {e}")
+            sched = []
+        _STATE.update(day=day, series=None, schedule=sched or None,
+                      retry=time.time() + (0 if sched else 600))
+        if sched:
+            _JPG.clear()
+        return sched
+
+
+def row_visible(catalog_id: str) -> bool:
+    if catalog_id != "comet_mytv":
+        return False
+    n = _STATE["n"]
+    return True if n is None else n >= MIN_SERIES
+
+
+def _art_url(bucket: int) -> str:
+    return f"{_base_art()}/art/mytv/{bucket}.jpg"
+
+
+def _bucket(now: datetime | None = None) -> int:
+    return int((now or _local_now()).timestamp() // 300)
+
+
+async def catalog_items(catalog_id: str, base_url: str) -> list[dict]:
+    if catalog_id != "comet_mytv":
+        return []
+    sched = await _ensure()
+    if not sched:
+        return []
+    now = _local_now()
+    i = current_index(sched, now)
+    item = {"id": MAIN_ID, "type": "tv", "name": CHANNEL_NAME, "poster": _art_url(_bucket(now)),
+            "posterShape": "landscape"}
+    if i is not None:
+        item["description"] = describe(sched, i, now, 3)
+    return [item]
+
+
+async def get_meta(media_id: str, base_url: str) -> dict | None:
+    if media_id != MAIN_ID:
+        return None
+    sched = await _ensure()
+    if not sched:
+        return None
+    now = _local_now()
+    i = current_index(sched, now)
+    if i is None:
+        return None
+    poster = _art_url(_bucket(now))
+    return {
+        "id": MAIN_ID, "type": "tv", "name": CHANNEL_NAME, "poster": poster, "posterShape": "landscape",
+        "logo": poster,
+        "background": f"https://images.metahub.space/background/medium/{sched[i]['imdb']}/img",
+        "description": describe(sched, i, now, 8),
+        "videos": [{"id": MAIN_ID, "title": "📺 Ao vivo agora", "released": now.astimezone(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
+                    "thumbnail": poster, "overview": describe(sched, i, now, 8)}],
+    }
+
+
+async def _assistir(session: aiohttp.ClientSession, p: dict) -> list[dict]:
+    token = getattr(settings, "PERSONAL_LINK_TOKEN", "") or ""
+    url = f"http://127.0.0.1:8000/{token}/stream/series/{p['imdb']}:{p['season']}:{p['episode']}.json"
+    try:
+        async with session.get(url, timeout=aiohttp.ClientTimeout(total=60)) as resp:
+            if resp.status != 200:
+                return []
+            streams = (await resp.json()).get("streams") or []
+    except Exception as e:
+        logger.warning(f"mytv: fontes de {p['imdb']}: {type(e).__name__}")
+        return []
+    best = [s for s in streams if str(s.get("name", "")).startswith("▶")]
+    return best[:1] or streams[:3]
+
+
+def _wrap(stream: dict, title: str) -> dict:
+    out = dict(stream)
+    out["name"] = CHANNEL_NAME
+    out["title"] = title
+    out["description"] = title
+    return out
+
+
+async def get_streams(media_id: str, base_url: str) -> list[dict] | None:
+    if media_id != MAIN_ID:
+        return None
+    sched = await _ensure()
+    i = current_index(sched, _local_now()) if sched else None
+    if i is None:
+        return []
+    cur = sched[i]
+    nxt = sched[i + 1] if i + 1 < len(sched) else None
+    async with aiohttp.ClientSession() as session:
+        got = await asyncio.gather(_assistir(session, cur), _assistir(session, nxt) if nxt else _none())
+    out = [_wrap(s, f"Agora: {cur['series']} T{cur['season']}E{cur['episode']} · começa do início") for s in got[0]]
+    if nxt:
+        out += [_wrap(s, f"A seguir: {nxt['series']} T{nxt['season']}E{nxt['episode']} · {nxt['start']:%H:%M}")
+                for s in got[1][:1]]
+    return out
+
+
+async def _none() -> list[dict]:
+    return []
+
+
+# ───────────────────────── capa ─────────────────────────
+
+async def _fetch_bytes(url: str) -> bytes | None:
+    try:
+        async with aiohttp.ClientSession() as session:
+            async with session.get(url, timeout=aiohttp.ClientTimeout(total=8)) as resp:
+                if resp.status == 200:
+                    return await resp.read()
+    except Exception as _e:
+        log_swallowed("mytv._fetch_bytes", _e)
+    return None
+
+
+async def render_cover(now: datetime | None = None) -> bytes | None:
+    sched = await _ensure()
+    now = now or _local_now()
+    i = current_index(sched, now) if sched else None
+    if i is None:
+        return None
+    cur = sched[i]
+    nxt = sched[i + 1] if i + 1 < len(sched) else None
+    from comet.services import live_art
+
+    logo = await _fetch_bytes(f"https://images.metahub.space/poster/small/{cur['imdb']}/img")
+    try:
+        return await asyncio.to_thread(
+            live_art.tv_guide_card, logo, CHANNEL_NAME, prog_label(cur), cur["start"], cur["end"],
+            prog_label(nxt) if nxt else None, nxt["start"] if nxt else None, now)
+    except Exception as e:
+        logger.warning(f"mytv: capa: {type(e).__name__}: {e}")
+        if logo is None:
+            return None
+        return await asyncio.to_thread(
+            live_art.tv_guide_card, None, CHANNEL_NAME, prog_label(cur), cur["start"], cur["end"],
+            prog_label(nxt) if nxt else None, nxt["start"] if nxt else None, now)
+
+
+@router.get("/art/mytv/{bucket}.jpg", include_in_schema=False)
+async def art_mytv(bucket: int):
+    jpg = _JPG.get(bucket)
+    if jpg is None:
+        # o cartão é sempre do momento atual do slot pedido (máx. ±1 slot do relógio)
+        if abs(bucket - _bucket()) > 1:
+            bucket = _bucket()
+        jpg = await render_cover(datetime.fromtimestamp(bucket * 300 + 1, TZ))
+        if jpg is None:
+            raise HTTPException(404)
+        if len(_JPG) > 6:
+            _JPG.clear()
+        _JPG[bucket] = jpg
+    return Response(jpg, media_type="image/jpeg", headers={"Cache-Control": "public, max-age=300"})
+
+
+async def start_service() -> None:
+    """Aquece a grade do dia (e do dia seguinte, após a virada) sem deixar exceção escapar."""
+    await asyncio.sleep(120)
+    while True:
+        try:
+            await _ensure()
+        except Exception as e:
+            logger.warning(f"mytv: serviço: {type(e).__name__}: {e}")
+        await asyncio.sleep(1800)
