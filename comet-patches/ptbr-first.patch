@@ -0,0 +1,270 @@
+"""Capas vivas: rotas que desenham imagens com informação do momento (motor em comet/services/live_art.py).
+
+Rotas (sem token; só desenham imagens públicas):
+  /art/tv/{cometlive id}.jpg             capa do canal com o que está passando agora
+  /art/ep.jpg?u=<thumb>&b=DUB,FILLER&r=9.4   miniatura de episódio com selos
+  /art/live.jpg?u=<capa>&pg=62&ml=23&st=HOJE  capa com barra de progresso / faixa de estado
+Imagens de origem: só image.tmdb.org, images.metahub.space, episodes.metahub.space ou o próprio Comet (/art/...).
+"""
+from __future__ import annotations
+
+import asyncio
+import hashlib
+import io
+import os
+import time
+import urllib.parse
+from datetime import datetime, timedelta
+
+import aiohttp
+from fastapi import APIRouter, HTTPException, Response
+
+from comet.core.logger import logger
+from comet.core.models import settings
+
+router = APIRouter(tags=["Stremio"])
+
+CACHE_DIR = "/opt/comet/data/live_art"
+_SEM = asyncio.Semaphore(2)
+_HERO_ASSETS: dict = {}  # imdb -> (quando, dados, fundo, logo, elenco): o caro de buscar fica 6 h
+_ALLOWED = ("image.tmdb.org", "images.metahub.space", "episodes.metahub.space", "images.pluto.tv")
+_IMG_HEADERS = {"Cache-Control": "public, max-age=900"}
+_UA = {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0 Safari/537.36"}
+
+
+def _base() -> str:
+    return (getattr(settings, "PUBLIC_BASE_URL", None) or "").rstrip("/")
+
+
+def bucket(minutes: int = 15) -> int:
+    return int(time.time() // (minutes * 60))
+
+
+def _cache_path(key: str) -> str:
+    os.makedirs(CACHE_DIR, exist_ok=True)
+    return os.path.join(CACHE_DIR, hashlib.sha1(key.encode()).hexdigest() + ".jpg")
+
+
+def _cache_get(key: str, max_age: int) -> bytes | None:
+    p = _cache_path(key)
+    try:
+        if os.path.exists(p) and time.time() - os.path.getmtime(p) < max_age:
+            with open(p, "rb") as f:
+                return f.read()
+    except OSError:
+        pass
+    return None
+
+
+def _cache_put(key: str, data: bytes) -> None:
+    p = _cache_path(key)
+    tmp = p + ".tmp"
+    try:
+        with open(tmp, "wb") as f:
+            f.write(data)
+        os.replace(tmp, p)
+    except OSError:
+        pass
+
+
+def _cleanup() -> None:
+    """Mantém o cache em até ~400 arquivos (os mais antigos saem)."""
+    try:
+        files = sorted((os.path.getmtime(os.path.join(CACHE_DIR, f)), f) for f in os.listdir(CACHE_DIR))
+        for _, f in files[:-400]:
+            os.remove(os.path.join(CACHE_DIR, f))
+    except OSError:
+        pass
+
+
+def _allowed(url: str) -> bool:
+    try:
+        u = urllib.parse.urlparse(url)
+    except ValueError:
+        return False
+    if u.scheme in ("http", "https") and u.hostname in _ALLOWED:
+        return True
+    base = urllib.parse.urlparse(_base())
+    return bool(base.hostname) and u.hostname == base.hostname and u.path.startswith("/art/")
+
+
+async def _fetch(url: str, session: aiohttp.ClientSession) -> bytes | None:
+    if not _allowed(url):
+        return None
+    # o próprio Comet: busca local, sem dar a volta pela internet
+    base = _base()
+    if base and url.startswith(base + "/art/"):
+        url = "http://127.0.0.1:8000" + url[len(base):]
+    try:
+        async with session.get(url, timeout=aiohttp.ClientTimeout(total=12), headers=_UA) as r:
+            if r.status != 200:
+                return None
+            data = await r.read()
+            return data if len(data) < 6 * 1024 * 1024 else None
+    except Exception:
+        return None
+
+
+def _tmdb_img(path: str | None, size: str = "w1280") -> str | None:
+    return f"https://image.tmdb.org/t/p/{size}{path}" if path else None
+
+
+# ---------------------------------------------------------------- URLs para o resto do Comet
+
+def tv_url(channel_id: str) -> str:
+    return f"{_base()}/art/tv/{urllib.parse.quote(channel_id, safe='')}.jpg?t={bucket(15)}"
+
+
+def ep_url(thumb: str, badges: list[str], rating: float | None, fallback: str | None = None) -> str:
+    q = {"u": thumb}
+    if fallback:
+        q["fb"] = fallback
+    if badges:
+        q["b"] = ",".join(badges)
+    if rating:
+        q["r"] = f"{rating:.1f}"
+    return f"{_base()}/art/ep.jpg?{urllib.parse.urlencode(q)}"
+
+
+def live_url(cover: str, pct: int | None = None, minutes_left: int | None = None, status: str | None = None) -> str:
+    q = {"u": cover}
+    if pct is not None:
+        q["pg"] = str(max(1, min(99, int(pct))))
+    if minutes_left is not None:
+        q["ml"] = str(max(1, int(minutes_left)))
+    if status:
+        q["st"] = status
+    return f"{_base()}/art/live.jpg?{urllib.parse.urlencode(q)}"
+
+
+# ---------------------------------------------------------------- dados do pôster editorial
+
+# ---------------------------------------------------------------- rotas
+
+@router.get("/art/tv/{channel_id}.jpg", include_in_schema=False)
+async def art_tv(channel_id: str):
+    channel_id = urllib.parse.unquote(channel_id)
+    if not channel_id.startswith("cometlive:"):
+        raise HTTPException(404)
+    key = f"tv:{channel_id}:{bucket(15)}"
+    hit = _cache_get(key, 900)
+    if hit:
+        return Response(hit, media_type="image/jpeg", headers=_IMG_HEADERS)
+    from comet.services import live_art, live_tv
+    name, logo_url, now_t, now_s, now_e, nxt_t, nxt_s = channel_id, None, "Ao vivo", None, None, None, None
+    now = datetime.now().astimezone()
+    try:
+        if channel_id.startswith("cometlive:pluto:"):
+            ch = await live_tv.get_pluto_channel_by_id(channel_id.split(":", 2)[2]) or {}
+            name = ch.get("name") or name
+            logo_url = ((ch.get("colorLogoPNG") or {}).get("path") or (ch.get("logo") or {}).get("path"))
+            progs = []
+            for tl in ch.get("timelines") or []:
+                try:
+                    st = datetime.fromisoformat(tl["start"].replace("Z", "+00:00")).astimezone()
+                    en = datetime.fromisoformat(tl["stop"].replace("Z", "+00:00")).astimezone()
+                    progs.append((st, en, tl.get("title") or ""))
+                except Exception:
+                    continue
+            progs.sort()
+            cur = next((p for p in progs if p[0] <= now < p[1]), None)
+            if cur:
+                now_s, now_e, now_t = cur
+                nxt = next((p for p in progs if p[0] >= cur[1]), None)
+                if nxt:
+                    nxt_s, nxt_t = nxt[0], nxt[2]
+        else:
+            ch = live_tv.get_iptv_channel_by_id(channel_id) or {}
+            name = ch.get("name") or name
+            logo_url = ch.get("logo")
+    except Exception as e:
+        logger.debug(f"art tv {channel_id}: {e}")
+    if now_s is None:
+        now_s, now_e = now - timedelta(minutes=30), now + timedelta(minutes=30)
+    async with _SEM:
+        logo = None
+        if logo_url:
+            async with aiohttp.ClientSession() as s:
+                try:
+                    async with s.get(logo_url, timeout=aiohttp.ClientTimeout(total=8), headers=_UA) as r:
+                        if r.status == 200:
+                            logo = await r.read()
+                except Exception:
+                    logo = None
+        try:
+            jpg = await asyncio.to_thread(live_art.tv_guide_card, logo, name, now_t, now_s, now_e, nxt_t, nxt_s, now)
+        except Exception as e:
+            logger.warning(f"art tv {channel_id}: {type(e).__name__}: {e}")
+            raise HTTPException(404)
+    _cache_put(key, jpg)
+    return Response(jpg, media_type="image/jpeg", headers=_IMG_HEADERS)
+
+
+@router.get("/art/ep.jpg", include_in_schema=False)
+async def art_ep(u: str, b: str | None = None, r: float | None = None, w: int = 0, fb: str | None = None):
+    if not _allowed(u):
+        raise HTTPException(404)
+    badges = [x for x in (b or "").split(",") if x][:4]
+    key = f"ep:{u}:{','.join(badges)}:{r}:{w}"
+    hit = _cache_get(key, 30 * 86400)
+    if hit:
+        return Response(hit, media_type="image/jpeg", headers={"Cache-Control": "public, max-age=86400"})
+    from comet.services import live_art
+    async with _SEM:
+        async with aiohttp.ClientSession() as s:
+            src = await _fetch(u, s)
+            if not src and fb and _allowed(fb):
+                src = await _fetch(fb, s)
+        if not src:
+            raise HTTPException(404)
+        jpg = await asyncio.to_thread(live_art.episode_thumb, src, badges, r, bool(w))
+    _cache_put(key, jpg)
+    return Response(jpg, media_type="image/jpeg", headers={"Cache-Control": "public, max-age=86400"})
+
+
+@router.get("/art/week/{key}.jpg", include_in_schema=False)
+async def art_week(key: str):
+    if not (len(key) == 8 and key.isdigit()):
+        raise HTTPException(404)
+    ck = f"week:{key}:{bucket(30)}"
+    hit = _cache_get(ck, 1800)
+    if hit:
+        return Response(hit, media_type="image/jpeg", headers=_IMG_HEADERS)
+    from comet.services import live_art
+    from comet.services.week_cards import day_card_data
+    data = await day_card_data(key)
+    if not data:
+        raise HTTPException(404)
+    day, dm, rows = data
+    async with _SEM:
+        jpg = await asyncio.to_thread(live_art.week_day_card, day, dm, rows)
+    _cache_put(ck, jpg)
+    return Response(jpg, media_type="image/jpeg", headers=_IMG_HEADERS)
+
+
+@router.get("/art/live.jpg", include_in_schema=False)
+async def art_live(u: str, pg: int | None = None, ml: int | None = None, st: str | None = None):
+    if not _allowed(u):
+        raise HTTPException(404)
+    key = f"live:{u}:{pg}:{ml}:{st}"
+    hit = _cache_get(key, 3 * 86400)
+    if hit:
+        return Response(hit, media_type="image/jpeg", headers=_IMG_HEADERS)
+    from comet.services import live_art
+    async with _SEM:
+        async with aiohttp.ClientSession() as s:
+            src = await _fetch(u, s)
+        if not src:
+            raise HTTPException(404)
+
+        def _draw():
+            img = live_art._load(src)
+            if st:
+                img = live_art.status_ribbon(img, st[:28])
+            if pg is not None:
+                img = live_art.progress_overlay(img, pg / 100.0, ml)
+            return live_art.to_jpeg(img)
+
+        jpg = await asyncio.to_thread(_draw)
+    _cache_put(key, jpg)
+    return Response(jpg, media_type="image/jpeg", headers=_IMG_HEADERS)
