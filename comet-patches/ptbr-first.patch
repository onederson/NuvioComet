+++ b/comet/services/meta_ptbr.py
@@ -0,0 +1,735 @@
+import asyncio
+import copy
+import re
+import time
+import aiohttp
+
+from comet.core.logger import logger, log_swallowed
+from comet.metadata.tmdb import TMDBApi
+from comet.services.catalogs import PROVIDERS
+
+_PROVIDER_SHORT_NAMES = {
+    info[1]: info[0] for info in PROVIDERS.values()
+}
+
+_GENERIC_EPISODE_RE = re.compile(
+    r"^(?:epis[oó]dio|episode|cap[ií]tulo)\s+\d+$", re.IGNORECASE
+)
+
+_META_CACHE: dict[tuple[str, str], tuple[float, dict]] = {}
+_META_CACHE_TTL = 12 * 3600.0  # 12 hours
+_META_CACHE_MAX = 500
+
+
+_RATING_ICON = {"10": "🔵", "12": "🟡", "14": "🟠", "16": "🔴", "18": "⚫"}
+
+def _is_generic_title(title: str) -> bool:
+    if not title:
+        return True
+    return bool(_GENERIC_EPISODE_RE.match(title.strip()))
+
+
+def _apply_tmdb_logo_and_trailer(base_meta: dict, tmdb_data: dict) -> None:
+    # 1. Logo do título: pt -> en -> null; maior vote_average; ignora .svg
+    images = tmdb_data.get("images")
+    if isinstance(images, dict):
+        logos = images.get("logos")
+        if isinstance(logos, list):
+            valid_logos = [
+                l
+                for l in logos
+                if isinstance(l, dict)
+                and l.get("file_path")
+                and not str(l["file_path"]).lower().endswith(".svg")
+            ]
+            chosen_logo = None
+            for target_lang in ("pt", "en", None):
+                candidates = [
+                    l
+                    for l in valid_logos
+                    if (
+                        l.get("iso_639_1") == target_lang
+                        or (
+                            target_lang is None
+                            and l.get("iso_639_1") in (None, "null", "")
+                        )
+                    )
+                ]
+                if candidates:
+                    chosen_logo = max(
+                        candidates,
+                        key=lambda x: (
+                            x.get("vote_average") or 0.0,
+                            x.get("vote_count") or 0,
+                        ),
+                    )
+                    break
+            if chosen_logo and chosen_logo.get("file_path"):
+                base_meta["logo"] = (
+                    f"https://image.tmdb.org/t/p/w500{chosen_logo['file_path']}"
+                )
+
+    # 2. Trailer em PT-BR: Trailer pt -> Teaser pt -> Trailer en -> Teaser en
+    videos_obj = tmdb_data.get("videos")
+    if isinstance(videos_obj, dict):
+        videos = videos_obj.get("results")
+        if isinstance(videos, list):
+            yt_videos = [
+                v
+                for v in videos
+                if isinstance(v, dict)
+                and v.get("site") == "YouTube"
+                and v.get("key")
+            ]
+            chosen_pt = None
+            for req_type in ("Trailer", "Teaser"):
+                matches = [
+                    v
+                    for v in yt_videos
+                    if v.get("type") == req_type
+                    and (v.get("iso_639_1") == "pt" or str(v.get("iso_639_1", "")).startswith("pt"))
+                ]
+                if matches:
+                    chosen_pt = matches[0]
+                    break
+
+            chosen_en = None
+            for req_type in ("Trailer", "Teaser"):
+                matches = [
+                    v
+                    for v in yt_videos
+                    if v.get("type") == req_type
+                    and (v.get("iso_639_1") == "en" or str(v.get("iso_639_1", "")).startswith("en"))
+                ]
+                if matches:
+                    chosen_en = matches[0]
+                    break
+
+            trailer_streams = []
+            trailers = []
+            if chosen_pt and chosen_en:
+                trailer_streams.append({"title": "Trailer dublado", "ytId": chosen_pt["key"]})
+                trailer_streams.append({"title": "Trailer legendado", "ytId": chosen_en["key"]})
+                trailers.append({"source": chosen_pt["key"], "type": "Trailer"})
+                trailers.append({"source": chosen_en["key"], "type": "Trailer"})
+            elif chosen_pt:
+                trailer_streams.append({"title": "Trailer", "ytId": chosen_pt["key"]})
+                trailers.append({"source": chosen_pt["key"], "type": "Trailer"})
+            elif chosen_en:
+                trailer_streams.append({"title": "Trailer", "ytId": chosen_en["key"]})
+                trailers.append({"source": chosen_en["key"], "type": "Trailer"})
+
+            if trailer_streams:
+                base_meta["trailerStreams"] = trailer_streams
+                base_meta["trailers"] = trailers
+
+
+def _overlay_episode(v: dict, tmdb_ep: dict) -> None:
+    """Põe nome e sinopse PT-BR do TMDB no episódio do Cinemeta."""
+    ep_name = (tmdb_ep.get("name") or "").strip()
+    if ep_name and not _is_generic_title(ep_name):
+        v["name"] = ep_name
+        v["title"] = ep_name
+    ep_overview = (tmdb_ep.get("overview") or "").strip()
+    if ep_overview:
+        v["overview"] = ep_overview
+        if "description" in v:
+            v["description"] = ep_overview
+
+
+def _ep_sort_key(v: dict) -> tuple[int, int]:
+    try:
+        return int(v.get("season") or 0), int(v.get("episode") or v.get("number") or 0)
+    except (TypeError, ValueError):
+        return 0, 0
+
+
+def _parse_day(value) -> "datetime.date | None":
+    import datetime
+
+    if not isinstance(value, str) or len(value) < 10:
+        return None
+    try:
+        return datetime.date.fromisoformat(value[:10])
+    except ValueError:
+        return None
+
+
+def _overlay_mismatched_seasons(
+    cinemeta_videos: list, tmdb_seasons: list[list[dict]], pending_seasons: set[int]
+) -> int:
+    """Traduz episódios cujas temporadas o Cinemeta e o TMDB dividem diferente.
+
+    1) Mesmo total de episódios (fora especiais): casa pela ordem geral.
+    2) Senão: casa pela data de lançamento (tolerância de 1 dia por causa do
+       fuso), só quando a data aponta para um único episódio do TMDB.
+    """
+    import datetime
+
+    cm_all = sorted(
+        (
+            v
+            for v in cinemeta_videos
+            if isinstance(v, dict) and _ep_sort_key(v)[0] >= 1
+        ),
+        key=_ep_sort_key,
+    )
+    tmdb_all = [ep for season in tmdb_seasons for ep in season]
+    if not cm_all or not tmdb_all:
+        return 0
+
+    applied = 0
+    if len(cm_all) == len(tmdb_all):
+        for v, ep in zip(cm_all, tmdb_all):
+            if _ep_sort_key(v)[0] in pending_seasons:
+                _overlay_episode(v, ep)
+                applied += 1
+        return applied
+
+    by_day: dict = {}
+    for i, ep in enumerate(tmdb_all):
+        d = _parse_day(ep.get("air_date"))
+        if d:
+            by_day.setdefault(d, []).append(i)
+    cm_days: dict = {}
+    for v in cm_all:
+        d = _parse_day(v.get("released") or v.get("firstAired"))
+        if d:
+            cm_days[d] = cm_days.get(d, 0) + 1
+
+    used: set[int] = set()
+    one_day = datetime.timedelta(days=1)
+    for v in cm_all:
+        if _ep_sort_key(v)[0] not in pending_seasons:
+            continue
+        d = _parse_day(v.get("released") or v.get("firstAired"))
+        if not d or cm_days.get(d, 0) != 1:
+            continue
+        exact = [i for i in by_day.get(d, []) if i not in used]
+        if len(exact) == 1:
+            pick = exact[0]
+        elif not exact:
+            near = [
+                i
+                for dd in (d - one_day, d + one_day)
+                for i in by_day.get(dd, [])
+                if i not in used
+            ]
+            if len(near) != 1 or cm_days.get(d - one_day, 0) or cm_days.get(d + one_day, 0):
+                continue
+            pick = near[0]
+        else:
+            continue
+        used.add(pick)
+        _overlay_episode(v, tmdb_all[pick])
+        applied += 1
+    return applied
+
