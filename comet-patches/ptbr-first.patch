+"""Limite simples para dicionários usados como cache em memória (o Comet fica dias ligado)."""
+
+
+def trim(d: dict, max_items: int) -> None:
+    """Se passou do limite, descarta a metade mais antiga (ordem de inserção)."""
+    n = len(d)
+    if n <= max_items:
+        return
+    for k in list(d)[: n - max_items // 2]:
+        d.pop(k, None)
