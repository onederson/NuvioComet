@@ -0,0 +1,1054 @@
+"""Motor de capas vivas do Comet (Python + Pillow).
+
+Funcoes puras: recebem bytes ou PIL.Image + dados e devolvem PIL.Image
+(sobreposicoes encadeaveis) ou JPEG bytes (cartoes prontos). Nada de rede.
+
+Tudo e proporcional ao tamanho da imagem: a "unidade" u equivale a 1 % da
+altura de uma capa deitada de referencia (780x439) escalada pela area.
+Formas e chips sao desenhados em 3x e reduzidos (antialias de verdade).
+Usa so APIs estaveis do Pillow (>= 9.1).
+"""
+from __future__ import annotations
+
+import colorsys
+import hashlib
+import io
+import math
+import os
+from datetime import datetime
+from functools import lru_cache
+from typing import Callable, Iterable
+
+from PIL import Image, ImageChops, ImageDraw, ImageFilter, ImageFont
+
+__all__ = [
+    "progress_overlay", "status_ribbon", "rating_chip", "tv_guide_card",
+    "week_day_card", "episode_thumb", "to_jpeg",
+]
+
+# ---------------------------------------------------------------- cores
+RED = (229, 9, 20)
+GOLD = (201, 162, 39)
+IMDB_YELLOW = (245, 197, 24)
+PURPLE = (123, 44, 191)
+GREEN = (29, 185, 84)
+WHITE = (255, 255, 255)
+BLACK = (0, 0, 0)
+
+_NAMED = {
+    "red": RED, "vermelho": RED, "gold": GOLD, "dourado": GOLD,
+    "yellow": IMDB_YELLOW, "amarelo": IMDB_YELLOW, "imdb": IMDB_YELLOW,
+    "purple": PURPLE, "roxo": PURPLE, "green": GREEN, "verde": GREEN,
+    "blue": (10, 132, 255), "azul": (10, 132, 255),
+    "black": (18, 18, 22), "preto": (18, 18, 22), "white": WHITE, "branco": WHITE,
+}
+
+SS = 3                      # fator de supersampling para chips e icones
+JPEG_QUALITY = 85
+LANCZOS = Image.Resampling.LANCZOS
+BILINEAR = Image.Resampling.BILINEAR
+REF_W, REF_H = 780, 439
+
+# ---------------------------------------------------------------- fontes
+_FONT_CANDIDATES = {
+    "bold": [
+        "/usr/share/fonts/truetype/liberation/LiberationSans-Bold.ttf",
+        "/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf",
+        "C:/Windows/Fonts/arialbd.ttf",
+        "C:/Windows/Fonts/segoeuib.ttf",
+    ],
+    "regular": [
+        "/usr/share/fonts/truetype/liberation/LiberationSans-Regular.ttf",
+        "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf",
+        "C:/Windows/Fonts/arial.ttf",
+        "C:/Windows/Fonts/segoeui.ttf",
+        "/usr/share/fonts/truetype/liberation/LiberationSans-Bold.ttf",
+        "C:/Windows/Fonts/arialbd.ttf",
+    ],
+    "narrow": [
+        "/usr/share/fonts/truetype/liberation/LiberationSansNarrow-Bold.ttf",
+        "C:/Windows/Fonts/arialnb.ttf",
+        "/usr/share/fonts/truetype/liberation/LiberationSans-Bold.ttf",
+        "/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf",
+        "C:/Windows/Fonts/arialbd.ttf",
+        "C:/Windows/Fonts/segoeuib.ttf",
+    ],
+}
+
+
+@lru_cache(maxsize=None)
+def _font_path(kind: str) -> str | None:
+    for p in _FONT_CANDIDATES[kind]:
+        if os.path.exists(p):
+            return p
+    return None
+
+
+@lru_cache(maxsize=512)
+def _font(size: float, bold: bool = True, narrow: bool = False) -> ImageFont.FreeTypeFont:
+    """Fonte TrueType no tamanho pedido (Liberation no aparelho, Arial no Windows)."""
+    size = max(6, int(round(size)))
+    kind = "narrow" if narrow else ("bold" if bold else "regular")
+    path = _font_path(kind)
+    if path:
+        try:
+            return ImageFont.truetype(path, size)
+        except OSError:
+            pass
+    try:
+        return ImageFont.load_default(size)  # Pillow >= 10.1
+    except TypeError:  # pragma: no cover
+        return ImageFont.load_default()
+
+
+@lru_cache(maxsize=512)
+def _cap(font: ImageFont.FreeTypeFont) -> int:
+    """Altura de maiuscula (para centralizar texto pela linha de base)."""
+    _, t, _, b = font.getbbox("H", anchor="ls")
+    return max(1, b - t)
+
+
+# ---------------------------------------------------------------- utilitarios
+def _rgb(c) -> tuple[int, int, int]:
+    if c is None:
+        return RED
+    if isinstance(c, str):
+        s = c.strip().lower()
+        if s in _NAMED:
+            return _NAMED[s]
+        s = s.lstrip("#")
+        if len(s) == 3:
+            s = "".join(ch * 2 for ch in s)
+        try:
+            return int(s[0:2], 16), int(s[2:4], 16), int(s[4:6], 16)
+        except ValueError:
+            return RED
+    return tuple(int(v) for v in c[:3])  # type: ignore[return-value]
+
+
+def _rgba(c, a: int = 255) -> tuple[int, int, int, int]:
+    if isinstance(c, tuple) and len(c) == 4:
+        return c  # type: ignore[return-value]
+    r, g, b = _rgb(c)
+    return r, g, b, a
+
+
+def _lum(c) -> float:
+    r, g, b = _rgb(c)
+    return (0.2126 * r + 0.7152 * g + 0.0722 * b) / 255
+
+
+def _auto_fg(bg) -> tuple[int, int, int, int]:
+    """Texto preto em fundos claros (amarelo/dourado), branco no resto."""
+    if isinstance(bg, tuple) and len(bg) == 4 and bg[3] < 160:
+        return (255, 255, 255, 255)
+    return (17, 17, 17, 255) if _lum(bg) > 0.6 else (255, 255, 255, 255)
+
+
+def _load(img) -> Image.Image:
+    if isinstance(img, (bytes, bytearray, memoryview)):
+        img = Image.open(io.BytesIO(bytes(img)))
+        img.load()
+    if img.mode != "RGBA":
+        return img.convert("RGBA")
+    return img.copy()
+
+
+def to_jpeg(img: Image.Image, quality: int = JPEG_QUALITY) -> bytes:
+    """Codifica em JPEG (4:4:4 para nao borrar texto vermelho)."""
+    buf = io.BytesIO()
+    img.convert("RGB").save(buf, "JPEG", quality=quality, subsampling=0)
+    return buf.getvalue()
+
+
+def _unit(w: int, h: int) -> float:
+    """1 % da altura da capa de referencia, escalado pela area da imagem."""
+    return REF_H / 100 * math.sqrt((w * h) / (REF_W * REF_H))
+
+
+def _cover(img: Image.Image, size: tuple[int, int], center=(0.5, 0.5)) -> Image.Image:
+    """Recorta e redimensiona para preencher `size` (como CSS cover)."""
+    W, H = size
+    iw, ih = img.size
+    scale = max(W / iw, H / ih)
+    cw, ch = W / scale, H / scale
+    x0 = (iw - cw) * center[0]
+    y0 = (ih - ch) * center[1]
+    out = img.resize(size, LANCZOS, box=(x0, y0, x0 + cw, y0 + ch), reducing_gap=2.0)
+    return out if out.mode == "RGBA" else out.convert("RGBA")
+
+
+def _contain(img: Image.Image, box: tuple[int, int]) -> Image.Image:
+    bw, bh = box
+    iw, ih = img.size
+    scale = min(bw / iw, bh / ih)
+    size = (max(1, round(iw * scale)), max(1, round(ih * scale)))
+    out = img.resize(size, LANCZOS, reducing_gap=2.0)
+    return out if out.mode == "RGBA" else out.convert("RGBA")
+
+
+def _comp(base: Image.Image, tile: Image.Image, x: float, y: float) -> None:
+    """alpha_composite com recorte nas bordas (aceita coordenadas negativas)."""
+    x, y = int(round(x)), int(round(y))
+    l, t = max(0, -x), max(0, -y)
+    r, b = min(tile.width, base.width - x), min(tile.height, base.height - y)
+    if r <= l or b <= t:
+        return
+    if (l, t, r, b) != (0, 0, tile.width, tile.height):
+        tile = tile.crop((l, t, r, b))
+    base.alpha_composite(tile, (x + l, y + t))
+
+
+def _shadow_of(alpha: Image.Image, strength: float, blur: int) -> tuple[Image.Image, int]:
+    pad = blur * 3
+    sh = Image.new("L", (alpha.width + 2 * pad, alpha.height + 2 * pad), 0)
+    sh.paste(alpha.point(lambda v: int(v * strength)), (pad, pad))
+    sh = sh.filter(ImageFilter.GaussianBlur(blur))
+    layer = Image.new("RGBA", sh.size, (0, 0, 0, 255))
+    layer.putalpha(sh)
+    return layer, pad
+
+
+def _place(base, tile, x, y, shadow: float = 0.0, blur: int | None = None, dy: int | None = None):
+    """Cola `tile` com sombra suave opcional."""
+    if shadow > 0:
+        blur = blur or max(1, round(tile.height * 0.14))
+        dy = max(1, round(tile.height * 0.06)) if dy is None else dy
+        layer, pad = _shadow_of(tile.getchannel("A"), shadow, blur)
+        _comp(base, layer, x - pad, y - pad + dy)
+    _comp(base, tile, x, y)
+
+
+def _hline(base: Image.Image, x0, x1, y, color, width) -> None:
+    """Linha horizontal translucida (ImageDraw nao mistura alfa em RGBA)."""
+    w = max(1, int(round(x1 - x0)))
+    _comp(base, Image.new("RGBA", (w, max(1, int(round(width)))), _rgba(color)), x0, y)
+
+
+def _ease(t: float) -> float:
+    t = min(1.0, max(0.0, t))
+    return t * t * (3 - 2 * t)
+
+
+def _ramp_mask(size, a: float, b: float, va: int, vb: int, horizontal: bool, power: float = 1.0):
+    """Mascara L: valor `va` antes de a, `vb` depois de b, transicao suave."""
+    w, h = size
+    n = w if horizontal else h
+    span = max(1e-6, b - a)
+    vals = []
+    for i in range(n):
+        t = _ease((i - a) / span) ** power if power != 1.0 else _ease((i - a) / span)
+        vals.append(int(round(va + (vb - va) * t)))
+    line = Image.new("L", (n, 1) if horizontal else (1, n))
+    line.putdata(vals)
+    return line.resize((w, h), Image.Resampling.NEAREST)
+
+
+def _shade(base: Image.Image, mask: Image.Image, color=(0, 0, 0)) -> None:
+    layer = Image.new("RGBA", base.size, _rgba(color, 0))
+    layer.putalpha(mask)
+    base.alpha_composite(layer)
+
+
+def _corner_gradient(size, tl, tr, bl, br) -> Image.Image:
+    """Degrade suave entre 4 cores de canto (2x2 ampliado)."""
+    g = Image.new("RGB", (2, 2))
+    g.putdata([_rgb(tl), _rgb(tr), _rgb(bl), _rgb(br)])
+    return g.resize(size, BILINEAR).convert("RGBA")
+
+
+def _glow(base: Image.Image, cx, cy, rx, ry, color, alpha: int) -> None:
+    """Brilho radial barato: elipse num canvas pequeno, borrada e ampliada."""
+    k = 8
+    sw, sh = max(2, base.width // k), max(2, base.height // k)
+    m = Image.new("L", (sw, sh), 0)
+    ImageDraw.Draw(m).ellipse(((cx - rx) / k, (cy - ry) / k, (cx + rx) / k, (cy + ry) / k), fill=alpha)
+    m = m.filter(ImageFilter.GaussianBlur(max(1, min(rx, ry) / k * 0.6)))
+    _shade(base, m.resize(base.size, BILINEAR), color)
+
+
+def _hue_color(key: str, s: float = 0.55, v: float = 0.78) -> tuple[int, int, int]:
+    h = int(hashlib.md5(key.encode("utf-8")).hexdigest()[:6], 16) / 0xFFFFFF
+    r, g, b = colorsys.hsv_to_rgb(h, s, v)
+    return int(r * 255), int(g * 255), int(b * 255)
+
+
+def _dominant(img: Image.Image) -> tuple[int, int, int]:
+    """Cor media dos pixels opacos (para o brilho de fundo do canal)."""
+    small = img.convert("RGBA").resize((24, 24), BILINEAR)
+    tot = [0.0, 0.0, 0.0]
+    wsum = 0.0
+    for r, g, b, a in small.getdata():
+        sat = max(r, g, b) - min(r, g, b)
+        w = a / 255 * (0.25 + sat / 255)
+        tot[0] += r * w
+        tot[1] += g * w
+        tot[2] += b * w
+        wsum += w
+    if wsum <= 0:
+        return (90, 90, 110)
+    return tuple(int(c / wsum) for c in tot)  # type: ignore[return-value]
+
+
+def _clean_text(text: str) -> str:
+    """Remove emojis/bandeiras (a fonte nao tem); o desenho vetorial substitui."""
+    out = []
+    for ch in text:
+        o = ord(ch)
+        if o >= 0x1F000 or 0x2600 <= o <= 0x27BF or 0xFE00 <= o <= 0xFE0F or o == 0x200D:
+            continue
+        out.append(ch)
+    return " ".join("".join(out).split())
+
+
+def _fmt_num(v: float) -> str:
+    return f"{v:.1f}".replace(".", ",")
+
+
+def _fmt_minutes(mins: int) -> str:
+    mins = max(0, int(mins))
+    if mins >= 60:
+        return f"{mins // 60}h {mins % 60:02d}min"
+    return f"{mins} min"
+
+
+def _ellipsize(text: str, font, maxw: float, tracking: float = 0.0) -> str:
+    if _tlen(text, font, tracking) <= maxw:
+        return text
+    lo, hi = 0, len(text)
+    while lo < hi:
+        mid = (lo + hi + 1) // 2
+        if _tlen(text[:mid].rstrip() + "…", font, tracking) <= maxw:
+            lo = mid
+        else:
+            hi = mid - 1
+    return (text[:lo].rstrip(" ·-,:") + "…") if lo > 0 else "…"
+
+
+def _wrap(text: str, font, maxw: float, max_lines: int) -> list[str]:
+    words = text.split()
+    lines: list[str] = []
+    cur = ""
+    i = 0
+    while i < len(words):
+        w = words[i]
+        trial = (cur + " " + w).strip()
+        if font.getlength(trial) <= maxw or not cur:
+            cur = trial
+            i += 1
+        else:
+            lines.append(cur)
+            cur = ""
+            if len(lines) == max_lines - 1:
+                break
+    rest = " ".join(([cur] if cur else []) + words[i:])
+    if rest:
+        lines.append(_ellipsize(rest, font, maxw))
+    return [ln for ln in lines if ln][:max_lines]
+
+
+def _tlen(text: str, font, tracking: float = 0.0) -> float:
+    if not tracking:
+        return font.getlength(text)
+    return sum(font.getlength(c) for c in text) + tracking * max(0, len(text) - 1)
+
+
+def _draw_str(d: ImageDraw.ImageDraw, x, y, text, font, fill, anchor="ls", tracking: float = 0.0):
+    if not tracking:
+        d.text((x, y), text, font=font, fill=fill, anchor=anchor)
+        return
+    va = anchor[1]
+    for c in text:
+        d.text((x, y), c, font=font, fill=fill, anchor="l" + va)
+        x += font.getlength(c) + tracking
+
+
+def _text(base: Image.Image, x, y, text, font, fill=WHITE, anchor="ls", tracking: float = 0.0,
+          shadow: float = 0.55, blur: float = 0.09):
+    """Texto com sombra suave (legivel sobre fundo claro)."""
+    if not text:
+        return
+    fill = _rgba(fill)
+    tw = _tlen(text, font, tracking)
+    if anchor[0] == "r":
+        x -= tw
+    elif anchor[0] == "m":
+        x -= tw / 2
+    anchor = "l" + anchor[1]
+    if shadow > 0:
+        d0 = ImageDraw.Draw(base)
+        l, t, r, b = d0.textbbox((x, y), text, font=font, anchor=anchor)
+        r = max(r, l + int(tw) + 1)
+        rad = max(1, int(round(font.size * blur)))
+        pad = rad * 3
+        m = Image.new("L", (int(r - l) + 2 * pad, int(b - t) + 2 * pad), 0)
+        _draw_str(ImageDraw.Draw(m), x - l + pad, y - t + pad + rad * 0.4, text, font,
+                  int(255 * shadow), anchor, tracking)
+        m = m.filter(ImageFilter.GaussianBlur(rad))
+        layer = Image.new("RGBA", m.size, (0, 0, 0, 255))
+        layer.putalpha(m)
+        _comp(base, layer, l - pad, t - pad)
+    if fill[3] < 255:
+        layer = Image.new("RGBA", base.size, (0, 0, 0, 0))
+        _draw_str(ImageDraw.Draw(layer), x, y, text, font, fill, anchor, tracking)
+        base.alpha_composite(layer)
+    else:
+        _draw_str(ImageDraw.Draw(base), x, y, text, font, fill, anchor, tracking)
+
+
+def _text_layer(base, x, y, text, font, fill, anchor="ls", tracking=0.0):
+    """Texto semitransparente sem desenhar uma camada do tamanho da imagem toda."""
+    fill = _rgba(fill)
+    tw = _tlen(text, font, tracking)
+    if anchor[0] == "r":
+        x -= tw
+    elif anchor[0] == "m":
+        x -= tw / 2
+    anchor = "l" + anchor[1]
+    l, t, r, b = ImageDraw.Draw(base).textbbox((x, y), text, font=font, anchor=anchor)
+    r = max(r, l + int(tw) + 2)
+    tile = Image.new("RGBA", (int(r - l) + 4, int(b - t) + 4), (0, 0, 0, 0))
+    _draw_str(ImageDraw.Draw(tile), x - l + 2, y - t + 2, text, font, fill, anchor, tracking)
+    _comp(base, tile, l - 2, t - 2)
+
+
+# ---------------------------------------------------------------- icones vetoriais
+# Cada icone recebe a altura em pixels (ja em escala de supersampling) e
+# devolve RGBA. Fora de chips use _icon(fn, h) para antialias.
+
+def _icon(fn: Callable[[int], Image.Image], h: float) -> Image.Image:
+    big = fn(max(4, int(round(h * SS))))
+    return big.resize((max(1, round(big.width / SS)), max(1, round(h))), LANCZOS)
+
+
+def _flag_br(h: int, border=True) -> Image.Image:
+    """Bandeira do Brasil: retangulo verde, losango amarelo, circulo azul, faixa."""
+    h = max(4, int(h))
+    w = int(round(h * 1.43))
+    im = Image.new("RGBA", (w, h), (0, 0, 0, 0))
+    d = ImageDraw.Draw(im)
+    rad = h * 0.16
+    bw = max(1, round(h * 0.075)) if border else 0
+    if border:
+        d.rounded_rectangle((0, 0, w - 1, h - 1), radius=rad, fill=(255, 255, 255, 255))
+    d.rounded_rectangle((bw, bw, w - 1 - bw, h - 1 - bw), radius=max(0, rad - bw), fill=(0, 151, 57, 255))
+    ix, iy, iw, ih = bw, bw, w - 2 * bw, h - 2 * bw
+    mx, my = iw * 0.09, ih * 0.13
+    d.polygon([(ix + mx, iy + ih / 2), (ix + iw / 2, iy + my),
+               (ix + iw - mx, iy + ih / 2), (ix + iw / 2, iy + ih - my)], fill=(254, 221, 0, 255))
+    cx, cy, R = ix + iw / 2, iy + ih / 2, ih * 0.255
+    d.ellipse((cx - R, cy - R, cx + R, cy + R), fill=(0, 39, 118, 255))
+    band = Image.new("L", im.size, 0)
+    R2 = R * 2.1
+    bx, by = cx - R * 0.35, cy + R * 1.85
+    ImageDraw.Draw(band).ellipse((bx - R2, by - R2, bx + R2, by + R2), outline=255,
+                                 width=max(1, round(R * 0.24)))
+    circ = Image.new("L", im.size, 0)
+    ImageDraw.Draw(circ).ellipse((cx - R, cy - R, cx + R, cy + R), fill=255)
+    im.paste((255, 255, 255, 255), (0, 0, w, h), ImageChops.multiply(band, circ))
+    return im
+
+
+def _tomato(h: int, rotten: bool = False) -> Image.Image:
+    """Tomatinho (fresco) ou respingo verde (podre), estilo Rotten Tomatoes."""
+    h = max(4, int(h))
+    w = int(round(h * 1.06))
+    im = Image.new("RGBA", (w, h), (0, 0, 0, 0))
+    d = ImageDraw.Draw(im)
+    if rotten:
+        c = (122, 196, 64, 255)
+        cx, cy = w / 2, h * 0.55
+        d.ellipse((cx - h * 0.33, cy - h * 0.33, cx + h * 0.33, cy + h * 0.33), fill=c)
+        for k, (ang, dist, r) in enumerate([(-80, .40, .11), (-20, .42, .09), (35, .41, .12),
+                                            (95, .40, .08), (150, .42, .11), (210, .40, .09)]):
+            a = math.radians(ang)
+            px, py = cx + math.cos(a) * h * dist, cy + math.sin(a) * h * dist
+            rr = h * r
+            d.ellipse((px - rr, py - rr, px + rr, py + rr), fill=c)
+        return im
+    d.ellipse((0, h * 0.17, w - 1, h - 1), fill=(250, 52, 12, 255))
+    hl = Image.new("RGBA", im.size, (0, 0, 0, 0))
+    ImageDraw.Draw(hl).ellipse((w * 0.16, h * 0.34, w * 0.42, h * 0.56), fill=(255, 170, 140, 150))
+    im.alpha_composite(hl)
+    # folhas (estrela verde) e cabinho
+    cx, cy = w / 2, h * 0.22
+    pts = []
+    for i in range(10):
+        a = math.radians(-90 + i * 36)
+        r = h * (0.24 if i % 2 == 0 else 0.07)
+        pts.append((cx + math.cos(a) * r, cy + math.sin(a) * r * 0.75))
+    d.polygon(pts, fill=(0, 140, 60, 255))
+    d.rectangle((cx - h * 0.03, cy - h * 0.2, cx + h * 0.03, cy), fill=(0, 120, 50, 255))
+    return im
+
