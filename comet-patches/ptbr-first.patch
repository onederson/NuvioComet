+async def _apply_live_art(meta: dict, mtype: str, imdb: str) -> dict:
+    """Selos nas miniaturas dos episódios (DUB, FILLER, FINAL, nota)."""
+    from comet.services.live_art_svc import ep_url
+    meta = dict(meta)
+    _orig_bg = meta.get("background")
+    # O fundo fica o original: o Nuvio desenha logo, notas e elenco por cima.
+    vids = meta.get("videos")
+    if mtype == "series" and isinstance(vids, list) and vids:
+        dub_eps = set()
+        try:
+            from comet.core.database import database
+            rows = await database.fetch_all("SELECT season, episode FROM dub_watch WHERE imdb = :i AND dub_ready = 1", {"i": imdb})
+            dub_eps = {(int(r["season"]), int(r["episode"])) for r in rows}
+        except Exception as _e:
+            log_swallowed("meta._apply_live_art", _e)
+        last_ep = {}
+        for v in vids:
+            try:
+                se, ep = int(v.get("season") or 0), int(v.get("episode") or v.get("number") or 0)
+                last_ep[se] = max(last_ep.get(se, 0), ep)
+            except (TypeError, ValueError):
+                pass
+        new_vids = []
+        for v in vids:
+            v = dict(v)
+            thumb = v.get("thumbnail")
+            try:
+                se, ep = int(v.get("season") or 0), int(v.get("episode") or v.get("number") or 0)
+            except (TypeError, ValueError):
+                se, ep = 0, 0
+            title = str(v.get("title") or v.get("name") or "")
+            badges = []
+            if (se, ep) in dub_eps:
+                badges.append("DUB")
+            if "Filler" in title:
+                badges.append("FILLER")
+            if se > 0 and ep and ep == last_ep.get(se) and ep > 1:
+                badges.append("FINAL")
+            rating = v.get("rating") if isinstance(v.get("rating"), (int, float)) else None
+            if thumb and (badges or rating):
+                v["thumbnail"] = ep_url(thumb, badges, rating, fallback=_orig_bg)
+            new_vids.append(v)
+        meta["videos"] = new_vids
+    return meta
+
+
+@router.get(
+    "/meta/{type}/{id}.json",
+    tags=["Stremio"],
+    summary="Meta Provider",
+    description="Returns metadata in PT-BR for the specified media.",
+)
+@router.get(
+    "/{b64config}/meta/{type}/{id}.json",
+    tags=["Stremio"],
+    summary="Meta Provider",
+    description="Returns metadata in PT-BR with configuration.",
+)
+async def get_meta_endpoint(
+    request: Request,
+    type: str,
+    id: str,
+    b64config: str | None = None,
+):
+    clean_id = id.removesuffix(".json")
+    from comet.core.models import settings
+    from comet.services import extra_rows as _extra_rows
+    if _extra_rows.owns(clean_id):
+        _base = (getattr(settings, "PUBLIC_BASE_URL", None) or f"{request.url.scheme}://{request.url.netloc}").rstrip("/")
+        _meta = await _extra_rows.meta(clean_id, f"{_base}/{b64config}" if b64config else _base)
+        return JSONResponse(content={"meta": _meta}, headers={"Cache-Control": "public, max-age=60"})
+    if type == "tv" and clean_id.startswith("cometlive:"):
+        from comet.services.live_tv import get_live_tv_meta
+        meta = await get_live_tv_meta(clean_id)
+        return JSONResponse(
+            content={"meta": meta},
+            headers={"Cache-Control": "public, max-age=1800"},
+        )
+
+    if clean_id.startswith("cometsaga:"):
+        try:
+            if b64config:
+                config = config_check(b64config)
+                if not config:
+                    return JSONResponse(
+                        content={"meta": None},
+                        headers={"Cache-Control": "public, max-age=21600"},
+                    )
+            from comet.services.marathon import get_marathon_meta, is_marathon_id
+            if is_marathon_id(clean_id):
+                meta = await get_marathon_meta(clean_id)
+            else:
+                from comet.services.catalogs import get_saga_meta
+                meta = await get_saga_meta(clean_id)
+            return JSONResponse(
+                content={"meta": meta},
+                headers={"Cache-Control": "public, max-age=86400"},
+            )
+        except Exception as e:
+            logger.warning(
+                f"Error handling saga meta request for {type}/{id}: {type(e).__name__}"
+            )
+            return JSONResponse(
+                content={"meta": None},
+                headers={"Cache-Control": "public, max-age=86400"},
+            )
+
+    if type not in ("movie", "series") or not clean_id.startswith("tt"):
+        return JSONResponse(
+            content={"meta": None},
+            headers={"Cache-Control": "public, max-age=21600"},
+        )
+
+    try:
+        if b64config:
+            config = config_check(b64config)
+            if not config:
+                return JSONResponse(
+                    content={"meta": None},
+                    headers={"Cache-Control": "public, max-age=21600"},
+                )
+
+        meta = await get_meta_ptbr(type, clean_id)
+        if isinstance(meta, dict) and getattr(settings, "PT_TEXT", True):
+            try:  # título brasileiro e sinopse em PT (o que passar de 4 s fica para a próxima)
+                from comet.services.pt_text import fix_meta as _pt_fix_meta
+                meta = await asyncio.wait_for(asyncio.shield(_pt_fix_meta(meta, type)), timeout=4)
+            except Exception as _pt_err:
+                log_swallowed("meta.pt_text", _pt_err)
+        if isinstance(meta, dict) and clean_id.startswith("tt") and type in ("movie", "series"):
+            try:
+                from comet.services.omdb import get_omdb, ratings_line
+                _od = await asyncio.wait_for(get_omdb(clean_id.split(":")[0]), timeout=4)
+                _line = ratings_line(_od)
+                if _line:
+                    meta = dict(meta)
+                    _desc = meta.get("description") or ""
+                    if not _desc.startswith("⭐"):
+                        meta["description"] = f"{_line}\n\n{_desc}" if _desc else _line
+                    if _od and _od.get("imdbRating") not in (None, "N/A"):
+                        meta["imdbRating"] = _od["imdbRating"]
+            except Exception as _e:
+                log_swallowed("meta.get_meta_endpoint", _e)
+            try:
+                meta = await _apply_live_art(meta, type, clean_id.split(":")[0])
+            except Exception as _la_err:
+                logger.debug(f"live art meta: {_la_err}")
+        _max_age = 21600
+        if isinstance(meta, dict) and is_personal_request(b64config):
+            try:  # "Onde você parou" (muda a cada play: cache curto)
+                from comet.services.resume import apply as _resume_apply
+                meta, _changed = await asyncio.wait_for(_resume_apply(meta, type, clean_id.split(":")[0]), 3)
+                if _changed:
+                    _max_age = 300
+            except Exception as _rs_err:
+                logger.debug(f"resume meta: {_rs_err}")
+        return JSONResponse(
+            content={"meta": meta},
+            headers={"Cache-Control": f"public, max-age={_max_age}"},
+        )
+    except Exception as e:
+        logger.warning(
+            f"Error handling meta request for {type}/{id}: {type(e).__name__}"
+        )
+        return JSONResponse(
+            content={"meta": None},
+            headers={"Cache-Control": "public, max-age=21600"},
+        )
