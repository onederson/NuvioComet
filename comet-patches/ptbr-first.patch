+async def make_art(kind: str, key: str) -> str:
+    """Gera (ou reaproveita) a arte e devolve o caminho do arquivo."""
+    svc = _svc(key)
+    daily = kind in ("tile", "focus", "hero", "video")
+    ext = {"tile": "jpg", "focus": "gif", "hero": "jpg", "logo": "png", "video": "mp4"}[kind]
+    path = _path(kind, key, ext, daily)
+    if os.path.exists(path) and os.path.getsize(path) > 0:
+        return path
+    lock = _locks.setdefault(f"{kind}:{key}", asyncio.Lock())
+    async with lock:
+        if os.path.exists(path) and os.path.getsize(path) > 0:
+            return path
+        started = time.monotonic()
+        if kind == "logo":
+            logo = await _logo_for(svc)
+            buf = io.BytesIO()
+            logo.save(buf, "PNG", optimize=True)
+            data = buf.getvalue()
+        elif kind in ("tile", "focus"):
+            logo = await _logo_for(svc)
+            bds = await _open_backdrops(key, 1, "w780")
+            tile = await asyncio.to_thread(_compose_tile, svc, logo, bds[0] if bds else None)
+            if kind == "tile":
+                data = _jpeg(tile.resize((640, 360)), 90)
+            else:
+                small = tile.resize((640, 360))
+                frames = await asyncio.to_thread(_sweep_frames, small)
+                buf = io.BytesIO()
+                pal = [f.quantize(colors=200, method=2, dither=1) for f in frames]
+                pal[0].save(buf, "GIF", save_all=True, append_images=pal[1:], duration=55,
+                            loop=0, optimize=True, disposal=1)
+                data = buf.getvalue()
+        elif kind == "hero":
+            bds = await _open_backdrops(key, 1)
+            data = _jpeg(await asyncio.to_thread(_compose_hero, svc, bds), 86)
+        elif kind == "video":
+            data = await _make_video(svc, key)
+        else:
+            raise HTTPException(status_code=404)
+        tmp = path + ".tmp"
+        with open(tmp, "wb") as f:
+            f.write(data)
+        os.replace(tmp, path)
+        _cleanup_old(f"{kind}_{key}_", path)
+        logger.log("COMET", f"🎨 Streamings: {kind} de {svc['name']} pronto em "
+                            f"{time.monotonic() - started:.1f}s ({len(data) // 1024} KB)")
+        return path
+
+
+async def _make_video(svc: dict, key: str) -> bytes:
+    """Vídeo do destaque: os títulos em alta passando com zoom lento (Ken Burns) e
+    transição suave, na cor da marca. 1280x720, sem áudio, ~14 s."""
+    bds = await _open_backdrops(key, 5)
+    if not bds:
+        raise HTTPException(status_code=404)
+    tmpdir = os.path.join(DATA_DIR, f"vtmp_{key}")
+    os.makedirs(tmpdir, exist_ok=True)
+    try:
+        files = []
+        for i, im in enumerate(bds[:5]):
+            hero = await asyncio.to_thread(_compose_hero, svc, [im], 1280, 720)
+            p = os.path.join(tmpdir, f"{i}.jpg")
+            hero.save(p, "JPEG", quality=90)
+            files.append(p)
+        seg, fade, fps = 3.4, 0.8, 25
+        args = ["ffmpeg", "-y", "-loglevel", "error"]
+        for p in files:
+            args += ["-i", p]  # zoompan gera os quadros a partir de UMA imagem (d=quadros)
+        filt = []
+        frames = int((seg + fade) * fps)
+        for i in range(len(files)):
+            zin = i % 2 == 0
+            z = "min(zoom+0.0009,1.12)" if zin else "if(eq(on,0),1.12,max(zoom-0.0009,1.0))"
+            filt.append(
+                f"[{i}:v]scale=1600:-1,zoompan=z='{z}':d={frames}:s=1280x720:fps={fps}"
+                f":x='iw/2-(iw/zoom/2)':y='ih/2-(ih/zoom/2)',format=yuv420p[v{i}]")
+        last = "v0"
+        for i in range(1, len(files)):
+            off = i * seg
+            filt.append(f"[{last}][v{i}]xfade=transition=fade:duration={fade}:offset={off:.2f}[x{i}]")
+            last = f"x{i}"
+        out = os.path.join(tmpdir, "out.mp4")
+        args += ["-filter_complex", ";".join(filt), "-map", f"[{last}]", "-an", "-c:v", "libx264",
+                 "-preset", "veryfast", "-crf", "27", "-pix_fmt", "yuv420p", "-movflags", "+faststart",
+                 "-r", str(fps), out]
+        proc = await asyncio.to_thread(subprocess.run, args, capture_output=True, timeout=600)
+        if proc.returncode != 0 or not os.path.exists(out):
+            logger.warning(f"Streamings: vídeo de {svc['name']} falhou: {proc.stderr[-300:]!r}")
+            raise HTTPException(status_code=404)
+        with open(out, "rb") as f:
+            return f.read()
+    finally:
+        for f in os.listdir(tmpdir):
+            try:
+                os.unlink(os.path.join(tmpdir, f))
+            except OSError:
+                pass
+        try:
+            os.rmdir(tmpdir)
+        except OSError:
+            pass
+
+
+async def warm_all() -> None:
+    """Gera tudo em 2º plano (uma vez por dia): o 1º foco na TV já encontra as artes prontas."""
+    keys = [FORYOU_ID] + [s["key"] for s in SERVICES]
+    for kind in ("logo", "tile", "focus", "hero", "video"):
+        for key in keys:
+            try:
+                await make_art(kind, key)
+            except Exception as e:
+                log_swallowed("streamings.warm_all", e)
+            await asyncio.sleep(0.2)
+    await _warm_ranks()
+
+
+_warm_task: asyncio.Task | None = None
+
+
+def start_warm() -> None:
+    global _warm_task
+
+    async def loop():
+        await asyncio.sleep(90)
+        while True:
+            await warm_all()
+            now = datetime.datetime.now()
+            tomorrow = (now + datetime.timedelta(days=1)).replace(hour=5, minute=10, second=0)
+            await asyncio.sleep(max(600.0, (tomorrow - now).total_seconds()))
+
+    if _warm_task is None or _warm_task.done():
+        try:
+            _warm_task = asyncio.get_running_loop().create_task(loop())
+        except RuntimeError:
+            pass
+
+
+# ───────────────────────── rotas ─────────────────────────
+
+router = APIRouter(tags=["Stremio"])
+_MEDIA = {"jpg": "image/jpeg", "gif": "image/gif", "png": "image/png", "mp4": "video/mp4"}
