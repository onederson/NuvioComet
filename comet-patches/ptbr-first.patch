+# ---------------------------------------------------------------------------
+# Detecção de áudio pelos bytes (offline, testável)
+# ---------------------------------------------------------------------------
+_MP3_BR = {
+    (3, 3): [0, 32, 64, 96, 128, 160, 192, 224, 256, 288, 320, 352, 384, 416, 448],  # MPEG1 L1
+    (3, 2): [0, 32, 48, 56, 64, 80, 96, 112, 128, 160, 192, 224, 256, 320, 384],     # MPEG1 L2
+    (3, 1): [0, 32, 40, 48, 56, 64, 80, 96, 112, 128, 160, 192, 224, 256, 320],      # MPEG1 L3
+    (2, 3): [0, 32, 48, 56, 64, 80, 96, 112, 128, 144, 160, 176, 192, 224, 256],     # MPEG2 L1
+    (2, 2): [0, 8, 16, 24, 32, 40, 48, 56, 64, 80, 96, 112, 128, 144, 160],          # MPEG2 L2/L3
+    (2, 1): [0, 8, 16, 24, 32, 40, 48, 56, 64, 80, 96, 112, 128, 144, 160],
+}
+_MP3_SR = {3: [44100, 48000, 32000], 2: [22050, 24000, 16000], 0: [11025, 12000, 8000]}
+
+
+def _mp3_frame(b: bytes, i: int) -> Optional[tuple[int, tuple]]:
+    if i + 4 > len(b) or b[i] != 0xFF or (b[i + 1] & 0xE0) != 0xE0:
+        return None
+    ver = (b[i + 1] >> 3) & 3
+    layer = (b[i + 1] >> 1) & 3
+    bri = (b[i + 2] >> 4) & 15
+    sri = (b[i + 2] >> 2) & 3
+    pad = (b[i + 2] >> 1) & 1
+    if ver == 1 or layer == 0 or bri in (0, 15) or sri == 3:
+        return None
+    br = _MP3_BR[(3 if ver == 3 else 2, layer)][bri] * 1000
+    sr = _MP3_SR[ver][sri]
+    if layer == 3:
+        ln = (12 * br // sr + pad) * 4
+    elif layer == 1 and ver != 3:
+        ln = 72 * br // sr + pad
+    else:
+        ln = 144 * br // sr + pad
+    if ln < 24:
+        return None
+    return ln, (ver, layer, sri)
+
+
+def _adts_frame(b: bytes, i: int) -> Optional[tuple[int, tuple]]:
+    if i + 7 > len(b) or b[i] != 0xFF or (b[i + 1] & 0xF6) != 0xF0:
+        return None
+    sfi = (b[i + 2] >> 2) & 15
+    if sfi > 12:
+        return None
+    ln = ((b[i + 3] & 3) << 11) | (b[i + 4] << 3) | (b[i + 5] >> 5)
+    if ln < 7:
+        return None
+    prof = (b[i + 2] >> 6) & 3
+    chan = ((b[i + 2] & 1) << 2) | (b[i + 3] >> 6)
+    return ln, (prof, sfi, chan)
+
+
+def _chain(b: bytes, parser, start: int, need: int) -> bool:
+    i = start
+    first = parser(b, i)
+    if not first:
+        return False
+    sig = first[1]
+    n = 0
+    while n < need:
+        fr = parser(b, i)
+        if not fr or fr[1] != sig:
+            return False
+        n += 1
+        i += fr[0]
+        if i + 7 > len(b):
+            return n >= max(2, need - 1) and len(b) - start >= 1024
+    return True
+
+
+def skip_id3(b: bytes) -> int:
+    off = 0
+    while b[off:off + 3] == b"ID3" and len(b) >= off + 10:
+        size = (b[off + 6] & 0x7F) << 21 | (b[off + 7] & 0x7F) << 14 | (b[off + 8] & 0x7F) << 7 | (b[off + 9] & 0x7F)
+        off += 10 + size + (10 if b[off + 5] & 0x10 else 0)
+    return off
+
+
+def _ogg_pages(b: bytes, i: int, need: int = 2) -> bool:
+    n = 0
+    while n < need:
+        if b[i:i + 4] != b"OggS" or i + 27 > len(b) or b[i + 4] != 0:
+            return False
+        nseg = b[i + 26]
+        if i + 27 + nseg > len(b):
+            return n >= 1
+        size = 27 + nseg + sum(b[i + 27:i + 27 + nseg])
+        n += 1
+        i += size
+        if i >= len(b):
+            return n >= 1 and len(b) >= 4096
+    return True
+
+
+def _ts_packets(b: bytes, i: int, need: int = 5) -> bool:
+    return i + 188 * need <= len(b) and all(b[i + 188 * k] == 0x47 for k in range(need))
+
+
+def detect_audio(b: bytes, scan: int = 65536) -> str:
+    """Formato detectado ('mp3', 'aac', 'ogg', 'ts', 'mp4', 'flac') ou '' se não for áudio."""
+    if not b or len(b) < 512:
+        return ""
+    head = b[:512].lstrip().lower()
+    if head.startswith((b"<!doctype", b"<html", b"<?xml", b"{", b"<head", b"<body")):
+        return ""
+    if b[4:8] in (b"ftyp", b"styp", b"moof"):
+        return "mp4"
+    if b[:4] == b"fLaC":
+        return "flac"
+    if b[:4] == b"FLV" and len(b) >= 13 + 11 and b[13] in (8, 18):
+        return "flv"  # streamtheworld manda AAC em FLV; o ExoPlayer toca
+    start = skip_id3(b)
+    if start >= len(b):
+        return ""
+    limit = min(len(b) - 4, start + scan)
+    # MPEG-TS (segmentos HLS)
+    for i in range(start, min(start + 188, len(b))):
+        if b[i] == 0x47 and _ts_packets(b, i):
+            return "ts"
+    j = b.find(b"OggS", start, limit + 4)
+    if j >= 0 and _ogg_pages(b, j):
+        return "ogg"
+    i = start
+    while True:
+        i = b.find(b"\xff", i, limit)
+        if i < 0:
+            break
+        if _chain(b, _adts_frame, i, 4):
+            return "aac"
+        if _chain(b, _mp3_frame, i, 4):
+            return "mp3"
+        i += 1
+    return ""
+
+
+# ---------------------------------------------------------------------------
+# Cliente HTTP mínimo para streams (aceita ICY)
+# ---------------------------------------------------------------------------
+class StreamResp:
+    def __init__(self, status: int, reason: str, headers: dict[str, str], reader, writer, url: str, proto: str):
+        self.status = status
+        self.reason = reason
+        self.headers = headers
+        self.url = url
+        self.proto = proto
+        self._r = reader
+        self._w = writer
+        self._chunked = "chunked" in headers.get("transfer-encoding", "").lower()
+        cl = headers.get("content-length", "")
+        self._left = int(cl) if cl.isdigit() and not self._chunked else -1
+        self._chunk_left = 0
+        self._eof = False
+
+    async def read(self, n: int = 16384, timeout: float = 10.0) -> bytes:
+        if self._eof:
+            return b""
+        return await asyncio.wait_for(self._read(n), timeout)
+
+    async def _read(self, n: int) -> bytes:
+        if self._chunked:
+            if self._chunk_left == 0:
+                line = await self._r.readline()
+                if not line:
+                    self._eof = True
+                    return b""
+                try:
+                    size = int(line.split(b";")[0].strip() or b"0", 16)
+                except ValueError:
+                    self._eof = True
+                    return b""
+                if size == 0:
+                    self._eof = True
+                    return b""
+                self._chunk_left = size
+            data = await self._r.read(min(n, self._chunk_left))
+            if not data:
+                self._eof = True
+                return b""
+            self._chunk_left -= len(data)
+            if self._chunk_left == 0:
+                await self._r.readline()  # CRLF
+            return data
+        if self._left == 0:
+            self._eof = True
+            return b""
+        want = n if self._left < 0 else min(n, self._left)
+        data = await self._r.read(want)
+        if not data:
+            self._eof = True
+            return b""
+        if self._left > 0:
+            self._left -= len(data)
+        return data
+
+    async def read_upto(self, limit: int, deadline: float) -> bytes:
+        buf = bytearray()
+        while len(buf) < limit:
+            left = deadline - time.monotonic()
+            if left <= 0:
+                break
+            try:
+                data = await self.read(min(16384, limit - len(buf)), timeout=left)
+            except (asyncio.TimeoutError, OSError, ssl.SSLError):
+                break
+            if not data:
+                break
+            buf += data
+        return bytes(buf)
+
+    def close(self) -> None:
+        try:
+            self._w.close()
+        except Exception as _e:
+            log_swallowed("radio.close", _e)
+
+
+_SSL_CTX: Optional[ssl.SSLContext] = None
+
+
+def _ssl_ctx() -> ssl.SSLContext:
+    global _SSL_CTX
+    if _SSL_CTX is None:
+        _SSL_CTX = ssl.create_default_context()
+        try:
+            import certifi  # type: ignore
+
+            _SSL_CTX.load_verify_locations(certifi.where())
+        except Exception as _e:
+            log_swallowed("radio._ssl_ctx", _e)
+    return _SSL_CTX
+
+
+async def open_stream(url: str, extra_headers: Optional[dict[str, str]] = None,
+                      timeout: float = 6.0, max_redirects: int = 5) -> StreamResp:
+    """GET com HTTP/1.1 + Connection: close. Segue redirects. Levanta OSError/TimeoutError/ValueError."""
+    for _ in range(max_redirects + 1):
+        sp = urlsplit(url)
+        if sp.scheme not in ("http", "https") or not sp.hostname:
+            raise ValueError(f"url inválida: {url[:80]}")
+        tls = sp.scheme == "https"
+        port = sp.port or (443 if tls else 80)
+        path = (sp.path or "/") + (f"?{sp.query}" if sp.query else "")
+        host_hdr = sp.hostname if sp.port in (None, 80, 443) else f"{sp.hostname}:{sp.port}"
+        if ":" in sp.hostname and not host_hdr.startswith("["):
+            host_hdr = f"[{sp.hostname}]" + (f":{sp.port}" if sp.port else "")
+        hdrs = {
+            "Host": host_hdr,
+            "User-Agent": USER_AGENT,
+            "Accept": "*/*",
+            "Icy-MetaData": "0",
+            "Connection": "close",
+        }
+        if extra_headers:
+            hdrs.update(extra_headers)
+        req = f"GET {path} HTTP/1.1\r\n" + "".join(f"{k}: {v}\r\n" for k, v in hdrs.items()) + "\r\n"
+
+        async def _connect():
+            kw = dict(ssl=_ssl_ctx() if tls else None, server_hostname=sp.hostname if tls else None, limit=65536)
+            try:  # IPv6 quebrado não pode travar a conexão
+                r, w = await asyncio.open_connection(sp.hostname, port, happy_eyeballs_delay=0.25, **kw)
+            except TypeError:  # uvloop (o Comet roda com ele) não aceita happy_eyeballs_delay
+                r, w = await asyncio.open_connection(sp.hostname, port, **kw)
+            w.write(req.encode("latin-1", "replace"))
+            await w.drain()
+            status_line = await r.readline()
+            headers: dict[str, str] = {}
+            total = 0
+            for _n in range(100):
+                line = await r.readline()
+                total += len(line)
+                if total > 32768:
+                    raise ValueError("cabeçalhos grandes demais")
+                if line in (b"\r\n", b"\n", b""):
+                    break
+                k, _, v = line.decode("latin-1").partition(":")
+                headers[k.strip().lower()] = v.strip()
+            return r, w, status_line, headers
+
+        r, w, status_line, headers = await asyncio.wait_for(_connect(), timeout)
+        parts = status_line.decode("latin-1", "replace").strip().split(" ", 2)
+        if len(parts) < 2 or not parts[1].isdigit():
+            w.close()
+            raise ValueError(f"resposta inválida: {status_line[:60]!r}")
+        proto, status = parts[0], int(parts[1])
+        reason = parts[2] if len(parts) > 2 else ""
+        if status in (301, 302, 303, 307, 308) and headers.get("location"):
+            w.close()
+            url = urljoin(url, headers["location"])
+            continue
+        return StreamResp(status, reason, headers, r, w, url, proto)
+    raise ValueError("redirects demais")
+
+
+async def fetch_small(url: str, limit: int = 262144, timeout: float = 8.0) -> tuple[StreamResp, bytes]:
+    resp = await open_stream(url, timeout=timeout)
+    try:
+        body = await resp.read_upto(limit, time.monotonic() + timeout)
+    finally:
+        resp.close()
+    return resp, body
+
+
+# ---------------------------------------------------------------------------
+# Playlists
+# ---------------------------------------------------------------------------
+PLAYLIST_TYPES = ("audio/x-scpls", "audio/scpls", "audio/x-mpegurl", "audio/mpegurl",
+                  "application/vnd.apple.mpegurl", "application/x-mpegurl", "application/pls+xml",
+                  "video/x-ms-asf", "audio/x-ms-wax")
+
+
+def is_playlist(url: str, ctype: str, body_head: bytes) -> bool:
+    p = urlsplit(url).path.lower()
+    h = body_head[:64].lstrip().lower()
+    return (ctype.split(";")[0].strip().lower() in PLAYLIST_TYPES
+            or p.endswith((".pls", ".m3u", ".m3u8", ".asx"))
+            or h.startswith((b"#extm3u", b"[playlist]", b"<asx")))
+
+
+def parse_pls(text: str) -> list[str]:
+    return [m.group(1).strip() for m in re.finditer(r"(?im)^\s*file\d+\s*=\s*(\S+)\s*$", text)]
+
+
+def parse_m3u(text: str, base: str) -> list[str]:
+    out = []
+    for line in text.splitlines():
+        line = line.strip()
+        if line and not line.startswith("#"):
+            out.append(urljoin(base, line))
+    return out
+
+
+def parse_asx(text: str) -> list[str]:
+    return re.findall(r'(?i)<ref\s+href\s*=\s*"([^"]+)"', text)
+
+
+def hls_info(text: str, base: str) -> dict:
+    """{'master': bool, 'variants': [url...], 'segments': [url...]}"""
+    lines = [l.strip() for l in text.splitlines()]
+    variants, segments = [], []
+    expect_variant = False
+    for l in lines:
+        if not l:
+            continue
+        if l.startswith("#EXT-X-STREAM-INF"):
+            expect_variant = True
+            continue
+        if l.startswith("#"):
+            continue
+        u = urljoin(base, l)
+        (variants if expect_variant else segments).append(u)
+        expect_variant = False
+    return {"master": bool(variants), "variants": variants, "segments": segments}
+
+
+def _is_hls_text(text: str) -> bool:
+    return "#EXT-X-" in text or "#EXTINF" in text and ".ts" in text
+
+
+# ---------------------------------------------------------------------------
+# Validação de um stream
+# ---------------------------------------------------------------------------
+async def probe_url(url: str, depth: int = 0, budget: float = 9.0, read_bytes: int = 49152,
+                    min_bytes: int = 12288) -> dict:
+    """Testa se ``url`` toca áudio de verdade. Retorna dict com ok, final_url, fmt, ctype, hls, reason."""
+    res = {"ok": False, "final_url": url, "fmt": "", "ctype": "", "hls": False, "reason": "",
+           "icy_name": "", "bitrate": 0}
+    t0 = time.monotonic()
+    deadline = t0 + budget
+    resp = None
+    try:
+        resp = await open_stream(url, timeout=min(6.0, budget))
+        res["final_url"] = resp.url
+        ctype = resp.headers.get("content-type", "").split(";")[0].strip().lower()
+        res["ctype"] = ctype
+        res["icy_name"] = resp.headers.get("icy-name", "")[:120]
+        br = resp.headers.get("icy-br", "").split(",")[0].strip()
+        res["bitrate"] = int(br) if br.isdigit() else 0
+        if resp.status >= 400 or resp.status < 200:
+            res["reason"] = f"status {resp.status}"
+            return res
+        if ctype.startswith("text/html") or ctype in ("application/json", "text/xml"):
+            res["reason"] = f"content-type {ctype}"
+            return res
+        first = await resp.read_upto(2048, min(deadline, time.monotonic() + 5))
+        if is_playlist(resp.url, ctype, first):
+            body = first + await resp.read_upto(262144 - len(first), min(deadline, time.monotonic() + 4))
+            resp.close()
+            text = body.decode("utf-8", "replace")
+            if _is_hls_text(text):
+                return await _probe_hls(resp.url, text, res, deadline)
+            if depth >= 3:
+                res["reason"] = "playlist aninhada demais"
+                return res
+            if "[playlist]" in text.lower():
+                entries = parse_pls(text)
+            elif "<asx" in text.lower():
+                entries = parse_asx(text)
+            else:
+                entries = parse_m3u(text, resp.url)
+            for e in entries[:3]:
+                left = deadline - time.monotonic()
+                if left < 2:
+                    break
+                sub = await probe_url(e, depth + 1, budget=left)
+                if sub["ok"]:
+                    return sub
+                res["reason"] = "playlist: " + sub["reason"]
+            res["reason"] = res["reason"] or "playlist vazia"
+            return res
+        if ctype.startswith("text/") and not first.lstrip().startswith(b"ID3"):
+            res["reason"] = f"content-type {ctype}"
+            return res
+        body = first + await resp.read_upto(read_bytes - len(first), deadline)
+        if len(body) < min_bytes:
+            res["reason"] = f"poucos bytes ({len(body)})"
+            return res
+        fmt = detect_audio(body)
+        if not fmt and deadline - time.monotonic() > 1:
+            # alguns servidores mandam um começo estranho; mais uma janela antes de reprovar
+            more = await resp.read_upto(32768, deadline)
+            fmt = detect_audio(more) if len(more) >= 4096 else ""
+        if not fmt:
+            res["reason"] = f"sem sincronia de áudio ({ctype or 'sem content-type'})"
+            return res
+        res.update(ok=True, fmt=fmt)
+        return res
+    except asyncio.TimeoutError:
+        res["reason"] = "timeout"
+    except ssl.SSLError as e:
+        res["reason"] = f"ssl: {str(e)[:60]}"
+    except (OSError, ValueError, UnicodeError) as e:
+        res["reason"] = f"{type(e).__name__}: {str(e)[:60]}"
+    except Exception as e:  # pragma: no cover
+        res["reason"] = f"{type(e).__name__}: {str(e)[:60]}"
+    finally:
+        if resp is not None:
+            resp.close()
+    return res
+
+
+async def _probe_hls(url: str, text: str, res: dict, deadline: float) -> dict:
+    res["hls"] = True
+    res["final_url"] = url
+    info = hls_info(text, url)
+    media_text, media_url = text, url
+    if info["master"]:
+        media_url = info["variants"][0]
+        try:
+            _, body = await fetch_small(media_url, timeout=max(1.0, min(5.0, deadline - time.monotonic())))
+        except Exception as e:
+            res["reason"] = f"hls variante: {type(e).__name__}"
+            return res
+        media_text = body.decode("utf-8", "replace")
+        info = hls_info(media_text, media_url)
+    segs = info["segments"]
+    if not segs:
+        res["reason"] = "hls sem segmentos"
+        return res
+    seg = segs[-1] if len(segs) < 3 else segs[-3]
+    left = deadline - time.monotonic()
+    if left < 1:
+        res["reason"] = "timeout"
+        return res
+    try:
+        resp = await open_stream(seg, timeout=min(5.0, left))
+        try:
+            if resp.status >= 400:
+                res["reason"] = f"hls segmento status {resp.status}"
+                return res
+            body = await resp.read_upto(32768, deadline)
+        finally:
+            resp.close()
+    except Exception as e:
+        res["reason"] = f"hls segmento: {type(e).__name__}"
+        return res
+    fmt = detect_audio(body) if len(body) >= 2048 else ""
+    if not fmt:
+        res["reason"] = f"hls segmento sem áudio ({len(body)} bytes)"
+        return res
+    res.update(ok=True, fmt="hls-" + fmt)
+    return res
+
+
+def _https_variant(url: str) -> str:
+    sp = urlsplit(url)
+    if sp.scheme != "http" or sp.port not in (None, 80):
+        return ""
+    return "https://" + url[len("http://"):]
+
+
+# ---------------------------------------------------------------------------
+# Favicons
+# ---------------------------------------------------------------------------
+def image_size(b: bytes) -> tuple[int, int]:
+    if b[:8] == b"\x89PNG\r\n\x1a\n" and len(b) >= 24:
+        return int.from_bytes(b[16:20], "big"), int.from_bytes(b[20:24], "big")
+    if b[:2] == b"\xff\xd8":
+        i = 2
+        while i + 9 < len(b):
+            if b[i] != 0xFF:
+                i += 1
+                continue
+            m = b[i + 1]
+            if m in (0xC0, 0xC1, 0xC2):
+                return int.from_bytes(b[i + 7:i + 9], "big"), int.from_bytes(b[i + 5:i + 7], "big")
+            i += 2 + int.from_bytes(b[i + 2:i + 4], "big")
+    if b[:4] == b"RIFF" and b[8:12] == b"WEBP":
+        return 512, 512  # não vale o parse; webp de favicon costuma ser grande
+    if b[:6] in (b"GIF87a", b"GIF89a"):
+        return int.from_bytes(b[6:8], "little"), int.from_bytes(b[8:10], "little")
+    return 0, 0
+
+
+async def check_favicon(client, url: str) -> str:
+    """Devolve a URL https do favicon se for imagem utilizável (png/jpg/webp/gif, >= 64 px), senão ''."""
+    url = (url or "").strip()
+    if not url:
+        return ""
+    cands = [url] if url.startswith("https://") else ([_https_variant(url)] if _https_variant(url) else [])
+    for u in cands:
+        try:
+            async with client.stream("GET", u, timeout=6.0) as r:
+                if r.status_code != 200:
+                    continue
+                ct = r.headers.get("content-type", "").lower()
+                if not ct.startswith("image/") or "svg" in ct or "icon" in ct:
+                    continue
+                buf = b""
+                async for chunk in r.aiter_bytes():
+                    buf += chunk
+                    if len(buf) >= 65536:
+                        break
+                w, h = image_size(buf)
+                if w >= 64 and h >= 64 or (w == 0 and len(buf) > 4096 and "webp" in ct):
+                    return str(r.url)
+        except Exception:
+            continue
+    return ""
+
+
+# ---------------------------------------------------------------------------
+# API do Radio Browser
+# ---------------------------------------------------------------------------
+async def _api_servers() -> list[str]:
+    hosts: list[str] = []
+    try:
+        loop = asyncio.get_running_loop()
+        infos = await asyncio.wait_for(
+            loop.getaddrinfo("all.api.radio-browser.info", 443, type=socket.SOCK_STREAM), 5)
+        for info in infos:
+            ip = info[4][0]
+            try:
+                name = (await asyncio.wait_for(loop.run_in_executor(None, socket.gethostbyaddr, ip), 4))[0]
+                if name.endswith("radio-browser.info") and name not in hosts:
+                    hosts.append(name)
+            except Exception:
+                continue
+    except Exception as _e:
+        log_swallowed("radio._api_servers", _e)
+    random.shuffle(hosts)
+    for h in API_SERVERS:
+        if h not in hosts:
+            hosts.append(h)
+    return hosts
+
