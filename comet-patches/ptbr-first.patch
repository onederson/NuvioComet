+
+
+def _mb(n: float) -> str:
+    return f"{n / 1048576:.1f}"
+
+
+# ---------------------------------------------------------------- cifra (puro)
+
+def _derive_key(password: str, salt: bytes) -> bytes:
+    from cryptography.hazmat.primitives.kdf.scrypt import Scrypt
+
+    return Scrypt(salt=salt, length=32, n=2**15, r=8, p=1).derive(password.encode("utf-8"))
+
+
+def encrypt_bytes(data: bytes, password: str) -> bytes:
+    from cryptography.hazmat.primitives.ciphers.aead import AESGCM
+
+    salt, nonce = os.urandom(16), os.urandom(12)
+    return MAGIC + salt + nonce + AESGCM(_derive_key(password, salt)).encrypt(nonce, data, None)
+
+
+def decrypt_bytes(blob: bytes, password: str) -> bytes:
+    from cryptography.hazmat.primitives.ciphers.aead import AESGCM
+
+    if blob[:8] != MAGIC or len(blob) < 8 + 16 + 12 + 16:
+        raise ValueError("arquivo não é um backup do Comet")
+    salt, nonce, ct = blob[8:24], blob[24:36], blob[36:]
+    return AESGCM(_derive_key(password, salt)).decrypt(nonce, ct, None)
+
+
+# ---------------------------------------------------------------- banco enxuto
+
+def _q(name: str) -> str:
+    return '"' + name.replace('"', '""') + '"'
+
+
+def choose_slim_tables(sizes: dict[str, int | None]) -> list[str]:
+    """Tabelas que entram no banco enxuto (puro). sizes: nome -> bytes (None = desconhecido)."""
+    return [t for t, sz in sizes.items()
+            if t not in SLIM_EXCLUDE and not t.startswith("sqlite_")
+            and (sz is None or sz <= SLIM_MAX_BYTES)]
+
+
+def build_slim_db(src: Path, dest: Path) -> dict:
+    """Copia o schema e as linhas das tabelas pequenas. Bloqueante: rode em thread."""
+    if dest.exists():
+        dest.unlink()
+    ro = sqlite3.connect(f"file:{src}?mode=ro", uri=True, timeout=120)
+    ro.execute("PRAGMA busy_timeout=120000")
+    master = ro.execute(
+        "SELECT type, name, tbl_name, sql FROM sqlite_master WHERE sql IS NOT NULL").fetchall()
+    sizes: dict[str, int | None] = {}
+    for typ, name, _tbl, _sql in master:
+        if typ != "table" or name in SLIM_EXCLUDE or name.startswith("sqlite_"):
+            if typ == "table":
+                sizes[name] = None
+            continue
+        try:
+            sizes[name] = ro.execute(
+                "SELECT sum(pgsize) FROM dbstat WHERE name=?", (name,)).fetchone()[0] or 0
+        except sqlite3.Error:
+            sizes[name] = None
+    ro.close()
+    keep = set(choose_slim_tables(sizes))
+
+    out = sqlite3.connect(f"file:{dest}", uri=True, timeout=120)
+    out.isolation_level = None
+    out.execute("PRAGMA busy_timeout=120000")
+    out.execute("PRAGMA journal_mode=OFF")
+    out.execute("ATTACH DATABASE ? AS src", (f"file:{src}?mode=ro",))
+    rows = 0
+    try:
+        out.execute("BEGIN")
+        for typ, name, _tbl, sql in master:
+            if typ == "table" and name in keep:
+                out.execute(sql)
+        for typ, name, tbl, sql in master:
+            if typ == "table" and name in keep:
+                cur = out.execute(f"INSERT INTO main.{_q(name)} SELECT * FROM src.{_q(name)}")
+                rows += max(cur.rowcount, 0)
+        for typ, name, tbl, sql in master:
+            if typ == "index" and tbl in keep:
+                out.execute(sql)
+        out.execute("COMMIT")
+    except Exception:
+        try:
+            out.execute("ROLLBACK")
+        except sqlite3.Error:
+            pass
+        raise
+    finally:
+        out.close()
+    return {"tables": sorted(keep), "rows": rows, "bytes": dest.stat().st_size}
+
+
+# ---------------------------------------------------------------- backup
+
+def _make_tar(dest: Path, slim: Path | None) -> None:
+    with tarfile.open(dest, "w:gz") as tar:
+        for p, arc in ((ENV_PATH, ".env"), (CADDYFILE, "Caddyfile")):
+            if p.is_file():
+                tar.add(p, arcname=arc)
+        for p in sorted(DATA_DIR.glob("*.json")):
+            try:
+                if p.is_file() and p.stat().st_size < 2 * 1024 * 1024:
+                    tar.add(p, arcname=f"data/{p.name}")
+            except OSError:
+                pass
+        if slim is not None and slim.is_file():
+            tar.add(slim, arcname="comet-slim.db")
+
+
+def _ensure_password() -> tuple[str, bool]:
+    """Devolve (senha, recém-criada)."""
+    from comet.services.telegram_bot import _env
+
+    pw = _env("BACKUP_PASSWORD")
+    if pw:
+        return pw, False
+    pw = secrets.token_urlsafe(18)
+    txt = ""
+    try:
+        txt = ENV_PATH.read_text(encoding="utf-8")
+    except OSError:
+        pass
+    with open(ENV_PATH, "a", encoding="utf-8", newline="\n") as fh:
+        fh.write(("" if not txt or txt.endswith("\n") else "\n") + f"BACKUP_PASSWORD={pw}\n")
+    return pw, True
+
+
+def _build_backup(password: str, with_slim: bool, stamp: str) -> dict:
+    """Bloqueante. Monta tar, cifra e grava o .enc. Devolve info."""
+    BACKUP_DIR.mkdir(parents=True, exist_ok=True)
+    tmp_tar = BACKUP_DIR / "tmp-backup.tar.gz"
+    slim_path = BACKUP_DIR / "comet-slim.db"
+    slim_info = None
+    try:
+        if with_slim:
+            slim_info = build_slim_db(DB_PATH, slim_path)
+        _make_tar(tmp_tar, slim_path if with_slim else None)
+        enc = encrypt_bytes(tmp_tar.read_bytes(), password)
+    finally:
+        for p in (tmp_tar, slim_path):
+            try:
+                p.unlink()
+            except OSError:
+                pass
+    out = BACKUP_DIR / f"comet-backup-{stamp}.tar.gz.enc"
+    tmp_out = out.with_suffix(".tmp")
+    tmp_out.write_bytes(enc)
+    os.chmod(tmp_out, 0o600)
+    os.replace(tmp_out, out)
+    try:
+        os.chmod(BACKUP_DIR, 0o700)
+    except OSError:
+        pass
+    return {"path": out, "bytes": len(enc), "slim": slim_info}
+
+
+def _prune_backups() -> None:
+    files = sorted(BACKUP_DIR.glob("comet-backup-*.tar.gz.enc"))
+    for old in files[:-KEEP_BACKUPS]:
+        try:
+            old.unlink()
+        except OSError:
+            pass
+
+
+async def run_backup() -> str:
+    """Faz o backup, envia ao Telegram e devolve um resumo curto."""
+    from comet.services.telegram_bot import send_telegram, send_telegram_file
+
+    if _backup_lock.locked():
+        return "Já tem um backup em andamento."
+    async with _backup_lock:
+        t0 = time.time()
+        st = _load_state()
+        stamp = _now_local().strftime("%Y%m%d")
+        day = _now_local().strftime("%Y-%m-%d")
+        try:
+            pw, created = await asyncio.to_thread(_ensure_password)
+            if created:
+                await send_telegram(
+                    f"🔐 Senha dos backups: {pw}\nGuarde num gerenciador de senhas e apague esta mensagem.")
+            info = await asyncio.to_thread(_build_backup, pw, True, stamp)
+            note = ""
+            if info["bytes"] > TG_LIMIT:
+                info = await asyncio.to_thread(_build_backup, pw, False, stamp)
+                note = " (sem o banco enxuto: passou de 45 MB)"
+            await asyncio.to_thread(_prune_backups)
+        except Exception as e:
+            logger.warning(f"Guardião: backup falhou: {type(e).__name__}: {e}")
+            if st.get("backup_fail_day") != day:
+                st["backup_fail_day"] = day
+                _save_state()
+                await send_telegram(f"⚠️ Backup falhou: {type(e).__name__}: {e}")
+            return f"Backup falhou: {type(e).__name__}: {e}"
+        size = info["bytes"]
+        sent = False
+        if size <= TG_LIMIT:
+            sent = await send_telegram_file(
+                info["path"], f"💾 Backup do Comet {day} ({_mb(size)} MB){note}")
+        elapsed = time.time() - t0
+        st["backup_day"] = day
+        st["backup_info"] = {"ts": time.time(), "mb": round(size / 1048576, 1),
+                             "secs": round(elapsed, 1), "sent": sent}
+        _save_state()
+        if not sent:
+            await send_telegram(f"⚠️ Backup feito ({_mb(size)} MB) mas não consegui enviar. Está em {info['path']}")
+        return (f"💾 Backup pronto: {_mb(size)} MB em {elapsed:.0f} s"
+                f"{note}{' e enviado' if sent else ' (envio falhou)'}.")
+
+
+# ---------------------------------------------------------------- saúde
+
+THERMAL = Path("/sys/class/thermal")
+BATT = Path("/sys/class/power_supply/battery")
+
+
+def _read(p: Path) -> str | None:
+    try:
+        return p.read_text().strip()
+    except (OSError, ValueError):
+        return None
+
+
+def pick_cpu_temp(zones: dict[str, int]) -> float | None:
+    """zones: tipo -> milésimos de °C. Maior temperatura plausível de CPU (puro)."""
+    def ok(v):
+        return 0 < v <= 150000
+
+    skip = ("lmh-dcvs", "-step", "-lowf")
+    cpu = [v for k, v in zones.items() if k.startswith("cpu") and k.endswith("-usr") and ok(v)]
+    if not cpu:
+        cpu = [v for k, v in zones.items() if ok(v) and not any(s in k for s in skip)]
+    return max(cpu) / 1000 if cpu else None
+
+
+def read_health() -> dict:
+    """Bloqueante, mas só lê arquivos pequenos."""
+    h: dict = {}
+    cap = _read(BATT / "capacity")
+    temp = _read(BATT / "temp")
+    h["bat_pct"] = int(cap) if cap and cap.lstrip("-").isdigit() else None
+    h["bat_temp"] = int(temp) / 10 if temp and temp.lstrip("-").isdigit() else None
+    h["bat_status"] = _read(BATT / "status") or "?"
+    zones: dict[str, int] = {}
+    try:
+        for z in THERMAL.glob("thermal_zone*"):
+            t, v = _read(z / "type"), _read(z / "temp")
+            if t and v and v.lstrip("-").isdigit():
+                zones[t] = max(int(v), zones.get(t, -10**9))
+    except OSError:
+        pass
+    h["cpu_temp"] = pick_cpu_temp(zones)
+    try:
+        h["disk_free"] = shutil.disk_usage(str(COMET_DIR)).free
+    except OSError:
+        h["disk_free"] = None
+    mem = None
+    try:
+        for line in open("/proc/meminfo"):
+            if line.startswith("MemAvailable:"):
+                mem = int(line.split()[1]) * 1024
+                break
+    except (OSError, ValueError):
+        pass
+    h["mem_avail"] = mem
+    try:
+        h["db_bytes"] = DB_PATH.stat().st_size
+    except OSError:
+        h["db_bytes"] = None
+    return h
+
+
+def _charging(status: str) -> bool:
+    return status in ("Charging", "Full", "Not charging")
+
+
+def evaluate_alerts(h: dict, alerts: dict, now: float) -> list[str]:
+    """Decide os avisos de saúde (puro). Altera `alerts` e devolve as mensagens."""
+    gb = 1024 ** 3
+    bt, ct, df, mem = h.get("bat_temp"), h.get("cpu_temp"), h.get("disk_free"), h.get("mem_avail")
+    pct = h.get("bat_pct")
+    mem_streak = alerts.setdefault("_mem_streak", 0)
+    mem_streak = mem_streak + 1 if (mem is not None and mem < 250 * 1048576) else 0
+    alerts["_mem_streak"] = mem_streak
+    low_bat_now = pct is not None and pct < 20 and not _charging(h.get("bat_status", ""))
+    low_bat_clear = pct is None or pct >= 25 or _charging(h.get("bat_status", ""))
+    # tipo: (condição de alerta, condição de normalização, aviso, normalizou)
+    rules = {
+        "bat_temp": (bt is not None and bt >= 45, bt is None or bt < 42,
+                     f"🔥 Bateria do A71 a {bt:.0f} °C" if bt is not None else "",
+                     "✅ Temperatura da bateria voltou ao normal"),
+        "cpu_temp": (ct is not None and ct >= 80, ct is None or ct < 75,
+                     f"🔥 Processador do A71 a {ct:.0f} °C" if ct is not None else "",
+                     "✅ Temperatura do processador voltou ao normal"),
+        "disk": (df is not None and df < 5 * gb, df is None or df >= 6 * gb,
+                 f"💽 Pouco espaço no A71: {df / gb:.1f} GB livres" if df is not None else "",
+                 "✅ Espaço em disco voltou ao normal"),
+        "bat_low": (low_bat_now, low_bat_clear,
+                    f"🪫 Bateria do A71 em {pct} % e sem carregar",
+                    "✅ Bateria do A71 carregando ou recuperada"),
+        "mem": (mem_streak >= 3, mem is None or mem >= 300 * 1048576,
+                f"🧠 Pouca memória no A71: {(mem or 0) / 1048576:.0f} MB livres",
+                "✅ Memória do A71 voltou ao normal"),
+    }
+    msgs = []
+    for key, (bad, clear, warn, ok_msg) in rules.items():
+        a = alerts.setdefault(key, {"active": False, "last": 0})
+        if bad:
+            if now - a["last"] >= ALERT_GAP:
+                msgs.append(warn)
+                a["active"], a["last"] = True, now
+        elif a["active"] and clear:
+            msgs.append(ok_msg)
+            a["active"] = False
+    return msgs
+
+
+def _fmt_health(h: dict, detailed: bool) -> list[str]:
+    bs = h["bat_status"]
+    est = {"Charging": "carregando", "Full": "cheia", "Discharging": "descarregando",
+           "Not charging": "na tomada"}.get(bs, bs.lower())
+    bat = "?" if h["bat_temp"] is None else f"{h['bat_temp']:.0f}"
+    cpu = "?" if h["cpu_temp"] is None else f"{h['cpu_temp']:.0f}"
+    pct = "?" if h["bat_pct"] is None else h["bat_pct"]
+    lines = [f"🌡️ Bateria {bat} °C ({pct} %, {est}) · CPU {cpu} °C"]
+    disk = "?" if h["disk_free"] is None else f"{h['disk_free'] / 1024 ** 3:.0f}"
+    db = "?" if h["db_bytes"] is None else f"{h['db_bytes'] / 1048576:.0f}"
+    lines.append(f"💽 Disco livre {disk} GB · banco {db} MB")
+    if detailed:
+        mem = "?" if h["mem_avail"] is None else f"{h['mem_avail'] / 1048576:.0f}"
+        lines.append(f"🧠 Memória disponível {mem} MB")
+    return lines
+
+
+async def health_text() -> str:
+    h = await asyncio.to_thread(read_health)
+    lines = _fmt_health(h, True)
+    st = _load_state()
+    b = st.get("backup_info")
+    if b:
+        when = datetime.fromtimestamp(b["ts"], TZ).strftime("%d/%m %H:%M")
+        lines.append(f"💾 Último backup {when} ({b['mb']} MB)")
+    v = st.get("vacuum")
+    if v:
+        lines.append(f"🧹 Manutenção do banco {v.get('day', '?')}: {v.get('note', '')}")
+    return "\n".join(lines)
+
+
+async def health_tick() -> None:
+    from comet.services.telegram_bot import send_telegram
+
+    h = await asyncio.to_thread(read_health)
+    st = _load_state()
+    msgs = evaluate_alerts(h, st.setdefault("alerts", {}), time.time())
+    st["last_health"] = {k: h.get(k) for k in ("bat_pct", "bat_temp", "cpu_temp", "disk_free")}
+    _save_state()
+    for m in msgs:
+        await send_telegram(m)
+
+
+# ---------------------------------------------------------------- manutenção do banco
+
+def should_vacuum(freelist: int, pages: int, disk_free: int, db_bytes: int) -> bool:
+    """Puro: fração livre > 20 % e disco livre > 3x o banco."""
+    return pages > 0 and freelist / pages > 0.20 and disk_free > 3 * db_bytes
+
+
+def _maintain_db() -> dict:
+    """Bloqueante: optimize + analyze e, se valer a pena, VACUUM."""
+    t0 = time.time()
+    size0 = DB_PATH.stat().st_size
+    con = sqlite3.connect(str(DB_PATH), timeout=120)
+    con.isolation_level = None
+    try:
+        con.execute("PRAGMA busy_timeout=120000")
+        con.execute("PRAGMA optimize")
+        con.execute("ANALYZE")
+        freelist = con.execute("PRAGMA freelist_count").fetchone()[0]
+        pages = con.execute("PRAGMA page_count").fetchone()[0]
+        free = shutil.disk_usage(str(COMET_DIR)).free
+        vac = should_vacuum(freelist, pages, free, size0)
+        if vac:
+            con.execute("VACUUM")
+    finally:
+        con.close()
+    return {"vacuum": vac, "freelist": freelist, "pages": pages, "size_before": size0,
+            "size_after": DB_PATH.stat().st_size, "secs": round(time.time() - t0, 1)}
+
+
+async def run_maintenance() -> None:
+    from comet.services.telegram_bot import send_telegram
+
+    st = _load_state()
+    day = _now_local().strftime("%Y-%m-%d")
+    try:
+        r = await asyncio.to_thread(_maintain_db)
+    except Exception as e:
+        logger.warning(f"Guardião: manutenção do banco falhou: {type(e).__name__}: {e}")
+        st["vacuum"] = {"day": day, "note": f"erro {type(e).__name__}"}
+        st["maint_day"] = day
+        _save_state()
+        await send_telegram(f"⚠️ Manutenção do banco falhou: {type(e).__name__}: {e}")
+        return
+    note = (f"VACUUM {_mb(r['size_before'])} → {_mb(r['size_after'])} MB em {r['secs']} s"
+            if r["vacuum"] else f"otimizado em {r['secs']} s (sem VACUUM, {r['freelist']}/{r['pages']} páginas livres)")
+    st["vacuum"] = {"day": day, "note": note, **r}
+    st["maint_day"] = day
+    _save_state()
+    logger.info(f"Guardião: {note}")
+    if r["vacuum"]:
+        await send_telegram(f"🧹 Banco compactado: {note}")
+
+
+# ---------------------------------------------------------------- fonte morta
+
+def prune_obs(obs: list, now: float) -> list:
+    return [o for o in obs if now - o[0] <= 86400]
+
+
+def pause_ratio(obs: list, now: float, window: float) -> tuple[float, int]:
+    sel = [o for o in obs if now - o[0] <= window]
+    if not sel:
+        return 0.0, 0
+    return sum(o[1] for o in sel) / len(sel), len(sel)
+
+
+def source_is_dead(obs: list, now: float) -> bool:
+    ratio, n = pause_ratio(obs, now, 86400)
+    return n >= 100 and ratio >= 0.8
+
+
+def source_is_back(obs: list, now: float) -> bool:
+    ratio, n = pause_ratio(obs, now, 3 * 3600)
+    return n >= 3 and ratio < 0.2
+
+
+def _paused(state: str) -> int:
+    return 1 if state.startswith("pausada") else 0
+
+
+async def breaker_tick() -> None:
+    from comet.core import breaker
+    from comet.services.telegram_bot import send_telegram
+
+    now = time.time()
+    st = _load_state()
+    srcs = st.setdefault("sources", {})
+    msgs = []
+    for row in breaker.snapshot(now):
+        s = srcs.setdefault(row["name"], {"obs": [], "dead": False})
+        s["obs"] = prune_obs(s["obs"], now) + [[now, _paused(row["state"])]]
+        if not s["dead"] and source_is_dead(s["obs"], now):
+            s["dead"] = True
+            msgs.append(f"⚠️ Fonte {row['name']} fora do ar há 24 h (site pode ter mudado de endereço)")
+        elif s["dead"] and source_is_back(s["obs"], now):
+            s["dead"] = False
+            msgs.append(f"✅ Fonte {row['name']} voltou")
+    _save_state()
+    for m in msgs:
+        await send_telegram(m)
+
+
+def sources_text() -> str:
+    from comet.core import breaker
+
+    now = time.time()
+    srcs = _load_state().get("sources", {})
+    snap = breaker.snapshot(now)
+    if not snap:
+        return "Nenhuma fonte registrada ainda (o servidor acabou de subir ou ninguém buscou)."
+    lines = []
+    for row in snap:
+        obs = srcs.get(row["name"], {}).get("obs", [])
+        ratio, n = pause_ratio(obs, now, 86400)
+        icon = "🟢" if row["state"] == "ok" else "⏸️"
+        pct = f"{ratio * 100:.0f} % pausada em 24 h" if n else "sem histórico ainda"
+        dead = " · FORA DO AR" if srcs.get(row["name"], {}).get("dead") else ""
+        lines.append(f"{icon} {row['name']}: {row['state']} · {pct}{dead}")
+    return "\n".join(lines)
+
+
+# ---------------------------------------------------------------- versão do Comet original
+
+def _git_head() -> str | None:
+    try:
+        r = subprocess.run(["git", "-C", str(COMET_DIR), "rev-parse", "HEAD"],
+                           capture_output=True, text=True, timeout=20)
+        return r.stdout.strip() or None
+    except (OSError, subprocess.SubprocessError):
+        return None
+
+
+def format_news(ahead: int, titles: list[str]) -> str:
+    """Puro: texto do aviso de versão nova."""
+    bullets = "\n".join(f"• {t}" for t in titles)
+    return (f"🆕 Comet original tem {ahead} novidades desde a nossa versão:\n{bullets}\n"
+            "Para atualizar com segurança, no PC: .\\scripts\\update_comet.ps1 check")
+
+
+async def check_version() -> tuple[str, str | None, int]:
+    """Devolve (texto, sha remoto, nº de commits à frente). Só lê o GitHub."""
+    import aiohttp
+
+    local = await asyncio.to_thread(_git_head)
+    if not local:
+        return "Não consegui ler a versão local do Comet.", None, 0
+    hdr = {"User-Agent": "Comet-A71", "Accept": "application/vnd.github+json"}
+    timeout = aiohttp.ClientTimeout(total=30)
+    try:
+        async with aiohttp.ClientSession(headers=hdr, timeout=timeout) as s:
+            async with s.get("https://api.github.com/repos/g0ldyy/comet") as r:
+                r.raise_for_status()
+                branch = (await r.json()).get("default_branch", "main")
+            async with s.get(f"https://api.github.com/repos/g0ldyy/comet/commits/{branch}") as r:
+                r.raise_for_status()
+                remote = (await r.json())["sha"]
+            if remote == local:
+                return "✅ O Comet está igual ao original, sem novidades.", remote, 0
+            async with s.get(f"https://api.github.com/repos/g0ldyy/comet/compare/{local}...{remote}") as r:
+                r.raise_for_status()
+                cmp = await r.json()
+    except Exception as e:
+        return f"Não consegui consultar o GitHub: {type(e).__name__}", None, 0
+    ahead = int(cmp.get("ahead_by", 0))
+    if ahead <= 0:
+        return "✅ O Comet está igual ao original, sem novidades.", remote, 0
+    commits = cmp.get("commits", [])[-5:][::-1]
+    titles = [(c.get("commit", {}).get("message", "") or "").split("\n")[0][:100] for c in commits]
+    return format_news(ahead, titles), remote, ahead
+
+
+async def version_tick() -> None:
+    from comet.services.telegram_bot import send_telegram
+
+    st = _load_state()
+    text, sha, ahead = await check_version()
+    st["version_day"] = _now_local().strftime("%Y-%m-%d")
+    if sha and ahead > 0 and st.get("version_notified") != sha:
+        st["version_notified"] = sha
+        _save_state()
+        await send_telegram(text)
+    else:
+        _save_state()
+
+
+# ---------------------------------------------------------------- Telegram
+
+async def handle_command(text: str) -> str | None:
+    cmd = text.strip().split()[0].split("@")[0].lower() if text.strip() else ""
+    if cmd == "/backup":
+        return await run_backup()
+    if cmd == "/saude":
+        return await health_text()
+    if cmd == "/fontes":
+        return sources_text()
+    if cmd == "/versao":
+        reply, sha, ahead = await check_version()
+        if sha and ahead > 0:
+            st = _load_state()
+            st["version_notified"] = sha
+            _save_state()
+        return reply
+    return None
+
+
+async def status_lines() -> list[str]:
+    h = await asyncio.to_thread(read_health)
+    return _fmt_health(h, False)
+
+
+# ---------------------------------------------------------------- serviço de fundo
+
+def due_jobs(now: datetime, st: dict, ts: float) -> list[str]:
+    """Puro: quais tarefas estão no horário (now em hora local)."""
+    day = now.strftime("%Y-%m-%d")
+    hm = (now.hour, now.minute)
+    jobs = []
+    if ts - st.get("t_health", 0) >= 300:
+        jobs.append("health")
+    if ts - st.get("t_breaker", 0) >= 600:
+        jobs.append("breaker")
+    if hm >= (5, 30) and st.get("backup_day") != day and ts - st.get("t_backup", 0) >= 3600:
+        jobs.append("backup")
+    if now.weekday() == 6 and hm >= (5, 0) and st.get("maint_day") != day:
+        jobs.append("maint")
+    if now.weekday() == 0 and hm >= (10, 0) and st.get("version_day") != day:
+        jobs.append("version")
+    return jobs
+
+
+async def start_service() -> None:
+    await asyncio.sleep(120)
+    while True:
+        try:
+            st = _load_state()
+            ts = time.time()
+            for job in due_jobs(_now_local(), st, ts):
+                try:
+                    if job == "health":
+                        st["t_health"] = ts
+                        await health_tick()
+                    elif job == "breaker":
+                        st["t_breaker"] = ts
+                        await breaker_tick()
+                    elif job == "backup":
+                        st["t_backup"] = ts
+                        await run_backup()
+                    elif job == "maint":
+                        st["maint_day"] = _now_local().strftime("%Y-%m-%d")
+                        await run_maintenance()
+                    elif job == "version":
+                        await version_tick()
+                except Exception as e:
+                    logger.warning(f"Guardião: {job} falhou: {type(e).__name__}: {e}")
+            _save_state()
+        except Exception as e:
+            logger.warning(f"Guardião: ciclo falhou: {type(e).__name__}: {e}")
+        await asyncio.sleep(60)
+
+
+# ---------------------------------------------------------------- linha de comando
+
+def _cli(argv: list[str]) -> int:
+    if len(argv) >= 3 and argv[0] == "decrypt":
+        args = argv[1:]
+        pw = os.environ.get("BACKUP_PASSWORD")
+        if "--senha" in args:
+            i = args.index("--senha")
+            pw = args[i + 1] if i + 1 < len(args) else None
+            del args[i:i + 2]
+        if len(args) != 2 or not pw:
+            print("uso: python -m comet.services.guardian decrypt <arquivo.enc> <saida.tar.gz> [--senha X]")
+            return 2
+        try:
+            data = decrypt_bytes(Path(args[0]).read_bytes(), pw)
+        except Exception as e:
+            print(f"falhou: {type(e).__name__} (senha errada ou arquivo corrompido?)")
+            return 1
+        Path(args[1]).write_bytes(data)
+        print(f"ok: {len(data)} bytes em {args[1]}")
+        return 0
+    print("uso: python -m comet.services.guardian decrypt <arquivo.enc> <saida.tar.gz> [--senha X]")
+    return 2
+
+
+if __name__ == "__main__":
+    sys.exit(_cli(sys.argv[1:]))
