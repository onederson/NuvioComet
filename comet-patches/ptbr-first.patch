+def _check(h: int, color=WHITE, circle=None) -> Image.Image:
+    h = max(4, int(h))
+    im = Image.new("RGBA", (h, h), (0, 0, 0, 0))
+    d = ImageDraw.Draw(im)
+    s = 1.0
+    if circle is not None:
+        d.ellipse((0, 0, h - 1, h - 1), fill=_rgba(circle))
+        s = 0.62
+    o = h * (1 - s) / 2
+    pts = [(o + h * s * 0.10, o + h * s * 0.52), (o + h * s * 0.38, o + h * s * 0.80),
+           (o + h * s * 0.92, o + h * s * 0.20)]
+    d.line(pts, fill=_rgba(color), width=max(1, round(h * (0.13 if circle is None else 0.1))), joint="curve")
+    r = h * (0.065 if circle is None else 0.05)
+    for px, py in (pts[0], pts[2]):
+        d.ellipse((px - r, py - r, px + r, py + r), fill=_rgba(color))
+    return im
+
+
+def _clock(h: int, color=WHITE) -> Image.Image:
+    h = max(4, int(h))
+    im = Image.new("RGBA", (h, h), (0, 0, 0, 0))
+    d = ImageDraw.Draw(im)
+    lw = max(1, round(h * 0.11))
+    d.ellipse((lw / 2, lw / 2, h - 1 - lw / 2, h - 1 - lw / 2), outline=_rgba(color), width=lw)
+    c = h / 2
+    d.line([(c, h * 0.24), (c, c), (h * 0.70, c)], fill=_rgba(color), width=lw, joint="curve")
+    return im
+
+
+def _calendar(h: int, color=WHITE) -> Image.Image:
+    h = max(4, int(h))
+    w = int(round(h * 0.95))
+    im = Image.new("RGBA", (w, h), (0, 0, 0, 0))
+    d = ImageDraw.Draw(im)
+    lw = max(1, round(h * 0.1))
+    top = h * 0.12
+    d.rounded_rectangle((0, top, w - 1, h - 1), radius=h * 0.16, outline=_rgba(color), width=lw)
+    d.rounded_rectangle((0, top, w - 1, h * 0.4), radius=h * 0.16, fill=_rgba(color))
+    d.rectangle((0, h * 0.3, w - 1, h * 0.4), fill=_rgba(color))
+    for fx in (0.28, 0.72):
+        x = w * fx
+        d.rounded_rectangle((x - lw / 2, 0, x + lw / 2, h * 0.26), radius=lw / 2, fill=_rgba(color))
+    r = h * 0.07
+    for fx in (0.3, 0.5, 0.7):
+        for fy in (0.58, 0.78):
+            d.ellipse((w * fx - r, h * fy - r, w * fx + r, h * fy + r), fill=_rgba(color))
+    return im
