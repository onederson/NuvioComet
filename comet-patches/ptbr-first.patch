+import asyncio
+import time
+from datetime import datetime, timezone
+
+import aiohttp
+
+from comet.core.database import database
+from comet.core.logger import logger, log_swallowed
+from comet.core.models import settings
+
+_RECENT_PREFETCHES: dict[str, float] = {}
+_PREFETCH_SEMAPHORE = asyncio.Semaphore(2)
+_TASKS: set = set()  # guarda referencia: sem isso o asyncio pode descartar a tarefa
+_COOLDOWN_SECONDS = 20 * 60  # 20 minutes
+
+
+# --- Pré-download do próximo episódio dublado (Tarefa Y) ---
+import json as _json
+import re as _re
+from pathlib import Path as _Path
+
+_PREDL_FILE = _Path("/opt/comet/data/predownload.json")
+_PREDL_LOCK = asyncio.Lock()
+_PREDL_SERIES_COOLDOWN = 12 * 3600
+_RES_PREF = {"1080p": 0, "720p": 1, "4K": 2, "480p": 3, "SD": 4}
+
+
+def _predl_load() -> dict:
+    try:
+        return _json.loads(_PREDL_FILE.read_text(encoding="utf-8"))
+    except Exception:
+        return {}
+
+
+def _predl_save(state: dict) -> None:
+    try:
+        tmp = _PREDL_FILE.with_suffix(".tmp")
+        tmp.write_text(_json.dumps(state, ensure_ascii=False), encoding="utf-8")
+        tmp.replace(_PREDL_FILE)
+    except Exception as e:
+        logger.debug(f"pré-download: não gravou estado: {e}")
+
+
+def get_predownload_summary() -> dict:
+    st = _predl_load()
+    today = time.strftime("%Y-%m-%d")
+    return {
+        "today": st.get("count", 0) if st.get("day") == today else 0,
+        "recent": (st.get("recent") or [])[-5:],
+    }
+
+
+def _stream_size_gb(desc: str) -> float | None:
+    m = _re.search(r"([\d.,]+)\s*GB", desc or "")
+    if not m:
+        return None
+    try:
+        return float(m.group(1).replace(".", "").replace(",", "."))
+    except ValueError:
+        return None
+
+
+def _stream_res(name: str) -> str | None:
+    for r in ("4K", "1080p", "720p", "480p", "SD"):
+        if r in (name or ""):
+            return r
+    return None
+
+
+def _pick_predownload(streams: list[dict]) -> dict | None:
+    """Melhor stream 🇧🇷 não cacheado (⬇️). None se já existe 🇧🇷 ⚡ ou se não há 🇧🇷."""
+    pt_ready = False
+    candidates = []
+    for st in streams:
+        name = str(st.get("name") or "")
+        desc = str(st.get("description") or st.get("title") or "")
+        if "🇧🇷" not in name + desc or not st.get("url"):
+            continue
+        if name.startswith("▶"):
+            continue
+        if "⚡" in name or "🌐" in name:
+            pt_ready = True  # dublado em cache ou link direto dublado: já toca na hora
+            continue
+        if "⬇" not in name:
+            continue
+        if "P2P" in name + desc:
+            continue
+        res = _stream_res(name)
+        size = _stream_size_gb(desc)
+        if res is None or (size is not None and size > 15):
+            continue
+        service = "TorBox" if "TorBox" in desc else "Real-Debrid"
+        candidates.append((_RES_PREF.get(res, 9), 0 if service == "Real-Debrid" else 1, size or 99, res, service, st))
+    if pt_ready or not candidates:
+        return None
+    candidates.sort(key=lambda c: c[:3])
+    _, _, size, res, service, st = candidates[0]
+    return {"stream": st, "res": res, "service": service, "size": size}
+
+
+async def _maybe_predownload(streams: list[dict], imdb_id: str, s: int, e: int, name: str = "") -> None:
+    if not getattr(settings, "PREDOWNLOAD_NEXT_EPISODE", True):
+        return
+    choice = _pick_predownload(streams)
+    if not choice:
+        logger.debug(f"pré-download {imdb_id} T{s}E{e}: pulado (já tem 🇧🇷 ⚡ ou não há 🇧🇷)")
+        return
+    async with _PREDL_LOCK:
+        st = _predl_load()
+        today = time.strftime("%Y-%m-%d")
+        if st.get("day") != today:
+            st["day"], st["count"] = today, 0
+        max_day = int(getattr(settings, "PREDOWNLOAD_MAX_PER_DAY", 10))
+        if st.get("count", 0) >= max_day:
+            logger.debug(f"pré-download {imdb_id}: limite diário ({max_day})")
+            return
+        last = (st.get("series") or {}).get(imdb_id, 0)
+        if time.time() - last < _PREDL_SERIES_COOLDOWN:
+            logger.debug(f"pré-download {imdb_id}: mesma série há menos de 12 h")
+            return
+        url = str(choice["stream"]["url"])
+        public = (getattr(settings, "PUBLIC_BASE_URL", None) or "").rstrip("/")
+        if public and url.startswith(public):
+            url = "http://127.0.0.1:8000" + url[len(public):]
+        try:
+            async with aiohttp.ClientSession(timeout=aiohttp.ClientTimeout(total=20.0)) as client:
+                async with client.get(url, headers={"Range": "bytes=0-1", "User-Agent": "ExoPlayerLib/2.19.1"}, allow_redirects=False) as resp:
+                    status = resp.status
+        except Exception as exc:
+            logger.warning(f"pré-download {imdb_id} T{s}E{e} falhou: {type(exc).__name__}")
+            return
+        size_txt = f"{choice['size']:.1f} GB" if choice.get("size") and choice["size"] < 99 else "?"
+        logger.info(f"📥 pré-download {imdb_id} T{s}E{e}: {choice['service']} {choice['res']} {size_txt} (HTTP {status})")
+        st["count"] = st.get("count", 0) + 1
+        st.setdefault("series", {})[imdb_id] = time.time()
+        recent = st.setdefault("recent", [])
+        recent.append(f"{name or imdb_id} T{s}E{e} · {choice['service']} {choice['res']}")
+        st["recent"] = recent[-20:]
+        _predl_save(st)
+
+
+
+def _is_future_release(rel_str: str | None) -> bool:
+    if not rel_str or not isinstance(rel_str, str):
+        return True
+    try:
+        clean = rel_str.strip().replace("Z", "+00:00")
+        dt = datetime.fromisoformat(clean)
+        if dt.tzinfo is None:
+            dt = dt.replace(tzinfo=timezone.utc)
+        return dt > datetime.now(timezone.utc)
+    except Exception:
+        try:
+            d_part = rel_str.strip().split("T", 1)[0]
+            d = datetime.strptime(d_part, "%Y-%m-%d").date()
+            return d > datetime.now(timezone.utc).date()
+        except Exception:
+            return True
+
+
+def _find_next_episode(
+    videos: list[dict], current_s: int, current_e: int
+) -> tuple[int, int] | None:
+    all_episodes: dict[tuple[int, int], dict] = {}
+    for v in videos:
+        if not isinstance(v, dict):
+            continue
+        s = v.get("season")
+        e = v.get("episode", v.get("number"))
+        try:
+            all_episodes[(int(s), int(e))] = v
+        except (TypeError, ValueError):
+            continue
+
+    season_episodes = [ep for (s, ep) in all_episodes.keys() if s == current_s]
+    if not season_episodes:
+        return None
+
+    max_e = max(season_episodes)
+    if current_e < max_e:
+        target = (current_s, current_e + 1)
+    else:
+        target = (current_s + 1, 1)
+
+    target_video = all_episodes.get(target)
+    if not target_video:
+        return None
+
+    rel = target_video.get("released") or target_video.get("firstAired")
+    if _is_future_release(rel):
+        return None
+
+    return target
+
+
+async def _get_series_videos(
+    session: aiohttp.ClientSession, imdb_id: str
+) -> list[dict]:
+    # 1. Tenta meta_ptbr (usa cache em memoria)
+    try:
+        from comet.services.meta_ptbr import get_meta_ptbr
+
+        meta = await get_meta_ptbr("series", imdb_id)
+        if meta and isinstance(meta.get("videos"), list) and meta["videos"]:
+            return meta["videos"]
+    except Exception as e:
+        logger.warning(f"Erro ao obter meta_ptbr para {imdb_id}: {e}")
+
+    # 2. Fallback direto Cinemeta
+    try:
+        url = f"https://v3-cinemeta.strem.io/meta/series/{imdb_id}.json"
+        async with session.get(
+            url, timeout=aiohttp.ClientTimeout(total=10.0)
+        ) as resp:
+            if resp.status == 200:
+                data = await resp.json()
+                if isinstance(data, dict):
+                    meta = data.get("meta") or {}
+                    if isinstance(meta.get("videos"), list):
+                        return meta["videos"]
+    except Exception as e:
+        logger.warning(f"Erro ao obter Cinemeta para {imdb_id}: {e}")
+
+    return []
+
+
+async def _resolve_imdb_id(
+    media_id: str | None, info_hash: str | None
+) -> str | None:
+    if media_id:
+        if media_id.startswith("tt"):
+            return media_id.split(":")[0]
+        if media_id.startswith("kitsu:"):
+            try:
+                from comet.services.anime import anime_mapper
+
+                parts = media_id.split(":")
+                k_id = parts[1] if len(parts) > 1 else media_id
+                mapped = await anime_mapper.get_imdb_from_kitsu(k_id)
+                if mapped and mapped.startswith("tt"):
+                    return mapped
+            except Exception as _e:
+                log_swallowed("prefetch._resolve_imdb_id", _e)
+            return media_id.split(":")[0] if ":" in media_id else media_id
+
+    if info_hash:
+        try:
+            row = await database.fetch_one(
+                """
+                SELECT media_id
+                FROM torrents
+                WHERE info_hash = :hash
+                ORDER BY updated_at DESC
+                LIMIT 1
+                """,
+                {"hash": info_hash},
+            )
+            if row and row["media_id"]:
+                raw = str(row["media_id"]).strip()
+                if raw.startswith("tt"):
+                    return raw.split(":")[0]
+                return raw
+        except Exception as _e:
+            log_swallowed("prefetch._resolve_imdb_id", _e)
+
+    return media_id.split(":")[0] if media_id else None
+
+
+async def _prefetch_worker(
+    b64config: str,
+    media_id: str | None,
+    info_hash: str | None,
+    season: int,
+    episode: int,
+) -> None:
+    try:
+        imdb_id = await _resolve_imdb_id(media_id, info_hash)
+        if not imdb_id:
+            return
+
+        timeout_meta = aiohttp.ClientTimeout(total=15.0)
+        async with aiohttp.ClientSession(timeout=timeout_meta) as meta_session:
+            videos = await _get_series_videos(meta_session, imdb_id)
+
+        if not videos:
+            return
+
+        target = _find_next_episode(videos, season, episode)
+        if not target:
+            return
+
+        next_s, next_e = target
+        cache_key = f"{imdb_id}:{next_s}:{next_e}"
+
+        now = time.monotonic()
+        expired = [
+            k
+            for k, v in _RECENT_PREFETCHES.items()
+            if now - v >= _COOLDOWN_SECONDS
+        ]
+        for k in expired:
+            _RECENT_PREFETCHES.pop(k, None)
+
+        if now - _RECENT_PREFETCHES.get(cache_key, 0) < _COOLDOWN_SECONDS:
+            return
+
+        _RECENT_PREFETCHES[cache_key] = now
+
+        async with _PREFETCH_SEMAPHORE:
+            url = f"http://127.0.0.1:8000/{b64config}/stream/series/{imdb_id}:{next_s}:{next_e}.json"
+            t0 = time.monotonic()
+            timeout_get = aiohttp.ClientTimeout(total=60.0)
+            async with aiohttp.ClientSession(timeout=timeout_get) as client:
+                async with client.get(url) as resp:
+                    elapsed = time.monotonic() - t0
+                    if resp.status == 200:
+                        data = await resp.json()
+                        streams = (
+                            data.get("streams", [])
+                            if isinstance(data, dict)
+                            else []
+                        )
+                        n_streams = len(streams)
+                        logger.info(
+                            f"⏭️ pré-busca {imdb_id} S{next_s}E{next_e}: {n_streams} streams em {elapsed:.1f}s"
+                        )
+                        try:
+                            await _maybe_predownload(streams, imdb_id, next_s, next_e)
+                        except Exception as pd_err:
+                            logger.warning(f"pré-download falhou: {pd_err}")
+                    else:
+                        logger.warning(
+                            f"Pré-busca {imdb_id} S{next_s}E{next_e} falhou: HTTP {resp.status}"
+                        )
+    except Exception as e:
+        logger.warning(
+            f"Pré-busca {media_id or info_hash} S{season}E{episode} falhou: {e}"
+        )
+
+
+def trigger_prefetch_next_episode(
+    b64config: str,
+    media_id: str | None,
+    info_hash: str | None,
+    season: int | None,
+    episode: int | None,
+) -> None:
+    if not getattr(settings, "PREFETCH_NEXT_EPISODE", True):
+        return
+    if season is None or episode is None:
+        return
+    task = asyncio.create_task(
+        _prefetch_worker(
+            b64config=b64config,
+            media_id=media_id,
+            info_hash=info_hash,
+            season=season,
+            episode=episode,
+        )
+    )
+    _TASKS.add(task)
+    task.add_done_callback(_TASKS.discard)
+
+
+def trigger_prefetch_next_episode_later(b64config: str, media_id: str, season: int, episode: int, delay: float = 25.0) -> None:
+    """Pré-busca do próximo episódio quando o usuário ABRE o episódio (lista de streams).
+    Cobre o caso em que o ▶ Assistir é link direto e o play não passa pelo Comet."""
+    if not getattr(settings, "PREFETCH_NEXT_EPISODE", True):
+        return
+
+    async def _later():
+        await asyncio.sleep(delay)
+        trigger_prefetch_next_episode(b64config, media_id, None, season, episode)
+
+    task = asyncio.create_task(_later())
+    _TASKS.add(task)
+    task.add_done_callback(_TASKS.discard)
