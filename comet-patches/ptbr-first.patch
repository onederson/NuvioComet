diff --git a/comet/api/endpoints/artwork.py b/comet/api/endpoints/artwork.py
new file mode 100644
index 0000000..1fdce15
--- /dev/null
+++ b/comet/api/endpoints/artwork.py
@@ -0,0 +1,131 @@
+from fastapi import APIRouter, HTTPException, Response
+
+from comet.services.artwork import (
+    ArtworkNotFound,
+    render_animation,
+    render_landscape,
+    render_poster,
+    render_top10,
+)
+
+router = APIRouter(tags=["Stremio"])
+
+
+@router.get(
+    "/art/top10/{rank}/{poster_file:path}",
+    summary="Top 10 Artwork",
+    description="Returns composite top 10 artwork with rank number.",
+)
+async def get_art_top10(rank: int, poster_file: str, p: int | None = None):
+    try:
+        data = await render_top10(rank, poster_file, provider_id=p)
+        return Response(
+            content=data,
+            media_type="image/jpeg",
+            headers={"Cache-Control": "public, max-age=2592000, immutable"},
+        )
+    except (ArtworkNotFound, ValueError):
+        raise HTTPException(status_code=404, detail="Artwork not found")
+    except Exception as e:
+        raise HTTPException(status_code=404, detail="Artwork not found")
+
+
+@router.get(
+    "/art/poster/{poster_file:path}",
+    summary="Poster Artwork with Badge",
+    description="Returns portrait poster artwork with optional badge.",
+)
+async def get_art_poster(
+    poster_file: str, b: str | None = None, p: int | None = None, o: int | None = None
+):
+    if b and b not in ("new_ep", "new", "dub", "top10"):
+        raise HTTPException(status_code=404, detail="Invalid badge")
+    try:
+        data = await render_poster(poster_file, badge=b, provider_id=p, oscar=bool(o))
+        return Response(
+            content=data,
+            media_type="image/jpeg",
+            headers={"Cache-Control": "public, max-age=2592000, immutable"},
+        )
+    except (ArtworkNotFound, ValueError):
+        raise HTTPException(status_code=404, detail="Artwork not found")
+    except Exception as e:
+        raise HTTPException(status_code=404, detail="Artwork not found")
+
+
+@router.get(
+    "/art/land/{backdrop_file}",
+    summary="Landscape Artwork without Logo",
+    description="Returns landscape artwork with dark gradients.",
+)
+async def get_art_land_no_logo(
+    backdrop_file: str, b: str | None = None, p: int | None = None, o: int | None = None
+):
+    if b and b not in ("new_ep", "new", "dub", "top10"):
+        raise HTTPException(status_code=404, detail="Invalid badge")
+    try:
+        data = await render_landscape(backdrop_file, None, badge=b, provider_id=p, oscar=bool(o))
+        return Response(
+            content=data,
+            media_type="image/jpeg",
+            headers={"Cache-Control": "public, max-age=2592000, immutable"},
+        )
+    except (ArtworkNotFound, ValueError):
+        raise HTTPException(status_code=404, detail="Artwork not found")
+    except Exception as e:
+        raise HTTPException(status_code=404, detail="Artwork not found")
+
+
+@router.get(
+    "/art/land/{backdrop_file}/{logo_file:path}",
+    summary="Landscape Artwork with Logo",
+    description="Returns landscape artwork with logo and dark gradients.",
+)
+async def get_art_land_with_logo(
+    backdrop_file: str, logo_file: str, b: str | None = None, p: int | None = None, o: int | None = None
+):
+    if b and b not in ("new_ep", "new", "dub", "top10"):
+        raise HTTPException(status_code=404, detail="Invalid badge")
+    try:
+        data = await render_landscape(backdrop_file, logo_file, badge=b, provider_id=p, oscar=bool(o))
+        return Response(
+            content=data,
+            media_type="image/jpeg",
+            headers={"Cache-Control": "public, max-age=2592000, immutable"},
+        )
+    except (ArtworkNotFound, ValueError):
+        raise HTTPException(status_code=404, detail="Artwork not found")
+    except Exception as e:
+        raise HTTPException(status_code=404, detail="Artwork not found")
+
+
+@router.get(
+    "/art/anim/{media_type}/{filename:path}",
+    summary="Animated Artwork",
+    description="Returns animated backdrop or poster in WebP or GIF format.",
+)
+async def get_art_anim(media_type: str, filename: str, kind: str | None = None):
+    try:
+        parts = filename.strip("/").split("/")
+        if len(parts) == 2 and media_type in ("poster", "backdrop"):
+            actual_kind = media_type
+            actual_type = parts[0]
+            actual_file = parts[1]
+        else:
+            actual_kind = kind or "backdrop"
+            actual_type = media_type
+            actual_file = parts[-1]
+
+        if "." not in actual_file:
+            raise HTTPException(status_code=404, detail="Invalid filename")
+        tmdb_id, ext = actual_file.rsplit(".", 1)
+        data, mime = await render_animation(actual_type, tmdb_id, ext, kind=actual_kind)
+        return Response(
+            content=data,
+            media_type=mime,
+            headers={"Cache-Control": "public, max-age=2592000, immutable"},
+        )
+    except (ArtworkNotFound, ValueError):
+        raise HTTPException(status_code=404, detail="Artwork not found")
+    except Exception as e:
+        raise HTTPException(status_code=404, detail="Artwork not found")
diff --git a/comet/api/endpoints/catalog.py b/comet/api/endpoints/catalog.py
new file mode 100644
index 0000000..58fb1e5
--- /dev/null
+++ b/comet/api/endpoints/catalog.py
@@ -0,0 +1,240 @@
+import urllib.parse
+from fastapi import APIRouter, Request
+from fastapi.responses import JSONResponse
+
+from comet.core.config_validation import config_check, is_kids_request, is_personal_request
+from comet.core.logger import logger, log_swallowed
+from comet.core.models import settings
+from comet.services.catalogs import get_catalog
+
+router = APIRouter()
+
+_PROGRESS_CACHE: dict = {"ts": 0.0, "map": {}}
+
+
+async def _progress_map() -> dict:
+    """imdb -> (porcentagem, minutos que faltam) do que está pela metade no histórico do Stremio (cache 5 min)."""
+    import time as _t
+    if _t.time() - _PROGRESS_CACHE["ts"] < 300:
+        return _PROGRESS_CACHE["map"]
+    out = {}
+    try:
+        from comet.services.stremio_library import get_stremio_library
+        key = getattr(settings, "STREMIO_AUTH_KEY", None)
+        for it in (await get_stremio_library(key) if key else []) or []:
+            st = it.get("state") or {}
+            off, dur = st.get("timeOffset") or 0, st.get("duration") or 0
+            iid = it.get("_id") or it.get("id")
+            if iid and dur and 0.03 < off / dur < 0.95:
+                out[iid] = (int(off * 100 / dur), max(1, int((dur - off) / 60000)))
+    except Exception:
+        out = _PROGRESS_CACHE["map"]
+    _PROGRESS_CACHE.update(ts=_t.time(), map=out)
+    return out
+
+
+async def _pt_fix(metas: list, media_type: str) -> list:
+    """Título brasileiro e sinopse em PT em toda fileira (PT_TEXT=False desliga)."""
+    if not metas or not getattr(settings, "PT_TEXT", True):
+        return metas
+    try:
+        from comet.services.pt_text import fix_metas
+
+        return await fix_metas(metas, media_type)
+    except Exception as e:
+        log_swallowed("catalog._pt_fix", e)
+        return metas
+
+
+def _status_ribbons(metas: list, catalog_id: str) -> list:
+    """Faixa de estado na capa: HOJE / AMANHÃ / EM N DIAS / NOVO (semana) e DUBLADO CHEGOU."""
+    import re as _re
+    from datetime import date as _date
+    from comet.services.live_art_svc import live_url
+    today = _date.today()
+    out = []
+    for m in metas or []:
+        m = dict(m)
+        st = None
+        if catalog_id == "comet_dubready":
+            st = "DUBLADO CHEGOU"
+        else:
+            mm = _re.search(r"(\d{2})/(\d{2})", (m.get("description") or "").split("\n")[0])
+            if mm:
+                try:
+                    d = _date(today.year, int(mm.group(2)), int(mm.group(1)))
+                    diff = (d - today).days
+                    st = "HOJE" if diff == 0 else "AMANHÃ" if diff == 1 else f"EM {diff} DIAS" if diff > 1 else "NOVO"
+                except ValueError:
+                    st = None
+        if st and m.get("poster"):
+            # a faixa ocupa o canto do selo de texto: tira o selo antigo (?b=) da capa de origem
+            import urllib.parse as _up
+            _u = _up.urlsplit(m["poster"])
+            _q = [(k, v) for k, v in _up.parse_qsl(_u.query) if k != "b"]
+            _src = _up.urlunsplit((_u.scheme, _u.netloc, _u.path, _up.urlencode(_q), ""))
+            m["poster"] = live_url(_src, status=st)
+        out.append(m)
+    return out
+
+
+async def _apply_live_covers(metas: list, catalog_id: str, is_personal: bool) -> list:
+    from comet.services.live_art_svc import live_url, tv_url
+    if catalog_id in ("comet_livetv", "comet_livehome"):
+        out = []
+        for m in metas or []:
+            m = dict(m)
+            if str(m.get("id", "")).startswith("cometlive:"):
+                m["poster"] = tv_url(m["id"])
+                m["posterShape"] = "landscape"
+            out.append(m)
+        return out
+    if not is_personal:
+        return metas
+    if catalog_id in ("comet_week", "comet_dubready"):
+        metas = _status_ribbons(metas, catalog_id)
+    prog = await _progress_map()
+    if not prog:
+        return metas
+    out = []
+    for m in metas or []:
+        p = prog.get(m.get("id"))
+        if p and m.get("poster"):
+            m = dict(m)
+            m["poster"] = live_url(m["poster"], pct=p[0], minutes_left=p[1])
+        out.append(m)
+    return out
+
+
+@router.get(
+    "/catalog/{type}/{id}.json",
+    tags=["Stremio"],
+    summary="Catalog Provider",
+    description="Returns catalog metadata for the specified media.",
+)
+@router.get(
+    "/catalog/{type}/{id}/{extra}.json",
+    tags=["Stremio"],
+    summary="Catalog Provider",
+    description="Returns catalog metadata with extra parameters.",
+)
+@router.get(
+    "/{b64config}/catalog/{type}/{id}.json",
+    tags=["Stremio"],
+    summary="Catalog Provider",
+    description="Returns catalog metadata with configuration.",
+)
+@router.get(
+    "/{b64config}/catalog/{type}/{id}/{extra}.json",
+    tags=["Stremio"],
+    summary="Catalog Provider",
+    description="Returns catalog metadata with configuration and extra parameters.",
+)
+async def get_catalog_endpoint(
+    request: Request,
+    type: str,
+    id: str,
+    extra: str | None = None,
+    b64config: str | None = None,
+):
+    if not settings.CATALOGS_ENABLED:
+        return JSONResponse(
+            content={"metas": []},
+            headers={"Cache-Control": "public, max-age=600"},
+        )
+
+    try:
+        if b64config:
+            config = config_check(b64config)
+            if not config:
+                return JSONResponse(
+                    content={"metas": []},
+                    headers={"Cache-Control": "public, max-age=600"},
+                )
+
+        extra_dict = {}
+        if extra:
+            parsed = urllib.parse.parse_qs(extra)
+            for k, v in parsed.items():
+                if v:
+                    extra_dict[k] = v[0]
+
+        for k, v in request.query_params.items():
+            if k not in extra_dict:
+                extra_dict[k] = v
+
+        base_url = (getattr(settings, "PUBLIC_BASE_URL", None) or f"{request.url.scheme}://{request.url.netloc}").rstrip("/")
+        kids = is_kids_request(b64config)
+        is_personal = is_personal_request(b64config)
+        if id in ("comet_livetv", "comet_livehome", "comet_radio") and b64config is not None and not is_personal and not kids:
+            return JSONResponse(
+                content={"metas": []},
+                headers={"Cache-Control": "public, max-age=600"},
+            )
+        from comet.services import row_groups as _row_groups
+        if _row_groups.is_group(id):
+            # fileira agrupada: o filtro escolhe o membro; sem filtro, rodízio do dia
+            id, extra_dict = _row_groups.resolve(id, type, extra_dict)
+        from comet.services import extra_rows as _extra_rows
+        if _extra_rows.is_extra_catalog(id):
+            # futebol, sessão da noite, Minha TV, retrospectiva: só no link pessoal (e Nuvio)
+            if not is_personal or kids:
+                return JSONResponse(content={"metas": []}, headers={"Cache-Control": "public, max-age=600"})
+            try:
+                _skip = int(extra_dict.get("skip", 0) or 0)
+            except (TypeError, ValueError):
+                _skip = 0
+            _base_tok = f"{base_url}/{b64config}" if b64config else base_url
+            return JSONResponse(
+                content={"metas": await _pt_fix(await _extra_rows.catalog(id, _base_tok, _skip), type)},
+                headers={"Cache-Control": "public, max-age=60"},
+            )
+        metas = await get_catalog(
+            media_type=type,
+            catalog_id=id,
+            extra=extra_dict,
+            base_url=base_url,
+            kids=kids,
+        )
+        if (
+            getattr(settings, "ROW_WARM", True)
+            and request.headers.get("x-forwarded-for")
+            and (is_personal or kids)
+            and b64config
+            and metas
+        ):
+            try:
+                from comet.services.row_warm import enqueue_catalog_row
+
+                enqueue_catalog_row(
+                    catalog_id=id,
+                    media_type=type,
+                    b64config=b64config,
+                    metas=metas,
+                )
+            except Exception as rw_err:
+                logger.debug(f"Erro ao enfileirar row warm: {rw_err}")
+        try:
+            from comet.services.omdb import oscar_won, _ensure_loaded as _omdb_load
+            await _omdb_load()
+            for _m in metas or []:
+                _p = _m.get("poster") or ""
+                if "/art/" in _p and "o=1" not in _p and oscar_won(_m.get("id")):
+                    _m["poster"] = _p + ("&" if "?" in _p else "?") + "o=1"
+        except Exception as _e:
+            log_swallowed("catalog.get_catalog_endpoint", _e)
+        try:
+            metas = await _apply_live_covers(metas, id, is_personal)
+        except Exception as _lc_err:
+            logger.debug(f"live covers: {_lc_err}")
+        metas = await _pt_fix(metas, type)
+        return JSONResponse(
+            content={"metas": metas},
+            headers={"Cache-Control": "public, max-age=600"},
+        )
+    except Exception as e:
+        logger.warning(f"Error handling catalog request: {type(e).__name__}")
+        return JSONResponse(
+            content={"metas": []},
+            headers={"Cache-Control": "public, max-age=600"},
+        )
diff --git a/comet/api/endpoints/live_routes.py b/comet/api/endpoints/live_routes.py
