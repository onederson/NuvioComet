+async def _fetch_week_items(
+    skip: int,
+    base_url: str = "",
+) -> list[dict]:
+    if skip >= 30:
+        return []
+
+    _ensure_imdb_map_loaded()
+    _ensure_landscape_map_loaded()
+
+    tz_br = datetime.timezone(datetime.timedelta(hours=-3))
+    now_br = datetime.datetime.now(tz_br)
+    today_br = now_br.date()
+    monday_br = today_br - datetime.timedelta(days=today_br.weekday())
+    sunday_br = monday_br + datetime.timedelta(days=6)
+
+    timeout = aiohttp.ClientTimeout(total=15.0)
+    async with aiohttp.ClientSession(timeout=timeout) as session:
+        tmdb = TMDBApi(session)
+        series_candidates: dict[str, tuple[str, dict]] = {}
+
+        # (a) Histórico últimos 90 dias
+        auth_key = getattr(settings, "STREMIO_AUTH_KEY", None)
+        if auth_key:
+            try:
+                from comet.services.stremio_library import get_stremio_library
+                library = await get_stremio_library(auth_key)
+                now_utc = datetime.datetime.now(datetime.timezone.utc)
+                for it in library:
+                    if it.get("type") != "series":
+                        continue
+                    mid = it.get("_id") or it.get("id")
+                    if not mid or not isinstance(mid, str) or not mid.startswith("tt"):
+                        continue
+                    lw = it.get("state", {}).get("lastWatched")
+                    if not lw:
+                        continue
+                    try:
+                        clean = str(lw).strip().replace("Z", "+00:00")
+                        dt = datetime.datetime.fromisoformat(clean)
+                        if dt.tzinfo is None:
+                            dt = dt.replace(tzinfo=datetime.timezone.utc)
+                        diff = (now_utc - dt).total_seconds() / 86400
+                        if 0 <= diff <= 90:
+                            series_candidates[mid] = (it.get("name") or "", {})
+                    except Exception as _e:
+                        log_swallowed("catalogs._fetch_week_items", _e)
+            except Exception as e:
+                logger.warning(f"Erro ao carregar historico para estreias da semana: {e}")
+
+        # (b) 30 mais populares do tv/on_the_air
+        try:
+            p1, p2 = await asyncio.gather(
+                tmdb._get_json("tv/on_the_air?language=pt-BR&page=1", "ota1"),
+                tmdb._get_json("tv/on_the_air?language=pt-BR&page=2", "ota2"),
