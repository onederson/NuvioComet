+# ---------------------------------------------------------------- chip (selo)
+Part = "str | tuple | Callable[[int], Image.Image]"
+
+
+def _chip(h: float, parts: Iterable, bg, fg=None, *, radius: float = 0.24, pad: float = 0.36,
+          gap: float = 0.22, fs: float = 0.5, narrow: bool = False, outline=None,
+          gloss: bool = True) -> Image.Image:
+    """Selo arredondado em 3x, reduzido com Lanczos.
+
+    parts: str (texto no fg), (texto, cor[, escala[, bold]]) ou callable(H)->RGBA
+    (icone desenhado na altura H do chip ja supersampled).
+    """
+    H = max(6, int(round(h * SS)))
+    bgc = _rgba(bg)
+    fgc = _rgba(fg) if fg is not None else _auto_fg(bgc)
+    font = _font(H * fs, True, narrow)
+    items = []
+    for p in parts:
+        if p is None or p == "":
+            continue
+        if isinstance(p, str):
+            items.append(("t", p, font.getlength(p), font, fgc))
+        elif isinstance(p, tuple):
+            txt, col = p[0], p[1]
+            sc = p[2] if len(p) > 2 else 1.0
+            bold = p[3] if len(p) > 3 else True
+            f = _font(H * fs * sc, bold, narrow)
+            items.append(("t", txt, f.getlength(txt), f, _rgba(col) if col is not None else fgc))
+        else:
+            im = p(H)
+            items.append(("i", im, im.width, None, None))
+    padx, gapx = H * pad, H * gap
+    W = int(round(2 * padx + sum(it[2] for it in items) + gapx * max(0, len(items) - 1)))
+    W = max(W, H)
+    tile = Image.new("RGBA", (W, H), (0, 0, 0, 0))
+    d = ImageDraw.Draw(tile)
+    r = H * radius
+    if outline is not None:
+        ow = max(1, round(H * 0.045))
+        d.rounded_rectangle((0, 0, W - 1, H - 1), radius=r, fill=_rgba(outline))
+        d.rounded_rectangle((ow, ow, W - 1 - ow, H - 1 - ow), radius=max(0, r - ow), fill=bgc)
+    else:
+        d.rounded_rectangle((0, 0, W - 1, H - 1), radius=r, fill=bgc)
+    if gloss and bgc[3] > 200:
+        shape = Image.new("L", (W, H), 0)
+        ImageDraw.Draw(shape).rounded_rectangle((0, 0, W - 1, H - 1), radius=r, fill=255)
+        g = _ramp_mask((W, H), 0, H * 0.62, 52, 0, horizontal=False)
+        hi = Image.new("RGBA", (W, H), (255, 255, 255, 0))
+        hi.putalpha(ImageChops.multiply(g, shape))
+        tile.alpha_composite(hi)
+        lo = _ramp_mask((W, H), H * 0.55, H, 0, 40, horizontal=False)
+        dk = Image.new("RGBA", (W, H), (0, 0, 0, 0))
+        dk.putalpha(ImageChops.multiply(lo, shape))
+        tile.alpha_composite(dk)
+    x = padx
+    for kind, obj, w, f, col in items:
+        if kind == "t":
+            d.text((x, H / 2 + _cap(f) / 2), obj, font=f, fill=col, anchor="ls")
+        else:
+            tile.alpha_composite(obj, (int(round(x)), int(round((H - obj.height) / 2))))
+        x += w + gapx
+    return tile.resize((max(1, round(W / SS)), max(1, round(h))), LANCZOS)
+
+
+def _fit_chip(h, parts, bg, maxw, **kw) -> Image.Image:
+    """Chip que cabe em maxw: tenta fonte normal, depois estreita, depois reduz."""
+    chip = _chip(h, parts, bg, **kw)
+    if chip.width <= maxw:
+        return chip
+    kw2 = dict(kw, narrow=True)
+    chip = _chip(h, parts, bg, **kw2)
+    if chip.width <= maxw:
+        return chip
+    return _chip(h * maxw / chip.width, parts, bg, **kw2)
+
+
+# ---------------------------------------------------------------- barra
+def _bar(w: float, h: float, fraction: float, fill=RED, track=(255, 255, 255, 70),
+         knob: bool = False) -> Image.Image:
+    W, H = max(2, int(round(w * SS))), max(2, int(round(h * SS)))
+    kh = H * 2.4 if knob else H
+    TH = int(round(kh))
+    tile = Image.new("RGBA", (W + (TH if knob else 0), TH), (0, 0, 0, 0))
+    d = ImageDraw.Draw(tile)
+    ox = TH / 2 if knob else 0
+    y0 = (TH - H) / 2
+    d.rounded_rectangle((ox, y0, ox + W - 1, y0 + H - 1), radius=H / 2, fill=_rgba(track))
+    fw = max(H, W * min(1.0, max(0.0, fraction)))
+    if fraction > 0:
+        d.rounded_rectangle((ox, y0, ox + fw - 1, y0 + H - 1), radius=H / 2, fill=_rgba(fill))
+    if knob:
+        kx = ox + fw
+        d.ellipse((kx - TH / 2, 0, kx + TH / 2 - 1, TH - 1), fill=(255, 255, 255, 255))
+    return tile.resize((max(1, round(tile.width / SS)), max(1, round(tile.height / SS))), LANCZOS)
+
+
+# =================================================================== 1
+def progress_overlay(card, fraction: float, minutes_left: int | None) -> Image.Image:
+    """Barra de progresso estilo Netflix + chip "faltam 23 min"."""
+    img = _load(card)
+    W, H = img.size
+    u = _unit(W, H)
+    m = 3.65 * u
+    _shade(img, _ramp_mask((W, H), H * 0.6, H, 0, 175, horizontal=False))
+    bh = 1.6 * u
+    bar = _bar(W - 2 * m, bh, fraction, track=(150, 150, 150, 150))
+    by = H - m * 0.9 - bar.height
+    _place(img, bar, m, by, shadow=0.5, blur=max(1, round(u)), dy=0)
+    if minutes_left is not None:
+        ch = 7.4 * u
+        chip = _chip(ch, [lambda H_: _clock(int(H_ * 0.46)), f"faltam {_fmt_minutes(minutes_left)}"],
+                     (0, 0, 0, 170), WHITE, fs=0.46, gap=0.2, pad=0.3, gloss=False, radius=0.5)
+        _place(img, chip, W - m - chip.width, by - 2.0 * u - chip.height, shadow=0.35)
+    return img.convert("RGB")
+
+
+# =================================================================== 2
+_AUTO_COLORS = [("DUBLAD", GREEN), ("HOJE", RED), ("AO VIVO", RED), ("AMANH", GOLD),
+                ("ESTREIA", PURPLE), ("NOVO", RED), ("FINAL", PURPLE)]
+
+
+def _status_parts(text: str):
+    raw = text
+    clean = _clean_text(text).upper()
+    icon = None
+    if "\U0001F1E7\U0001F1F7" in raw or "DUBLAD" in clean:
+        icon = lambda H_: _flag_br(int(H_ * 0.46))  # noqa: E731
+    elif clean.startswith("HOJE") or clean.startswith("AO VIVO"):
+        icon = lambda H_: _dot(int(H_ * 0.42))  # noqa: E731
+    elif clean.startswith("AMANH") or clean.startswith("ESTREIA"):
+        icon = None  # cor decide; desenhado abaixo com a cor do texto
+    return clean, icon
+
+
+def status_ribbon(card, text: str, color: str | None = None) -> Image.Image:
+    """Chip de estado no canto superior esquerdo (HOJE, AMANHA, DUBLADO CHEGOU...)."""
+    img = _load(card)
+    W, H = img.size
+    u = _unit(W, H)
+    m = 3.65 * u
+    clean, icon = _status_parts(text)
+    if not color:
+        color = next((c for k, c in _AUTO_COLORS if k in clean), RED)
+    bg = _rgba(color)
+    fg = _auto_fg(bg)
+    if icon is None and (clean.startswith("AMANH") or clean.startswith("ESTREIA")):
+        icon = lambda H_: _calendar(int(H_ * 0.44), fg)  # noqa: E731
+    parts = [icon, clean] if icon else [clean]
+    chip = _fit_chip(11 * u, parts, bg, W * 0.66, fg=fg, fs=0.47, pad=0.36 if icon else 0.4,
+                     gap=0.24)
+    _place(img, chip, m, m, shadow=0.45)
+    return img.convert("RGB")
+
+
+# =================================================================== 3
+def rating_chip(card, imdb: float | None, rt: int | None) -> Image.Image:
+    """Chip discreto de notas (IMDb e Rotten Tomatoes) no canto inferior direito."""
+    img = _load(card)
+    if imdb is None and rt is None:
+        return img.convert("RGB")
+    W, H = img.size
+    u = _unit(W, H)
+    m = 3.65 * u
+    parts: list = []
+    if imdb is not None:
+        parts += [lambda H_: _imdb_logo(int(H_ * 0.56)), _fmt_num(imdb)]
+    if imdb is not None and rt is not None:
+        parts.append(lambda H_: _vsep(H_))
+    if rt is not None:
+        rotten = rt < 60
+        parts += [lambda H_: _tomato(int(H_ * 0.56), rotten), f"{int(rt)}%"]
+    chip = _chip(8.6 * u, parts, (0, 0, 0, 153), WHITE, fs=0.47, gap=0.18, pad=0.26,
+                 radius=0.3, gloss=False)
+    _place(img, chip, W - m - chip.width, H - m - chip.height, shadow=0.3)
+    return img.convert("RGB")
+
