+def _uf_pattern() -> re.Pattern:
+    names = sorted(((norm(n), uf) for uf, (n, _) in UFS.items()), key=lambda x: -len(x[0]))
+    return re.compile(r"\b(" + "|".join(re.escape(n) for n, _ in names) + r")\b")
+
