+            ImageDraw.Draw(mask).rounded_rectangle((0, 0, right_w * 3 - 1, ph * 3 - 1), radius=60, fill=255)
+            mask = mask.resize((right_w, ph), la.LANCZOS)
+            p.putalpha(mask)
+            la._place(img, p, W - mx - right_w, 70, shadow=0.6)
+        except Exception as e:
+            logger.debug(f"recap: pôster: {type(e).__name__}")
+    return la.to_jpeg(img)
+
+
+# ───────────────────────── banco ─────────────────────────
+
+async def _ensure_tables() -> None:
+    global _tables_ready
+    if _tables_ready:
+        return
+    from comet.core.database import database
+    await database.execute(
+        """CREATE TABLE IF NOT EXISTS recap_plays (
+            day TEXT NOT NULL, media_id TEXT NOT NULL, imdb TEXT NOT NULL,
+            season INTEGER, episode INTEGER, is_pt INTEGER, first_ts BIGINT,
+            PRIMARY KEY (day, media_id))""")
+    await database.execute(
+        """CREATE TABLE IF NOT EXISTS recap_titles (
+            imdb TEXT PRIMARY KEY, kind TEXT, name TEXT, runtime_min INTEGER,
+            genres TEXT, poster_path TEXT)""")
+    await database.execute("CREATE TABLE IF NOT EXISTS recap_sent (key TEXT PRIMARY KEY)")
+    _tables_ready = True
+
+
+async def sync_plays() -> int:
+    """Copia o play_log para recap_plays (dedupe por dia + media_id). Devolve linhas novas lidas."""
+    from comet.core.database import database
+    await _ensure_tables()
+    r = await database.fetch_one("SELECT MAX(first_ts) AS m FROM recap_plays")
+    since = int((r["m"] if r and r["m"] else 0)) - 86400
+    rows = await database.fetch_all(
+        "SELECT ts, media_id, imdb, season, episode, is_pt FROM play_log WHERE ts > :s ORDER BY ts",
+        {"s": max(0, since)})
+    seen: dict[tuple, dict] = {}
+    for x in rows:
+        if not x["imdb"] or not x["media_id"]:
+            continue
+        k = (day_of(x["ts"]), x["media_id"])
+        if k not in seen:
+            seen[k] = {"day": k[0], "m": x["media_id"], "imdb": x["imdb"], "s": x["season"],
+                       "e": x["episode"], "pt": 1 if x["is_pt"] else 0, "ts": int(x["ts"])}
+    for v in seen.values():
+        await database.execute(
+            """INSERT INTO recap_plays (day, media_id, imdb, season, episode, is_pt, first_ts)
+               VALUES (:day, :m, :imdb, :s, :e, :pt, :ts) ON CONFLICT (day, media_id) DO NOTHING""", v)
+    return len(seen)
+
+
+async def _load_plays(key: str) -> list[dict]:
+    from comet.core.database import database
+    await _ensure_tables()
+    rows = await database.fetch_all(
+        "SELECT day, media_id, imdb, season, episode, is_pt FROM recap_plays WHERE day LIKE :p",
+        {"p": key + "%"})
+    return [{c: r[c] for c in ("day", "media_id", "imdb", "season", "episode", "is_pt")} for r in rows]
+
+
+async def _fetch_title(tmdb, imdb: str) -> dict | None:
+    """Metadados do TMDB para um imdb. None se a rede falhou (não guarda)."""
+    found = await tmdb._get_json(f"find/{imdb}?external_source=imdb_id&language=pt-BR", f"recap find {imdb}")
+    if not isinstance(found, dict):
+        return None
+    mv, tv = (found.get("movie_results") or []), (found.get("tv_results") or [])
+    if mv:
+        d = await tmdb._get_json(f"movie/{mv[0]['id']}?language=pt-BR", f"recap movie {imdb}")
+        if not isinstance(d, dict):
+            return None
+        return {"kind": "movie", "name": d.get("title") or mv[0].get("title") or imdb,
+                "runtime_min": d.get("runtime") or DEFAULT_MOVIE_MIN,
+                "genres": ",".join(g["name"] for g in d.get("genres") or []),
+                "poster_path": d.get("poster_path")}
+    if tv:
+        d = await tmdb._get_json(f"tv/{tv[0]['id']}?language=pt-BR", f"recap tv {imdb}")
+        if not isinstance(d, dict):
+            return None
+        rt = (d.get("last_episode_to_air") or {}).get("runtime")
+        if not rt:
+            ert = d.get("episode_run_time") or []
+            rt = ert[0] if ert else DEFAULT_EPISODE_MIN
+        return {"kind": "series", "name": d.get("name") or tv[0].get("name") or imdb,
+                "runtime_min": rt or DEFAULT_EPISODE_MIN,
+                "genres": ",".join(g["name"] for g in d.get("genres") or []),
+                "poster_path": d.get("poster_path")}
+    return {"kind": "", "name": imdb, "runtime_min": None, "genres": "", "poster_path": None}
+
+
+async def ensure_titles(imdbs: set[str]) -> dict[str, dict]:
+    from comet.core.database import database
+    from comet.metadata.tmdb import TMDBApi
+    await _ensure_tables()
+    out: dict[str, dict] = {}
+    if not imdbs:
+        return out
+    rows = await database.fetch_all("SELECT imdb, kind, name, runtime_min, genres, poster_path FROM recap_titles")
+    for r in rows:
+        out[r["imdb"]] = {c: r[c] for c in ("kind", "name", "runtime_min", "genres", "poster_path")}
+    missing = [i for i in imdbs if i not in out]
+    if missing:
+        sem = asyncio.Semaphore(4)
+        async with aiohttp.ClientSession(timeout=aiohttp.ClientTimeout(total=20)) as session:
+            tmdb = TMDBApi(session)
+
+            async def one(imdb: str):
+                async with sem:
+                    try:
+                        t = await _fetch_title(tmdb, imdb)
+                    except Exception as e:
+                        logger.debug(f"recap: título {imdb}: {type(e).__name__}")
+                        return
+                if t is None:
+                    return
+                out[imdb] = t
+                await database.execute(
+                    """INSERT INTO recap_titles (imdb, kind, name, runtime_min, genres, poster_path)
+                       VALUES (:i, :k, :n, :r, :g, :p) ON CONFLICT (imdb) DO NOTHING""",
+                    {"i": imdb, "k": t["kind"], "n": t["name"], "r": t["runtime_min"],
+                     "g": t["genres"], "p": t["poster_path"]})
+            await asyncio.gather(*(one(i) for i in missing))
+    return out
+
+
+_STATS_CACHE: dict[str, tuple[float, dict | None]] = {}
+
+
+async def get_stats(key: str) -> dict | None:
+    hit = _STATS_CACHE.get(key)
+    if hit and time.time() - hit[0] < 600:
+        return hit[1]
+    plays = await _load_plays(key)
+    st = None
+    if plays:
+        titles = await ensure_titles({p["imdb"] for p in plays})
+        st = compute_stats(plays, titles, key)
+    if st:  # vazio não vai para o cache: a 1ª sincronização pode chegar logo depois
+        _STATS_CACHE[key] = (time.time(), st)
+    return st
+
+
+async def available_keys() -> list[str]:
+    """Chaves da fileira que têm dados (mais recente primeiro; ano no fim)."""
+    global _AVAIL
+    from comet.core.database import database
+    await _ensure_tables()
+    keys = keys_for_row(now_local())
+    ok = []
+    for k in keys:
+        r = await database.fetch_one("SELECT 1 AS x FROM recap_plays WHERE day LIKE :p LIMIT 1", {"p": k + "%"})
+        if r:
+            ok.append(k)
+    _AVAIL = set(ok)
+    return ok
+
+
+async def _poster_bytes(path: str | None) -> bytes | None:
+    if not path:
+        return None
+    try:
+        async with aiohttp.ClientSession(timeout=aiohttp.ClientTimeout(total=15)) as s:
+            async with s.get(f"https://image.tmdb.org/t/p/w500{path}") as r:
+                if r.status == 200:
+                    return await r.read()
+    except Exception as e:
+        logger.debug(f"recap: pôster: {type(e).__name__}")
+    return None
+
+
+async def card_jpeg(key: str) -> bytes | None:
+    """Cartão com cache em disco de 6 h."""
+    if not valid_key(key):
+        return None
+    os.makedirs(CACHE_DIR, exist_ok=True)
+    p = os.path.join(CACHE_DIR, f"{key}.jpg")
+    try:
+        if os.path.exists(p) and time.time() - os.path.getmtime(p) < CACHE_TTL:
+            with open(p, "rb") as f:
+                return f.read()
+    except OSError:
+        pass
+    st = await get_stats(key)
+    if not st:
+        return None
+    poster = await _poster_bytes(st.get("poster_path"))
+    jpg = await asyncio.to_thread(render_card, st, poster)
+    try:
+        with open(p + ".tmp", "wb") as f:
+            f.write(jpg)
+        os.replace(p + ".tmp", p)
+    except OSError:
+        pass
+    return jpg
+
+
+# ───────────────────────── fileira / meta ─────────────────────────
+
+def row_visible(catalog_id: str) -> bool:
+    return True  # catalog_items consulta o banco (available_keys) e devolve vazio se não houver dados
+
+
+def _poster_url(key: str) -> str:
+    base = (getattr(settings, "PUBLIC_BASE_URL", None) or "").rstrip("/")
+    return f"{base}/art/recap/{key}.jpg?v={now_local().strftime('%Y%m%d')}"
+
+
+async def catalog_items(catalog_id: str, base_url: str) -> list[dict]:
+    items = []
+    for k in await available_keys():
+        st = await get_stats(k)
+        if not st:
+            continue
+        items.append({
+            "id": ID_PREFIX + k, "type": "movie",
+            "name": key_label(k) + (" (até agora)" if st["partial"] else ""),
+            "poster": _poster_url(k), "posterShape": "landscape",
+            "description": summary_text(st),
+        })
+    return items
+
+
+async def get_meta(media_id: str, base_url: str) -> dict | None:
+    if not media_id.startswith(ID_PREFIX):
+        return None
+    key = media_id[len(ID_PREFIX):]
+    if not valid_key(key):
+        return None
+    st = await get_stats(key)
+    if not st:
+        return None
+    url = _poster_url(key)
+    return {
+        "id": media_id, "type": "movie", "name": "🎁 " + key_label(key),
+        "poster": url, "posterShape": "landscape", "background": url, "logo": url,
+        "description": summary_text(st),
+    }
+
+
+async def get_streams(media_id: str, base_url: str) -> list[dict] | None:
+    return [] if media_id.startswith(ID_PREFIX) else None
+
+
+@router.get("/art/recap/{key}.jpg", include_in_schema=False)
+async def art_recap(key: str):
+    jpg = await card_jpeg(key)
+    if not jpg:
+        raise HTTPException(404)
+    return Response(jpg, media_type="image/jpeg", headers={"Cache-Control": "public, max-age=900"})
+
+
+# ───────────────────────── Telegram ─────────────────────────
+
+async def _send_card(key: str, intro: str = "") -> bool:
+    from comet.services.telegram_bot import send_telegram_file
+    st = await get_stats(key)
+    if not st:
+        return False
+    jpg = await card_jpeg(key)
+    if not jpg:
+        return False
+    os.makedirs(CACHE_DIR, exist_ok=True)
+    p = os.path.join(CACHE_DIR, f"{key}.jpg")
+    return await send_telegram_file(p, (intro + summary_text(st)), photo=True)
+
+
+async def handle_command(text: str) -> str | None:
+    t = _norm(text)
+    if not (t == "/retrospectiva" or t.startswith("/retrospectiva ") or t.startswith("/retrospectiva@")):
+        return None
+    arg = text.split(None, 1)[1] if len(text.split(None, 1)) > 1 else ""
+    key = parse_key(arg, now_local())
+    if not key:
+        return "Não entendi o período. Ex.: /retrospectiva, /retrospectiva outubro, /retrospectiva 2026"
+    await sync_plays()
+    _STATS_CACHE.pop(key, None)
+    st = await get_stats(key)
+    if not st:
+        return f"Ainda não tenho nada assistido em {key_label(key)}."
+    if await _send_card(key):
+        return "🎁 Aí está a sua retrospectiva de " + key_label(key) + "."
+    return summary_text(st)
+
+
+async def status_lines() -> list[str]:
+    try:
+        from comet.core.database import database
+        await _ensure_tables()
+        r = await database.fetch_one("SELECT COUNT(*) AS n, MIN(day) AS d FROM recap_plays")
+        if r and r["n"]:
+            return [f"🎁 Retrospectiva: {r['n']} plays guardados desde {r['d']}"]
+    except Exception as _e:
+        log_swallowed("recap.status_lines", _e)
+    return []
+
+
+async def _was_sent(key: str) -> bool:
+    from comet.core.database import database
+    return bool(await database.fetch_one("SELECT 1 AS x FROM recap_sent WHERE key = :k", {"k": key}))
+
+
+async def _mark_sent(key: str) -> None:
+    from comet.core.database import database
+    await database.execute("INSERT INTO recap_sent (key) VALUES (:k) ON CONFLICT (key) DO NOTHING", {"k": key})
+
+
+async def _scheduled(now: datetime) -> None:
+    if now.day == 1 and now.hour >= 10:
+        key = key_prev_month(now)
+        if not await _was_sent(key):
+            await _mark_sent(key)
+            await _send_card(key, "🎁 Seu mês chegou!\n")
+    if now.month == 12 and now.day == 31 and now.hour >= 20:
+        key = str(now.year)
+        if not await _was_sent(key):
+            await _mark_sent(key)
+            await _send_card(key, "🎁 Seu ano chegou!\n")
+
+
+async def start_service() -> None:
+    global _last_sync
+    await asyncio.sleep(120)
+    while True:
+        try:
+            if time.time() - _last_sync >= SYNC_EVERY:
+                n = await sync_plays()
+                _last_sync = time.time()
+                logger.info(f"🎁 Retrospectiva: {n} plays sincronizados")
+            await available_keys()
+            await _scheduled(now_local())
+        except Exception as e:
+            logger.warning(f"recap: {type(e).__name__}: {e}")
+        await asyncio.sleep(300)
