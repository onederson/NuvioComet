+"""Maratonas na ordem certa + anime só a história (sem filler).
+
+IDs (reaproveitam o prefixo `cometsaga:`, que o app do usuário já conhece, então não exige reinstalar):
+- `cometsaga:o-<chave>`  → coleção em ordem cronológica (cada filme é um "episódio"; id do vídeo = tt do filme,
+                           e o stream/series/<tt> já é tratado como filme).
+- `cometsaga:c-<imdb>`   → anime sem filler (vídeos com os ids originais "tt:S:E", renumerados numa temporada).
+"""
+from __future__ import annotations
+
+import asyncio
+import time
+from datetime import date, timedelta
+
+import aiohttp
+
+from comet.core.logger import logger
+from comet.services.anime_canon import canon_stats, canon_videos
+from comet.services.watch_orders import WATCH_ORDERS
+
+_META_CACHE: dict[str, tuple[float, dict]] = {}
+_TTL = 24 * 3600
+_CINEMETA = "https://v3-cinemeta.strem.io/meta/series/{imdb}.json"
+
+
+def _poster(tt: str) -> str:
+    return f"https://images.metahub.space/poster/medium/{tt}/img"
+
+
+def _background(tt: str) -> str:
+    return f"https://images.metahub.space/background/medium/{tt}/img"
+
+
+# Animes com lista de filler conhecida (animefillerlist.com). Nome em PT-BR para exibir.
+CANON_ANIME = [
+    ("tt0388629", "One Piece"),
+    ("tt0409591", "Naruto"),
+    ("tt0988824", "Naruto Shippuden"),
+    ("tt0434665", "Bleach"),
+    ("tt6342474", "Boruto: Naruto Next Generations"),
+    ("tt1528406", "Fairy Tail"),
+    ("tt7441658", "Black Clover"),
+    ("tt0214341", "Dragon Ball Z"),
+]
+
+
+def _cached(key: str) -> dict | None:
+    hit = _META_CACHE.get(key)
+    if hit and time.time() - hit[0] < _TTL:
+        return hit[1]
+    return None
+
+
+def order_catalog_items() -> list[dict]:
+    items = []
+    for key, col in WATCH_ORDERS.items():
+        films = col["items"]
+        mid = films[len(films) // 2][0]
+        items.append({
+            "id": f"cometsaga:o-{key}",
+            "type": "series",
+            "name": col["name"],
+            "poster": _poster(films[0][0]),
+            "background": _background(mid),
+            "description": f"🍿 {len(films)} filmes na ordem da história.\n\n{col.get('description', '')}".strip(),
+            "releaseInfo": f"{len(films)} filmes",
+        })
+    return items
+
+
+def order_meta(key: str) -> dict | None:
+    col = WATCH_ORDERS.get(key)
+    if not col:
+        return None
+    films = col["items"]
+    base = date(2000, 1, 1)
+    videos = []
+    for n, item in enumerate(films, start=1):
+        tt, title = item[0], item[1]
+        when = item[2] if len(item) > 2 else ""
+        videos.append({
+            "id": tt,
+            "title": f"{n}. {title}",
+            "season": 1,
+            "episode": n,
+            # datas fictícias crescentes: alguns apps ordenam por data
+            "released": (base + timedelta(days=n)).isoformat() + "T00:00:00.000Z",
+            "thumbnail": _background(tt),
+            "overview": f"🕰️ Na história: {when}" if when else "",
+        })
+    return {
+        "id": f"cometsaga:o-{key}",
+        "type": "series",
+        "name": col["name"],
+        "poster": _poster(films[0][0]),
+        "background": _background(films[len(films) // 2][0]),
+        "description": f"🍿 Maratona na ordem da história: {len(films)} filmes.\n\n{col.get('description', '')}".strip(),
+        "releaseInfo": f"{len(films)} filmes",
+        "genres": ["Maratona"],
+        "videos": videos,
+    }
+
+
+def canon_catalog_items() -> list[dict]:
+    items = []
+    for imdb, name in CANON_ANIME:
+        items.append({
+            "id": f"cometsaga:c-{imdb}",
+            "type": "series",
+            "name": f"{name} · só a história",
+            "poster": _poster(imdb),
+            "background": _background(imdb),
+            "description": f"🎌 {name} sem os episódios filler, na ordem certa.",
+        })
+    return items
+
+
+async def canon_meta(imdb: str) -> dict | None:
+    key = f"c-{imdb}"
+    hit = _cached(key)
+    if hit:
+        return hit
+    name = dict(CANON_ANIME).get(imdb, "")
+    try:
+        async with aiohttp.ClientSession(timeout=aiohttp.ClientTimeout(total=20)) as s:
+            base = {}
+            try:  # meta em PT-BR que o Comet já monta (títulos e sinopses dos episódios em português)
+                from comet.services.meta_ptbr import get_meta_ptbr
+                base = await get_meta_ptbr("series", imdb) or {}
+            except Exception:
+                base = {}
+            if not base.get("videos"):
+                async with s.get(_CINEMETA.format(imdb=imdb)) as r:
+                    data = await r.json(content_type=None)
+                base = (data or {}).get("meta") or {}
+            videos = base.get("videos") or []
+            if not videos:
+                return None
+            from comet.services.anime_filler import get_anime_filler_map
+            filler_map = await get_anime_filler_map(imdb, base.get("name") or name, None, s)
+    except Exception as e:
+        logger.warning(f"Maratona canon {imdb}: {type(e).__name__}: {e}")
+        return None
+    if not filler_map:
+        return None
+    vids = canon_videos(videos, filler_map, keep_mixed=True)
+    st = canon_stats(videos, filler_map, keep_mixed=True)
+    removed = st.get("removed", st.get("removed_total", 0))
+    hours = st.get("hours_saved", 0)
+    meta = {
+        "id": f"cometsaga:c-{imdb}",
+        "type": "series",
+        "name": f"{name or base.get('name')} · só a história",
+        "poster": base.get("poster") or _poster(imdb),
+        "background": base.get("background") or _background(imdb),
+        "logo": base.get("logo"),
+        "description": (f"🎌 Só a história: {len(vids)} episódios, sem {removed} fillers "
+                        f"(~{hours:.0f} h a menos). Os episódios mistos ficam.\n\n{base.get('description') or ''}").strip(),
+        "genres": base.get("genres") or ["Anime"],
+        "releaseInfo": base.get("releaseInfo"),
+        "videos": vids,
+    }
+    _META_CACHE[key] = (time.time(), meta)
+    logger.info(f"🎌 Anime só a história {imdb}: {len(vids)} episódios, {removed} fillers fora")
+    return meta
+
+
+def _clean(obj):
+    """Tira campos vazios (None): o app do Stremio descarta a página inteira se achar logo/releaseInfo nulos."""
+    if isinstance(obj, dict):
+        return {k: _clean(v) for k, v in obj.items() if v is not None}
+    if isinstance(obj, list):
+        return [_clean(v) for v in obj if v is not None]
+    return obj
+
+
+async def get_marathon_meta(meta_id: str) -> dict | None:
+    meta = await _get_marathon_meta(meta_id)
+    return _clean(meta) if meta else None
+
+
+async def _get_marathon_meta(meta_id: str) -> dict | None:
+    rest = meta_id.split("cometsaga:", 1)[1]
+    if rest.startswith("o-"):
+        return order_meta(rest[2:])
+    if rest.startswith("c-"):
+        return await canon_meta(rest[2:])
+    if rest.startswith("w-"):
+        from comet.services.week_cards import week_meta
+        return await week_meta(rest[2:])
+    return None
+
+
+def is_marathon_id(meta_id: str) -> bool:
+    return meta_id.startswith(("cometsaga:o-", "cometsaga:c-", "cometsaga:w-"))
diff --git a/comet/services/media_info.py b/comet/services/media_info.py
new file mode 100644
index 0000000..c2e6079
--- /dev/null
+++ b/comet/services/media_info.py
@@ -0,0 +1,168 @@
+"""Qualidade de verdade: lê o cabeçalho do arquivo (MKV/MP4) e guarda o resumo (vídeo, HDR/DV, bitrate,
+faixas de áudio e qual é a padrão). Usa comet/services/media_probe.py (Python puro).
+
+- probe_full(url) -> (faixas_no_formato_antigo | None, resumo | None)   [um download só]
+- save_media / get_media_batch: tabela media_info (60 dias)
+"""
+from __future__ import annotations
+
+import json
+import re
+import time
+
+import aiohttp
+
+from comet.core.database import database
+from comet.core.logger import logger, log_swallowed
+from comet.services import media_probe
+
+_READY = False
+_HEAD = 4 * 1024 * 1024
+_LANG3 = {"pt": "por", "en": "eng", "ja": "jpn", "es": "spa", "fr": "fre", "it": "ita", "de": "ger", "ko": "kor"}
+
+
+async def _ensure() -> None:
+    global _READY
+    if _READY:
+        return
+    try:
+        await database.execute(
+            "CREATE TABLE IF NOT EXISTS media_info (info_hash TEXT, file_key TEXT, summary TEXT, probed_at INTEGER, "
+            "PRIMARY KEY (info_hash, file_key))"
+        )
+        await database.execute("DELETE FROM media_info WHERE probed_at < :c", {"c": int(time.time()) - 60 * 86400})
+    except Exception as e:
+        logger.debug(f"media_info: {e}")
+    _READY = True
+
+
+async def _get(session: aiohttp.ClientSession, url: str, start: int, end: int) -> tuple[bytes | None, int | None]:
+    headers = {"User-Agent": "ExoPlayerLib/2.19.1", "Range": f"bytes={start}-{end}"}
+    try:
+        async with session.get(url, headers=headers, allow_redirects=True,
+                               timeout=aiohttp.ClientTimeout(total=12)) as r:
+            if r.status not in (200, 206):
+                return None, None
+            total = None
+            m = re.search(r"/(\d+)$", r.headers.get("Content-Range", ""))
+            if m:
+                total = int(m.group(1))
+            want = end - start + 1
+            buf = bytearray()
+            async for chunk in r.content.iter_chunked(65536):
+                buf += chunk
+                if len(buf) >= want:
+                    break
+            return bytes(buf[:want]), total
+    except Exception as e:
+        logger.debug(f"media_info range {start}-{end}: {type(e).__name__}")
+        return None, None
+
+
+def _legacy_tracks(summary: dict) -> list[dict]:
+    """Faixas no formato que o audio_probe antigo grava (lang ISO-639-2, name, codec)."""
+    out = []
+    for a in summary.get("audio") or []:
+        lang = a.get("lang") or ""
+        out.append({
+            "lang": _LANG3.get(lang, lang),
+            "name": a.get("name") or "",
+            "codec": a.get("codec") or "",
+            "bcp47": "pt" if lang == "pt" else "",
+            "default": bool(a.get("default")),
+        })
+    return out
+
+
+async def probe_full(url: str) -> tuple[list[dict] | None, dict | None]:
+    if not url:
+        return None, None
+    try:
+        async with aiohttp.ClientSession() as s:
+            data, total = await _get(s, url, 0, _HEAD - 1)
+            if not data or len(data) < 8:
+                return None, None
+            probe = media_probe.parse_header(data)
+            for _ in range(2):  # no máx. 2 trechos extras (SeekHead / moov no fim)
+                if not probe or "need_range" not in probe:
+                    break
+                off, size = probe["need_range"]
+                if total and off >= total:
+                    break
+                extra, _t = await _get(s, url, off, off + size - 1)
+                if not extra:
+                    break
+                probe = media_probe.parse_header(data, extra)
+            if not probe or probe.get("need_range") or probe.get("moov_at_end") and not probe.get("tracks"):
+                return None, None
+            summary = media_probe.summarize(probe, total)
+            if not summary or not (summary.get("audio") or summary.get("video")):
+                return None, None
+            summary["file_size"] = total
+            for _a in summary.get("audio") or []:
+                _a.pop("children", None)
+                _a.pop("crc", None)
+            summary.pop("tracks_crc", None)
+            return _legacy_tracks(summary), summary
+    except Exception as e:
+        logger.debug(f"probe_full: {type(e).__name__}: {e}")
+        return None, None
+
+
+async def save_media(info_hash: str, file_key: str, summary: dict | None) -> None:
+    if not info_hash or not summary:
+        return
+    await _ensure()
+    try:
+        await database.execute(
+            "INSERT OR REPLACE INTO media_info (info_hash, file_key, summary, probed_at) VALUES (:h, :k, :s, :t)",
+            {"h": info_hash.lower(), "k": str(file_key), "s": json.dumps(summary, default=str), "t": int(time.time())},
+        )
+    except Exception as e:
+        logger.debug(f"save_media: {e}")
+
+
+async def get_media_batch(hashes: list[str]) -> dict[tuple[str, str], dict]:
+    await _ensure()
+    hs = sorted({h.lower() for h in hashes if h})
+    if not hs:
+        return {}
+    out = {}
+    try:
+        ph = ", ".join(f":h{i}" for i in range(len(hs)))
+        rows = await database.fetch_all(
+            f"SELECT info_hash, file_key, summary FROM media_info WHERE info_hash IN ({ph})",
+            {f"h{i}": h for i, h in enumerate(hs)},
+        )
+        for r in rows:
+            try:
+                out[(r["info_hash"], r["file_key"])] = json.loads(r["summary"])
+            except Exception as _e:
+                log_swallowed("media_info.get_media_batch", _e)
+    except Exception as e:
+        logger.debug(f"get_media_batch: {e}")
+    return out
+
+
+def lines_for(summary: dict) -> dict:
+    """Textos curtos para a lista de fontes: vídeo real, áudio (com a faixa padrão) e avisos."""
+    try:
+        lb = media_probe.labels(summary)
+    except Exception:
+        return {}
+    _aud = lb.get("audio")
+    if summary.get("_pt_auto") and _aud:
+        _pre = "🔊 " if _aud.startswith("🔊") else ""
+        _parts = [p.replace(" padrão", "").strip() for p in _aud.replace("🔊", "").split(" · ") if p.strip()]
+        _others = [p for p in _parts if not p.upper().startswith("PT")]
+        _aud = _pre + " · ".join(["PT"] + _others)
+    return {"video": lb.get("video"), "audio": _aud, "warnings": lb.get("warnings") or []}
+
+
+def pick_penalty(summary: dict | None) -> tuple[int, int]:
+    """(risco_de_tela, pt_nao_padrao) para a escolha do ▶ Assistir. Menor é melhor."""
+    if not summary:
+        return 0, 0
+    v = summary.get("video") or {}
+    risky = 1 if (v.get("dv_profile") == 5 or (v.get("hdr") == "DV" and v.get("dv_has_hdr10_fallback") is False)) else 0
+    return risky, 0
diff --git a/comet/services/media_probe.py b/comet/services/media_probe.py
new file mode 100644
index 0000000..2e6dd11
--- /dev/null
+++ b/comet/services/media_probe.py
@@ -0,0 +1,1034 @@
+"""Leitor de cabeçalho de vídeo (MKV/WebM e MP4) em Python puro.
+
+Lê os primeiros bytes de um arquivo (ex.: 4 MB via Range) e descobre o que ele
+realmente é: codec, resolução, profundidade de cor, HDR/Dolby Vision, faixas de
+áudio e legendas com idioma e flags.
+
+- parse_header(data, extra=None): dados brutos do contêiner, ou
+  {"need_range": (offset, tamanho)} quando falta um trecho do arquivo. Quem
+  chama busca esse trecho e chama de novo com extra=<bytes a partir do offset>.
+  MP4 com moov no fim devolve {"moov_at_end": True, ...}. Formato inválido: None.
+- summarize(probe, file_size): campos normalizados (codec, real_res_label, hdr,
+  bitrate, áudios com idioma normalizado, pt_audio, pt_is_default...).
+- labels(summary): textos curtos em PT-BR para mostrar ao usuário.
+- quality_score(summary): nota de qualidade real, para ordenar.
+"""
+from __future__ import annotations
+
+import math
+import struct
+
+# ---------------------------------------------------------------------------
+# IDs EBML / Matroska usados
+# ---------------------------------------------------------------------------
+EBML_MAGIC = b"\x1a\x45\xdf\xa3"
+ID_EBML = 0x1A45DFA3
+ID_DOCTYPE = 0x4282
+ID_SEGMENT = 0x18538067
+ID_SEEKHEAD = 0x114D9B74
+ID_SEEK = 0x4DBB
+ID_SEEKID = 0x53AB
+ID_SEEKPOS = 0x53AC
+ID_INFO = 0x1549A966
+ID_TIMECODESCALE = 0x2AD7B1
+ID_DURATION = 0x4489
+ID_TRACKS = 0x1654AE6B
+ID_TRACKENTRY = 0xAE
+ID_CLUSTER = 0x1F43B675
+ID_CRC32 = 0xBF
+
+ID_TRACKNUMBER = 0xD7
+ID_TRACKTYPE = 0x83
+ID_CODECID = 0x86
+ID_LANGUAGE = 0x22B59C
+ID_LANGUAGE_BCP47 = 0x22B59D
+ID_NAME = 0x536E
+ID_FLAGDEFAULT = 0x88
+ID_FLAGFORCED = 0x55AA
+ID_CODECPRIVATE = 0x63A2
+ID_VIDEO = 0xE0
+ID_PIXELWIDTH = 0xB0
+ID_PIXELHEIGHT = 0xBA
+ID_COLOUR = 0x55B0
+ID_MATRIX = 0x55B1
+ID_BITSPERCHANNEL = 0x55B2
+ID_TRANSFER = 0x55BA
+ID_PRIMARIES = 0x55BB
+ID_MASTERING = 0x55D0
+ID_MAXCLL = 0x55BC
+ID_AUDIO = 0xE1
+ID_SAMPLINGFREQ = 0xB5
+ID_CHANNELS = 0x9F
+ID_BITDEPTH = 0x6264
+ID_BLOCKADDMAPPING = 0x41E4
+ID_BLOCKADDIDTYPE = 0x41E7
+ID_BLOCKADDIDEXTRA = 0x41ED
+
+# FourCC dos registros Dolby Vision (como uint em BlockAddIDType)
+DV_FOURCCS = {int.from_bytes(t, "big") for t in (b"dvcC", b"dvvC", b"dvwC")}
+
+# Assinatura SEI do HDR10+ (ITU-T T.35: país B5, provedor 003C, código 0001, app 4)
+HDR10PLUS_SIG = b"\xb5\x00\x3c\x00\x01\x04"
+
+TRACK_TYPES = {1: "video", 2: "audio", 17: "subtitle"}
+
+# Janelas pedidas quando o tamanho exato do trecho ainda não é conhecido
+TRACKS_WINDOW = 512 * 1024
+MOOV_WINDOW = 2 * 1024 * 1024
+
+
+class _Truncated(Exception):
+    """Os bytes acabaram no meio de um elemento."""
+
+
+class _Invalid(Exception):
+    """Estrutura impossível (vint inválido etc.)."""
+
+
+# ---------------------------------------------------------------------------
+# API pública
+# ---------------------------------------------------------------------------
+def parse_header(data: bytes, extra: bytes | None = None) -> dict | None:
+    """Detecta o contêiner e lê o cabeçalho. Nunca levanta exceção.
+
+    `extra` são os bytes do trecho pedido em `need_range` (começando exatamente
+    no offset pedido). Sem dados suficientes nem como pedir mais: None.
+    """
+    try:
+        data = bytes(data or b"")
+        if data[:4] == EBML_MAGIC:
+            return _parse_mkv(data, extra)
+        if data[4:8] == b"ftyp":
+            return _parse_mp4(data, extra)
+    except Exception:  # noqa: BLE001 - contrato: nada escapa
+        return None
+    return None
+
+
+# ---------------------------------------------------------------------------
+# EBML de baixo nível
+# ---------------------------------------------------------------------------
+def _vint_len(first: int) -> int:
+    """Quantidade de bytes do vint pelo primeiro bit 1 (0 = inválido)."""
+    for n in range(8):
+        if first & (0x80 >> n):
+            return n + 1
+    return 0
+
+
+def _read_id(buf: bytes, pos: int) -> tuple[int, int]:
+    """Lê um ID EBML (1 a 4 bytes, marcador incluso no valor)."""
+    if pos >= len(buf):
+        raise _Truncated
+    n = _vint_len(buf[pos])
+    if n == 0 or n > 4:
+        raise _Invalid
+    if pos + n > len(buf):
+        raise _Truncated
+    return int.from_bytes(buf[pos:pos + n], "big"), pos + n
+
+
+def _read_size(buf: bytes, pos: int) -> tuple[int | None, int]:
+    """Lê um tamanho EBML (1 a 8 bytes). None = tamanho desconhecido."""
+    if pos >= len(buf):
+        raise _Truncated
+    n = _vint_len(buf[pos])
+    if n == 0:
+        raise _Invalid
+    if pos + n > len(buf):
+        raise _Truncated
+    mask = (1 << (7 * n)) - 1
+    value = int.from_bytes(buf[pos:pos + n], "big") & mask
+    return (None if value == mask else value), pos + n
+
+
+def _elements(buf: bytes, start: int, end: int):
+    """Percorre os filhos em [start, end): (id, ini_elem, ini_dados, fim_dados, completo).
+
+    Tamanho desconhecido vai até o fim do pai. `completo` diz se todos os bytes
+    do elemento estão em `buf`. Para em bytes truncados ou inválidos.
+    """
+    pos = start
+    while pos < end:
+        try:
+            eid, p = _read_id(buf, pos)
+            size, p = _read_size(buf, p)
+        except (_Truncated, _Invalid):
+            return
+        stop = end if size is None else p + size
+        yield eid, pos, p, min(stop, end), stop <= len(buf)
+        if size is None:
+            return  # sem tamanho não dá para pular; o chamador decide
+        pos = stop
+
+
+def _uint(b: bytes) -> int:
+    return int.from_bytes(b, "big") if b else 0
+
+
+def _float(b: bytes) -> float | None:
+    if len(b) == 4:
+        return struct.unpack(">f", b)[0]
+    if len(b) == 8:
+        return struct.unpack(">d", b)[0]
+    return 0.0 if not b else None
+
+
+def _text(b: bytes) -> str:
+    return b.split(b"\x00", 1)[0].decode("utf-8", "replace").strip()
+
+
+# ---------------------------------------------------------------------------
+# Matroska
+# ---------------------------------------------------------------------------
+def _parse_mkv(data: bytes, extra: bytes | None) -> dict | None:
+    """Lê EBML header + Segment até o primeiro Cluster."""
+    doctype, seg = "matroska", None
+    for eid, _, ds, de, _ in _elements(data, 0, len(data)):
+        if eid == ID_EBML:
+            doctype = _mkv_doctype(data, ds, de) or doctype
+        elif eid == ID_SEGMENT:
+            seg = (ds, de)
+            break
+    if seg is None:
+        return None
+    probe = {"container": "webm" if doctype == "webm" else "mkv",
+             "duration_s": None, "tracks": None}
+    need = _scan_segment(data, seg[0], seg[1], probe)
+    if probe["tracks"] is None and need is not None:
+        probe.pop("_cluster", None)
+        if extra:
+            need = _tracks_from_extra(extra, need[0], probe)
+        if probe["tracks"] is None:
+            return {"container": probe["container"], "need_range": need}
+    if probe["tracks"] is None:
+        return None
+    cluster = probe.pop("_cluster", None)
+    if cluster:
+        _scan_hevc_sei(data, cluster, probe["tracks"])
+    return probe
+
+
+def _mkv_doctype(buf: bytes, start: int, end: int) -> str | None:
+    for eid, _, ds, de, _ in _elements(buf, start, end):
+        if eid == ID_DOCTYPE:
+            return _text(buf[ds:de]).lower()
+    return None
+
+
+def _scan_segment(data: bytes, start: int, end: int, probe: dict):
+    """Lê Info/Tracks do Segment. Devolve (offset, tamanho) a buscar, ou None."""
+    seeks: dict[int, int] = {}
+    for eid, es, ds, de, complete in _elements(data, start, end):
+        if eid == ID_CLUSTER:
+            probe["_cluster"] = (ds, de)
+            break
+        if eid == ID_TRACKS:
+            if not complete:  # Tracks começa aqui mas não coube nos bytes lidos
+                size, _ = _read_size(data, _read_id(data, es)[1])
+                return es, TRACKS_WINDOW if size is None else (ds - es) + size
+            probe["tracks"] = _parse_tracks(data, ds, de, 0, probe)
+        elif not complete:
+            break  # elemento grande (ex.: anexos) passa do fim dos bytes lidos
+        elif eid == ID_INFO:
+            _parse_info(data, ds, de, probe)
+        elif eid == ID_SEEKHEAD:
+            seeks.update(_parse_seekhead(data, ds, de))
+    if probe["tracks"] is not None:
+        return None
+    pos = seeks.get(ID_TRACKS)
+    return None if pos is None else (start + pos, TRACKS_WINDOW)
+
+
+def _tracks_from_extra(extra: bytes, offset: int, probe: dict):
+    """Lê o Tracks a partir do trecho buscado; se ainda faltar, pede o tamanho exato."""
+    for eid, es, ds, de, complete in _elements(extra, 0, len(extra)):
+        if eid != ID_TRACKS:
+            return None
+        if not complete:
+            size, _ = _read_size(extra, _read_id(extra, 0)[1])
+            return None if size is None else (offset, (ds - es) + size)
+        probe["tracks"] = _parse_tracks(extra, ds, de, offset, probe)
+        return None
+    return None
+
+
+def _parse_info(buf: bytes, start: int, end: int, probe: dict) -> None:
+    scale, duration = 1_000_000, None
+    for eid, _, ds, de, _ in _elements(buf, start, end):
+        if eid == ID_TIMECODESCALE:
+            scale = _uint(buf[ds:de]) or scale
+        elif eid == ID_DURATION:
+            duration = _float(buf[ds:de])
+    if duration:
+        probe["duration_s"] = duration * scale / 1e9
+
+
+def _parse_seekhead(buf: bytes, start: int, end: int) -> dict[int, int]:
+    """SeekHead -> {id_do_elemento: posição relativa ao início dos dados do Segment}."""
+    out = {}
+    for eid, _, ds, de, _ in _elements(buf, start, end):
+        if eid != ID_SEEK:
+            continue
+        sid = spos = None
+        for cid, _, cs, ce, _ in _elements(buf, ds, de):
+            if cid == ID_SEEKID:
+                sid = _uint(buf[cs:ce])
+            elif cid == ID_SEEKPOS:
+                spos = _uint(buf[cs:ce])
+        if sid is not None and spos is not None:
+            out.setdefault(sid, spos)
+    return out
+
+
+def _parse_tracks(buf: bytes, start: int, end: int, base: int = 0,
+                  probe: dict | None = None) -> list[dict]:
+    """TrackEntries do Tracks. `base` = offset absoluto de buf[0] no arquivo.
+
+    Marca probe["tracks_has_crc"] se o Tracks ou algum TrackEntry tem CRC-32.
+    """
+    tracks, crc = [], None
+    for eid, _, ds, de, _ in _elements(buf, start, end):
+        if eid == ID_TRACKENTRY:
+            tracks.append(_parse_track_entry(buf, ds, de, base))
+        elif eid == ID_CRC32 and crc is None:
+            crc = _crc_info(ID_TRACKS, start, end, ds, de, base)
+    if probe is not None:
+        probe["tracks_crc"] = crc
+        probe["tracks_has_crc"] = crc is not None or any(t.get("crc") for t in tracks)
+    return tracks
+
+
+# Filhos de TrackEntry que são uint (para registrar o valor em "children")
+_TRACK_UINT_IDS = {0xD7, 0x73C5, 0x83, 0xB9, 0x88, 0x55AA, 0x55AB, 0x55AC, 0x55AD,
+                   0x55AE, 0x55AF, 0x9C, 0x6DE7, 0x6DF8, 0x23E383, 0x234E7A, 0x55EE,
+                   0xAA, 0x6FAB, 0x56AA, 0x56BB, 0x7446}
+
+
+def _crc_info(parent_id: int, pstart: int, pend: int, cds: int, cde: int, base: int) -> dict:
+    """CRC-32 (0xBF) de um pai: onde estão os 4 bytes e quais bytes ele cobre.
+
+    Pela especificação, o CRC cobre todos os bytes do pai depois do elemento CRC.
+    """
+    return {"parent_id": parent_id, "parent_data": (base + pstart, base + pend),
+            "offset": base + cds, "size": cde - cds, "covered": (base + cde, base + pend)}
+
+
+def _parse_track_entry(buf: bytes, start: int, end: int, base: int = 0) -> dict:
+    t = {"number": None, "type": "other", "codec_id": "", "lang": "eng",
+         "lang_bcp47": None, "name": "", "default": True, "forced": False,
+         "flag_default_value_offset": None, "flag_default_value_size": None,
+         "flag_forced_value_offset": None, "flag_forced_value_size": None,
+         "entry_data": (base + start, base + end), "children": [], "crc": None}
+    private = b""
+    for eid, es, ds, de, _ in _elements(buf, start, end):
+        raw = buf[ds:de]
+        t["children"].append({
+            "id": eid, "offset": base + es, "total": de - es, "data_offset": base + ds,
+            "data_size": de - ds,
+            "value": _uint(raw) if eid in _TRACK_UINT_IDS and de - ds <= 8 else None})
+        if eid == ID_CRC32 and t["crc"] is None:
+            t["crc"] = _crc_info(ID_TRACKENTRY, start, end, ds, de, base)
+        if eid == ID_TRACKNUMBER:
+            t["number"] = _uint(raw)
+        elif eid == ID_TRACKTYPE:
+            t["type"] = TRACK_TYPES.get(_uint(raw), "other")
+        elif eid == ID_CODECID:
+            t["codec_id"] = _text(raw)
+        elif eid == ID_LANGUAGE:
+            t["lang"] = _text(raw) or "eng"
+        elif eid == ID_LANGUAGE_BCP47:
+            t["lang_bcp47"] = _text(raw) or None
+        elif eid == ID_NAME:
+            t["name"] = _text(raw)
+        elif eid == ID_FLAGDEFAULT:
+            t["default"] = bool(_uint(raw))
+            t["flag_default_value_offset"], t["flag_default_value_size"] = base + ds, de - ds
+        elif eid == ID_FLAGFORCED:
+            t["forced"] = bool(_uint(raw))
+            t["flag_forced_value_offset"], t["flag_forced_value_size"] = base + ds, de - ds
+        elif eid == ID_CODECPRIVATE:
+            private = raw
+        elif eid == ID_VIDEO:
+            _parse_video(buf, ds, de, t)
+        elif eid == ID_AUDIO:
+            _parse_audio(buf, ds, de, t)
+        elif eid == ID_BLOCKADDMAPPING:
+            dv = _parse_block_add_mapping(buf, ds, de)
+            if dv:
+                t["dv"] = dv
+    if t["type"] == "video" and private:
+        t["private_bit_depth"] = _bit_depth_from_private(t["codec_id"], private)
+        if "HEVC" in t["codec_id"]:
+            t["nal_length_size"] = _hvcc_nal_length_size(private)
+    return t
+
+
+def _parse_video(buf: bytes, start: int, end: int, t: dict) -> None:
+    for eid, _, ds, de, _ in _elements(buf, start, end):
+        if eid == ID_PIXELWIDTH:
+            t["width"] = _uint(buf[ds:de])
+        elif eid == ID_PIXELHEIGHT:
+            t["height"] = _uint(buf[ds:de])
+        elif eid == ID_COLOUR:
+            t["colour"] = _parse_colour(buf, ds, de)
+
+
+def _parse_colour(buf: bytes, start: int, end: int) -> dict:
+    keys = {ID_MATRIX: "matrix", ID_BITSPERCHANNEL: "bits",
+            ID_TRANSFER: "transfer", ID_PRIMARIES: "primaries", ID_MAXCLL: "max_cll"}
+    c = {"mastering": False}
+    for eid, _, ds, de, _ in _elements(buf, start, end):
+        if eid in keys:
+            c[keys[eid]] = _uint(buf[ds:de])
+        elif eid == ID_MASTERING:
+            c["mastering"] = True
+    return c
+
+
+def _parse_audio(buf: bytes, start: int, end: int, t: dict) -> None:
+    t["channels"] = 1  # padrão do Matroska
+    for eid, _, ds, de, _ in _elements(buf, start, end):
+        if eid == ID_SAMPLINGFREQ:
+            t["sample_rate"] = _float(buf[ds:de])
+        elif eid == ID_CHANNELS:
+            t["channels"] = _uint(buf[ds:de])
+        elif eid == ID_BITDEPTH:
+            t["bit_depth"] = _uint(buf[ds:de])
+
+
+def _parse_block_add_mapping(buf: bytes, start: int, end: int) -> dict | None:
+    """BlockAdditionMapping com registro Dolby Vision (dvcC/dvvC)."""
+    kind, extra = None, b""
+    for eid, _, ds, de, _ in _elements(buf, start, end):
+        if eid == ID_BLOCKADDIDTYPE:
+            kind = _uint(buf[ds:de])
+        elif eid == ID_BLOCKADDIDEXTRA:
+            extra = buf[ds:de]
+    return parse_dv_config(extra) if kind in DV_FOURCCS else None
+
+
+def parse_dv_config(rec: bytes) -> dict | None:
+    """Decodifica o registro DOVIDecoderConfigurationRecord (dvcC/dvvC/dvwC)."""
+    if len(rec) < 5:
+        return None
+    bits = (rec[2] << 8) | rec[3]
+    return {
+        "version": (rec[0], rec[1]),
+        "profile": bits >> 9,
+        "level": (bits >> 3) & 0x3F,
+        "rpu": bool(bits & 4),
+        "el": bool(bits & 2),
+        "bl": bool(bits & 1),
+        "compat_id": rec[4] >> 4,
+    }
+
+
+def _bit_depth_from_private(codec_id: str, private: bytes) -> int | None:
+    """Profundidade de cor a partir do CodecPrivate (hvcC / avcC / av1C)."""
+    if "HEVC" in codec_id or codec_id.startswith("hvc"):
+        return _hvcc_bit_depth(private)
+    if "AVC" in codec_id or codec_id.startswith("avc"):
+        return _avcc_bit_depth(private)
+    if "AV1" in codec_id or codec_id.startswith("av01"):
+        return _av1c_bit_depth(private)
+    return None
+
+
+def _hvcc_nal_length_size(p: bytes) -> int:
+    """hvcC byte 21: lengthSizeMinusOne nos 2 bits baixos."""
+    return (p[21] & 3) + 1 if len(p) >= 23 and p[0] == 1 else 4
+
+
+def _hvcc_bit_depth(p: bytes) -> int | None:
+    # byte 17: bitDepthLumaMinus8 nos 3 bits baixos
+    return (p[17] & 7) + 8 if len(p) >= 23 and p[0] == 1 else None
+
+
+def _avcc_bit_depth(p: bytes) -> int | None:
+    """avcC: perfis High (100+) têm bit_depth após as listas SPS/PPS."""
+    if len(p) < 7 or p[0] != 1:
+        return None
+    profile, pos = p[1], 6
+    try:
+        for _ in range(p[5] & 0x1F):  # SPS
+            pos += 2 + int.from_bytes(p[pos:pos + 2], "big")
+        count = p[pos]
+        pos += 1
+        for _ in range(count):  # PPS
+            pos += 2 + int.from_bytes(p[pos:pos + 2], "big")
+        if profile in (100, 110, 122, 144) and pos + 2 <= len(p):
+            return (p[pos + 1] & 7) + 8
+    except IndexError:
+        pass
+    return {100: 8, 110: 10}.get(profile, 8 if profile < 100 else None)
+
+
+def _av1c_bit_depth(p: bytes) -> int | None:
+    if len(p) < 3:
+        return None
+    high, twelve = bool(p[2] & 0x40), bool(p[2] & 0x20)
+    return 12 if high and twelve else (10 if high else 8)
+
+
+# ---------------------------------------------------------------------------
+# Primeiro quadro HEVC: mensagens SEI (HDR10 sem Colour, HDR10+)
+# ---------------------------------------------------------------------------
+ID_SIMPLEBLOCK = 0xA3
+ID_BLOCKGROUP = 0xA0
+ID_BLOCK = 0xA1
+SEI_MASTERING = 137  # mastering_display_colour_volume (ST 2086)
+SEI_CLL = 144  # content_light_level_info
+SEI_T35 = 4  # user_data_registered_itu_t_t35 (HDR10+)
+MAX_BLOCKS_SCANNED = 8
+
+
+def _scan_hevc_sei(data: bytes, cluster: tuple[int, int], tracks: list[dict]) -> None:
+    """Lê as SEI dos primeiros blocos HEVC do 1º Cluster e anota em track["sei"]."""
+    hevc = {t["number"]: t for t in tracks
+            if t.get("type") == "video" and "HEVC" in t.get("codec_id", "")}
+    if not hevc:
+        return
+    seen = 0
+    for number, payload in _cluster_blocks(data, *cluster):
+        t = hevc.get(number)
+        if t is None:
+            continue
+        sei = t.setdefault("sei", {"mastering": False, "cll": False, "hdr10plus": False})
+        for kind, body in _sei_messages(payload, t.get("nal_length_size", 4)):
+            sei["mastering"] |= kind == SEI_MASTERING
+            sei["cll"] |= kind == SEI_CLL
+            sei["hdr10plus"] |= kind == SEI_T35 and body[:6] == HDR10PLUS_SIG
+        seen += 1
+        if seen >= MAX_BLOCKS_SCANNED:
+            return
+
+
+def _cluster_blocks(buf: bytes, start: int, end: int):
+    """(número_da_faixa, bytes_do_quadro) de SimpleBlock/Block sem lacing."""
+    for eid, _, ds, de, _ in _elements(buf, start, end):
+        if eid == ID_BLOCKGROUP:
+            inner = next(((s, e) for i, _, s, e, _ in _elements(buf, ds, de) if i == ID_BLOCK), None)
+            if not inner:
+                continue
+            ds, de = inner
+        elif eid != ID_SIMPLEBLOCK:
+            continue
+        try:
+            number, p = _read_size(buf, ds)  # número da faixa usa a codificação de tamanho
+        except (_Truncated, _Invalid):
+            return
+        if p + 3 <= de and not buf[p + 2] & 0x06:  # 2 bytes timecode + flags; sem lacing
+            yield number, buf[p + 3:de]
+
+
+def _sei_messages(frame: bytes, length_size: int):
+    """Percorre NALs (prefixados por tamanho) e devolve (tipo, corpo) das SEI prefixo."""
+    pos = 0
+    while pos + length_size <= len(frame):
+        size = int.from_bytes(frame[pos:pos + length_size], "big")
+        nal = frame[pos + length_size:pos + length_size + size]
+        pos += length_size + size
+        if len(nal) > 2 and (nal[0] >> 1) & 0x3F == 39:  # PREFIX_SEI_NUT
+            yield from _sei_payloads(_unescape(nal[2:]))
+
+
+def _unescape(b: bytes) -> bytes:
+    """Remove os bytes de prevenção de emulação (00 00 03 -> 00 00)."""
+    return b.replace(b"\x00\x00\x03", b"\x00\x00") if b"\x00\x00\x03" in b else b
+
+
+def _sei_payloads(rbsp: bytes):
+    pos = 0
+    while pos < len(rbsp) and rbsp[pos] != 0x80:  # 0x80 = rbsp_trailing_bits
+        kind = size = 0
+        while pos < len(rbsp) and rbsp[pos] == 0xFF:
+            kind, pos = kind + 255, pos + 1
+        if pos >= len(rbsp):
+            return
+        kind, pos = kind + rbsp[pos], pos + 1
+        while pos < len(rbsp) and rbsp[pos] == 0xFF:
+            size, pos = size + 255, pos + 1
+        if pos >= len(rbsp):
+            return
+        size, pos = size + rbsp[pos], pos + 1
+        yield kind, rbsp[pos:pos + size]
+        pos += size
+
+
+# ---------------------------------------------------------------------------
+# MP4 / ISO BMFF
+# ---------------------------------------------------------------------------
+def _boxes(buf: bytes, start: int, end: int):
+    """Percorre caixas: (tipo, ini_caixa, ini_dados, fim, completa). Para em lixo."""
+    pos = start
+    while pos + 8 <= end:
+        size = int.from_bytes(buf[pos:pos + 4], "big")
+        kind = buf[pos + 4:pos + 8].decode("latin-1")
+        hdr = 8
+        if size == 1:
+            if pos + 16 > len(buf):
+                return
+            size, hdr = int.from_bytes(buf[pos + 8:pos + 16], "big"), 16
+        elif size == 0:
+            size = end - pos
+        if size < hdr:
+            return
+        stop = pos + size
+        yield kind, pos, pos + hdr, min(stop, end), stop <= len(buf)
+        pos = stop
+
+
+def _child(buf: bytes, start: int, end: int, kind: str):
+    for k, _, ds, de, _ in _boxes(buf, start, end):
+        if k == kind:
+            return ds, de
+    return None
+
+
+def _parse_mp4(data: bytes, extra: bytes | None) -> dict | None:
+    """Acha o moov no topo; sem ele, sinaliza moov no fim / pede o trecho."""
+    for kind, bs, ds, de, complete in _boxes(data, 0, len(data)):
+        if kind == "moov":
+            if complete:
+                return _parse_moov(data, ds, de)
+            return _mp4_need(extra, bs, (de - bs) if de > bs else MOOV_WINDOW, False)
+        if not complete:  # ex.: mdat gigante antes do moov
+            stop = bs + int.from_bytes(data[bs:bs + 4], "big")
+            if data[bs:bs + 4] == b"\x00\x00\x00\x01":
+                stop = bs + int.from_bytes(data[bs + 8:bs + 16], "big")
+            return _mp4_need(extra, stop, MOOV_WINDOW, True)
+    return {"container": "mp4", "moov_at_end": True}
+
+
+def _mp4_need(extra: bytes | None, offset: int, size: int, at_end: bool) -> dict | None:
+    """Usa `extra` (bytes a partir de `offset`) ou pede esse trecho."""
+    if extra:
+        for kind, _, ds, de, complete in _boxes(extra, 0, len(extra)):
+            if kind != "moov":
+                break
+            if complete:
+                return _parse_moov(extra, ds, de)
+            full = int.from_bytes(extra[:4], "big")
+            if extra[:4] == b"\x00\x00\x00\x01":
+                full = int.from_bytes(extra[8:16], "big")
+            return {"container": "mp4", "moov_at_end": at_end, "need_range": (offset, full)}
+    out = {"container": "mp4", "need_range": (offset, size)}
+    if at_end:
+        out["moov_at_end"] = True
+    return out
+
+
+def _full_box_version(buf: bytes, ds: int) -> int:
+    return buf[ds] if ds < len(buf) else 0
+
+
+def _parse_moov(buf: bytes, start: int, end: int) -> dict:
+    probe = {"container": "mp4", "duration_s": None, "tracks": []}
+    mvhd = _child(buf, start, end, "mvhd")
+    if mvhd:
+        probe["duration_s"] = _mp4_duration(buf, mvhd[0])
+    for kind, _, ds, de, _ in _boxes(buf, start, end):
+        if kind == "trak":
+            t = _parse_trak(buf, ds, de)
+            if t:
+                probe["tracks"].append(t)
+    return probe
+
+
+def _mp4_duration(buf: bytes, ds: int) -> float | None:
+    """mvhd/mdhd: timescale e duração (versão 0 = 32 bits, 1 = 64 bits)."""
+    if _full_box_version(buf, ds) == 1:
+        scale = int.from_bytes(buf[ds + 20:ds + 24], "big")
+        dur = int.from_bytes(buf[ds + 24:ds + 32], "big")
+    else:
+        scale = int.from_bytes(buf[ds + 12:ds + 16], "big")
+        dur = int.from_bytes(buf[ds + 16:ds + 20], "big")
+    return dur / scale if scale else None
+
+
+def _mp4_lang(buf: bytes, ds: int) -> str:
+    """mdhd: idioma ISO-639-2 empacotado em 15 bits (3 x 5 bits + 0x60)."""
+    off = ds + (28 if _full_box_version(buf, ds) == 1 else 20)
+    packed = int.from_bytes(buf[off:off + 2], "big") & 0x7FFF
+    if not packed:
+        return "und"
+    return "".join(chr(((packed >> s) & 0x1F) + 0x60) for s in (10, 5, 0))
+
+
+def _parse_trak(buf: bytes, start: int, end: int) -> dict | None:
+    mdia = _child(buf, start, end, "mdia")
+    if not mdia:
+        return None
+    t = {"number": None, "type": "other", "codec_id": "", "lang": "und",
+         "lang_bcp47": None, "name": "", "default": True, "forced": False}
+    tkhd = _child(buf, start, end, "tkhd")
+    if tkhd:
+        ds = tkhd[0]
+        t["default"] = bool(int.from_bytes(buf[ds + 1:ds + 4], "big") & 1)  # track_enabled
+        t["number"] = int.from_bytes(buf[ds + (20 if buf[ds] == 1 else 12):][:4], "big")
+    hdlr = _child(buf, *mdia, "hdlr")
+    if hdlr:
+        ds, de = hdlr
+        handler = buf[ds + 8:ds + 12].decode("latin-1")
+        t["type"] = {"vide": "video", "soun": "audio", "subt": "subtitle",
+                     "sbtl": "subtitle", "text": "subtitle"}.get(handler, "other")
+        t["name"] = _text(buf[ds + 24:de])
+    mdhd = _child(buf, *mdia, "mdhd")
+    if mdhd:
+        t["lang"] = _mp4_lang(buf, mdhd[0])
+    stsd = _find_path(buf, *mdia, ("minf", "stbl", "stsd"))
+    if stsd:
+        _parse_stsd(buf, stsd[0] + 8, stsd[1], t)  # pula version/flags + contagem
+    return t
+
+
+def _find_path(buf: bytes, start: int, end: int, path) -> tuple[int, int] | None:
+    rng = (start, end)
+    for kind in path:
+        rng = _child(buf, *rng, kind)
+        if not rng:
+            return None
+    return rng
+
+
+def _parse_stsd(buf: bytes, start: int, end: int, t: dict) -> None:
+    """Primeira sample entry: formato e detalhes por tipo de faixa."""
+    for kind, _, ds, de, _ in _boxes(buf, start, end):
+        t["codec_id"] = kind
+        if t["type"] == "video":
+            _parse_visual_entry(buf, ds, de, t)
+        elif t["type"] == "audio":
+            _parse_audio_entry(buf, ds, de, t)
+        return
+
+
+def _parse_visual_entry(buf: bytes, ds: int, de: int, t: dict) -> None:
+    # 6 reservados + 2 dref + 16 pre_defined/reservados, depois largura/altura
+    t["width"] = int.from_bytes(buf[ds + 24:ds + 26], "big")
+    t["height"] = int.from_bytes(buf[ds + 26:ds + 28], "big")
+    for kind, _, cs, ce, _ in _boxes(buf, ds + 78, de):
+        body = buf[cs:ce]
+        if kind in ("dvcC", "dvvC", "dvwC"):
+            dv = parse_dv_config(body)
+            if dv:
+                t["dv"] = dv
+        elif kind in ("hvcC", "avcC", "av1C"):
+            t["private_bit_depth"] = _bit_depth_from_private(t["codec_id"], body)
+        elif kind == "colr" and body[:4] in (b"nclx", b"nclc") and len(body) >= 10:
+            t["colour"] = {"primaries": int.from_bytes(body[4:6], "big"),
+                           "transfer": int.from_bytes(body[6:8], "big"),
+                           "matrix": int.from_bytes(body[8:10], "big"),
+                           "mastering": False}
+        elif kind == "mdcv":
+            t.setdefault("colour", {})["mastering"] = True
+
+
+def _parse_audio_entry(buf: bytes, ds: int, de: int, t: dict) -> None:
+    version = int.from_bytes(buf[ds + 8:ds + 10], "big")  # QuickTime v1/v2
+    t["channels"] = int.from_bytes(buf[ds + 16:ds + 18], "big")
+    t["sample_rate"] = int.from_bytes(buf[ds + 24:ds + 26], "big")
+    children = ds + 28 + {1: 16, 2: 36}.get(version, 0)
+    esds = _child(buf, children, de, "esds")
+    if esds:
+        t["object_type"] = _esds_object_type(buf[esds[0]:esds[1]])
+
+
+def _esds_object_type(b: bytes) -> int | None:
+    """esds: objectTypeIndication do DecoderConfigDescriptor (0x40 AAC, 0x6B MP3)."""
+    pos = 4  # version/flags
+    try:
+        while pos < len(b):
+            tag = b[pos]
+            pos += 1
+            size = 0
+            for _ in range(4):  # tamanho em 7 bits por byte
+                c = b[pos]
+                pos += 1
+                size = (size << 7) | (c & 0x7F)
+                if not c & 0x80:
+                    break
+            if tag == 0x03:  # ES_Descriptor: id(2) + flags(1) + opcionais
+                flags = b[pos + 2]
+                pos += 3 + (2 if flags & 0x80 else 0) + (2 if flags & 0x20 else 0)
+                if flags & 0x40:
+                    pos += 1 + b[pos]
+            elif tag == 0x04:
+                return b[pos]
+            else:
+                pos += size
+    except IndexError:
+        pass
+    return None
+
+
+# ---------------------------------------------------------------------------
+# Normalização
+# ---------------------------------------------------------------------------
+_VIDEO_CODECS = [
+    (("V_MPEG4/ISO/AVC", "avc1", "avc3"), "h264"),
+    (("V_MPEGH/ISO/HEVC", "hvc1", "hev1", "dvh1", "dvhe"), "hevc"),
+    (("V_AV1", "av01", "dav1"), "av1"),
+    (("V_VP9", "vp09"), "vp9"),
+    (("V_MPEG2", "mp2v"), "mpeg2"),
+]
+_AUDIO_CODECS = {
+    "A_AC3": "ac3", "ac-3": "ac3", "A_EAC3": "eac3", "ec-3": "eac3",
+    "A_DTS": "dts", "dtsc": "dts", "A_DTS/EXPRESS": "dts-hd", "A_DTS/LOSSLESS": "dts-hd",
+    "dtsh": "dts-hd", "dtsl": "dts-hd", "dtse": "dts-hd", "dtsx": "dts-hd",
+    "A_TRUEHD": "truehd", "mlpa": "truehd", "A_OPUS": "opus", "Opus": "opus",
+    "A_FLAC": "flac", "fLaC": "flac", "A_MPEG/L3": "mp3", ".mp3": "mp3",
+}
+_SUB_CODECS = {
+    "S_TEXT/UTF8": "srt", "S_TEXT/ASS": "ass", "S_TEXT/SSA": "ass", "S_ASS": "ass",
+    "S_SSA": "ass", "S_HDMV/PGS": "pgs", "S_VOBSUB": "vobsub", "S_TEXT/WEBVTT": "webvtt",
+    "S_DVBSUB": "dvbsub", "tx3g": "tx3g", "wvtt": "webvtt", "stpp": "ttml",
+}
+_LANGS = {"por": "pt", "pob": "pt", "pt": "pt", "pb": "pt", "eng": "en", "en": "en",
+          "jpn": "ja", "ja": "ja", "spa": "es", "es": "es"}
+_PT_WORDS = ("portugu", "dublad", "brasil", "brazil")
+
+
+def _video_codec(cid: str) -> str:
+    for ids, name in _VIDEO_CODECS:
+        if any(cid.startswith(i) for i in ids):
+            return name
+    return "outro"
+
+
+def _audio_codec(t: dict) -> str:
+    cid, name = t.get("codec_id", ""), t.get("name", "").lower()
+    if cid.startswith("A_AAC") or (cid == "mp4a" and t.get("object_type") in (None, 0x40, 0x66, 0x67, 0x68)):
+        return "aac"
+    if cid == "mp4a" and t.get("object_type") in (0x69, 0x6B):
+        return "mp3"
+    codec = _AUDIO_CODECS.get(cid, "outro")
+    if codec == "dts" and any(w in name for w in ("dts-hd", "dts hd", "dts:x", "dts-x", " ma ", "master audio")):
+        codec = "dts-hd"
+    return codec
+
+
+def norm_lang(code: str | None, name: str = "") -> str:
+    """Idioma curto: 'pt' para por/pob/pt-BR ou nome com portugu/dublad/brasil."""
+    low = (name or "").lower()
+    if any(w in low for w in _PT_WORDS):
+        return "pt"
+    primary = (code or "und").lower().replace("_", "-").split("-")[0] or "und"
+    return _LANGS.get(primary, primary)
+
+
+def _track_lang(t: dict) -> str:
+    return norm_lang(t.get("lang_bcp47") or t.get("lang"), t.get("name", ""))
+
+
+def _hdr_kind(t: dict, codec: str, bit_depth: int | None) -> str | None:
+    """SDR/HDR10/HDR10+/HLG/DV pelo que o arquivo declara; None se não dá para saber.
+
+    Ordem: registro Dolby Vision > Colour/colr (transfer 16 = PQ, 18 = HLG) >
+    SEI do 1º quadro HEVC (mastering display = HDR10) > 8 bits = SDR.
+    """
+    if t.get("dv"):
+        return "DV"
+    sei = t.get("sei") or {}
+    plus = "HDR10+" if sei.get("hdr10plus") else "HDR10"
+    transfer = (t.get("colour") or {}).get("transfer")
+    if transfer == 16:
+        return plus
+    if transfer == 18:
+        return "HLG"
+    if transfer is not None and transfer != 2:  # 2 = "não especificado"
+        return "SDR"
+    if sei.get("mastering") or sei.get("hdr10plus"):
+        return plus
+    if codec in ("h264", "mpeg2") or bit_depth == 8:
+        return "SDR"  # 8 bits sem metadado de cor: na prática SDR
+    return None
+
+
+def _res_label(width: int | None) -> str | None:
+    if not width:
+        return None
+    if width >= 3200:
+        return "4K"
+    if width >= 1700:
+        return "1080p"
+    if width >= 1200:
+        return "720p"
+    return "SD"
+
+
+def _summarize_video(t: dict | None) -> dict | None:
+    if not t:
+        return None
+    codec = _video_codec(t.get("codec_id", ""))
+    colour = t.get("colour") or {}
+    bit_depth = colour.get("bits") or t.get("private_bit_depth")
+    dv = t.get("dv") or {}
+    profile, compat = dv.get("profile"), dv.get("compat_id")
+    fallback = None
+    if dv:
+        fallback = profile != 5 and compat in (1, 6)
+    return {
+        "codec": codec, "width": t.get("width"), "height": t.get("height"),
+        "bit_depth": bit_depth, "hdr": _hdr_kind(t, codec, bit_depth),
+        "hdr10plus": bool((t.get("sei") or {}).get("hdr10plus")),
+        "dv_profile": profile, "dv_compat_id": compat,
+        "dv_has_hdr10_fallback": fallback, "real_res_label": _res_label(t.get("width")),
+    }
+
+
+def _summarize_audio(t: dict) -> dict:
+    codec, name = _audio_codec(t), t.get("name", "")
+    return {"codec": codec, "channels": t.get("channels"), "lang": _track_lang(t),
+            "default": bool(t.get("default")), "name": name,
+            "atmos": codec in ("truehd", "eac3") and "atmos" in name.lower(),
+            "number": t.get("number"), "forced": bool(t.get("forced")),
+            "flag_default_offset": t.get("flag_default_value_offset"),
+            "flag_default_size": t.get("flag_default_value_size"),
+            "flag_forced_offset": t.get("flag_forced_value_offset"),
+            "flag_forced_size": t.get("flag_forced_value_size"),
+            "children": t.get("children") or [], "crc": t.get("crc")}
+
+
+def _summarize_sub(t: dict) -> dict:
+    cid = t.get("codec_id", "")
+    return {"lang": _track_lang(t), "forced": bool(t.get("forced")),
+            "default": bool(t.get("default")), "codec": _SUB_CODECS.get(cid, cid.lower() or "outro")}
+
+
+def summarize(probe: dict, file_size: int | None = None) -> dict:
+    """Campos normalizados a partir do resultado de parse_header."""
+    tracks = (probe or {}).get("tracks") or []
+    videos = [t for t in tracks if t.get("type") == "video"]
+    duration = (probe or {}).get("duration_s")
+    audio = [_summarize_audio(t) for t in tracks if t.get("type") == "audio"]
+    playing = next((a for a in audio if a["default"]), audio[0] if audio else None)
+    bitrate = None
+    if file_size and duration and duration > 0:
+        bitrate = round(file_size * 8 / duration / 1e6, 2)
+    return {
+        "container": (probe or {}).get("container"),
+        "duration_s": round(duration, 3) if duration else None,
+        "video": _summarize_video(videos[0] if videos else None),
+        "bitrate_mbps": bitrate,
+        "audio": audio,
+        "subtitles": [_summarize_sub(t) for t in tracks if t.get("type") == "subtitle"],
+        "pt_audio": any(a["lang"] == "pt" for a in audio),
+        "pt_is_default": bool(playing and playing["lang"] == "pt"),
+        "first_audio_lang": audio[0]["lang"] if audio else None,
+        "tracks_has_crc": bool((probe or {}).get("tracks_has_crc")),
+        "tracks_crc": (probe or {}).get("tracks_crc"),
+    }
+
+
+# ---------------------------------------------------------------------------
+# Textos para o usuário
+# ---------------------------------------------------------------------------
+_CODEC_NAMES = {"h264": "H.264", "hevc": "HEVC", "av1": "AV1", "vp9": "VP9", "mpeg2": "MPEG-2"}
+_HARD_AUDIO = {"truehd": "TrueHD", "dts": "DTS", "dts-hd": "DTS-HD"}
+
+
+def _fmt_mbps(v: float) -> str:
+    return f"{v:.0f}" if v >= 10 else f"{v:.1f}".replace(".", ",")
+
+
+def _video_label(s: dict) -> str:
+    v = s.get("video") or {}
+    if not v:
+        return ""
+    parts = []
+    if v.get("real_res_label"):
+        parts.append(v["real_res_label"])
+    codec = _CODEC_NAMES.get(v.get("codec"), "?")
+    parts.append(f"{codec} {v['bit_depth']}-bit" if v.get("bit_depth") else codec)
+    if v.get("hdr") == "DV":
+        dv = f"DV {v['dv_profile']}"
+        if v.get("dv_profile") == 8 and v.get("dv_compat_id") is not None:
+            dv += f".{v['dv_compat_id']}"
+        parts.append(dv + (" · HDR10+" if v.get("hdr10plus") else ""))
+    elif v.get("hdr") and v["hdr"] != "SDR":
+        parts.append(v["hdr"])
+    if s.get("bitrate_mbps"):
+        parts.append(f"{_fmt_mbps(s['bitrate_mbps'])} Mbps")
+    return " · ".join(parts)
+
+
+def _audio_label(s: dict) -> str:
+    audio = s.get("audio") or []
+    if not audio:
+        return ""
+    playing = next((a for a in audio if a["default"]), audio[0])
+    langs = [playing["lang"]] + [a["lang"] for a in audio if a["lang"] != playing["lang"]]
+    names = list(dict.fromkeys("?" if l == "und" else l.upper() for l in langs))
+    return "🔊 " + " · ".join([f"{names[0]} padrão"] + names[1:])
+
+
+def _warnings(s: dict) -> list[str]:
+    out = []
+    v = s.get("video") or {}
+    if v.get("dv_profile") == 5:
+        out.append("DV perfil 5: cores erradas em TV sem Dolby Vision")
+    audio = s.get("audio") or []
+    if audio:
+        playing = next((a for a in audio if a["default"]), audio[0])
+        first_pt = next((a for a in audio if a["lang"] == "pt"), None)
+        for codec in dict.fromkeys(a["codec"] for a in (playing, first_pt) if a):
+            if codec in _HARD_AUDIO:
+                out.append(f"Som {_HARD_AUDIO[codec]}: muitas TVs não tocam")
+        if not s.get("pt_audio"):
+            out.append("Sem áudio em português")
+    br = s.get("bitrate_mbps")
+    if v.get("real_res_label") == "4K" and br and br < 8:
+        out.append(f"4K com só {_fmt_mbps(br)} Mbps: pode ser upscale ou muito comprimido")
+    return out
+
+
+def labels(summary: dict) -> dict:
+    """{'video': '4K · HEVC 10-bit · HDR10 · 18 Mbps', 'audio': '🔊 PT padrão · EN', 'warnings': [...]}"""
+    return {"video": _video_label(summary), "audio": _audio_label(summary),
+            "warnings": _warnings(summary)}
+
+
+# ---------------------------------------------------------------------------
+# Nota de qualidade
+# ---------------------------------------------------------------------------
+_RES_BASE = {"4K": 4.0, "1080p": 3.0, "720p": 2.0, "SD": 1.0}
+# Bitrate de referência "bom" em equivalente H.264 (Mbps)
+_REF_MBPS = {"4K": 40.0, "1080p": 10.0, "720p": 5.0, "SD": 2.5}
+# Eficiência do codec relativa ao H.264
+_CODEC_EFF = {"h264": 1.0, "hevc": 1.6, "av1": 2.0, "vp9": 1.5, "mpeg2": 0.5, "outro": 1.0}
+_HDR_BONUS = {"HDR10": 0.5, "HLG": 0.5, "HDR10+": 0.6, "DV": 0.6}
+
+
+def quality_score(summary: dict) -> float:
+    """Nota de qualidade REAL da imagem (maior = melhor). Sem vídeo: 0.
+
+    nota = base_res + termo_bitrate + bônus_bits + bônus_hdr - penalidade_upscale
+
+    - base_res pela largura real: 4K=4, 1080p=3, 720p=2, SD=1.
+    - termo_bitrate = clamp(log2(efetivo / referência), -2, +0.5), onde
+      efetivo = bitrate_mbps * eficiência do codec (H.264 1,0; HEVC 1,6; AV1 2,0;
+      VP9 1,5; MPEG-2 0,5) e referência = 40 (4K), 10 (1080p), 5 (720p), 2,5 (SD).
+      Cada metade do bitrate de referência custa 1 ponto. Bitrate desconhecido: 0.
+    - bônus_bits: +0,3 se bit_depth >= 10.
+    - bônus_hdr: HDR10/HLG +0,5; HDR10+/DV +0,6 (compatibilidade, como DV perfil 5
+      em TV sem DV, NÃO entra aqui — veja labels()['warnings']).
+    - penalidade_upscale: -1,0 se "4K" com bitrate < 8 Mbps (suspeito de upscale).
+    Ex.: 4K HEVC 10-bit HDR10 a 18 Mbps = 4 + log2(28,8/40) + 0,3 + 0,5 ≈ 4,33;
+    1080p H.264 8-bit a 10 Mbps = 3,0; 4K HEVC a 6 Mbps ≈ 4 - 2 + 0,3 - 1 = 1,3.
+    """
+    v = (summary or {}).get("video") or {}
+    res = v.get("real_res_label")
+    if not res:
+        return 0.0
+    score = _RES_BASE[res]
+    br = summary.get("bitrate_mbps")
+    if br and br > 0:
+        eff = br * _CODEC_EFF.get(v.get("codec"), 1.0)
+        score += max(-2.0, min(0.5, math.log2(eff / _REF_MBPS[res])))
+        if res == "4K" and br < 8:
+            score -= 1.0
+    if (v.get("bit_depth") or 0) >= 10:
+        score += 0.3
+    score += _HDR_BONUS.get(v.get("hdr"), 0.0)
+    return round(score, 3)
