+# =================================================================== 7
+_BADGES = {
+    "DUB": ("DUB", GREEN, "flag"), "DUBLADO": ("DUB", GREEN, "flag"),
+    "FILLER": ("FILLER", IMDB_YELLOW, None), "FINAL": ("FINAL", PURPLE, None),
+    "ESTREIA": ("ESTREIA", RED, None), "NOVO": ("NOVO", RED, None),
+    "LEG": ("LEG", (30, 30, 36), None), "4K": ("4K", (30, 30, 36), None),
+}
+
+
+def episode_thumb(thumb, badges: list[str], rating: float | None, watched: bool,
+                  size=(780, 439)) -> bytes:
+    """Miniatura de episodio com selos empilhados, nota e estado "visto"."""
+    W, H = size
+    u = _unit(W, H)
+    m = 3.65 * u
+    img = _cover(_load(thumb), (W, H))
+    if watched:
+        gray = img.convert("L").convert("RGBA")
+        img = Image.blend(img, gray, 0.45)
+        _shade(img, Image.new("L", (W, H), 120))
+    _shade(img, _ramp_mask((W, H), 0, H * 0.32, 110, 0, horizontal=False))
+
+    bh = 7.4 * u
+    y = m
+    for b in badges or []:
+        key = _clean_text(str(b)).upper()
+        label, color, icon = _BADGES.get(key, (key, (30, 30, 36), None))
+        if "\U0001F1E7\U0001F1F7" in str(b):
+            icon = "flag"
+        parts = [lambda H_: _flag_br(int(H_ * 0.48))] if icon == "flag" else []
+        parts.append(label)
+        chip = _chip(bh, parts, color, fs=0.5, pad=0.34, gap=0.2, radius=0.26)
+        _place(img, chip, m, y, shadow=0.4)
+        y += bh + 1.5 * u
+    if rating is not None:
+        chip = _chip(bh, [lambda H_: _star(int(H_ * 0.5)), _fmt_num(float(rating))], (0, 0, 0, 160),
+                     WHITE, fs=0.5, pad=0.3, gap=0.18, radius=0.26, gloss=False)
+        _place(img, chip, W - m - chip.width, m, shadow=0.35)
+    if watched:
+        chip = _chip(12 * u, [lambda H_: _check(int(H_ * 0.6), WHITE, GREEN), "VISTO"], (0, 0, 0, 175),
+                     WHITE, fs=0.42, pad=0.24, gap=0.22, radius=0.5, gloss=False)
+        _place(img, chip, (W - chip.width) / 2, (H - chip.height) / 2, shadow=0.45)
+        bar = _bar(W - 2 * m, 1.3 * u, 1.0, track=(150, 150, 150, 150))
+        _place(img, bar, m, H - m * 0.9 - bar.height)
+    return to_jpeg(img)
