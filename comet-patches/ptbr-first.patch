+SLIM_EXCLUDE = {
+    "torrents", "debrid_availability", "download_links_cache", "media_metadata_cache",
+    "imdb_title_lookup", "anime_entries", "anime_ids", "anime_mapping_state",
+    "dmm_entries", "dmm_ingested_files", "background_scraper_items",
+    "background_scraper_runs", "background_scraper_episodes", "metrics_cache",
+    "active_connections", "bandwidth_stats", "series_episode_index",
+    "series_episode_index_refresh", "debrid_account_magnets",
+}
+SLIM_MAX_BYTES = 20 * 1024 * 1024
+
+HELP = (
+    "/backup — faz um backup agora\n"
+    "/saude — temperatura, bateria e disco do A71\n"
+    "/fontes — fontes de busca e quais estão fora\n"
+    "/versao — se há versão nova do Comet original"
+)
+
+_state: dict | None = None
+_backup_lock = asyncio.Lock()
