+# =================================================================== 4
+def _initials(name: str) -> str:
+    ws = [w for w in _clean_text(name).replace("-", " ").split() if w[:1].isalnum()]
+    if not ws:
+        return "?"
+    if len(ws) == 1:
+        return ws[0][:2].upper()
+    return (ws[0][0] + ws[-1][0]).upper()
+
+
+def tv_guide_card(logo, channel_name: str, now_title: str, now_start: datetime, now_end: datetime,
+                  next_title: str | None, next_start: datetime | None, now: datetime,
+                  size=(780, 439)) -> bytes:
+    """Capa de canal ao vivo: logo, AGORA + programa, progresso, DEPOIS."""
+    W, H = size
+    u = _unit(W, H)
+    m = 6.0 * u
+    logo_im = _load(logo) if logo is not None else None
+    accent = _dominant(logo_im) if logo_im is not None else _hue_color(channel_name)
+    img = _corner_gradient((W, H), (24, 28, 42), (14, 16, 26), (12, 14, 22), (6, 7, 11))
+    side = min(W * 0.30, H - 2 * m)
+    px, py = m, (H - side) / 2
+    _glow(img, px + side / 2, H / 2, side * 0.95, side * 0.85, accent, 120)
+    _glow(img, W * 0.9, -H * 0.1, W * 0.35, H * 0.4, RED, 40)
+
+    # painel de vidro com o logo
+    S = SS
+    panel = Image.new("RGBA", (int(side * S), int(side * S)), (0, 0, 0, 0))
+    ImageDraw.Draw(panel).rounded_rectangle((0, 0, panel.width - 1, panel.height - 1),
+                                            radius=side * S * 0.12, fill=(255, 255, 255, 22),
+                                            outline=(255, 255, 255, 46), width=max(1, round(S * u * 0.3)))
+    panel = panel.resize((int(side), int(side)), LANCZOS)
+    _place(img, panel, px, py, shadow=0.35)
+    if logo_im is not None:
+        lg = _contain(logo_im, (int(side * 0.7), int(side * 0.7)))
+        _place(img, lg, px + (side - lg.width) / 2, py + (side - lg.height) / 2, shadow=0.35,
+               blur=max(1, round(u * 1.5)))
+    else:
+        name = _clean_text(channel_name) or "TV"
+        fsz = side * 0.2
+        while True:
+            f = _font(fsz, True)
+            lines = _wrap(name, f, side * 0.82, 3)
+            if (all(f.getlength(ln) <= side * 0.82 for ln in lines) and "…" not in "".join(lines)) \
+                    or fsz < side * 0.09:
+                break
+            fsz *= 0.9
+        lh = fsz * 1.12
+        y = py + side / 2 - lh * len(lines) / 2 + lh / 2 + _cap(f) / 2
+        for ln in lines:
+            _text(img, px + side / 2, y, ln, f, WHITE, anchor="ms", shadow=0.4)
+            y += lh
+
+    x0, x1 = px + side + 6.5 * u, W - m
+    cw = x1 - x0
+    # AO VIVO no canto
+    live = _chip(7.6 * u, [lambda H_: _dot(int(H_ * 0.42)), "AO VIVO"], RED, WHITE, fs=0.46,
+                 pad=0.32, gap=0.2)
+    _place(img, live, W - m - live.width, m, shadow=0.4)
+    f_lab = _font(3.9 * u, True)
+    lab_base = m + live.height / 2 + _cap(f_lab) / 2
+    _text(img, x0, lab_base, "AGORA", f_lab, (232, 76, 84), tracking=0.9 * u, shadow=0)
+
+    # bloco central: titulo, barra, horarios
+    ttl = _clean_text(now_title) or "Programação"
+    for tsz in (9.0, 8.2, 7.4):
+        f_title = _font(tsz * u, True)
+        lines = _wrap(ttl, f_title, cw, 2)
+        if "…" not in "".join(lines):
+            break
+    lh = f_title.size * 1.14
+    bar_h = 1.7 * u
+    f_time = _font(4.3 * u, True)
+    f_time_r = _font(4.3 * u, False)
+    block_h = _cap(f_title) + lh * (len(lines) - 1) + 4.6 * u + bar_h * 2.4 + 3.4 * u + _cap(f_time)
+    top_lim = lab_base + 3.5 * u
+    div_y = H - m - 9.5 * u
+    y = top_lim + max(0.0, (div_y - 4 * u - top_lim - block_h) / 2)
+    y += _cap(f_title)
+    for ln in lines:
+        _text(img, x0, y, ln, f_title, WHITE, shadow=0.5)
+        y += lh
+    y -= lh
+    dur = max(1.0, (now_end - now_start).total_seconds())
+    frac = (now - now_start).total_seconds() / dur
+    bar = _bar(cw, bar_h, frac, track=(255, 255, 255, 46), knob=True)
+    by = y + 4.6 * u
+    _place(img, bar, x0 - (bar.width - cw) / 2, by)
+    tb = by + bar.height + 3.4 * u + _cap(f_time)
+    left_min = max(0, int(math.ceil((now_end - now).total_seconds() / 60)))
+    _text(img, x0, tb, f"faltam {_fmt_minutes(left_min)}", f_time, WHITE, shadow=0)
+    _text(img, x1, tb, f"até {now_end:%H:%M}", f_time_r, (170, 176, 192), anchor="rs", shadow=0)
+
+    # DEPOIS
+    _hline(img, x0, x1, div_y, (255, 255, 255, 34), max(1, round(u * 0.25)))
+    if next_title:
+        f_nl = _font(3.6 * u, True)
+        f_nx = _font(4.6 * u, False)
+        nb = H - m - 1.2 * u
+        _text(img, x0, nb, "DEPOIS", f_nl, (150, 156, 172), tracking=0.8 * u, shadow=0)
+        nx = x0 + _tlen("DEPOIS", f_nl, 0.8 * u) + 2.4 * u
+        when = f"{next_start:%H:%M}" if next_start else ""
+        if when:
+            fb = _font(4.6 * u, True)
+            _text(img, nx, nb, when, fb, WHITE, shadow=0)
+            nx += fb.getlength(when) + 1.4 * u
+            _text(img, nx, nb, "·", f_nx, (150, 156, 172), shadow=0)
+            nx += f_nx.getlength("·") + 1.4 * u
+        _text(img, nx, nb, _ellipsize(_clean_text(next_title), f_nx, x1 - nx), f_nx,
+              (214, 218, 228), shadow=0)
+    return to_jpeg(img)
+
+
+# =================================================================== 5
+def week_day_card(day_label: str, date_label: str, items: list[dict], size=(780, 439)) -> bytes:
+    """Cartao de agenda de um dia: QUARTA 05/11 + ate 4 lancamentos."""
+    W, H = size
+    u = _unit(W, H)
+    m = 6.0 * u
+    any_today = any(it.get("today") for it in items)
+    accent = RED if any_today else GOLD
+    img = _corner_gradient((W, H), (30, 30, 38), (18, 18, 24), (14, 14, 19), (8, 8, 11))
+    _glow(img, 0, 0, W * 0.45, H * 0.55, accent, 70 if any_today else 45)
+
+    f_day = _font(10.0 * u, True)
+    f_date = _font(6.0 * u, False)
+    base = m + _cap(f_day)
+    # barrinha de destaque
+    bw = 1.2 * u
+    acc = Image.new("RGBA", (int(bw * SS), int(_cap(f_day) * SS)), (0, 0, 0, 0))
+    ImageDraw.Draw(acc).rounded_rectangle((0, 0, acc.width - 1, acc.height - 1), radius=bw * SS / 2,
+                                          fill=_rgba(accent))
+    acc = acc.resize((max(1, round(bw)), _cap(f_day)), LANCZOS)
+    _comp(img, acc, m, m)
+    xd = m + bw + 3.0 * u
+    day = _clean_text(day_label).upper()
+    _text(img, xd, base, day, f_day, WHITE, tracking=0.35 * u, shadow=0.3)
+    xd += _tlen(day, f_day, 0.35 * u) + 2.8 * u
+    _text(img, xd, base, _clean_text(date_label), f_date, _rgba(accent) if any_today else (190, 170, 110),
+          shadow=0)
+    n = len(items)
+    f_cnt = _font(4.0 * u, False)
+    cnt = f"{n} lançamento" + ("s" if n != 1 else "") if n else "sem lançamentos"
+    _text(img, W - m, base, cnt, f_cnt, (140, 140, 152), anchor="rs", shadow=0)
+    div_y = base + 4.2 * u
+    _hline(img, m, W - m, div_y, (255, 255, 255, 30), max(1, round(u * 0.25)))
+
+    shown = items[:4]
+    more = 0
+    if len(items) > 4:
+        shown, more = items[:3], len(items) - 3
+    rows = 4
+    top = div_y + 2.2 * u
+    row_h = (H - m * 0.7 - top) / rows
+    f_t = _font(6.4 * u, True)
+    f_c = _font(5.2 * u, False)
+    for i, it in enumerate(shown):
+        ry = top + i * row_h
+        cy = ry + row_h / 2
+        today = bool(it.get("today"))
+        if today:
+            hl = Image.new("RGBA", (int((W - 2 * m + 2 * u) * SS), int((row_h - 1.2 * u) * SS)), (0, 0, 0, 0))
+            ImageDraw.Draw(hl).rounded_rectangle((0, 0, hl.width - 1, hl.height - 1), radius=row_h * 0.22 * SS,
+                                                 fill=(229, 9, 20, 46), outline=(229, 9, 20, 120),
+                                                 width=max(1, round(0.3 * u * SS)))
+            hl = hl.resize((max(1, round(hl.width / SS)), max(1, round(hl.height / SS))), LANCZOS)
+            _comp(img, hl, m - u, ry + 0.6 * u)
+        # bolinha
+        dot = _icon(lambda H_: _dot(H_, RED if today else (255, 255, 255)), 2.6 * u) if today else \
+            _icon(lambda H_: _dot(H_, (200, 200, 210)), 1.9 * u)
+        x = m + 1.4 * u
+        _comp(img, dot, x + (2.6 * u - dot.width) / 2, cy - dot.height / 2)
+        x = m + 5.6 * u
+        bl = cy + _cap(f_t) / 2
+        title = _clean_text(str(it.get("title") or it.get("name") or ""))
+        code = _clean_text(str(it.get("ep") or it.get("episode") or it.get("code") or ""))
+        right_x = W - m
+        if today:
+            chip = _chip(6.4 * u, ["HOJE"], RED, WHITE, fs=0.5, pad=0.42)
+            _place(img, chip, right_x - chip.width - 0.6 * u, cy - chip.height / 2, shadow=0.3)
+            right_x -= chip.width + 3 * u
+        elif it.get("time"):
+            tt = str(it["time"])
+            _text(img, right_x, bl, tt, f_c, (150, 150, 162), anchor="rs", shadow=0)
+            right_x -= f_c.getlength(tt) + 3 * u
+        flag = _icon(lambda H_: _flag_br(H_), _cap(f_t) * 1.05) if it.get("dub") else None
+        reserve = (f_c.getlength(code) + 2.2 * u if code else 0) + (flag.width + 2.4 * u if flag else 0)
+        title = _ellipsize(title, f_t, max(f_t.size, right_x - x - reserve))
+        _text(img, x, bl, title, f_t, WHITE, shadow=0.3)
+        x += f_t.getlength(title) + 2.2 * u
+        if code:
+            _text(img, x, bl, code, f_c, (165, 165, 178), shadow=0)
+            x += f_c.getlength(code) + 2.4 * u
+        if flag:
+            _place(img, flag, x, cy - flag.height / 2, shadow=0.3)
+        if i < len(shown) - 1 and not today and not shown[i + 1].get("today"):
+            ly = ry + row_h
+            _hline(img, m + 5.6 * u, W - m, ly, (255, 255, 255, 16), max(1, round(u * 0.22)))
+    if more:
+        ry = top + 3 * row_h
+        _text(img, m + 5.6 * u, ry + row_h / 2 + _cap(f_c) / 2, f"+ {more} outros", f_c,
+              (150, 150, 162), shadow=0)
+    if not items:
+        _text(img, m + 5.6 * u, top + row_h, "Nada estreia neste dia.", f_c, (150, 150, 162), shadow=0)
+    return to_jpeg(img)
+
+
+# =================================================================== 6
+def _avatar(photo, name: str, d: int) -> Image.Image:
+    """Foto (ou iniciais) em circulo com aro fino, antialias por supersampling."""
+    D = d * SS
+    if photo is not None:
+        face = _cover(_load(photo), (D, D), center=(0.5, 0.3))
+    else:
+        c = _hue_color(name, 0.45, 0.62)
+        c2 = tuple(max(0, int(v * 0.55)) for v in c)
+        face = _corner_gradient((D, D), c, c, c2, c2)
+        f = _font(D * 0.36, True)
+        ImageDraw.Draw(face).text((D / 2, D / 2 + _cap(f) / 2), _initials(name), font=f,
+                                  fill=(255, 255, 255, 235), anchor="ms")
+    mask = Image.new("L", (D, D), 0)
+    ImageDraw.Draw(mask).ellipse((0, 0, D - 1, D - 1), fill=255)
+    out = Image.new("RGBA", (D, D), (0, 0, 0, 0))
+    out.paste(face, (0, 0), mask)
+    ring = Image.new("RGBA", (D, D), (0, 0, 0, 0))
+    ImageDraw.Draw(ring).ellipse((0, 0, D - 1, D - 1), outline=(255, 255, 255, 120),
+                                 width=max(1, round(D * 0.022)))
+    out.alpha_composite(ring)
+    return out.resize((d, d), LANCZOS)
+
+
+def _fmt_runtime(mins: int) -> str:
+    mins = int(mins)
+    if mins < 60:
+        return f"{mins}min"
+    return f"{mins // 60}h {mins % 60:02d}min" if mins % 60 else f"{mins // 60}h"
+
