+"""🎁 Retrospectiva Comet: o mês (ou o ano) de quem assiste, em números e num cartão estilo "Wrapped".
+
+- Tabela própria `recap_plays` (uma linha por dia + título), copiada do `play_log` a cada 6 h,
+  porque o `play_log` é limpo após 180 dias. `recap_titles` guarda os metadados do TMDB.
+- Fileira `comet_recap` (filmes): itens `cometsaga:recap-AAAA-MM` / `cometsaga:recap-AAAA`.
+- Capa: GET /art/recap/{AAAA-MM|AAAA}.jpg (cache em disco de 6 h).
+- Telegram: dia 1 às 10:00 (mês anterior), 31/12 às 20:00 (ano) e o comando /retrospectiva.
+"""
+from __future__ import annotations
+
+import asyncio
+import io
+import os
+import re
+import time
+import unicodedata
+from collections import Counter, defaultdict
+from datetime import datetime, timedelta, timezone
+
+import aiohttp
+from fastapi import APIRouter, HTTPException, Response
+
+from comet.core.logger import logger, log_swallowed
+from comet.core.models import settings
+
+ROWS = [{"type": "movie", "id": "comet_recap", "name": "🎁 Sua retrospectiva"}]
+ID_PREFIX = "cometsaga:recap-"
+HELP = "/retrospectiva — seu mês em números (também chega todo dia 1)"
+
+router = APIRouter(tags=["Stremio"])
+
+CACHE_DIR = "/opt/comet/data/recap_cache"
+CACHE_TTL = 6 * 3600
+SYNC_EVERY = 6 * 3600
+BR_TZ = timezone(timedelta(hours=-3))  # America/Recife (sem horário de verão)
+DEFAULT_MOVIE_MIN = 100
+DEFAULT_EPISODE_MIN = 45
+
+_MONTHS = ["janeiro", "fevereiro", "março", "abril", "maio", "junho", "julho", "agosto",
+           "setembro", "outubro", "novembro", "dezembro"]
+_WEEKDAYS = ["segunda-feira", "terça-feira", "quarta-feira", "quinta-feira", "sexta-feira",
+             "sábado", "domingo"]
+
+_tables_ready = False
+_AVAIL: set[str] = set()      # chaves com cartão disponível agora (atualizada pelo serviço e pelo catálogo)
+_last_sync = 0.0
+
+
+# ───────────────────────── funções puras ─────────────────────────
+
+def _norm(t: str) -> str:
+    t = unicodedata.normalize("NFKD", t).encode("ascii", "ignore").decode().lower()
+    return re.sub(r"\s+", " ", t).strip()
+
+
+def now_local() -> datetime:
+    return datetime.now(BR_TZ)
+
+
+def day_of(ts: float) -> str:
+    return datetime.fromtimestamp(ts, BR_TZ).strftime("%Y-%m-%d")
+
+
+def key_label(key: str) -> str:
+    if len(key) == 4:
+        return key
+    y, m = key.split("-")
+    return f"{_MONTHS[int(m) - 1].capitalize()} {y}"
+
+
+def key_prev_month(now: datetime) -> str:
+    y, m = (now.year, now.month - 1) if now.month > 1 else (now.year - 1, 12)
+    return f"{y}-{m:02d}"
+
+
+def keys_for_row(now: datetime) -> list[str]:
+    """Mês atual, 3 anteriores e (em dezembro/janeiro) o ano."""
+    keys = []
+    y, m = now.year, now.month
+    for _ in range(4):
+        keys.append(f"{y}-{m:02d}")
+        y, m = (y, m - 1) if m > 1 else (y - 1, 12)
+    if now.month == 12:
+        keys.append(str(now.year))
+    elif now.month == 1:
+        keys.append(str(now.year - 1))
+    return keys
+
+
+def parse_key(arg: str, now: datetime) -> str | None:
+    """'' -> mês atual; 'outubro' -> último outubro; '2026' -> ano; '2026-10' -> mês."""
+    a = _norm(arg)
+    if not a:
+        return f"{now.year}-{now.month:02d}"
+    if re.fullmatch(r"\d{4}", a):
+        return a
+    if re.fullmatch(r"\d{4}-\d{1,2}", a):
+        y, m = a.split("-")
+        return f"{y}-{int(m):02d}" if 1 <= int(m) <= 12 else None
+    names = [_norm(x) for x in _MONTHS]
+    for i, n in enumerate(names):
+        if a == n or (len(a) >= 3 and n.startswith(a)):
+            y = now.year if i + 1 <= now.month else now.year - 1
+            return f"{y}-{i + 1:02d}"
+    return None
+
+
+def valid_key(key: str) -> bool:
+    return bool(re.fullmatch(r"\d{4}(-(0[1-9]|1[0-2]))?", key or ""))
+
+
+def _fmt_hours(minutes: float) -> str:
+    h = minutes / 60
+    return f"{h:.1f}".replace(".", ",") if h < 10 else str(round(h))
+
+
+def compute_stats(plays: list[dict], titles: dict[str, dict], key: str, now: datetime | None = None) -> dict | None:
+    """plays: [{day, media_id, imdb, season, episode, is_pt}] já deduplicados por (day, media_id).
+    titles: imdb -> {kind, name, runtime_min, genres, poster_path}. None se não há plays na chave."""
+    rows = [p for p in plays if str(p["day"]).startswith(key)]
+    if not rows:
+        return None
+    movies = eps = 0
+    minutes_total = 0.0
+    by_title_min: dict[str, float] = defaultdict(float)
+    series_eps: dict[str, set] = defaultdict(set)
+    by_day_min: dict[str, float] = defaultdict(float)
+    genres: Counter = Counter()
+    pt = 0
+    for p in rows:
+        imdb = p["imdb"]
+        t = titles.get(imdb) or {}
+        is_series = p.get("season") is not None or ":" in str(p["media_id"]) or t.get("kind") == "series"
+        runtime = t.get("runtime_min") or (DEFAULT_EPISODE_MIN if is_series else DEFAULT_MOVIE_MIN)
+        minutes_total += runtime
+        by_title_min[imdb] += runtime
+        by_day_min[p["day"]] += runtime
+        if is_series:
+            eps += 1
+            series_eps[imdb].add((p.get("season"), p.get("episode"), p["media_id"]))
+        else:
+            movies += 1
+        for g in (t.get("genres") or "").split(","):
+            if g.strip():
+                genres[g.strip()] += 1
+        if p.get("is_pt"):
+            pt += 1
+    top_series = None
+    if series_eps:
+        imdb, s = max(series_eps.items(), key=lambda kv: (len(kv[1]), by_title_min[kv[0]]))
+        top_series = {"imdb": imdb, "name": (titles.get(imdb) or {}).get("name") or imdb, "episodes": len(s)}
+    top_titles = []
+    for imdb, mins in sorted(by_title_min.items(), key=lambda kv: -kv[1])[:3]:
+        t = titles.get(imdb) or {}
+        n = len(series_eps.get(imdb, ()))
+        top_titles.append({"imdb": imdb, "name": t.get("name") or imdb, "minutes": mins,
+                           "episodes": n, "poster_path": t.get("poster_path")})
+    best_day = max(by_day_min.items(), key=lambda kv: (kv[1], kv[0]))
+    wd_min: dict[int, float] = defaultdict(float)
+    for d, m in by_day_min.items():
+        wd_min[datetime.strptime(d, "%Y-%m-%d").weekday()] += m
+    best_wd = max(wd_min.items(), key=lambda kv: kv[1])[0]
+    now = now or now_local()
+    partial = key == f"{now.year}-{now.month:02d}" or key == str(now.year)
+    return {
+        "key": key, "label": key_label(key), "partial": partial,
+        "minutes": minutes_total, "hours": minutes_total / 60,
+        "movies": movies, "episodes": eps, "plays": len(rows),
+        "top_series": top_series, "top_titles": top_titles,
+        "genre": genres.most_common(1)[0][0] if genres else None,
+        "weekday": _WEEKDAYS[best_wd],
+        "best_day": best_day[0], "best_day_minutes": best_day[1],
+        "dub_pct": round(100 * pt / len(rows)),
+        "poster_path": top_titles[0]["poster_path"] if top_titles else None,
+    }
+
+
+def _date_br(day: str) -> str:
+    return datetime.strptime(day, "%Y-%m-%d").strftime("%d/%m")
+
+
+def _plural(n: int, one: str, many: str) -> str:
+    return f"{n} {one if n == 1 else many}"
+
+
+def summary_text(st: dict) -> str:
+    head = f"🎁 Retrospectiva Comet · {st['label']}" + (" (até agora)" if st["partial"] else "")
+    lines = [head, f"⏱ ~{_fmt_hours(st['minutes'])} horas assistindo",
+             f"🎬 {_plural(st['movies'], 'filme', 'filmes')} · 📺 {_plural(st['episodes'], 'episódio', 'episódios')}"]
+    if st["top_series"]:
+        lines.append(f"🏆 Série mais vista: {st['top_series']['name']} ({_plural(st['top_series']['episodes'], 'episódio', 'episódios')})")
+    if st["genre"]:
+        lines.append(f"🎭 Gênero do período: {st['genre']}")
+    lines.append(f"📅 Mais assistiu: {st['weekday']}; maior dia {_date_br(st['best_day'])} (~{_fmt_hours(st['best_day_minutes'])} h)")
+    lines.append(f"🇧🇷 {st['dub_pct']}% dublado")
+    if st["top_titles"]:
+        lines.append("🥇 Top 3: " + " · ".join(t["name"] for t in st["top_titles"]))
+    return "\n".join(lines)
+
+
+# ───────────────────────── desenho do cartão ─────────────────────────
+
+def render_card(st: dict, poster: bytes | None = None, size=(1280, 720)) -> bytes:
+    from PIL import Image, ImageDraw
