+"""Streamings no estilo Disney+: uma coleção do Nuvio com uma pasta por serviço.
+
+Na tela inicial do Nuvio aparece, fixada no topo, a fileira "Streamings" com um bloco por serviço
+(Netflix, Prime Video, Disney+...). Com foco num bloco, o destaque gigante do topo vira o fundo,
+o logo e o vídeo daquele serviço. Ao abrir, a página do serviço tem abas: Top 10, Originais, Em alta,
+Novidades e Aclamados. Tudo é servido pelo Comet:
+
+- catálogos `comet_sv_<aba>` (um por aba e tipo, o serviço vai no `genre`), fora da tela inicial
+  (`showInHome: false`), que leem o TMDB por serviço no Brasil;
+- a coleção pronta em `/<link>/nuvio/colecoes.json` (o Nuvio importa por link);
+- as artes em `/art/svc/...`: bloco, brilho animado no foco, fundo do destaque, logo e vídeo.
+"""
+from __future__ import annotations
+
+import asyncio
+import datetime
+import io
+import math
+import os
+import random
+import re
+import subprocess
+import time
+from typing import Any
+
+from fastapi import APIRouter, HTTPException, Response
+from fastapi.responses import FileResponse, JSONResponse
+
+from comet.core.logger import log_swallowed, logger
+from comet.core.models import settings
+
+# ───────────────────────── serviços ─────────────────────────
+# key, nome, provider (TMDB watch provider BR), redes dos originais, cores (escura, viva), logo TMDB
+SERVICES: list[dict[str, Any]] = [
+    {"key": "netflix", "name": "Netflix", "provider": 8, "networks": "213",
+     "c1": (20, 0, 2), "c2": (229, 9, 20), "logo": "/wwemzKWzjKYJFfCeiB57q3r4Bcm.png", "white": False},
+    {"key": "prime", "name": "Prime Video", "provider": 119, "networks": "1024",
+     "c1": (0, 14, 30), "c2": (0, 168, 225), "logo": "/w7HfLNm9CWwRmAMU58udl2L7We7.png", "white": True},
+    {"key": "disney", "name": "Disney+", "provider": 337, "networks": "2739",
+     "c1": (4, 10, 38), "c2": (17, 60, 207), "logo": "/1edZOYAfoyZyZ3rklNSiUpXX30Q.png", "white": True},
+    {"key": "max", "name": "HBO Max", "provider": 1899, "networks": "3186|49",
+     "c1": (8, 2, 30), "c2": (88, 34, 180), "logo": "/nmU0UMDJB3dRRQSTUqawzF2Od1a.png", "white": True},
+    {"key": "apple", "name": "Apple TV+", "provider": 350, "networks": "2552",
+     "c1": (8, 8, 10), "c2": (150, 150, 160), "logo": "/bngHRFi794mnMq34gfVcm9nDxN1.png", "white": True},
+    {"key": "paramount", "name": "Paramount+", "provider": 531, "networks": "4330",
+     "c1": (0, 10, 40), "c2": (0, 100, 255), "logo": "/fi83B1oztoS47xxcemFdPMhIzK.png", "white": True},
+    {"key": "globoplay", "name": "Globoplay", "provider": 307, "networks": "3290",
+     "c1": (30, 4, 4), "c2": (242, 56, 14), "logo": "/kPSphunwE18PB4XIAwiuTVt6ERI.png", "white": True},
+    {"key": "crunchyroll", "name": "Crunchyroll", "provider": 283, "networks": "1112",
+     "c1": (30, 10, 0), "c2": (244, 117, 33), "logo": "/qqyXcZlJQKlRmAD1TCKV7mGLQlt.png", "white": True},
+    {"key": "mubi", "name": "MUBI", "provider": 11, "networks": None,
+     "c1": (2, 6, 24), "c2": (0, 20, 137), "logo": "/16gclYCHdh6QFQyBRNOo3DuaqDT.png", "white": True},
+    {"key": "pluto", "name": "Pluto TV", "provider": 300, "networks": None,
+     "c1": (16, 14, 40), "c2": (250, 220, 0), "logo": None, "white": True},
+]
+BY_KEY = {s["key"]: s for s in SERVICES}
+BY_NAME = {s["name"].lower(): s for s in SERVICES}
+
+# aba -> (tipo, nome no manifesto). A ordem é a das abas na página do serviço.
+TABS: list[tuple[str, str, str]] = [
+    ("top10s", "series", "🏆 Top 10 séries"),
+    ("top10m", "movie", "🏆 Top 10 filmes"),
+    ("orig", "series", "✨ Originais"),
+    ("hots", "series", "🔥 Séries em alta"),
+    ("hotm", "movie", "🍿 Filmes em alta"),
+    ("newm", "movie", "🆕 Novidades"),
+    ("bests", "series", "💎 Séries aclamadas"),
+    ("bestm", "movie", "💎 Filmes aclamados"),
+]
+_TAB_TYPE = {t[0]: t[1] for t in TABS}
+CATALOG_PREFIX = "comet_sv_"
+COLLECTION_ID = "comet_streamings"
+FORYOU_ID = "foryou"
+
+DATA_DIR = "/opt/comet/data/svc_art"
+_ART_VERSION = "4"  # muda a URL das artes quando o desenho muda (o Nuvio guarda em cache)
+
+
+def manifest_catalogs() -> list[dict]:
+    names = [s["name"] for s in SERVICES]
+    orig_names = [s["name"] for s in SERVICES if s.get("networks")]
+    out = []
+    for tab, ctype, name in TABS:
+        opts = orig_names if tab == "orig" else names
+        extra = [{"name": "genre", "isRequired": False, "options": opts}]
+        if not tab.startswith("top10"):
+            extra.append({"name": "skip", "isRequired": False})
+        out.append({"type": ctype, "id": CATALOG_PREFIX + tab, "name": name, "extra": extra,
+                    "showInHome": False})
+    return out
+
+
+def _service_from_genre(genre: str | None) -> dict | None:
+    if not genre:
+        return None
+    return BY_NAME.get(genre.strip().lower()) or BY_KEY.get(genre.strip().lower())
+
+
+def tmdb_query(catalog_id: str, media_type: str, language: str, region: str, page: int,
+               today: datetime.date) -> tuple[str, dict] | None:
+    """Consulta do TMDB para o id interno `svx_<serviço>_<aba>` (usado por catalogs._fetch_catalog_items)."""
+    m = re.fullmatch(r"svx_([a-z0-9]+)_([a-z0-9]+)", catalog_id or "")
+    if not m:
+        return None
+    svc, tab = BY_KEY.get(m.group(1)), m.group(2)
+    if not svc or _TAB_TYPE.get(tab) != media_type:
+        return None
+    tv = media_type == "series"
+    kind = "tv" if tv else "movie"
+    p: dict[str, Any] = {"language": language, "page": page, "watch_region": region,
+                         "with_watch_providers": svc["provider"]}
+    if tv:
+        p["without_genres"] = "10763,10764,10766,10767"  # sem jornal, reality, novela e talk show
+    date_key = "first_air_date" if tv else "primary_release_date"
+    if tab.startswith("top10"):
+        p["sort_by"] = "popularity.desc"
+        p["vote_count.gte"] = 15
+        if tv:
+            p["air_date.gte"] = (today - datetime.timedelta(days=150)).isoformat()
+        else:
+            p[f"{date_key}.gte"] = (today - datetime.timedelta(days=3 * 365)).isoformat()
+    elif tab == "orig":
+        if not svc.get("networks"):
+            return None
+        p.pop("watch_region"), p.pop("with_watch_providers")
+        p["with_networks"] = svc["networks"]
+        p["sort_by"] = "popularity.desc"
+        p["vote_count.gte"] = 30
+    elif tab.startswith("hot"):
+        p["sort_by"] = "popularity.desc"
+        p["vote_count.gte"] = 50
+        if tv:
+            p["air_date.gte"] = (today - datetime.timedelta(days=2 * 365)).isoformat()
+        else:
+            p[f"{date_key}.gte"] = (today - datetime.timedelta(days=5 * 365)).isoformat()
+    elif tab == "newm":
+        p["sort_by"] = "popularity.desc"
+        p["vote_count.gte"] = 5
+        p[f"{date_key}.gte"] = (today - datetime.timedelta(days=240)).isoformat()
+        p[f"{date_key}.lte"] = today.isoformat()
+    elif tab.startswith("best"):
+        p["sort_by"] = "vote_average.desc"
+        p["vote_count.gte"] = 300 if tv else 1500
+    else:
+        return None
+    if svc["key"] in ("mubi", "pluto"):  # catálogos pequenos: não exigir tantos votos
+        p["vote_count.gte"] = min(int(p.get("vote_count.gte", 0)), 20)
+    return f"discover/{kind}", p
+
+
+_CACHE: dict[tuple, tuple[float, list[dict]]] = {}
+_CACHE_TTL = 3 * 3600
+_POSTER_RE = re.compile(r"/([A-Za-z0-9_-]{10,}\.(?:jpg|jpeg|png|webp))")
+
+
+async def get_catalog(media_type: str, catalog_id: str, extra: dict | None, base_url: str,
+                      kids: bool = False) -> list[dict]:
+    start_warm()
+    tab = catalog_id[len(CATALOG_PREFIX):]
+    # sem serviço escolhido (Explorar, testes): o primeiro da lista
+    svc = _service_from_genre((extra or {}).get("genre")) or SERVICES[0]
+    if kids or _TAB_TYPE.get(tab) != media_type:
+        return []
+    try:
+        skip = int((extra or {}).get("skip") or 0)
+    except (TypeError, ValueError):
+        skip = 0
+    if tab.startswith("top10") and skip:
+        return []
+    key = (svc["key"], tab, media_type, skip, base_url)
+    hit = _CACHE.get(key)
+    if hit and time.time() - hit[0] < _CACHE_TTL:
+        return hit[1]
+    from comet.services import catalogs as _cat
+    metas = await _cat._fetch_catalog_items(media_type, f"svx_{svc['key']}_{tab}", None, skip,
+                                            base_url=base_url)
+    if tab.startswith("top10"):
+        from urllib.parse import quote
+        metas = [dict(m) for m in metas[:10]]
+        for idx, meta in enumerate(metas, start=1):
+            src = meta.get("poster") or ""
+            if src.startswith(base_url):
+                src = src[len(base_url):]
+            if not src.startswith("/art/land/"):
+                bg = meta.get("background") or ""
+                mm = re.search(r"/t/p/\w+/([A-Za-z0-9_-]+\.(?:jpg|png))", bg)
+                src = f"/art/land/{mm.group(1)}" if mm else ""
+            mb = re.match(r"/art/land/([A-Za-z0-9_-]+\.(?:jpg|png))", src)
+            src = f"/art/land/{mb.group(1)}" if mb else ""  # só o fundo: logo e selo cortariam
+            if src:
+                art = f"{base_url}/art/svc/rank/{svc['key']}-{idx}.jpg?v={_ART_VERSION}&s={quote(src, safe='')}"
+                meta["poster"] = art
+                meta["landscapePoster"] = art
+                meta["background"] = art  # o card horizontal do Nuvio usa background primeiro
+                meta["posterShape"] = "landscape"
+    if metas:
+        _CACHE[key] = (time.time(), metas)
+        if len(_CACHE) > 400:
+            for k in sorted(_CACHE, key=lambda k: _CACHE[k][0])[:100]:
+                _CACHE.pop(k, None)
+    return metas
