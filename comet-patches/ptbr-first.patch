diff --git a/comet/metadata/siblings.py b/comet/metadata/siblings.py
new file mode 100644
index 0000000..246c38b
--- /dev/null
+++ b/comet/metadata/siblings.py
@@ -0,0 +1,272 @@
+import asyncio
+import time
+import urllib.parse
+
+from curl_cffi.requests import AsyncSession
+
+from comet.core.logger import log_swallowed, logger
+from comet.metadata.manager import MetadataScraper
+from comet.services.anime import anime_mapper
+from comet.services.filtering import scrub
+from comet.utils.http_client import http_client_manager
+from comet.utils.languages import merge_aliases
+
+from comet.utils.bounded import trim
+
+_CACHE_TTL = 86400.0  # 24 hours
+
+# Itens com este prefixo no conjunto bloqueado são títulos de episódio de uma série HOMÔNIMA:
+# release que cita um deles é da outra série (ex.: "ONE.PIECE.S01E01.ROMANCE.DAWN" é o live-action).
+EP_PREFIX = "ep:"
+HDR_MARK = "__hdr__"
+_LAST_EP_YEAR: dict[str, int] = {}  # imdb -> ano do último episódio (preenchido junto com os títulos)
+
+
+def _year(release_info) -> int | None:
+    try:
+        return int(str(release_info or "")[:4])
+    except ValueError:
+        return None
+
+
+async def _cinemeta_episode_names(session: AsyncSession, imdb_id: str) -> dict[str, set[tuple[int, int]]]:
+    """título de episódio (scrub) -> {(temporada, episódio)}"""
+    resp = await session.get(f"https://v3-cinemeta.strem.io/meta/series/{imdb_id}.json", timeout=6.0)
+    if resp.status_code != 200:
+        return {}
+    videos = ((resp.json() or {}).get("meta") or {}).get("videos") or []
+    out: dict[str, set[tuple[int, int]]] = {}
+    last = 0
+    for v in videos:
+        if not isinstance(v, dict) or not (v.get("season") or 0) >= 1:
+            continue
+        last = max(last, _year(v.get("released")) or 0)
+        name = scrub(v.get("name") or v.get("title") or "")
+        if name:
+            out.setdefault(name, set()).add((int(v.get("season") or 0), int(v.get("episode") or 0)))
+    _LAST_EP_YEAR[imdb_id] = last
+    return out
+
+
+async def _twin_episode_phrases(imdb_id: str, twins: list[str]) -> set[str]:
+    """Títulos de episódio da(s) série(s) homônima(s), compridos o bastante para não dar falso positivo.
+
+    "título"            -> bloqueia qualquer release que cite o título (só existe na outra série);
+    "T:E:título"        -> o título existe nas duas: bloqueia só se o release for SxxEyy da outra
+                           série e esse número não for o episódio de mesmo nome da nossa.
+    """
+    async with AsyncSession(impersonate="chrome") as session:
+        own, *others = await asyncio.gather(
+            _cinemeta_episode_names(session, imdb_id),
+            *(_cinemeta_episode_names(session, t) for t in twins),
+        )
+    # "World War Three (2)" no Cinemeta vira "world war three 2"; o arquivo costuma vir sem o
+    # número da parte ("Doctor Who S01E05 World War Three"). Vale também o título sem ele.
+    own_all: dict[str, set] = {}
+    for n, eps in own.items():
+        for v in {n, _strip_part(n)}:
+            own_all.setdefault(v, set()).update(eps)
+    own_padded = [f" {o} " for o in own_all]
+    phrases = set()
+    for names in others:
+        for name, eps in names.items():
+            for n in {name, _strip_part(name)}:
+                # genérico demais ("episode 1", "pilot") ou curto: fica de fora
+                if len(n) < 10 or len(n.split()) < 2 or n.startswith("episode"):
+                    continue
+                inside_own = [
+                    e for o, e in zip(own_padded, own_all.values()) if f" {n} " in o
+                ] if n not in own_all else None
+                if n not in own_all and not inside_own:
+                    phrases.add(n)
+                    continue
+                # o título (ou um trecho dele) também é nosso: bloqueia só pelo SxxEyy da outra
+                ours = own_all[n] if n in own_all else set().union(*inside_own)
+                for se, ep in eps - ours:
+                    phrases.add(f"{se}:{ep}:{n}")
+    return phrases
+
+
+def _strip_part(name: str) -> str:
+    """Tira o número da parte no fim: "world war three 2" / "the daleks part 1" -> sem ele."""
+    words = name.split()
+    while words and (words[-1].isdigit() or words[-1] in ("part", "parte", "pt")):
+        words.pop()
+    return " ".join(words)
+_cache: dict[tuple[str, str], tuple[float, frozenset[str]]] = {}
+_locks: dict[tuple[str, str], asyncio.Lock] = {}
+
+
+async def get_blocked_titles(
+    media_type: str, imdb_id: str, title: str
+) -> frozenset[str]:
+    if (
+        not imdb_id
+        or not isinstance(imdb_id, str)
+        or not imdb_id.startswith("tt")
+        or not title
+        or not isinstance(title, str)
+        or media_type not in ("series", "movie")
+    ):
+        return frozenset()
+
+    cache_key = (media_type, imdb_id)
+    now = time.time()
+    cached = _cache.get(cache_key)
+    if cached is not None and (now - cached[0]) < _CACHE_TTL:
+        return cached[1]
+
+    lock = _locks.get(cache_key)
+    if lock is None:
+        lock = asyncio.Lock()
+        _locks[cache_key] = lock
+
+    async with lock:
+        now = time.time()
+        cached = _cache.get(cache_key)
+        if cached is not None and (now - cached[0]) < _CACHE_TTL:
+            return cached[1]
+
+        base_scrub = scrub(title)
+        if not base_scrub:
+            empty = frozenset()
+            _cache[cache_key] = (now, empty)
+            return empty
+
+        prefix = base_scrub + " "
+        encoded_query = urllib.parse.quote_plus(title)
+        url = f"https://v3-cinemeta.strem.io/catalog/{media_type}/top/search={encoded_query}.json"
+
+        try:
+            async with AsyncSession(impersonate="chrome") as session:
+                resp = await session.get(url, timeout=6.0)
+                if resp.status_code != 200:
+                    logger.warning(
+                        f"Cinemeta search failed with HTTP {resp.status_code} for {imdb_id} ({title})"
+                    )
+                    empty = frozenset()
+                    _cache[cache_key] = (now, empty)
+                    return empty
+                payload = resp.json()
+        except Exception as exc:
+            logger.warning(
+                f"Cinemeta search failed for {imdb_id} ({title}): {exc}"
+            )
+            empty = frozenset()
+            _cache[cache_key] = (now, empty)
+            return empty
+
+        metas = payload.get("metas") if isinstance(payload, dict) else None
+        if not isinstance(metas, list) or not metas:
+            empty = frozenset()
+            _cache[cache_key] = (now, empty)
+            return empty
+
+        siblings: list[dict] = []
+        twins: list[str] = []  # mesmo nome exato (One Piece anime x live-action, Doctor Who 1963 x 2005)
+        own_year, twin_years = None, []
+        for meta in metas:
+            if isinstance(meta, dict) and (meta.get("id") or meta.get("imdb_id")) == imdb_id:
+                own_year = _year(meta.get("releaseInfo"))
+            if not isinstance(meta, dict):
+                continue
+            meta_id = meta.get("id") or meta.get("imdb_id")
+            meta_name = meta.get("name") or ""
+            if not meta_id or meta_id == imdb_id:
+                continue
+            meta_type = meta.get("type")
+            if meta_type and meta_type != media_type:
+                continue
+            meta_scrub = scrub(meta_name)
+            if media_type == "series" and meta_scrub == base_scrub and len(twins) < 3:
+                twins.append(meta_id)
+                twin_years.append(_year(meta.get("releaseInfo")))
+            if meta_scrub.startswith(prefix):
+                siblings.append(
+                    {"id": meta_id, "name": meta_name, "scrub": meta_scrub}
+                )
+                if len(siblings) == 6:
+                    break
+
+        twin_phrases: set[str] = set()
+        if twins:
+            try:
+                twin_phrases = await _twin_episode_phrases(imdb_id, twins)
+            except Exception as e:
+                logger.debug(f"homônimos de {imdb_id}: {type(e).__name__}: {e}")
+            # série antiga com homônima nova: Dolby Vision/HDR no nome é da nova
+            if own_year and own_year <= 2012 and any(y and y >= 2016 for y in twin_years):
+                twin_phrases.add(HDR_MARK)
+            # ano no nome do release a partir da estreia da homônima mais nova = é da homônima
+            # só quando a nossa acabou antes (One Piece anime segue no ar: não vale)
+            own_last = _LAST_EP_YEAR.get(imdb_id) or 0
+            newer = [y for y in twin_years if y and own_last and y > own_last]
+            if newer:
+                twin_phrases.add(f"__minyear:{min(newer)}__")
+
+        if not siblings:
+            result = frozenset(EP_PREFIX + p for p in twin_phrases)
+            _cache[cache_key] = (now, result)
+            if result:
+                logger.log("FILTER", f"🧬 Homônimos de {imdb_id} ({title}): {', '.join(twins)} → {len(result)} títulos de episódio bloqueados")
+            return result
+
+        blocked: set[str] = {EP_PREFIX + p for p in twin_phrases}
+        for sib in siblings:
+            blocked.add(sib["scrub"])
+
+        session = await http_client_manager.get_session()
+        scraper = MetadataScraper(session)
+
+        async def _fetch_sibling_aliases(sib_id: str) -> dict:
+            try:
+                _, aliases = await scraper.fetch_metadata_and_aliases(
+                    media_type, sib_id
+                )
+            except Exception as e:
+                logger.warning(
+                    f"Failed fetching aliases for sibling {sib_id}: {e}"
+                )
+                aliases = {}
+
+            if anime_mapper.is_loaded():
+                try:
+                    kids = anime_mapper.get_kitsu_ids_from_imdb(sib_id)
+                    for kid in kids:
+                        k_aliases = await anime_mapper.get_aliases(f"kitsu:{kid}")
+                        if k_aliases:
+                            aliases = merge_aliases(aliases, k_aliases)
+                except Exception as _e:
+                    log_swallowed("siblings._fetch_sibling_aliases", _e)
+
+            return aliases if isinstance(aliases, dict) else {}
+
+        sibling_aliases_list = await asyncio.gather(
+            *(_fetch_sibling_aliases(s["id"]) for s in siblings),
+            return_exceptions=True,
+        )
+
+        for aliases in sibling_aliases_list:
+            if isinstance(aliases, dict):
+                for titles in aliases.values():
+                    if isinstance(titles, list):
+                        for t in titles:
+                            if isinstance(t, str):
+                                st = scrub(t)
+                                if st.startswith(prefix):
+                                    blocked.add(st)
+
+        result = frozenset(blocked)
+        _cache[cache_key] = (time.time(), result)
+        trim(_cache, 3000)
+        trim(_locks, 3000)
+        trim(_LAST_EP_YEAR, 3000)
+
+        if result:
+            sibs_str = ", ".join(f"{s['id']} {s['name']}" for s in siblings)
+            logger.log(
+                "FILTER",
+                f"🧬 Irmãos de {imdb_id} ({title}): {sibs_str} → {len(result)} nomes bloqueados",
+            )
+
+        return result
