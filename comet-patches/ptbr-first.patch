+def _vsep(H: int) -> Image.Image:
+    """Divisor vertical fino entre itens de um chip."""
+    w = max(2, round(H * 0.045))
+    im = Image.new("RGBA", (w, H), (0, 0, 0, 0))
+    ImageDraw.Draw(im).rectangle((0, H * 0.26, w - 1, H * 0.74), fill=(255, 255, 255, 90))
