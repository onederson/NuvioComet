+def _star(h: int, color=(245, 197, 24)) -> Image.Image:
+    h = max(4, int(h))
+    im = Image.new("RGBA", (h, h), (0, 0, 0, 0))
+    cx, cy, R = h / 2, h * 0.53, h * 0.5
+    pts = []
+    for i in range(10):
+        a = math.radians(-90 + i * 36)
+        r = R if i % 2 == 0 else R * 0.44
+        pts.append((cx + math.cos(a) * r, cy + math.sin(a) * r))
+    ImageDraw.Draw(im).polygon(pts, fill=_rgba(color))
