diff --git a/comet/services/week_cards.py b/comet/services/week_cards.py
new file mode 100644
index 0000000..709d6f1
--- /dev/null
+++ b/comet/services/week_cards.py
@@ -0,0 +1,130 @@
+"""📅 Sua semana em cartões: um cartão desenhado por dia (hoje + 6), com os episódios que estreiam.
+
+- Fileira `comet_myweek` (série, link pessoal): itens `cometsaga:w-AAAAMMDD` (prefixo já conhecido pelo app).
+- Capa: /art/week/AAAAMMDD.jpg (desenho do live_art.week_day_card).
+- Clique: meta com os episódios do dia como vídeos (ids "tt:S:E", tocam normalmente).
+A fonte é a própria fileira 📅 Estreias da semana (`comet_week`), cuja descrição é
+"📅 <Dia> DD/MM · T<S>E<E> · <status>".
+"""
+from __future__ import annotations
+
+import re
+import time
+from datetime import date, datetime, timedelta
+
+from comet.core.logger import logger
+
+_DAYS = ["SEGUNDA", "TERÇA", "QUARTA", "QUINTA", "SEXTA", "SÁBADO", "DOMINGO"]
+_DESC = re.compile(r"(\d{2})/(\d{2})\s*·\s*T(\d+)E(\d+)\s*·\s*(.+)")
+_CACHE: dict = {"ts": 0.0, "days": {}}
+
+
+async def _week_items() -> dict[str, list[dict]]:
+    """AAAAMMDD -> [{imdb, name, season, episode, dub, aired, poster}] (cache 30 min)."""
+    if time.time() - _CACHE["ts"] < 1800 and _CACHE["days"]:
+        return _CACHE["days"]
+    days: dict[str, list[dict]] = {}
+    try:
+        from comet.services.catalogs import get_catalog
+        metas = await get_catalog("series", "comet_week", extra={}, base_url="", kids=False) or []
+    except Exception as e:
+        logger.debug(f"semana: {e}")
+        metas = []
+    today = date.today()
+    for m in metas:
+        first = (m.get("description") or "").split("\n")[0]
+        mm = _DESC.search(first)
+        if not mm:
+            continue
+        d, mo, se, ep, status = mm.groups()
+        y = today.year
+        try:
+            dt = date(y, int(mo), int(d))
+            if (dt - today).days < -180:
+                dt = date(y + 1, int(mo), int(d))
+        except ValueError:
+            continue
+        days.setdefault(dt.strftime("%Y%m%d"), []).append({
+            "imdb": m.get("id"), "name": m.get("name") or "", "season": int(se), "episode": int(ep),
+            "dub": "dublado" in status.lower(), "aired": "não saiu" not in status.lower(),
+        })
+    _CACHE.update(ts=time.time(), days=days)
+    return days
+
+
+def _labels(d: date) -> tuple[str, str]:
+    today = date.today()
+    if d == today:
+        day = "HOJE"
+    elif d == today + timedelta(days=1):
+        day = "AMANHÃ"
+    else:
+        day = _DAYS[d.weekday()]
+    return day, d.strftime("%d/%m")
+
+
+async def catalog_items(base_url: str) -> list[dict]:
+    days = await _week_items()
+    out = []
+    today = date.today()
+    for k in range(7):
+        d = today + timedelta(days=k)
+        key = d.strftime("%Y%m%d")
+        items = days.get(key) or []
+        if not items:
+            continue
+        day, dm = _labels(d)
+        n_dub = sum(1 for i in items if i["dub"])
+        out.append({
+            "id": f"cometsaga:w-{key}",
+            "type": "series",
+            "name": f"{day.capitalize()} · {dm}",
+            "poster": f"{base_url}/art/week/{key}.jpg?t={int(time.time() // 1800)}",
+            "posterShape": "landscape",
+            "description": f"{len(items)} estreia(s), {n_dub} dublada(s):\n" + "\n".join(
+                f"• {i['name']} T{i['season']}E{i['episode']}" + (" 🇧🇷" if i["dub"] else "") for i in items[:8]),
+        })
+    return out
+
+
+async def day_card_data(key: str) -> tuple[str, str, list[dict]] | None:
+    try:
+        d = datetime.strptime(key, "%Y%m%d").date()
+    except ValueError:
+        return None
+    items = (await _week_items()).get(key) or []
+    day, dm = _labels(d)
+    rows = [{"title": f"{i['name']} T{i['season']}E{i['episode']}", "dub": i["dub"], "today": d == date.today()}
+            for i in items[:4]]
+    if len(items) > 4:
+        rows[-1]["title"] = f"+ {len(items) - 3} estreias"
+        rows[-1]["dub"] = False
+    return day, dm, rows
+
+
+async def week_meta(key: str) -> dict | None:
+    items = (await _week_items()).get(key)
+    if not items:
+        return None
+    d = datetime.strptime(key, "%Y%m%d").date()
+    day, dm = _labels(d)
+    videos = []
+    for n, i in enumerate(items, start=1):
+        videos.append({
+            "id": f"{i['imdb']}:{i['season']}:{i['episode']}",
+            "title": f"{i['name']} · T{i['season']}E{i['episode']}" + (" · 🇧🇷 dublado" if i["dub"] else ""),
+            "season": 1,
+            "episode": n,
+            "released": d.isoformat() + "T00:00:00.000Z",
+            "thumbnail": f"https://images.metahub.space/background/medium/{i['imdb']}/img",
+            "overview": "Já saiu" + (" e já tem dublado pronto" if i["dub"] else "") if i["aired"] else "Ainda não estreou",
+        })
+    return {
+        "id": f"cometsaga:w-{key}",
+        "type": "series",
+        "name": f"📅 {day.capitalize()} · {dm}",
+        "description": f"{len(items)} estreia(s) das suas séries e das populares neste dia.",
+        "background": f"https://images.metahub.space/background/medium/{items[0]['imdb']}/img",
+        "poster": f"https://images.metahub.space/poster/medium/{items[0]['imdb']}/img",
+        "videos": videos,
+    }
diff --git a/comet/services/wishlist.py b/comet/services/wishlist.py
new file mode 100644
index 0000000..93c4ba9
--- /dev/null
+++ b/comet/services/wishlist.py
@@ -0,0 +1,602 @@
+"""Lista de desejos dublados + radar de lançamentos (Comet do A71).
+
+- Lista de desejos: "me avisa quando sair Duna 3 dublado" → fica esperando; a cada 3 h o serviço confere a
+  lista de fontes. Chegou 🇧🇷 pronto (⚡/🌐) → avisa no Telegram. Saiu 🇧🇷 que precisa baixar (⬇️) → manda o
+  debrid baixar (uma vez só por item) e avisa. Esperando há mais de 120 dias → cancela com aviso.
+- Radar (opcional, /radar on): 1×/dia pega os filmes no cinema / a estrear no Brasil (TMDB) e, quando passa a
+  data digital BR (ou 45 dias após o cinema, sem data), avisa uma vez se já existe dublado pronto que não seja CAM.
+
+GANCHOS (onde ligar no Comet; este arquivo vira comet/services/wishlist.py):
+
+(a) comet/services/telegram_bot.py, no começo do try de `_answer`, ANTES do roteamento (/start, /status...):
+
+        from comet.services.wishlist import handle_command, HELP_WISHLIST
+        reply = await handle_command(text)
+        if reply is None:
+            if low.startswith("/start") ...      # roteamento atual, sem mudanças (vira o corpo deste if)
+            ...
+
+    e acrescentar HELP_WISHLIST ao texto de ajuda: `_HELP + "\n\n" + HELP_WISHLIST`.
+    (handle_command já devolve None para "oi", pedidos normais e comandos que não são dela.)
+
+(b) comet/api/app.py (lifespan), junto de `telegram_task = asyncio.create_task(start_telegram_bot())`:
+
+        from comet.services.wishlist import start_wishlist_service
+        wishlist_task = asyncio.create_task(start_wishlist_service())
+        ...  # no shutdown: wishlist_task.cancel()
+
+    start_wishlist_service dorme 10 min, depois em loop: radar_refresh() (ele mesmo limita a 1×/dia e só roda
+    com o radar ligado) + check_all(), e dorme 3 h. Quem preferir a madrugada (nightly) pode chamar
+    `await check_all()` / `await radar_refresh()` direto de lá em vez de iniciar o serviço.
+"""
+from __future__ import annotations
+
+import asyncio
+import re
+import time
+import unicodedata
+from datetime import date, datetime, timedelta, timezone
+
+import aiohttp
+
+from comet.core.database import database
+from comet.core.logger import logger
+
+CHECK_EVERY = 3 * 3600
+FIRST_DELAY = 600
+PACE_SECONDS = 2.0          # no máx. 1 consulta (lista de fontes / Cinemeta) a cada 2 s
+MAX_WAIT_DAYS = 120
+RADAR_FALLBACK_DAYS = 45    # sem data digital BR: considera 45 dias após o cinema
+RADAR_GIVE_UP_DAYS = 240    # depois disso (contado do cinema) para de olhar o filme
+RADAR_MAX_PER_RUN = 10
+RADAR_RECHECK = 20 * 3600
+_CINEMETA = "https://v3-cinemeta.strem.io/meta/series/{imdb}.json"
+
+ACTIVE = ("esperando", "baixando")
+
+HELP_WISHLIST = (
+    "⭐ Lista de desejos (dublados):\n"
+    "/quero Duna 3 — aviso quando sair dublado (ou: \"me avisa quando sair Duna 3 dublado\")\n"
+    "/quero The Last of Us T2E3 — um episódio; só o nome da série = o próximo episódio dublado\n"
+    "/desejos — ver a lista · /remover 2 — tirar o nº 2\n"
+    "/radar on|off — aviso quando filme do cinema sair dublado · /radar — estado e próximos"
+)
+
+_READY = False
+_READY_LOCK = asyncio.Lock()
+_TASKS: set = set()
+_last_call = 0.0
+from comet.utils.bounded import trim
+
+_radar_seen: dict[str, float] = {}
+_TMDB_IMDB: dict[int, str] = {}   # id TMDB → imdb (evita repetir external_ids todo dia)
+
+
+# ───────────────────────── utilidades ─────────────────────────
+
+def _now() -> int:
+    return int(time.time())
+
+
+def _today() -> date:
+    return datetime.fromtimestamp(_now(), timezone.utc).date()
+
+
+def _norm(t: str) -> str:
+    t = unicodedata.normalize("NFKD", t).encode("ascii", "ignore").decode().lower()
+    return re.sub(r"\s+", " ", t).strip()
+
+
+def _ago(ts: int | None) -> str:
+    if not ts:
+        return "—"
+    d = max(0, _now() - int(ts))
+    if d < 3600:
+        return f"há {max(1, d // 60)} min"
+    if d < 86400:
+        return f"há {d // 3600} h"
+    n = d // 86400
+    return f"há {n} dia" + ("s" if n > 1 else "")
+
+
+def _spawn(coro) -> None:
+    task = asyncio.create_task(coro)
+    _TASKS.add(task)
+    task.add_done_callback(_TASKS.discard)
+
+
+async def _pace() -> None:
+    """Garante PACE_SECONDS entre consultas pesadas (não pesar no celular)."""
+    global _last_call
+    wait = _last_call + PACE_SECONDS - time.monotonic()
+    if wait > 0:
+        await asyncio.sleep(wait)
+    _last_call = time.monotonic()
+
+
+async def _ensure_tables() -> None:
+    global _READY
+    if _READY:
+        return
+    async with _READY_LOCK:
+        if _READY:
+            return
+        await database.execute(
+            "CREATE TABLE IF NOT EXISTS wishlist (id INTEGER PRIMARY KEY, kind TEXT, imdb TEXT, season INT, "
+            "episode INT, title TEXT, created_at INT, status TEXT, last_check INT, done_at INT, note TEXT)"
+        )
+        await database.execute(
+            "CREATE TABLE IF NOT EXISTS radar (imdb TEXT PRIMARY KEY, title TEXT, theatrical TEXT, digital TEXT, "
+            "status TEXT, notified_at INT)"
+        )
+        await database.execute("CREATE TABLE IF NOT EXISTS wishlist_settings (key TEXT PRIMARY KEY, value TEXT)")
+        _READY = True
+
+
+async def _get_setting(key: str, default: str | None = None) -> str | None:
+    await _ensure_tables()
+    row = await database.fetch_one("SELECT value FROM wishlist_settings WHERE key = :k", {"k": key})
+    return row["value"] if row else default
+
+
+async def _set_setting(key: str, value: str) -> None:
+    await _ensure_tables()
+    await database.execute("INSERT OR REPLACE INTO wishlist_settings (key, value) VALUES (:k, :v)", {"k": key, "v": value})
+
+
+async def radar_enabled() -> bool:
+    return (await _get_setting("radar_enabled", "0")) == "1"
+
+
+_CAM_RE = re.compile(r"🎦|(?<![A-Za-z])(?:HD|HQ)?CAM(?:RIP)?(?![A-Za-z])", re.I)
+
+
+def _is_cam(stream: dict) -> bool:
+    text = str(stream.get("name") or "") + " " + str(stream.get("description") or stream.get("title") or "")
+    return bool(_CAM_RE.search(text))
+
+
+def _pt_ready(streams: list[dict], skip_cam: bool = False) -> str | None:
+    """Linha do 1º 🇧🇷 pronto (⚡ em cache ou 🌐 link direto), ignorando o '▶ Assistir' (cópia do melhor)."""
+    for st in streams or []:
+        name = str(st.get("name") or "")
+        if name.startswith("▶"):
+            continue
+        desc = str(st.get("description") or st.get("title") or "")
+        if ("⚡" in name or "🌐" in name) and "🇧🇷" in name + desc:
+            if skip_cam and _is_cam(st):
+                continue
+            return name.replace("\n", " ")
+    return None
+
+
+def _label(row, season=None, episode=None) -> str:
+    s = row["season"] if season is None else season
+    e = row["episode"] if episode is None else episode
+    if row["kind"] == "series" and s is not None and e is not None:
+        return f"{row['title']} T{s}E{e}"
+    return row["title"]
+
+
+async def _cinemeta_latest(session: aiohttp.ClientSession, imdb: str) -> tuple[int, int] | None:
+    """(temporada, episódio) mais recente já lançado, pelo Cinemeta. None se não achar."""
+    try:
+        async with session.get(_CINEMETA.format(imdb=imdb), timeout=aiohttp.ClientTimeout(total=20)) as r:
+            if r.status != 200:
+                return None
+            data = await r.json(content_type=None)
+    except asyncio.CancelledError:
+        raise
+    except Exception as e:
+        logger.debug(f"wishlist: Cinemeta {imdb}: {type(e).__name__}")
+        return None
+    return latest_released((data or {}).get("meta") or {})
+
+
+def latest_released(meta: dict) -> tuple[int, int] | None:
+    now = datetime.fromtimestamp(_now(), timezone.utc)
+    best = None
+    for v in meta.get("videos") or []:
+        try:
+            s = int(v.get("season") or 0)
+            e = int(v.get("episode") or v.get("number") or 0)
+            rel = datetime.fromisoformat(str(v.get("released") or "").replace("Z", "+00:00"))
+        except (TypeError, ValueError):
+            continue
+        if rel.tzinfo is None:
+            rel = rel.replace(tzinfo=timezone.utc)
+        if s < 1 or e < 1 or rel > now:
+            continue
+        if best is None or (s, e) > best:
+            best = (s, e)
+    return best
+
+
+# ───────────────────────── lista de desejos ─────────────────────────
+
+async def add_from_text(text: str) -> str:
+    from comet.services.telegram_bot import _tmdb_find, parse_request
+    await _ensure_tables()
+    req = parse_request(text)
+    if not req.get("query"):
+        return "🤔 Me diga o nome. Ex.: /quero Duna 3 ou /quero The Last of Us T2E3"
+    async with aiohttp.ClientSession(timeout=aiohttp.ClientTimeout(total=20)) as s:
+        found = await _tmdb_find(s, req, prefer_released=False)
+    if not found:
+        return f"🤔 Não achei \"{req['query']}\". Tente com o nome do filme/série (pode ser em português)."
+    kind, imdb = found["type"], found["imdb"]
+    season = episode = None
+    if kind == "series":
+        season, episode = req.get("season"), req.get("episode")
+        title = found["name"]
+    else:
+        title = f"{found['name']} ({found['year']})" if found.get("year") else found["name"]
+    dup = await database.fetch_one(
+        "SELECT id FROM wishlist WHERE imdb = :i AND IFNULL(season, -1) = :s AND IFNULL(episode, -1) = :e "
+        "AND status IN ('esperando', 'baixando')",
+        {"i": imdb, "s": -1 if season is None else season, "e": -1 if episode is None else episode},
+    )
+    if kind == "series" and season is None:
+        what = f"{title} (o próximo episódio que sair dublado)"
+    elif kind == "series":
+        what = f"{title} T{season}E{episode}"
+    else:
+        what = title
+    if dup:
+        return f"👍 {what} já está na sua lista de desejos. /desejos mostra tudo."
+    await database.execute(
+        "INSERT INTO wishlist (kind, imdb, season, episode, title, created_at, status, last_check, done_at, note) "
+        "VALUES (:k, :i, :s, :e, :t, :c, 'esperando', NULL, NULL, NULL)",
+        {"k": kind, "i": imdb, "s": season, "e": episode, "t": title, "c": _now()},
+    )
+    logger.info(f"⭐ wishlist: + {what} [{imdb}]")
+    return (f"⭐ Anotado: {what}.\nConfiro a cada 3 h e te aviso aqui quando sair dublado "
+            f"(se precisar baixar, já mando o debrid baixar). /desejos mostra a lista.")
+
+
+_STATUS_TXT = {"esperando": "⏳ esperando", "baixando": "📥 baixando", "pronto": "✅ pronto", "cancelado": "✖️ cancelado"}
+
+
+async def _listed_rows() -> list:
+    """Mesma ordem em /desejos e /remover: ativos (mais antigos primeiro) + concluídos dos últimos 14 dias."""
+    await _ensure_tables()
+    active = await database.fetch_all(
+        "SELECT * FROM wishlist WHERE status IN ('esperando', 'baixando') ORDER BY created_at, id")
+    done = await database.fetch_all(
+        "SELECT * FROM wishlist WHERE status IN ('pronto', 'cancelado') AND IFNULL(done_at, 0) >= :t "
+        "ORDER BY done_at DESC, id DESC LIMIT 5", {"t": _now() - 14 * 86400})
+    return list(active) + list(done)
+
+
+def _item_name(r) -> str:
+    if r["kind"] == "series" and r["season"] is None:
+        return f"{r['title']} (próximo episódio)"
+    return _label(r)
+
+
+async def list_text() -> str:
+    rows = await _listed_rows()
+    if not rows:
+        return "⭐ Sua lista de desejos está vazia.\nEx.: /quero Duna 3 ou \"me avisa quando sair Duna 3 dublado\"."
+    lines = ["⭐ Lista de desejos:"]
+    for n, r in enumerate(rows, 1):
+        st = r["status"]
+        when = f"pedido {_ago(r['created_at'])}" if st in ACTIVE else f"{_ago(r['done_at'])}"
+        lines.append(f"{n}. {_item_name(r)} — {_STATUS_TXT.get(st, st)} ({when})")
+    lines.append("\n/remover <nº> tira da lista.")
+    return "\n".join(lines)
+
+
+async def remove(n: int) -> str:
+    rows = await _listed_rows()
+    if not rows:
+        return "⭐ Sua lista de desejos está vazia."
+    if not 1 <= n <= len(rows):
+        return f"🤔 Não tem o nº {n}. A lista vai de 1 a {len(rows)} (/desejos)."
+    r = rows[n - 1]
+    await database.execute("DELETE FROM wishlist WHERE id = :id", {"id": r["id"]})
+    return f"🗑️ Tirei da lista: {_item_name(r)}."
+
+
+async def _set_status(item_id: int, status: str, note: str | None = None, done: bool = False) -> None:
+    await database.execute(
+        "UPDATE wishlist SET status = :st, last_check = :now, note = COALESCE(:note, note), "
+        "done_at = CASE WHEN :done = 1 THEN :now ELSE done_at END WHERE id = :id",
+        {"st": status, "now": _now(), "note": note, "done": 1 if done else 0, "id": item_id},
+    )
+
+
+async def check_all(max_items: int = 30) -> dict:
+    """Confere os itens esperando/baixando (os menos conferidos primeiro, mais antigos no empate)."""
+    from comet.services.prefetch import _pick_predownload
+    from comet.services.telegram_bot import _streams, _trigger_download, send_telegram
+    await _ensure_tables()
+    counts = {"checked": 0, "ready": 0, "downloading": 0, "waiting": 0, "cancelled": 0, "errors": 0, "radar": 0}
+    rows = await database.fetch_all(
+        "SELECT * FROM wishlist WHERE status IN ('esperando', 'baixando') "
+        "ORDER BY IFNULL(last_check, 0), created_at, id LIMIT :n", {"n": int(max_items)})
+    async with aiohttp.ClientSession(timeout=aiohttp.ClientTimeout(total=30)) as s:
+        for r in rows:
+            try:
+                if r["status"] == "esperando" and _now() - int(r["created_at"] or 0) > MAX_WAIT_DAYS * 86400:
+                    await _set_status(r["id"], "cancelado", note="expirou", done=True)
+                    await send_telegram(f"⌛ Desisti de esperar {_item_name(r)}: {MAX_WAIT_DAYS} dias e nada dublado. "
+                                        f"Se ainda quiser, peça de novo com /quero.")
+                    counts["cancelled"] += 1
+                    continue
+                season, episode = r["season"], r["episode"]
+                if r["kind"] == "series":
+                    if season is None and r["status"] == "baixando" and r["note"]:
+                        try:  # já mandou baixar um episódio: acompanha esse (note = "tt..:S:E")
+                            _, season, episode = r["note"].split(":")
+                            season, episode = int(season), int(episode)
+                        except ValueError:
+                            season = episode = None
+                    if season is None:
+                        await _pace()
+                        latest = await _cinemeta_latest(s, r["imdb"])
+                        if not latest:
+                            await _set_status(r["id"], r["status"])
+                            counts["waiting"] += 1
+                            continue
+                        season, episode = latest
+                    stype, sid = "series", f"{r['imdb']}:{season}:{episode}"
+                else:
+                    stype, sid = "movie", r["imdb"]
+                label = _label(r, season, episode)
+                await _pace()
+                counts["checked"] += 1
+                streams = await _streams(s, stype, sid)
+                ready = _pt_ready(streams)
+                if ready:
+                    await _set_status(r["id"], "pronto", note=sid, done=True)
+                    await send_telegram(f"⚡ Chegou dublado: {label}\n{ready}\nÉ só abrir no Stremio.")
+                    counts["ready"] += 1
+                    continue
+                if r["status"] == "baixando":   # download já pedido (uma vez só): só espera ficar ⚡
+                    await _set_status(r["id"], "baixando")
+                    counts["downloading"] += 1
+                    continue
+                choice = _pick_predownload(streams)
+                if choice:
+                    st = await _trigger_download(s, choice)
+                    if st is not None:
+                        await _set_status(r["id"], "baixando", note=sid)
+                        await send_telegram(f"📥 {label} saiu dublado, baixando ({choice['res']} no {choice['service']}). "
+                                            f"Te aviso aqui quando ficar ⚡ pronto.")
+                        counts["downloading"] += 1
+                        continue
+                    logger.warning(f"wishlist: pedido de download falhou para {label}")
+                await _set_status(r["id"], "esperando")
+                counts["waiting"] += 1
+            except asyncio.CancelledError:
+                raise
+            except Exception as e:
+                counts["errors"] += 1
+                logger.warning(f"wishlist: erro ao conferir {r['title']}: {type(e).__name__}: {e}")
+        if await radar_enabled():
+            try:
+                counts["radar"] = await _radar_check(s, _streams, send_telegram)
+            except asyncio.CancelledError:
+                raise
+            except Exception as e:
+                counts["errors"] += 1
+                logger.warning(f"radar: erro na checagem: {type(e).__name__}: {e}")
+    logger.info(f"⭐ wishlist: {counts}")
+    return counts
+
+
+# ───────────────────────── radar de lançamentos ─────────────────────────
+
+def _d(iso: str | None) -> date | None:
+    try:
+        return date.fromisoformat(str(iso)[:10]) if iso else None
+    except ValueError:
+        return None
+
+
+def _radar_due(theatrical: str | None, digital: str | None) -> date | None:
+    dg = _d(digital)
+    if dg:
+        return dg
+    th = _d(theatrical)
+    return th + timedelta(days=RADAR_FALLBACK_DAYS) if th else None
+
+
+def _br_dates(release_dates: dict | None) -> tuple[str | None, str | None]:
+    """(cinema BR, digital BR) de movie/<id>/release_dates. Digital = tipo 4; sem ele, físico (tipo 5)."""
+    by_type: dict[int, list[str]] = {}
+    for c in (release_dates or {}).get("results") or []:
+        if c.get("iso_3166_1") != "BR":
+            continue
+        for rd in c.get("release_dates") or []:
+            if rd.get("release_date"):
+                by_type.setdefault(int(rd.get("type") or 0), []).append(str(rd["release_date"])[:10])
+    theatrical = min(by_type.get(3) or by_type.get(2) or [None], key=lambda x: x or "")
+    digital = min(by_type.get(4) or by_type.get(5) or [None], key=lambda x: x or "")
+    return theatrical, digital
+
+
+async def radar_refresh(force: bool = False) -> int:
+    """1×/dia (e só com o radar ligado): filmes no cinema / a estrear no BR + datas digitais BR. Devolve quantos viu."""
+    await _ensure_tables()
+    today = _today().isoformat()
+    if not force and (not await radar_enabled() or await _get_setting("radar_last_refresh") == today):
+        return 0
+    from comet.metadata.tmdb import TMDBApi
+    seen = 0
+    async with aiohttp.ClientSession(timeout=aiohttp.ClientTimeout(total=20)) as s:
+        tmdb = TMDBApi(s)
+        movies: dict[int, dict] = {}
+        for lst in ("now_playing", "upcoming"):
+            for page in (1, 2):
+                data = await tmdb._get_json(f"movie/{lst}?region=BR&language=pt-BR&page={page}", f"radar {lst} {page}")
+                for m in (data or {}).get("results") or []:
+                    if m.get("id"):
+                        movies.setdefault(m["id"], m)
+                await asyncio.sleep(0.5)
+        known = {r["imdb"]: r for r in await database.fetch_all("SELECT * FROM radar")}
+        for tid, m in movies.items():
+            try:
+                imdb = _TMDB_IMDB.get(tid)
+                if not imdb:
+                    ext = await tmdb._get_json(f"movie/{tid}/external_ids", f"radar ext {tid}")
+                    imdb = (ext or {}).get("imdb_id")
+                    if not imdb:
+                        continue
+                    _TMDB_IMDB[tid] = imdb
+                old = known.get(imdb)
+                if old and (old["status"] != "cinema" or old["digital"]):
+                    continue  # já avisado/encerrado ou já tem data digital
+                rd = await tmdb._get_json(f"movie/{tid}/release_dates", f"radar dates {tid}")
+                theatrical, digital = _br_dates(rd)
+                theatrical = theatrical or (m.get("release_date") or None)
+                title = m.get("title") or m.get("original_title") or imdb
+                year = (theatrical or m.get("release_date") or "")[:4]
+                await database.execute(
+                    "INSERT INTO radar (imdb, title, theatrical, digital, status, notified_at) "
+                    "VALUES (:i, :t, :th, :dg, 'cinema', NULL) ON CONFLICT(imdb) DO UPDATE SET "
+                    "title = :t, theatrical = :th, digital = :dg",
+                    {"i": imdb, "t": f"{title} ({year})" if year else title, "th": theatrical, "dg": digital},
+                )
+                seen += 1
+                await asyncio.sleep(0.5)
+            except asyncio.CancelledError:
+                raise
+            except Exception as e:
+                logger.debug(f"radar: {tid}: {type(e).__name__}: {e}")
+    await _set_setting("radar_last_refresh", today)
+    logger.info(f"🎬 radar: {seen} filmes atualizados")
+    return seen
+
+
+async def _radar_check(session, streams_fn, send_fn) -> int:
+    today = _today()
+    rows = await database.fetch_all("SELECT * FROM radar WHERE status = 'cinema'")
+    due = []
+    for r in rows:
+        when = _radar_due(r["theatrical"], r["digital"])
+        th = _d(r["theatrical"]) or when
+        if not when or when > today:
+            continue
+        if th and (today - th).days > RADAR_GIVE_UP_DAYS:
+            await database.execute("UPDATE radar SET status = 'expirado' WHERE imdb = :i", {"i": r["imdb"]})
+            continue
+        if _now() - _radar_seen.get(r["imdb"], 0) < RADAR_RECHECK:
+            continue
+        due.append((when, r))
+    due.sort(key=lambda x: x[0])
+    notified = 0
+    for _, r in due[:RADAR_MAX_PER_RUN]:
+        await _pace()
+        _radar_seen[r["imdb"]] = _now()
+        trim(_radar_seen, 5000)
+        try:
+            streams = await streams_fn(session, "movie", r["imdb"])
+        except asyncio.CancelledError:
+            raise
+        except Exception:
+            continue
+        ready = _pt_ready(streams, skip_cam=True)
+        if ready:
+            await database.execute("UPDATE radar SET status = 'avisado', notified_at = :t WHERE imdb = :i",
+                                   {"t": _now(), "i": r["imdb"]})
+            await send_fn(f"🎬 Saiu do cinema e já tem dublado: {r['title']}\n{ready}\nÉ só abrir no Stremio.")
+            notified += 1
+    return notified
+
+
+def _fmt(d: date | None) -> str:
+    return d.strftime("%d/%m") if d else "?"
+
+
+async def radar_text() -> str:
+    on = await radar_enabled()
+    lines = [f"🎬 Radar de lançamentos: {'ligado ✅' if on else 'desligado'}"]
+    rows = await database.fetch_all("SELECT * FROM radar WHERE status = 'cinema'")
+    today = _today()
+    nxt = sorted(((_radar_due(r["theatrical"], r["digital"]), r) for r in rows),
+                 key=lambda x: x[0] or date.max)
+    nxt = [(d, r) for d, r in nxt if d and d >= today][:5]
+    if nxt:
+        lines.append("Próximos a sair do cinema:")
+        for d, r in nxt:
+            how = "digital" if r["digital"] else "estimativa"
+            lines.append(f"• {r['title']} — {_fmt(d)} ({how})")
+    elif on:
+        lines.append("Ainda sem filmes na lista (atualizo 1×/dia).")
+    lines.append("/radar on · /radar off")
+    return "\n".join(lines)
+
+
+# ───────────────────────── comandos do bot ─────────────────────────
+
+_NATURAL = [
+    re.compile(r"^(?:me\s+)?avis(?:a|e|ar)(?:\s*-?\s*me)?\s+(?:quando|qdo|qnd|assim que)\s+"
+               r"(?:sair|chegar|lancar|tiver|estiver|ficar|aparecer)\s+(?:o\s+|a\s+)?(?P<t>.+)$"),
+    re.compile(r"^(?:eu\s+)?quero\s+(?:ver\s+|assistir\s+)?(?P<t>.*\bdublad[oa]s?\b.*)$"),
+]
+
+
+async def handle_command(text: str) -> str | None:
+    """Comandos da lista de desejos/radar. None = não é comigo (o bot segue o roteamento normal)."""
+    raw = (text or "").strip()
+    low = raw.lower()
+    cmd, _, arg = raw.partition(" ")
+    cmd = cmd.lower().split("@", 1)[0]
+    arg = arg.strip()
+    try:
+        if cmd == "/quero":
+            return await add_from_text(arg) if arg else "Use: /quero <nome>. Ex.: /quero Duna 3 ou /quero The Last of Us T2E3"
+        if cmd == "/desejos":
+            return await list_text()
+        if cmd == "/remover":
+            if not arg.isdigit():
+                return "Use: /remover <nº> (o número aparece em /desejos)."
+            return await remove(int(arg))
+        if cmd == "/radar":
+            a = _norm(arg)
+            if a in ("on", "ligar", "liga", "sim"):
+                await _set_setting("radar_enabled", "1")
+                _spawn(radar_refresh())
+                return ("🎬 Radar ligado. Atualizo a lista dos filmes no cinema 1×/dia e te aviso quando um deles "
+                        "sair dublado (sem CAM). /radar mostra os próximos.")
+            if a in ("off", "desligar", "desliga", "nao"):
+                await _set_setting("radar_enabled", "0")
+                return "🎬 Radar desligado."
+            return await radar_text()
+        if low.startswith("/"):
+            return None
+        n = _norm(raw).rstrip(" !?.")
+        for rx in _NATURAL:
+            m = rx.match(n)
+            if m and len(m.group("t").strip()) >= 2:
+                return await add_from_text(m.group("t"))
+        return None
+    except asyncio.CancelledError:
+        raise
+    except Exception as e:
+        logger.warning(f"wishlist: falha no comando \"{raw[:40]}\": {type(e).__name__}: {e}")
+        return "😵 Deu um erro na lista de desejos. Tenta de novo daqui a pouco."
+
+
+# ───────────────────────── serviço periódico ─────────────────────────
+
+async def start_wishlist_service() -> None:
+    """Task de fundo: 10 min após subir, depois a cada 3 h: radar_refresh (1×/dia) + check_all."""
+    await asyncio.sleep(FIRST_DELAY)
+    logger.info("⭐ wishlist: serviço ligado")
+    while True:
+        try:
+            await radar_refresh()
+        except asyncio.CancelledError:
+            raise
+        except Exception as e:
+            logger.warning(f"radar: refresh falhou: {type(e).__name__}: {e}")
+        try:
+            await check_all()
+        except asyncio.CancelledError:
+            raise
+        except Exception as e:
+            logger.warning(f"wishlist: check_all falhou: {type(e).__name__}: {e}")
+        await asyncio.sleep(CHECK_EVERY)
