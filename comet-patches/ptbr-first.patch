+
+            provider_id = item_providers.get(it.get("id"))
+            if catalog_id == "comet_top10" and poster_path:
+                meta["_raw_poster_path"] = poster_path
+                meta["_provider_id"] = provider_id
+
+            badge = None
+            if needs_badges:
