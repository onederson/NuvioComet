+def _dot(h: int, color=WHITE) -> Image.Image:
+    """Bolinha com halo (AO VIVO / HOJE)."""
+    h = max(4, int(h))
+    im = Image.new("RGBA", (h, h), (0, 0, 0, 0))
+    d = ImageDraw.Draw(im)
+    d.ellipse((0, 0, h - 1, h - 1), fill=_rgba(color, 80))
+    k = h * 0.24
+    d.ellipse((k, k, h - 1 - k, h - 1 - k), fill=_rgba(color))
+    return im
