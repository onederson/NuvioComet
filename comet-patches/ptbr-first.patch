+async def _fetch_catalog_items(
+    media_type: str, catalog_id: str, genre: str | None, skip: int, base_url: str = "", kids: bool = False
+) -> list[dict]:
+    if catalog_id == "comet_top10" and skip > 0:
+        return []
+
+    _ensure_imdb_map_loaded()
+    page1 = (skip // 40) * 2 + 1
+    page2 = page1 + 1
+
+    query1 = _build_tmdb_path_and_params(media_type, catalog_id, genre, page1, kids=kids)
+    if not query1:
+        return []
+
+    query2 = (
+        None
+        if catalog_id == "comet_top10"
+        else _build_tmdb_path_and_params(media_type, catalog_id, genre, page2, kids=kids)
+    )
+
+    path1, params1 = query1
+    url1 = f"{path1}?{urllib.parse.urlencode(params1)}"
+    url2 = (
+        f"{query2[0]}?{urllib.parse.urlencode(query2[1])}" if query2 else None
+    )
+
+    timeout = aiohttp.ClientTimeout(total=8.0)
+    async with aiohttp.ClientSession(timeout=timeout) as session:
+        tmdb = TMDBApi(session)
+        tasks = [tmdb._get_json(url1, f"catalog {catalog_id} p{page1}")]
+        if url2:
+            tasks.append(tmdb._get_json(url2, f"catalog {catalog_id} p{page2}"))
+        gather_res = await asyncio.gather(*tasks, return_exceptions=True)
+
+        raw_items = []
+        for res in gather_res:
+            if isinstance(res, dict) and isinstance(res.get("results"), list):
+                raw_items.extend(res["results"])
+
+        unique_raw_items = []
+        seen_tmdb_ids = set()
+        today_str = datetime.date.today().isoformat()
+        is_lancamentos = (
+            genre in ("Lançamentos", "Lancamentos") or (catalog_id == "comet_new" or _seasonal.is_new_list(catalog_id))
+        )
+
+        for item in raw_items:
+            if not isinstance(item, dict):
+                continue
+            if catalog_id == "comet_kids_tv" and item.get("original_language") == "ja":
+                continue
+            tid = item.get("id")
+            poster = item.get("poster_path")
+            if not tid or not poster or tid in seen_tmdb_ids:
+                continue
+            # If Lancamentos or comet_new, guarantee no future releases
+            if is_lancamentos:
+                rel_date = (
+                    item.get("release_date")
+                    if media_type == "movie"
+                    else item.get("first_air_date")
+                )
+                if rel_date and rel_date > today_str:
+                    continue
+            seen_tmdb_ids.add(tid)
+            unique_raw_items.append(item)
+            if catalog_id == "comet_top10" and len(unique_raw_items) >= 15:
+                break
+
+        tmdb_type = "movie" if media_type == "movie" else "tv"
+        sem = asyncio.Semaphore(10)
+        cache_updated = False
+        landscape_cache_updated = False
+
+        is_landscape = (
+            getattr(settings, "CATALOG_LANDSCAPE", True)
+            and not kids
+            and catalog_id != "comet_top10"
+            and not catalog_id.startswith("comet_orig_")
+            and catalog_id not in (
+                "comet_saga",
+                "comet_sagas",
+                "comet_previewtest",
+                "comet_search",
+                "comet_person",
+                "comet_kids_tv",
+                "comet_kids_anim",
+            )
+        )
+        needs_badges = (
+            (is_landscape or catalog_id.startswith("comet_orig_"))
+            and not kids
+            and catalog_id != "comet_top10"
+        )
+
+        if is_landscape:
+            _ensure_landscape_map_loaded()
+
+        top10_task = None
+        ready_task = None
+        if needs_badges:
+            top10_task = asyncio.create_task(_get_top10_imdb_ids(media_type, session, tmdb))
+            if catalog_id != "comet_ready":
+                ready_task = asyncio.create_task(_get_ready_tt_list(media_type))
+
+        async def resolve_imdb(tmdb_id: int) -> str | None:
+            nonlocal cache_updated
+            cache_key = f"{tmdb_type}:{tmdb_id}"
+            if cache_key in _IMDB_MAP:
+                return _IMDB_MAP[cache_key]
+
+            async with sem:
+                data = await tmdb._get_json(
+                    f"{tmdb_type}/{tmdb_id}/external_ids",
+                    f"{tmdb_type} external_ids {tmdb_id}",
+                )
+                if isinstance(data, dict):
+                    imdb_id = data.get("imdb_id")
+                    if isinstance(imdb_id, str) and imdb_id.startswith("tt"):
+                        _IMDB_MAP[cache_key] = imdb_id
+                        cache_updated = True
+                        return imdb_id
+            return None
+
+        async def resolve_landscape(tmdb_id: int, fallback_backdrop: str | None = None) -> dict | None:
+            nonlocal landscape_cache_updated
+            cache_key = f"{tmdb_type}:{tmdb_id}"
+            if cache_key in _LANDSCAPE_MAP:
+                val = _LANDSCAPE_MAP[cache_key]
+                if isinstance(val, dict) and "backdrop" in val:
+                    return val
+
+            async with sem:
+                data = await tmdb._get_json(
+                    f"{tmdb_type}/{tmdb_id}/images?include_image_language=pt,en,null",
+                    f"{tmdb_type} images {tmdb_id}",
+                )
+                chosen_backdrop = None
+                chosen_logo = None
+                if isinstance(data, dict):
+                    backdrops = data.get("backdrops")
+                    if isinstance(backdrops, list) and backdrops:
+                        null_bds = [
+                            b.get("file_path")
+                            for b in backdrops
+                            if isinstance(b, dict)
+                            and (b.get("iso_639_1") is None or b.get("iso_639_1") == "null")
+                            and b.get("file_path")
+                        ]
+                        if null_bds:
+                            chosen_backdrop = null_bds[0]
+                        else:
+                            any_bds = [
+                                b.get("file_path")
+                                for b in backdrops
+                                if isinstance(b, dict) and b.get("file_path")
+                            ]
+                            if any_bds:
+                                chosen_backdrop = any_bds[0]
+
+                    logos = data.get("logos")
+                    if isinstance(logos, list) and logos:
+                        valid_logos = [
+                            l for l in logos
+                            if isinstance(l, dict)
+                            and l.get("file_path")
+                            and l.get("file_path", "").lower().endswith(".png")
+                        ]
+                        pt_logos = [
+                            l for l in valid_logos
+                            if l.get("iso_639_1") == "pt"
+                        ]
+                        if pt_logos:
+                            pt_logos.sort(key=lambda x: float(x.get("vote_average") or 0.0), reverse=True)
+                            chosen_logo = pt_logos[0].get("file_path")
+                        else:
+                            en_logos = [
+                                l for l in valid_logos
+                                if l.get("iso_639_1") == "en"
+                            ]
+                            if en_logos:
+                                en_logos.sort(key=lambda x: float(x.get("vote_average") or 0.0), reverse=True)
+                                chosen_logo = en_logos[0].get("file_path")
+
+                if not chosen_backdrop and fallback_backdrop:
+                    chosen_backdrop = fallback_backdrop
+
+                res = {
+                    "backdrop": chosen_backdrop.lstrip("/") if chosen_backdrop else None,
+                    "logo": chosen_logo.lstrip("/") if chosen_logo else None,
+                }
+                _LANDSCAPE_MAP[cache_key] = res
+                landscape_cache_updated = True
+                return res
+
+        async def resolve_new_ep(tid: int) -> bool:
+            now = time.time()
+            cached = _TV_LAST_EP_CACHE.get(tid)
+            if cached is not None and (now - cached[0]) < 12 * 3600:
+                air_date = cached[1]
+            else:
+                air_date = None
+                async with sem:
+                    try:
+                        tv_data = await tmdb._get_json(f"tv/{tid}?language=pt-BR", f"tv {tid}")
+                        if isinstance(tv_data, dict):
+                            last_ep = tv_data.get("last_episode_to_air")
+                            if isinstance(last_ep, dict) and last_ep.get("air_date"):
+                                air_date = str(last_ep["air_date"])
+                        _TV_LAST_EP_CACHE[tid] = (now, air_date)
+                    except Exception:
+                        _TV_LAST_EP_CACHE[tid] = (now, None)
+            if air_date:
+                try:
+                    ep_date = datetime.date.fromisoformat(air_date)
+                    diff = (datetime.date.today() - ep_date).days
+                    return -1 <= diff <= 10
+                except ValueError:
+                    pass
+            return False
+
+        async def resolve_item(item: dict):
+            tid = item["id"]
+            tasks = [resolve_imdb(tid)]
+            if is_landscape:
+                tasks.append(resolve_landscape(tid, item.get("backdrop_path")))
+            else:
+                tasks.append(asyncio.sleep(0, result=None))
+
+            if needs_badges and media_type == "series" and _is_relevant_series(item):
+                tasks.append(resolve_new_ep(tid))
+            else:
+                tasks.append(asyncio.sleep(0, result=False))
+
+            res = await asyncio.gather(*tasks, return_exceptions=True)
+            imdb_id = res[0] if isinstance(res[0], str) else None
+            landscape_data = res[1] if isinstance(res[1], dict) else None
+            is_new_ep = res[2] if isinstance(res[2], bool) else False
+            return imdb_id, landscape_data, is_new_ep
+
+        resolved_pairs = await asyncio.gather(
+            *[resolve_item(it) for it in unique_raw_items],
+            return_exceptions=True,
+        )
+
+        if cache_updated:
+            await asyncio.to_thread(_save_imdb_map)
+        if landscape_cache_updated:
+            await asyncio.to_thread(_save_landscape_map)
+
+        top10_set = (await top10_task) if top10_task else set()
+        ready_tt_list = (await ready_task) if ready_task else []
+        ready_set = set(ready_tt_list)
+
+        # Provider resolution for row
+        row_mounts_art = is_landscape or catalog_id == "comet_top10" or catalog_id.startswith("comet_orig_")
+        row_provider_id = None
+        if catalog_id.startswith("comet_orig_"):
