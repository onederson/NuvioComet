+    draw.rectangle([ix + icon * 0.22, cy + icon * 0.34, ix + icon * 0.78, cy + icon * 0.5], fill="#2B1D00")
+    tx = ix + icon + gap - bb[0]
+    ty = y0 + (bh - th) / 2 - bb[1]
