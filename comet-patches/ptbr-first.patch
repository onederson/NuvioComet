+def clean_name(name: str) -> str:
+    s = re.sub(r"\s*\[[^\]]*\]\s*", " ", name or "")
+    s = re.sub(r"\s*\((?:ZY[A-Z]?\s?\d+|[^)]*\bMHz\b)[^)]*\)", " ", s)  # (ZYD241, 94,3 MHz FM)
+    s = re.sub(r"\s+", " ", s).strip(" -|·")
+    if s.isupper() and len(s) > 4:
+        s = s.title()
+    return s or "Rádio"
