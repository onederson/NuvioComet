+
+        is_pt = "pt" in c_langs
+        seeders = row["seeders"] or 0
+        c_res_rank = _RES_PRIORITY.get(c_res, 99)
+
+        if orig_res and c_res == orig_res and is_pt:
+            bucket1.append((row, -seeders, is_cam))
+        elif is_pt:
+            bucket2.append((row, c_res_rank, -seeders, is_cam))
+        elif orig_res and c_res == orig_res:
+            bucket3.append((row, -seeders, is_cam))
+
+    bucket1.sort(key=lambda x: x[1])
+    bucket2.sort(key=lambda x: (x[1], x[2]))
+    bucket3.sort(key=lambda x: x[1])
+
+    if settings.DEMOTE_CAM:
+        bons = (
+            [x[0] for x in bucket1 if not x[-1]]
+            + [x[0] for x in bucket2 if not x[-1]]
+            + [x[0] for x in bucket3 if not x[-1]]
+        )
+        cam = (
+            [x[0] for x in bucket1 if x[-1]]
