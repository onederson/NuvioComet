+def _kids_bedtime_window() -> tuple[int, int] | None:
+    """Janela 'HH:MM-HH:MM' de KIDS_BEDTIME (.env); desligado por padrão (ex.: KIDS_BEDTIME=21:00-07:00)."""
+    raw = getattr(settings, "KIDS_BEDTIME", None)
+    if raw is None:
+        try:
+            for line in open("/opt/comet/.env", encoding="utf-8"):
+                if line.startswith("KIDS_BEDTIME="):
+                    raw = line.split("=", 1)[1].strip().strip('"')
+        except OSError:
+            pass
+    raw = (raw or "off").strip().lower()
+    if raw in ("off", "0", "false", "nao", "não", ""):
+        return None
+    m = re.match(r"^(\d{1,2}):(\d{2})\s*-\s*(\d{1,2}):(\d{2})$", raw)
+    if not m:
+        return None
+    a = int(m.group(1)) * 60 + int(m.group(2))
+    b = int(m.group(3)) * 60 + int(m.group(4))
+    return a, b
+
