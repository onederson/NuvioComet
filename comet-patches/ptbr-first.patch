+    pad_y = max(4, round((badge_h - font_size) / 2))
+    pad_x = max(8, round(badge_h * 0.35))
+    radius = max(4, round(badge_h * 0.16))
+    margin = max(10, round(H * (0.025 if is_poster else 0.035)))
+    top10_s = round(badge_h * 1.85)
+    provider_size = max(24, round(H * (0.10 if is_poster else 0.16)))
+    return {
+        "badge_h": badge_h,
+        "font_size": font_size,
+        "pad_x": pad_x,
+        "pad_y": pad_y,
+        "radius": radius,
+        "margin": margin,
+        "top10_s": top10_s,
+        "provider_size": provider_size,
