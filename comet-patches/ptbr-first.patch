+def norm(s: str) -> str:
+    s = unicodedata.normalize("NFKD", s or "")
+    s = "".join(c for c in s if not unicodedata.combining(c))
+    return s.lower().strip()
+
+
+def norm_name(name: str) -> str:
+    s = norm(name)
+    s = re.sub(r"\[[^\]]*\]", " ", s)                                   # [aac], [MP3 192Kbps]
+    s = re.sub(r"\b(radio|web ?radio|fm|am|oficial|official|hd)\b", " ", s)
+    s = re.sub(r"\b(aac\+?|mp3|ogg|opus|\d+ ?kbps)\b", " ", s)
+    return re.sub(r"[^a-z0-9]+", "", s)
+
