+def detect_location(st: dict) -> tuple[str, str]:
+    """Devolve (UF, cidade) — strings vazias quando não dá para saber."""
+    iso = (st.get("iso_3166_2") or "").upper()
+    state = st.get("state") or ""
+    name = st.get("name") or ""
+    tags = st.get("tags") or ""
+    sn = norm(state)
+    uf = ""
+    city = ""
+    if iso.startswith("BR-") and iso[3:] in UFS:
+        uf = iso[3:]
+    c = _find_city(sn, name_mode=False) if sn else None
+    if c:
+        city, cuf = c
+        uf = uf or cuf
+    if not uf and sn:
+        m = _UF_NAME_RE.search(sn)
+        if m:
+            uf = _UF_BY_NORMNAME[m.group(1)]
+    if not uf and state:
+        m = _UF_CODE_RE.search(state.upper() if len(state.strip()) <= 3 else state)
+        if m:
+            uf = m.group(1)
+    if not city:
+        c = _find_city(norm(name), name_mode=True) or _find_city(norm(tags), name_mode=True)
+        if c and (not uf or c[1] == uf):
+            city, uf = c[0], c[1]
+    if not uf:
+        m = _UF_IN_NAME_RE.search(name)
+        if m:
+            uf = m.group(1)
+    if not city and state and ("," in state or " - " in state):
+        first = re.split(r",| - ", state)[0].strip()
+        if first and norm(first) not in _UF_BY_NORMNAME and first.upper() not in UFS \
+                and norm(first) not in ("brasil", "brazil"):
+            city = first
+    if city and norm(city) in _UF_BY_NORMNAME and _UF_BY_NORMNAME[norm(city)] == uf \
+            and uf != "RJ" and uf != "SP":
+        city = ""
+    return uf, city
