index 0000000..5e63bdf
--- /dev/null
+++ b/comet/services/reminders.py
@@ -0,0 +1,224 @@
+"""Lembrete de programa ao vivo (Pluto): /lembrar, /lembretes, /esquecer."""
+import asyncio
+import datetime
+import json
+import os
+import re
+import time
+import unicodedata
+
+from comet.core.logger import logger
+
+STATE_PATH = "/opt/comet/data/reminders.json"
+BR_TZ = datetime.timezone(datetime.timedelta(hours=-3))  # America/Recife, sem horário de verão
+WARN_MIN = 6  # avisa quando faltar até 6 min
+CHECK_EVERY = 300
+KEEP_NOTIFIED_S = 2 * 86400
+_STOP = {"o", "a", "os", "as", "de", "do", "da", "dos", "das"}
+
+HELP = (
+    "/lembrar Chaves — aviso 5 min antes de passar na TV\n"
+    "/lembretes — seus lembretes\n"
+    "/esquecer Chaves — para de avisar"
+)
+
+
+# ───────────────────────── funções puras ─────────────────────────
+
+def norm(t: str) -> str:
+    t = unicodedata.normalize("NFKD", t or "").encode("ascii", "ignore").decode().lower()
+    return re.sub(r"\s+", " ", re.sub(r"[^a-z0-9 ]+", " ", t)).strip()
+
+
+def words(query: str) -> list[str]:
+    return [w for w in norm(query).split() if w not in _STOP]
+
+
+def parse_command(text: str) -> tuple[str, str] | None:
+    """('lembrar'|'lembretes'|'esquecer', argumento) ou None."""
+    m = re.match(r"^/(lembrar|lembretes|esquecer)(?:@\w+)?\s*(.*)$", (text or "").strip(), re.I | re.S)
+    if not m:
+        return None
+    return m.group(1).lower(), m.group(2).strip()
+
+
+def _parse_iso(s) -> datetime.datetime | None:
+    try:
+        return datetime.datetime.fromisoformat(str(s).replace("Z", "+00:00"))
+    except Exception:
+        return None
+
+
+def _titles(t: dict) -> list[str]:
+    out = [t.get("title") or t.get("name") or ""]
+    ep = t.get("episode") or {}
+    if isinstance(ep, dict):
+        out.append(ep.get("name") or "")
+        ser = ep.get("series") or {}
+        if isinstance(ser, dict):
+            out.append(ser.get("name") or "")
+    return [x for x in out if x]
+
+
+def matches(t: dict, query: str) -> bool:
+    ws = words(query)
+    if not ws:
+        return False
+    for title in _titles(t):
+        have = set(norm(title).split())
+        if all(w in have for w in ws):
+            return True
+    return False
+
+
+def find_airings(channels: list[dict], query: str, now: datetime.datetime) -> list[dict]:
+    """Exibições que ainda não terminaram, ordenadas por início."""
+    out = []
+    for ch in channels or []:
+        if not isinstance(ch, dict):
+            continue
+        for t in ch.get("timelines") or []:
+            start, stop = _parse_iso(t.get("start")), _parse_iso(t.get("stop"))
+            if not start or not stop or stop <= now:
+                continue
+            if matches(t, query):
+                out.append({"start": start, "title": t.get("title") or t.get("name") or query,
+                            "channel": ch.get("name") or "canal", "cid": ch.get("_id") or "",
+                            "start_iso": t.get("start")})
+    out.sort(key=lambda a: a["start"])
+    return out
+
+
+def due_alerts(channels: list[dict], queries: list[str], now: datetime.datetime,
+               notified: dict) -> list[dict]:
+    """Programas que começam em até WARN_MIN min e ainda não foram avisados."""
+    out = []
+    for q in queries:
+        for a in find_airings(channels, q, now):
+            mins = (a["start"] - now).total_seconds() / 60
+            if mins <= 0 or mins > WARN_MIN:
+                continue
+            key = f"{a['cid']}|{a['start_iso']}|{q}"
+            if key in notified:
+                continue
+            out.append({**a, "key": key, "query": q})
+    return out
+
+
+def when_label(start: datetime.datetime, now: datetime.datetime) -> str:
+    s, n = start.astimezone(BR_TZ), now.astimezone(BR_TZ)
+    hhmm = s.strftime("%H:%M")
+    d = (s.date() - n.date()).days
+    day = "hoje" if d == 0 else "amanhã" if d == 1 else s.strftime("%d/%m")
+    return f"{day} às {hhmm}"
+
+
+def link(cid: str) -> str:
+    return f"stremio:///detail/tv/cometlive:pluto:{cid}" if cid else ""
+
+
+# ───────────────────────── estado ─────────────────────────
+
+def _load() -> dict:
+    try:
+        with open(STATE_PATH, encoding="utf-8") as f:
+            d = json.load(f)
+        if isinstance(d, dict):
+            d.setdefault("queries", [])
+            d.setdefault("notified", {})
+            return d
+    except (OSError, ValueError):
+        pass
+    return {"queries": [], "notified": {}}
+
+
+def _save(d: dict) -> None:
+    tmp = STATE_PATH + ".tmp"
+    with open(tmp, "w", encoding="utf-8") as f:
+        json.dump(d, f, ensure_ascii=False)
+    os.replace(tmp, STATE_PATH)
+
+
+async def _channels() -> list[dict]:
+    from comet.services.live_tv import get_pluto_channels
+    return await get_pluto_channels()
+
+
+# ───────────────────────── comandos ─────────────────────────
+
+async def handle_command(text: str) -> str | None:
+    p = parse_command(text)
+    if not p:
+        return None
+    cmd, arg = p
+    st = _load()
+    now = datetime.datetime.now(datetime.timezone.utc)
+    if cmd == "lembretes":
+        if not st["queries"]:
+            return "Nenhum lembrete ativo. Use /lembrar Chaves."
+        chs = await _channels()
+        lines = ["⏰ Seus lembretes:"]
+        for q in st["queries"]:
+            air = find_airings(chs, q, now)
+            nxt = (f"{air[0]['title']} {when_label(air[0]['start'], now)} no canal {air[0]['channel']}"
+                   if air else "ainda não está na grade")
+            lines.append(f"• {q} — {nxt}")
+        return "\n".join(lines)
+    if cmd == "esquecer":
+        if not arg:
+            return "Diga qual: /esquecer Chaves (ou /esquecer tudo)."
+        if norm(arg) == "tudo":
+            n = len(st["queries"])
+            st["queries"] = []
+            _save(st)
+            return f"Pronto, {n} lembrete(s) removido(s)." if n else "Não havia lembretes."
+        q = norm(arg)
+        if q in st["queries"]:
+            st["queries"].remove(q)
+            _save(st)
+            return f"Pronto, não aviso mais sobre {arg}."
+        return f"Não tenho lembrete de {arg}. Veja /lembretes."
+    # lembrar
+    if not words(arg):
+        return "Diga o programa: /lembrar Chaves."
+    q = norm(arg)
+    if q not in st["queries"]:
+        st["queries"].append(q)
+        _save(st)
+    air = find_airings(await _channels(), q, now)
+    if air:
+        a = air[0]
+        return (f"📺 {a['title']} passa {when_label(a['start'], now)} no canal {a['channel']}. "
+                f"Te aviso 5 min antes.\n{link(a['cid'])}").strip()
+    return "Ainda não está na grade das próximas horas; vou ficar de olho."
+
+
+async def status_lines() -> list[str]:
+    n = len(_load()["queries"])
+    return [f"⏰ Lembretes de TV: {n} ativo(s)"] if n else []
+
+
+# ───────────────────────── serviço de fundo ─────────────────────────
+
+async def _tick() -> None:
+    st = _load()
+    now = datetime.datetime.now(datetime.timezone.utc)
+    ts = time.time()
+    st["notified"] = {k: v for k, v in st["notified"].items() if ts - v < KEEP_NOTIFIED_S}
+    if st["queries"]:
+        from comet.services.telegram_bot import send_telegram
+        for a in due_alerts(await _channels(), st["queries"], now, st["notified"]):
+            hhmm = a["start"].astimezone(BR_TZ).strftime("%H:%M")
+            await send_telegram(f"⏰ Em 5 min: {a['title']} — {hhmm} no canal {a['channel']}\n{link(a['cid'])}")
+            st["notified"][a["key"]] = ts
+    _save(st)
+
+
+async def start_service() -> None:
+    await asyncio.sleep(120)
+    while True:
+        try:
+            await _tick()
+        except Exception as e:
+            logger.warning(f"reminders: {type(e).__name__}: {e}")
+        await asyncio.sleep(CHECK_EVERY)
