index 0000000..1450026
--- /dev/null
+++ b/comet/api/endpoints/live_routes.py
@@ -0,0 +1,95 @@
+"""Rotas sem config: abertura testada de canal ao vivo (e o repasse das rádios)."""
+from fastapi import APIRouter, Request
+from fastapi.responses import RedirectResponse, Response
+from comet.core.logger import log_swallowed
+
+router = APIRouter()
+
+
+@router.get("/live/pluto/{pluto_id}.m3u8", tags=["Live"])
+async def live_pluto(pluto_id: str):
+    from comet.services.live_tv import resolve_pluto_url
+    url = await resolve_pluto_url(pluto_id)
+    if not url:
+        return Response(status_code=404)
+    return RedirectResponse(url, status_code=302)
+
+
+_RADIO_ART: dict[str, bytes] = {}
+
+
+@router.get("/art/radio.png", tags=["Live"])
+async def radio_art(n: str = "Rádio", c: str = ""):
+    """Capa da rádio sem logo: nome grande sobre degradê, com a cidade embaixo."""
+    key = f"{n}|{c}"[:200]
+    png = _RADIO_ART.get(key)
+    if png is None:
+        import asyncio
+        png = await asyncio.to_thread(_draw_radio, n[:60], c[:40])
+        if len(_RADIO_ART) > 500:
+            _RADIO_ART.clear()
+        _RADIO_ART[key] = png
+    return Response(png, media_type="image/png", headers={"Cache-Control": "public, max-age=604800"})
+
+
+def _draw_radio(name: str, city: str) -> bytes:
+    import hashlib
+    import io
+    from PIL import Image, ImageDraw, ImageFont
+
+    W = 512
+    h = int(hashlib.md5(name.encode()).hexdigest()[:6], 16)
+    c1 = (20 + h % 60, 30 + (h >> 8) % 70, 90 + (h >> 16) % 120)
+    c2 = (c1[0] // 3, c1[1] // 3, c1[2] // 3)
+    img = Image.new("RGB", (W, W), c2)
+    d = ImageDraw.Draw(img)
+    for y in range(W):
+        t = y / W
+        d.line([(0, y), (W, y)], fill=tuple(int(c1[i] * (1 - t) + c2[i] * t) for i in range(3)))
+
+    def font(sz, bold=True):
+        for p in (("/usr/share/fonts/truetype/liberation/LiberationSans-Bold.ttf", "/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf")
