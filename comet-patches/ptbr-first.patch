+
+# ---------------------------------------------------------------- estado
+
+def _load_state() -> dict:
+    global _state
+    if _state is None:
+        try:
+            _state = json.loads(STATE_PATH.read_text(encoding="utf-8"))
+        except (OSError, ValueError):
