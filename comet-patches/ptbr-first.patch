+def _curated_shortcuts(candidates: list[dict], best_stream: dict | None, blocked_set: set) -> list[dict]:
+    """📱 Leve · 💎 Máxima qualidade · 🎧 Original — cópias de fontes prontas (⚡) com nome claro."""
+    GB = 1024 ** 3
+
+    def ok(c):
+        i = c.get("_info") or {}
+        if not i or i.get("kind") == "p2p" or not i.get("cached") or i.get("is_cam"):
+            return False
+        svc = str(i.get("debrid_service") or i.get("service") or "").lower()
+        h = str(i.get("info_hash") or "").lower()
+        if not ("torbox" in svc or svc == "tb") and h in blocked_set:
+            return False
+        return True
+
+    def res_of(i):
+        return str(i.get("resolution") or "").lower()
+
+    def score_q(c):
+        i = c.get("_info") or {}
+        mi = i.get("_media") or {}
+        v = mi.get("video") or {}
+        r = {"2160p": 4, "4k": 4, "1440p": 3, "1080p": 2, "720p": 1}.get(res_of(i), 0)
+        hdr = 1 if (v.get("hdr") and v.get("hdr") != "SDR") or any(t in str(i.get("raw_title") or "").upper() for t in ("HDR", "DV", "DOLBY.VISION")) else 0
+        risky = 1 if (v.get("dv_profile") == 5) else 0
+        return (-risky, r, hdr, float(mi.get("bitrate_mbps") or 0), (i.get("size") or 0))
+
+    pool = [c for c in candidates if ok(c) and c is not best_stream]
+    best_hash = str(((best_stream or {}).get("_info") or {}).get("info_hash") or "").lower()
+    pool = [c for c in pool if str((c.get("_info") or {}).get("info_hash") or "").lower() != best_hash]
+    out, used = [], set()
+
+    def add(c, name, line):
+        i = c["_info"]
+        h = str(i.get("info_hash") or "").lower()
+        if h in used:
+            return
+        used.add(h)
+        cp = dict(c)
+        cp["behaviorHints"] = dict(c.get("behaviorHints") or {})
+        cp["name"] = name
+        size = _format_size_gb(i.get("size"))
+        res = _format_resolution(i.get("resolution"))
+        desc = (c.get("description") or "").split("\n")
+        cp["description"] = "\n".join([" · ".join(p for p in [line, res, size] if p)] + desc[1:])
+        out.append(cp)
+
+    pt = [c for c in pool if (c.get("_info") or {}).get("is_pt") and (c.get("_info") or {}).get("has_pt") != 0]
+    # 📱 Leve: dublado, 720p/1080p, até 3 GB, o menor que ainda é bom
+    light = [c for c in pt if res_of(c["_info"]) in ("720p", "1080p") and 0 < (c["_info"].get("size") or 0) <= 3 * GB]
+    if light:
+        c = min(light, key=lambda c: ((0 if res_of(c["_info"]) == "1080p" else 1), c["_info"].get("size") or 0))
+        add(c, f"📱 Leve\n{_format_resolution(c['_info'].get('resolution'))}", "Para 4G e internet fraca")
+    # 💎 Máxima qualidade: 4K (dublado se houver), HDR, maior bitrate real
+    top_pool = [c for c in (pt or pool) if res_of(c["_info"]) in ("2160p", "4k")] or [c for c in pool if res_of(c["_info"]) in ("2160p", "4k")]
+    if top_pool:
+        c = max(top_pool, key=score_q)
+        add(c, f"💎 Máxima qualidade\n{_format_resolution(c['_info'].get('resolution'))}", "Melhor imagem disponível")
+    # 🎧 Original: melhor versão sem dublagem (para ver legendado)
+    orig = [c for c in pool if not (c.get("_info") or {}).get("is_pt") and res_of(c["_info"]) in ("1080p", "2160p", "4k")]
+    if orig:
+        c = max(orig, key=lambda c: ((1 if 0 < (c["_info"].get("size") or 0) <= 15 * GB else 0), (1 if res_of(c["_info"]) == "1080p" else 0), score_q(c)[:4]))
+        add(c, f"🎧 Original\n{_format_resolution(c['_info'].get('resolution'))}", "Áudio original (use legenda)")
+    return out
+
+
+_REMOTE_MAX_MBPS = float(getattr(settings, "REMOTE_MAX_MBPS", 12) or 12)  # teto do ▶ Assistir fora de casa
+
