+async def fetch_stations() -> list[dict]:
+    import httpx
+
+    params_base = {"hidebroken": "true", "order": "votes", "reverse": "true", "limit": "100000"}
+    queries = [
+        {"countrycode": "BR", **params_base},
+        {"state": "Pernambuco", **params_base},
+        {"name": "recife", **params_base},
+        {"name": "caruaru", **params_base},
+        {"name": "petrolina", **params_base},
+        {"name": "olinda", **params_base},
+    ]
+    last = None
+    async with httpx.AsyncClient(headers={"User-Agent": USER_AGENT}, timeout=30.0, follow_redirects=True) as c:
+        for host in await _api_servers():
+            try:
+                out: dict[str, dict] = {}
+                for i, q in enumerate(queries):
+                    try:
+                        r = await c.get(f"https://{host}/json/stations/search", params=q)
+                        r.raise_for_status()
+                        data = r.json()
+                    except Exception:
+                        if i == 0:
+                            raise
+                        continue
+                    for st in data:
+                        if i > 0 and (st.get("countrycode") or "").upper() not in ("BR", ""):
+                            continue
+                        out.setdefault(st.get("stationuuid", ""), st)
+                _state["api_server"] = host
+                logger.info(f"Rádio: {len(out)} estações do Radio Browser via {host}")
+                return list(out.values())
+            except Exception as e:
+                last = e
+                logger.warning(f"Rádio: servidor {host} falhou: {type(e).__name__}: {e}")
+    raise RuntimeError(f"nenhum servidor do Radio Browser respondeu ({last})")
+
+
+# ---------------------------------------------------------------------------
+# Validação completa
+# ---------------------------------------------------------------------------
+_TRANSIENT = ("timeout", "poucos bytes", "ConnectionResetError", "ValueError: resposta inválida: b''",
+              "sem sincronia", "IncompleteRead")
+
+
+async def validate_candidates(cands: list[dict], concurrency: int = CONCURRENCY,
+                              check_icons: bool = True, progress: Optional[Callable] = None) -> list[dict]:
+    import httpx
+
+    sem = asyncio.Semaphore(concurrency)
+    alive: list[dict] = []
+    now = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
+    _state["checked"] = 0
+    limits = httpx.Limits(max_connections=concurrency, max_keepalive_connections=4)
+    async with httpx.AsyncClient(headers={"User-Agent": USER_AGENT}, follow_redirects=True,
+                                 limits=limits) as client:
+        host_sems: dict[str, asyncio.Semaphore] = {}
+
+        async def one(r: dict):
+            # vários servidores de rádio limitam conexões por IP: no máximo 2 testes por host
+            hsem = host_sems.setdefault(urlsplit(r["url"]).hostname or "", asyncio.Semaphore(2))
+            async with hsem, sem:
+                res = await probe_url(r["url"])
+                if not res["ok"] and res["reason"].startswith(_TRANSIENT):
+                    await asyncio.sleep(1.5)  # servidor lento/ocupado: mais uma chance
+                    res = await probe_url(r["url"], budget=12.0)
+                if not res["ok"] and r.get("alt_url"):
+                    res = await probe_url(r["alt_url"])
+                if not res["ok"] and r.get("orig_url") and r["orig_url"] != r["url"]:
+                    res = await probe_url(r["orig_url"])
+                r = dict(r)
+                r["check"] = res
+                if res["ok"]:
+                    stream = res["final_url"]
+                    https_url = ""
+                    if r["url"].startswith("https://") and not res["hls"]:
+                        https_url = r["url"]  # o player segue o redirect sozinho
+                    elif stream.startswith("https://"):
+                        https_url = stream
+                    elif not res["hls"]:
+                        v = _https_variant(stream)
+                        if v:
+                            sub = await probe_url(v, budget=6.0)
+                            if sub["ok"]:
+                                https_url = sub["final_url"]
+                    r["stream_url"] = stream
+                    r["https_url"] = https_url
+                    r["hls"] = bool(res["hls"])
+                    r["fmt"] = res["fmt"]
+                    r["checked"] = now
+                    if not r["bitrate"] and res["bitrate"]:
+                        r["bitrate"] = res["bitrate"]
+                    if not r["codec"]:
+                        r["codec"] = {"mp3": "MP3", "aac": "AAC", "ogg": "OGG"}.get(res["fmt"], "")
+                    r["favicon"] = await check_favicon(client, r["favicon_src"]) if check_icons else ""
+                    alive.append(r)
+                _state["checked"] += 1
+                if progress:
+                    progress(r)
+
+        await asyncio.gather(*(one(r) for r in cands))
+    return order_default(alive)
+
+
+def _public_record(r: dict) -> dict:
+    keys = ("id", "name", "uf", "city", "region", "kinds", "tags", "codec", "bitrate", "hls", "fmt",
+            "stream_url", "https_url", "favicon", "homepage", "votes", "clickcount", "score", "checked")
+    out = {k: r.get(k) for k in keys}
+    for k, v in list(out.items()):
+        if v is None:
+            out[k] = [] if k == "kinds" else ("" if k not in ("bitrate", "votes", "clickcount", "score") else 0)
+    return out
+
+
+def save_alive(path: str, stations: list[dict]) -> None:
+    os.makedirs(os.path.dirname(os.path.abspath(path)), exist_ok=True)
+    data = {
+        "updated": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
+        "ts": time.time(),
+        "count": len(stations),
+        "stations": [_public_record(s) for s in stations],
+    }
+    tmp = path + ".tmp"
+    with open(tmp, "w", encoding="utf-8", newline="\n") as f:
+        json.dump(data, f, ensure_ascii=False, separators=(",", ":"))
+    os.replace(tmp, path)
+
+
+def load_alive(path: str) -> bool:
+    try:
+        with open(path, encoding="utf-8") as f:
+            data = json.load(f)
+    except FileNotFoundError:
+        return False
+    except Exception as e:
+        logger.warning(f"Rádio: não li {path}: {e}")
+        return False
+    sts = [s for s in data.get("stations") or [] if s.get("id") and s.get("stream_url")]
+    _install(sts, data.get("updated") or "", float(data.get("ts") or 0))
+    return True
+
+
+def _install(stations: list[dict], updated: str, ts: float) -> None:
+    global _stations, _by_id
+    _stations = order_default(stations)
+    _by_id = {s["id"]: s for s in _stations}
+    _state["updated"] = updated
+    _state["updated_ts"] = ts
+    _state["passed"] = len(_stations)
+
+
+async def refresh(path: Optional[str] = None) -> int:
+    """Busca, valida e grava. Devolve quantas passaram."""
+    path = path or _state["path"]
+    _state["running"] = True
+    t0 = time.monotonic()
+    try:
+        raw = await fetch_stations()
+        cands = build_candidates(raw)
+        _state["candidates"] = len(cands)
+        logger.info(f"Rádio: validando {len(cands)} candidatas ({sum(is_pe(c) for c in cands)} de PE)")
+        alive = await validate_candidates(cands)
+        if len(alive) < 20:  # rede fora ou algo quebrado: não grava lista vazia (tenta de novo em 30 min)
+            raise RuntimeError(f"validação aprovou só {len(alive)} estações; mantendo a lista anterior")
+        save_alive(path, alive)
+        _install([_public_record(a) for a in alive],
+                 datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"), time.time())
+        _state["last_error"] = ""
+        logger.info(f"Rádio: {len(alive)}/{len(cands)} no ar ({sum(is_pe(a) for a in alive)} de PE)")
+        return len(alive)
+    except Exception as e:
+        _state["last_error"] = f"{type(e).__name__}: {e}"
+        logger.warning(f"Rádio: atualização falhou: {e}")
+        return 0
+    finally:
+        _state["running"] = False
+        _state["duration_s"] = round(time.monotonic() - t0, 1)
+
+
+async def _loop(path: str, interval: float) -> None:
+    while True:
+        age = time.time() - float(_state["updated_ts"] or 0)
+        if age >= interval or not _stations:
+            await refresh(path)
+            wait = interval if _stations else 1800  # sem lista: tenta de novo em 30 min
+        else:
+            wait = interval - age
+        await asyncio.sleep(max(60.0, wait))
+
+
+async def start_radio_service(path: str = DEFAULT_PATH,
+                              fallback_poster: Optional[Callable[[str], str]] = None,
+                              interval: float = REVALIDATE_SECONDS) -> None:
+    """Carrega a lista salva e agenda a revalidação em segundo plano (idempotente)."""
+    global _task, _fallback_poster
+    _state["path"] = path
+    if fallback_poster is not None:
+        _fallback_poster = fallback_poster
+    if not _stations:
+        if load_alive(path):
+            logger.info(f"Rádio: {len(_stations)} estações carregadas de {path} ({_state['updated']})")
+    if _task is None or _task.done():
+        _task = asyncio.create_task(_loop(path, interval), name="radio-revalidate")
+
+
+def set_fallback_poster(fn: Optional[Callable[[str], str]]) -> None:
+    global _fallback_poster
+    _fallback_poster = fn
