+"""Futebol de Pernambuco no Comet: fileira "Hoje no futebol", capas com placar e avisos no Telegram.
+
+Fonte: API pública da ESPN (sem chave). Ids dos itens: ``cometlive:fut:<event_id>`` (type "tv").
+O intervalo de datas da ESPN (``dates=A-B``) devolve 400, então a busca é dia a dia.
+O Campeonato Pernambucano não existe na ESPN; a Série C só tem dados de 2025.
+"""
+import asyncio
+import json
+import os
+import time
+import unicodedata
+from datetime import datetime, timedelta, timezone
+from typing import Any, Optional
+
+import aiohttp
+from fastapi import APIRouter, Response
+from PIL import Image, ImageDraw
+
+from comet.core.logger import logger, log_swallowed
+from comet.core.models import settings
+from comet.services import live_art as la
+
+try:
+    from zoneinfo import ZoneInfo
+
+    TZ = ZoneInfo("America/Recife")
+except Exception:  # pragma: no cover
+    TZ = timezone(timedelta(hours=-3))
+
+ID_PREFIX = "cometlive:fut:"
+ROWS = [{"type": "tv", "id": "comet_fut", "name": "⚽ Hoje no futebol"}]
+
+ESPN = "https://site.api.espn.com/apis/site/v2/sports/soccer/"
+LEAGUES = [  # (slug, nome)
+    ("bra.1", "Brasileirão Série A"),
+    ("bra.2", "Brasileirão Série B"),
+    ("bra.3", "Brasileirão Série C"),
+    ("bra.copa_do_brazil", "Copa do Brasil"),
+    ("bra.copa_do_nordeste", "Copa do Nordeste"),
+    ("conmebol.libertadores", "Libertadores"),
+    ("conmebol.sudamericana", "Sul-Americana"),
+]
+LEAGUE_NAME = dict(LEAGUES)
+PE_TEAMS = {"sport", "sport recife", "sport club do recife", "nautico", "clube nautico capibaribe",
+            "santa cruz", "santa cruz fc", "retro", "retro fc"}
+
+LOGO_DIR = "/opt/comet/data/live_art/fut"
+STATE_PATH = "/opt/comet/data/football_state.json"
+SLOW, FAST = 900.0, 60.0
+UA = {"User-Agent": "Mozilla/5.0 (Comet football)"}
+
+_events: dict[str, dict] = {}
+_pair_of: dict[str, tuple[str, str]] = {}
+_fetched_ts = 0.0
+_lock: Optional[asyncio.Lock] = None
+_card_cache: dict[str, bytes] = {}
+
+
+# ---------------------------------------------------------------- funções puras
+def norm(s: str) -> str:
+    s = unicodedata.normalize("NFKD", s or "")
+    return "".join(c for c in s if not unicodedata.combining(c)).lower().strip()
+
+
+def is_pe_team(team: dict) -> bool:
+    return norm(team.get("name", "")) in PE_TEAMS or norm(team.get("short", "")) in PE_TEAMS
+
+
+def _to_local(iso: str) -> datetime:
+    dt = datetime.strptime(iso.replace("Z", ""), "%Y-%m-%dT%H:%M").replace(tzinfo=timezone.utc)
+    return dt.astimezone(TZ)
+
+
+def _team(c: dict) -> dict:
+    t = c.get("team") or {}
+    d = {
+        "id": str(t.get("id") or c.get("id") or ""),
+        "name": t.get("displayName") or t.get("name") or "?",
+        "short": t.get("shortDisplayName") or t.get("name") or "",
+        "abbr": t.get("abbreviation") or "",
+        "logo": t.get("logo") or "",
+        "color": t.get("color") or "",
+        "alt": t.get("alternateColor") or "",
+        "score": int(float(c.get("score") or 0)) if str(c.get("score") or "0").replace(".", "").isdigit() else 0,
+        "home": c.get("homeAway") == "home",
+    }
+    d["pe"] = is_pe_team(d)
+    return d
+
+
+def parse_event(ev: dict, slug: str) -> Optional[dict]:
+    """Evento cru da ESPN -> dict simples (ou None se vier sem os dois times)."""
+    try:
+        comp = ev["competitions"][0]
+        cs = comp.get("competitors") or []
+        if len(cs) != 2:
+            return None
+        teams = [_team(c) for c in cs]
+        home = next((t for t in teams if t["home"]), teams[0])
+        away = next(t for t in teams if t is not home)
+        st = comp.get("status") or ev.get("status") or {}
+        typ = st.get("type") or {}
+        sname = typ.get("name") or ""
+        state = typ.get("state") or "pre"
+        if sname in ("STATUS_POSTPONED", "STATUS_CANCELED", "STATUS_SUSPENDED", "STATUS_DELAYED"):
+            special = sname
+        else:
+            special = ""
+        goals = []
+        for d in comp.get("details") or []:
+            if not d.get("scoringPlay"):
+                continue
+            ath = (d.get("athletesInvolved") or [{}])[0]
+            goals.append({
+                "min": ((d.get("clock") or {}).get("displayValue") or "").strip(),
+                "team": str((d.get("team") or {}).get("id") or ""),
+                "player": ath.get("displayName") or ath.get("shortName") or "",
+                "own": bool(d.get("ownGoal")),
+                "pen": bool(d.get("penaltyKick")),
+            })
+        return {
+            "id": str(ev.get("id") or comp.get("id")),
+            "slug": slug,
+            "league": LEAGUE_NAME.get(slug, slug),
+            "date": ev.get("date") or comp.get("date") or "",
+            "state": state,                       # pre / in / post
+            "sname": sname,
+            "special": special,
+            "clock": st.get("displayClock") or "",
+            "home": home,
+            "away": away,
+            "venue": ((comp.get("venue") or {}).get("fullName")) or "",
+            "goals": goals,
+            "pe": home["pe"] or away["pe"],
+        }
+    except Exception:
+        return None
+
+
+def local_date(e: dict) -> str:
+    try:
+        return _to_local(e["date"]).strftime("%Y%m%d")
+    except Exception:
+        return ""
+
+
+def status_label(e: dict, now: Optional[datetime] = None) -> str:
+    """Texto da faixa: 'AO VIVO 67'', 'INTERVALO', 'ENCERRADO', 'HOJE 16:00', 'SÁB 15/11 16:00'."""
+    now = now or datetime.now(TZ)
+    if e["special"]:
+        return {"STATUS_POSTPONED": "ADIADO", "STATUS_CANCELED": "CANCELADO",
+                "STATUS_SUSPENDED": "SUSPENSO", "STATUS_DELAYED": "ATRASADO"}.get(e["special"], "ADIADO")
+    if e["state"] == "in":
+        if e["sname"] == "STATUS_HALFTIME":
+            return "INTERVALO"
+        return f"AO VIVO {e['clock']}".strip()
+    if e["state"] == "post":
+        return "ENCERRADO"
+    dt = _to_local(e["date"])
+    hh = dt.strftime("%H:%M")
+    if dt.date() == now.date():
+        return f"HOJE {hh}"
+    if dt.date() == (now + timedelta(days=1)).date():
+        return f"AMANHÃ {hh}"
+    dias = ["SEG", "TER", "QUA", "QUI", "SEX", "SÁB", "DOM"]
+    return f"{dias[dt.weekday()]} {dt.strftime('%d/%m')} {hh}"
+
+
+def title_of(e: dict) -> str:
+    h, a = e["home"], e["away"]
+    if e["state"] == "pre":
+        return f"{h['name']} x {a['name']}"
+    return f"{h['name']} {h['score']} x {a['score']} {a['name']}"
+
+
+def order_events(evs: list[dict]) -> list[dict]:
+    """Ao vivo -> próximos (por horário) -> encerrados."""
+    rank = {"in": 0, "pre": 1, "post": 2}
+    return sorted(evs, key=lambda e: (rank.get(e["state"], 1), e["date"] if e["state"] != "post" else "",
+                                      "" if e["state"] != "post" else e["date"], e["id"]))
+
+
+def select_today(events: list[dict], today: str) -> list[dict]:
+    """Jogos de hoje: times de PE primeiro, depois Série A, Copa do Brasil e Série B."""
+    day = [e for e in events if local_date(e) == today or e["state"] == "in"]
+    pe = order_events([e for e in day if e["pe"]])
+    rest = []
+    for slug in ("bra.1", "bra.copa_do_brazil", "bra.2"):
+        rest += order_events([e for e in day if not e["pe"] and e["slug"] == slug])
+    return pe + rest
+
+
+def goal_lines(e: dict) -> list[str]:
+    out = []
+    names = {e["home"]["id"]: e["home"]["name"], e["away"]["id"]: e["away"]["name"]}
+    for g in e["goals"]:
+        extra = " (pênalti)" if g["pen"] else (" (contra)" if g["own"] else "")
+        who = g["player"] or names.get(g["team"], "")
+        out.append(f"⚽ {g['min']} {who}{extra} - {names.get(g['team'], '')}".replace("  ", " ").strip())
+    return out
+
+
+def diff_alerts(prev: Optional[dict], e: dict) -> tuple[list[str], dict]:
+    """Compara com o último estado guardado e devolve (mensagens, novo estado). Sem repetir."""
+    h, a = e["home"], e["away"]
+    now = {"state": e["state"], "h": h["score"], "a": a["score"], "ts": time.time(),
+           "started": bool(prev and prev.get("started")), "ended": bool(prev and prev.get("ended"))}
+    msgs: list[str] = []
+    comp = e["league"]
+    head = f"{h['name']} x {a['name']} ({comp})"
+    if e["special"]:
+        return msgs, now
+    if e["state"] == "in":
+        if not now["started"]:
+            now["started"] = True
+            msgs.append(f"⚽ Começou: {head}")
+        ph, pa = (prev or {}).get("h", 0), (prev or {}).get("a", 0)
+        mins = [g["min"] for g in e["goals"] if g["min"]]
+        for side, tm, before in (("h", h, ph), ("a", a, pa)):
+            for _ in range(max(0, tm["score"] - before)):
+                minute = mins[-1] if mins else e["clock"]
+                msgs.append(f"⚽ GOL do {tm['name']}! {h['name']} {h['score']} x {a['score']} {a['name']}, {minute}")
+    elif e["state"] == "post" and prev is not None and not now["ended"]:
+        now["ended"] = True
+        if not now["started"]:
+            now["started"] = True
+        msgs.append(f"🏁 Fim: {h['name']} {h['score']} x {a['score']} {a['name']} ({comp})")
+    elif e["state"] == "post":
+        now["ended"] = True
+    return msgs, now
+
+
+# ---------------------------------------------------------------- pessoas: rádios
+PE_RADIO_KEYS = ["jornal", "cbn", "clube", "folha", "tamandare", "globo", "estadio"]
+
+
+def pick_stations(stations: list[dict], pe_game: bool, limit: int = 6) -> list[dict]:
+    """Escolhe as rádios para ouvir o jogo (puro)."""
+    chosen: list[dict] = []
+
+    def add(s):
+        if s not in chosen and len(chosen) < limit:
+            chosen.append(s)
+
+    if pe_game:
+        pe = [s for s in stations if s.get("uf") == "PE"]
+        for k in PE_RADIO_KEYS:
+            for s in pe:
+                if k in norm(s.get("name", "")) and ("Notícias" in (s.get("kinds") or [])
+                                                     or "Esporte" in (s.get("kinds") or [])
+                                                     or k in ("jornal", "cbn", "estadio", "clube")):
+                    add(s)
+        for s in pe:
+            if "Esporte" in (s.get("kinds") or []):
+                add(s)
+    sports = sorted([s for s in stations if "Esporte" in (s.get("kinds") or [])],
+                    key=lambda s: -float(s.get("score") or 0))
+    for s in sports:
+        add(s)
+    return chosen
+
+
+# ---------------------------------------------------------------- imagem
+def _lum(c) -> float:
+    return la._lum(c)
+
+
+def team_color(t: dict) -> tuple[int, int, int]:
+    cands = []
+    for k in ("color", "alt"):
+        v = (t.get(k) or "").strip().lstrip("#")
+        if len(v) == 6:
+            try:
+                cands.append(la._rgb(v))
+            except Exception as _e:
+                log_swallowed("football.team_color", _e)
+    for c in cands:  # cor viva: nem branca demais nem preta demais
+        if 0.08 < _lum(c) < 0.75:
+            return c
+    for c in cands:
+        if _lum(c) < 0.75:
+            return c if _lum(c) > 0.03 else (70, 70, 84)
+    return (70, 70, 84)
+
+
+def _mix(c, k: float):
+    return tuple(int(v * k) for v in c)
+
+
+def _logo_fallback(t: dict, d: int, color) -> Image.Image:
+    S = 3
+    big = Image.new("RGBA", (d * S, d * S), (0, 0, 0, 0))
+    dr = ImageDraw.Draw(big)
+    dr.ellipse((0, 0, d * S - 1, d * S - 1), fill=la._rgba(color), outline=(255, 255, 255, 200), width=S * 2)
+    f = la._font(d * S * 0.34, True)
+    txt = (t.get("abbr") or t.get("name") or "?")[:3].upper()
+    dr.text((d * S / 2, d * S / 2 + la._cap(f) / 2), txt, font=f, fill=(255, 255, 255, 255), anchor="ms")
+    return big.resize((d, d), la.LANCZOS)
+
+
+def fut_card(e: dict, logos: dict, size=(780, 439), now: Optional[datetime] = None) -> bytes:
+    """Cartão paisagem do jogo. logos: {team_id: bytes|None}."""
+    W, H = size
+    u = la._unit(W, H)
+    m = 6.0 * u
+    h, a = e["home"], e["away"]
+    ch, ca = team_color(h), team_color(a)
+    img = la._corner_gradient((W, H), _mix(ch, 0.5), _mix(ca, 0.5), _mix(ch, 0.2), _mix(ca, 0.2))
+    cy = H * 0.47
+    cxh, cxa = W * 0.19, W * 0.81
+    la._glow(img, cxh, cy, W * 0.24, H * 0.42, ch, 95)
+    la._glow(img, cxa, cy, W * 0.24, H * 0.42, ca, 95)
+    la._shade(img, la._ramp_mask((W, H), H * 0.55, H, 0, 150, horizontal=False))
+    la._shade(img, la._ramp_mask((W, H), 0, H * 0.25, 90, 0, horizontal=False))
+
+    # faixa de estado
+    label = status_label(e, now)
+    live = e["state"] == "in" and not e["special"]
+    bg = la.RED if live else ((70, 70, 82) if e["state"] == "post" or e["special"] else la.GOLD)
+    chip = la._chip(7.4 * u, [label], bg, la.WHITE if bg != la.GOLD else None, fs=0.52, pad=0.5)
+    la._place(img, chip, (W - chip.width) / 2, m * 0.8, shadow=0.35)
+
+    # escudos e nomes
+    d = int(round(34 * u))
+    for t, cx, col in ((h, cxh, ch), (a, cxa, ca)):
+        raw = logos.get(t["id"])
+        try:
+            lg = la._contain(la._load(raw), (d, d)) if raw else _logo_fallback(t, d, col)
+        except Exception:
+            lg = _logo_fallback(t, d, col)
+        la._place(img, lg, cx - lg.width / 2, cy - lg.height / 2 - 2 * u, shadow=0.5)
+        f = la._font(6.2 * u, True)
+        nm = la._ellipsize(la._clean_text(t["name"]), f, W * 0.34)
+        la._text(img, cx, cy + d / 2 + 6.5 * u, nm, f, la.WHITE, anchor="ms", shadow=0.5)
+
+    # meio: placar ou horário
+    if e["state"] == "pre" or e["special"]:
+        mid = _to_local(e["date"]).strftime("%H:%M")
+        size_u = 17.0
+    else:
+        mid = f"{h['score']}  x  {a['score']}"
+        size_u = 19.0
+    f = la._font(size_u * u, True)
+    while la._tlen(mid, f) > W * 0.36 and size_u > 8:
+        size_u -= 1
+        f = la._font(size_u * u, True)
+    la._text(img, W / 2, cy + la._cap(f) / 2 - 2 * u, mid, f, la.WHITE, anchor="ms", shadow=0.6)
+
+    # rodapé
+    foot = e["league"] + (f"  ·  {e['venue']}" if e["venue"] else "")
+    f = la._font(5.0 * u, False)
+    foot = la._ellipsize(la._clean_text(foot), f, W - 2 * m)
+    la._text(img, W / 2, H - m * 0.9, foot, f, (205, 205, 216), anchor="ms", shadow=0.4)
+    return la.to_jpeg(img)
+
+
+# ---------------------------------------------------------------- rede
+async def _get_json(session: aiohttp.ClientSession, url: str):
+    async with session.get(url, timeout=aiohttp.ClientTimeout(total=20)) as r:
+        if r.status != 200:
+            return None
+        return await r.json(content_type=None)
+
+
+async def fetch_day(session, slug: str, ymd: str) -> Optional[list[dict]]:
+    try:
+        d = await _get_json(session, f"{ESPN}{slug}/scoreboard?dates={ymd}")
+    except Exception as ex:
+        logger.warning(f"Futebol: {slug} {ymd} falhou: {type(ex).__name__}")
+        return None
+    if d is None:
+        return None
+    out = [parse_event(ev, slug) for ev in d.get("events") or []]
+    return [x for x in out if x]
+
+
+def _days(now: Optional[datetime] = None) -> list[str]:
+    now = now or datetime.now(TZ)
+    return [(now + timedelta(days=k)).strftime("%Y%m%d") for k in (-1, 0, 1)]
+
+
+async def refresh(full: bool = True) -> int:
+    """Atualiza o cache. full=False refaz só as (liga, dia) com jogo ao vivo ou prestes a começar."""
+    global _fetched_ts, _lock
+    if _lock is None:
+        _lock = asyncio.Lock()
+    async with _lock:
+        if full or not _events:
+            pairs = {(s, d) for s, _ in LEAGUES for d in _days()}
+        else:
+            now = datetime.now(timezone.utc)
+            pairs = set()
+            for e in _events.values():
+                soon = False
+                if e["state"] == "pre":
+                    try:
+                        st = datetime.strptime(e["date"].replace("Z", ""), "%Y-%m-%dT%H:%M").replace(tzinfo=timezone.utc)
+                        soon = -3600 < (st - now).total_seconds() < 1200
+                    except Exception as _e:
+                        log_swallowed("football.refresh", _e)
+                if (e["state"] == "in" or soon) and e["id"] in _pair_of:
+                    pairs.add(_pair_of[e["id"]])
+        if not pairs:
+            _fetched_ts = time.time()
+            return len(_events)
+        async with aiohttp.ClientSession(headers=UA) as session:
+            res = await asyncio.gather(*(fetch_day(session, s, d) for s, d in pairs))
+        for (s, d), evs in zip(pairs, res):
+            if evs is None:
+                continue
+            for e in evs:
+                _events[e["id"]] = e
+                _pair_of[e["id"]] = (s, d)
+        # esquece jogos antigos (> 3 dias)
+        keep_after = (datetime.now(TZ) - timedelta(days=3)).strftime("%Y%m%d")
+        for k in [k for k, e in _events.items() if local_date(e) < keep_after]:
+            _events.pop(k, None)
+            _pair_of.pop(k, None)
+        _fetched_ts = time.time()
+        return len(_events)
+
+
+def _any_live() -> bool:
+    today = datetime.now(TZ).strftime("%Y%m%d")
+    return any(e["state"] == "in" for e in select_today(list(_events.values()), today))
+
+
+async def _ensure_fresh() -> None:
+    age = time.time() - _fetched_ts
+    limit = FAST if _any_live() else SLOW
+    if not _events or age > limit:
+        await refresh(full=not _events or age > SLOW)
+
+
+def today_list() -> list[dict]:
+    return select_today(list(_events.values()), datetime.now(TZ).strftime("%Y%m%d"))
+
+
+def row_visible(catalog_id: str) -> bool:
+    return catalog_id == "comet_fut"  # catalog_items busca se o cache estiver vazio
+
+
+async def find_event(event_id: str, date: str = "") -> Optional[dict]:
+    event_id = event_id.split(":")[-1]
+    if event_id not in _events:
+        await _ensure_fresh()
+    if event_id not in _events and date:
+        async with aiohttp.ClientSession(headers=UA) as session:
+            for slug, _ in LEAGUES:
+                for e in await fetch_day(session, slug, date) or []:
+                    _events[e["id"]] = e
+                    _pair_of[e["id"]] = (slug, date)
+    return _events.get(event_id)
+
+
+async def get_logo(session, t: dict) -> Optional[bytes]:
+    if not t.get("logo") or not t.get("id"):
+        return None
+    path = os.path.join(LOGO_DIR, f"{t['id']}.png")
+    try:
+        if os.path.exists(path):
+            with open(path, "rb") as f:
+                return f.read()
+    except OSError:
+        pass
+    try:
