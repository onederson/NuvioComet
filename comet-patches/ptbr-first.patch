index 0000000..f4dc693
--- /dev/null
+++ b/comet/services/resume.py
@@ -0,0 +1,127 @@
+"""N2: "Onde você parou" na página do título (link pessoal / Nuvio).
+
+Usa o `play_log` do próprio Comet (cada play que passou pelo Comet), então funciona com qualquer app.
+Série: "▶ Você parou em T3E7 · Nome" (ou "terminou T3E7, o próximo é T3E8"), e, se faz tempo,
+um resumo em PT dos últimos episódios vistos. Filme: "✓ Você viu este filme em 03/11/2026".
+"""
+from __future__ import annotations
+
+import time
+from datetime import datetime
+from zoneinfo import ZoneInfo
+
+from comet.core.logger import logger
+
+_TZ = ZoneInfo("America/Recife")
+_LONG_AGO = 14 * 86400   # a partir daqui, mostra o resumo dos últimos episódios
+_SESSION = 3 * 3600      # plays do mesmo episódio dentro de 3 h contam como uma sessão
+
+
+def _ago(ts: float, now: float) -> str:
+    days = int((now - ts) // 86400)
+    if days <= 0:
+        return "hoje"
+    if days == 1:
+        return "ontem"
+    if days < 30:
+        return f"há {days} dias"
+    months = days // 30
+    return "há 1 mês" if months == 1 else f"há {months} meses"
+
+
+def _episodes(meta: dict) -> dict[tuple[int, int], dict]:
+    out = {}
+    for v in meta.get("videos") or []:
+        try:
+            se, ep = int(v.get("season") or 0), int(v.get("episode") or v.get("number") or 0)
+        except (TypeError, ValueError):
+            continue
+        if se > 0 and ep > 0:
+            out[(se, ep)] = v
+    return out
+
+
+def _short(text: str, n: int = 170) -> str:
+    text = " ".join(str(text or "").split())
+    return text if len(text) <= n else text[: n - 1].rsplit(" ", 1)[0] + "…"
+
+
+def build_series_lines(plays: list[dict], meta: dict, now: float | None = None) -> list[str]:
+    """plays: linhas do play_log da série (season, episode, ts, outcome), qualquer ordem. Função pura."""
+    now = now or time.time()
+    eps = [p for p in plays if p.get("season") and p.get("episode")]
+    if not eps:
+        return []
+    eps.sort(key=lambda p: p["ts"])
+    last = eps[-1]
+    se, ep = int(last["season"]), int(last["episode"])
+    videos = _episodes(meta)
+    v = videos.get((se, ep)) or {}
+    name = str(v.get("title") or v.get("name") or "").strip()
+    label = f"T{se}E{ep}" + (f" · {name}" if name and not name.lower().startswith("episod") else "")
+    ordered = sorted(videos)
+    nxt = None
+    if (se, ep) in videos:
+        i = ordered.index((se, ep))
+        if i + 1 < len(ordered):
+            nxt = ordered[i + 1]
+    lines = []
+    if (last.get("outcome") or "") == "completo" and nxt:
+        nv = videos[nxt]
+        nname = str(nv.get("title") or nv.get("name") or "").strip()
+        lines.append(f"▶ Você terminou {label} ({_ago(last['ts'], now)}). Próximo: T{nxt[0]}E{nxt[1]}"
+                     + (f" · {nname}" if nname else ""))
+    else:
+        lines.append(f"▶ Você parou em {label} ({_ago(last['ts'], now)})")
+    if now - last["ts"] >= _LONG_AGO:
+        seen, recap = set(), []
+        for p in reversed(eps):
+            k = (int(p["season"]), int(p["episode"]))
+            if k in seen:
+                continue
+            seen.add(k)
+            ov = (videos.get(k) or {}).get("overview") or (videos.get(k) or {}).get("description")
+            if ov:
+                recap.append(f"• T{k[0]}E{k[1]}: {_short(ov)}")
+            if len(seen) >= 2:
+                break
+        if recap:
+            lines.append("Para lembrar:\n" + "\n".join(reversed(recap)))
+    return lines
+
+
+def build_movie_lines(plays: list[dict], now: float | None = None) -> list[str]:
+    if not plays:
+        return []
+    last = max(plays, key=lambda p: p["ts"])
+    d = datetime.fromtimestamp(last["ts"], _TZ).strftime("%d/%m/%Y")
+    if (last.get("outcome") or "") == "completo":
+        return [f"✓ Você viu este filme em {d}"]
+    return [f"▶ Você começou este filme em {d}"]
+
+
+async def resume_lines(media_type: str, imdb: str, meta: dict) -> list[str]:
+    try:
+        from comet.core.database import database
+        rows = await database.fetch_all(
+            "SELECT season, episode, ts, outcome FROM play_log WHERE imdb = :i ORDER BY ts DESC LIMIT 200",
+            {"i": imdb},
+        )
+    except Exception as e:  # tabela ainda não existe, banco ocupado...
+        logger.debug(f"resume: {type(e).__name__}: {e}")
+        return []
+    plays = [{"season": r["season"], "episode": r["episode"], "ts": float(r["ts"]), "outcome": r["outcome"]} for r in rows]
+    if media_type == "series":
+        return build_series_lines(plays, meta)
+    return build_movie_lines(plays)
+
+
+async def apply(meta: dict, media_type: str, imdb: str) -> tuple[dict, bool]:
+    """Põe as linhas no começo da descrição. Devolve (meta, mudou)."""
+    lines = await resume_lines(media_type, imdb, meta)
+    if not lines:
+        return meta, False
+    meta = dict(meta)
+    desc = meta.get("description") or ""
+    meta["description"] = "\n".join(lines) + ("\n\n" + desc if desc else "")
+    return meta, True
diff --git a/comet/services/row_groups.py b/comet/services/row_groups.py
new file mode 100644
index 0000000..40a7877
--- /dev/null
+++ b/comet/services/row_groups.py
@@ -0,0 +1,164 @@
+"""Fileiras agrupadas: junta fileiras parecidas numa só, com filtro.
+
+Antes a tela inicial tinha 88 fileiras (7 streamings x 3, 9 de clima, 9 de gênero...).
+Aqui cada grupo vira UMA fileira com o filtro `genre` (no app: o seletor da fileira /
+aba Descobrir). Sem filtro, a fileira mostra um membro diferente a cada dia (rodízio).
+
+As fileiras originais continuam respondendo pelo id antigo (aquecimento, testes, links
+antigos); só deixam de aparecer no manifesto. Desligar: CATALOG_GROUPS=False no .env.
+"""
+from __future__ import annotations
+
+import datetime
+
+from comet.core.models import settings
+
+# id do grupo -> nome da fileira e membros por tipo [(rótulo do filtro, id original)]
+_STATIC_GROUPS: dict[str, dict] = {
+    "comet_moods": {
+        "name": "🎭 Clima do dia",
+        "members": {
+            "movie": [
+                ("😭 Para chorar", "comet_mood_cry"),
+                ("🤯 Plot twist", "comet_mood_twist"),
+                ("😌 Comédia leve", "comet_mood_light"),
+                ("👨‍👩‍👧 Sessão em família", "comet_mood_family"),
+                ("🌙 Suspense à noite", "comet_mood_night"),
+                ("🏆 Oscar de Melhor Filme", "comet_mood_oscar"),
+                ("⭐ Mais bem avaliados", "comet_mood_top"),
+                ("📼 Clássicos dublados", "comet_mood_classicdub"),
+            ],
+        },
+    },
+    "comet_genres": {
+        "name": "🎞️ Gêneros",
+        "members": {
+            "movie": [
+                ("💥 Ação e aventura", "comet_action"),
+                ("😂 Comédias", "comet_comedy"),
+                ("👻 Terror", "comet_horror"),
+                ("🧸 Para a família", "comet_family"),
+                ("🌍 Documentários", "comet_docs"),
+                ("🏆 Aclamados", "comet_top"),
+            ],
+            "series": [
+                ("🕵️ Crime e suspense", "comet_crime"),
+                ("🇰🇷 Doramas", "comet_kdrama"),
+                ("🏆 Aclamados", "comet_top"),
+            ],
+        },
+    },
+}
+
+STREAMS_ID = "comet_streams"
+ORIGS_ID = "comet_origs"
+_STREAMS_NAME = "📺 Nos streamings"
+_ORIGS_NAME = "⭐ Originais dos streamings"
+
+
+def enabled() -> bool:
+    return bool(getattr(settings, "CATALOG_GROUPS", True))
+
+
+def _provider_members(catalogs: list[dict]) -> dict[str, dict[str, list[tuple[str, str]]]]:
+    """Monta os grupos de streaming a partir do que o manifesto já tem (respeita CATALOG_PROVIDERS)."""
+    streams: dict[str, list[tuple[str, str]]] = {}
+    origs: dict[str, list[tuple[str, str]]] = {}
+    for c in catalogs:
+        cid, ctype, name = c.get("id", ""), c.get("type", ""), c.get("name", "")
+        if cid.startswith("comet_orig_"):
+            label = name.replace("⭐ Originais", "").strip() or cid[len("comet_orig_"):]
+            origs.setdefault(ctype, []).append((label, cid))
+    from comet.services.catalogs import PROVIDERS  # import tardio: evita ciclo
+
+    prov_ids = {f"comet_{p}" for p in PROVIDERS}
+    for c in catalogs:
+        cid, ctype = c.get("id", ""), c.get("type", "")
+        if cid in prov_ids:
+            streams.setdefault(ctype, []).append((c.get("name") or cid, cid))
+    return {STREAMS_ID: streams, ORIGS_ID: origs}
+
+
+def _all_groups(catalogs: list[dict] | None = None) -> dict[str, dict]:
+    groups = {k: {"name": v["name"], "members": v["members"]} for k, v in _STATIC_GROUPS.items()}
+    if catalogs is None:
+        catalogs = _manifest_source()
+    dyn = _provider_members(catalogs)
+    groups[STREAMS_ID] = {"name": _STREAMS_NAME, "members": dyn[STREAMS_ID]}
+    groups[ORIGS_ID] = {"name": _ORIGS_NAME, "members": dyn[ORIGS_ID]}
+    return groups
+
+
+_SOURCE_CACHE: dict = {"cats": None}
+
+
+def _manifest_source() -> list[dict]:
+    """Manifesto sem agrupar (para descobrir os membros ao responder um catálogo de grupo)."""
+    if _SOURCE_CACHE["cats"] is None:
+        from comet.services.catalogs import build_manifest_catalogs
+
+        _SOURCE_CACHE["cats"] = build_manifest_catalogs(is_personal=True, grouped=False)
+    return _SOURCE_CACHE["cats"]
+
+
+def consolidate(catalogs: list[dict]) -> list[dict]:
+    """Troca os membros de cada grupo por uma fileira só (na posição do primeiro membro)."""
+    if not enabled():
+        return catalogs
+    _SOURCE_CACHE["cats"] = list(catalogs)
+    groups = _all_groups(catalogs)
+    present = {(c.get("type"), c.get("id")) for c in catalogs}
+    member_of: dict[tuple[str, str], str] = {}
+    live_members: dict[tuple[str, str], list[tuple[str, str]]] = {}
+    for gid, g in groups.items():
+        for mtype, members in g["members"].items():
+            avail = [(lab, mid) for lab, mid in members if (mtype, mid) in present]
+            if len(avail) < 2:
+                continue  # grupo com 1 membro não vale a pena
+            live_members[(mtype, gid)] = avail
+            for _, mid in avail:
+                member_of[(mtype, mid)] = gid
+    out: list[dict] = []
+    placed: set[tuple[str, str]] = set()
+    for c in catalogs:
+        key = (c.get("type"), c.get("id"))
+        gid = member_of.get(key)
+        if not gid:
+            out.append(c)
+            continue
+        gkey = (c.get("type"), gid)
+        if gkey in placed:
+            continue
+        placed.add(gkey)
+        out.append({
+            "type": c.get("type"),
+            "id": gid,
+            "name": groups[gid]["name"],
+            "extra": [
+                {"name": "genre", "options": [lab for lab, _ in live_members[gkey]], "isRequired": False},
+                {"name": "skip", "isRequired": False},
+            ],
+        })
+    return out
+
+
+def is_group(catalog_id: str) -> bool:
+    return catalog_id in _STATIC_GROUPS or catalog_id in (STREAMS_ID, ORIGS_ID)
+
+
+def resolve(catalog_id: str, media_type: str, extra: dict, today: datetime.date | None = None) -> tuple[str, dict]:
+    """(id original, extra sem o filtro do grupo). Sem filtro: rodízio diário entre os membros."""
+    if not is_group(catalog_id):
+        return catalog_id, extra
+    members = (_all_groups().get(catalog_id) or {}).get("members", {}).get(media_type) or []
+    if not members:
+        return catalog_id, extra
+    extra = dict(extra or {})
+    label = extra.pop("genre", None)
+    for lab, mid in members:
+        if lab == label:
+            return mid, extra
+    day = (today or datetime.date.today()).toordinal()
+    # deslocamento por grupo/tipo: fileiras diferentes não giram juntas
+    off = sum(map(ord, catalog_id + media_type))
+    return members[(day + off) % len(members)][1], extra
diff --git a/comet/services/row_warm.py b/comet/services/row_warm.py
new file mode 100644
index 0000000..79f2083
--- /dev/null
+++ b/comet/services/row_warm.py
@@ -0,0 +1,403 @@
+from __future__ import annotations
+
+import asyncio
+import datetime
+import os
+import re
+import time
+from typing import Any
+
+import aiohttp
+
+from comet.core.database import database
+from comet.core.logger import logger, log_swallowed
+from comet.core.models import settings
+
+_QUEUE: list[dict[str, Any]] = []
+_NEW_ITEM_EVENT = asyncio.Event()
+
+_DEDUPE: dict[str, float] = {}
+_DEDUPE_TTL = 6 * 3600  # 6 horas
+
+_stats: dict[str, Any] = {
+    "day": "",
+    "warmed_today": 0,
+    "skipped_cache": 0,
+    "skipped_mem": 0,
+    "total_time": 0.0,
+    "total_warmed": 0,
+}
+
+_worker_task: asyncio.Task | None = None
+
+
+def _get_mem_available_mb() -> float:
+    try:
+        with open("/proc/meminfo", "r", encoding="utf-8") as f:
+            for line in f:
+                if line.startswith("MemAvailable:"):
+                    return float(line.split()[1]) / 1024.0
+    except Exception as _e:
+        log_swallowed("row_warm._get_mem_available_mb", _e)
+    return 9999.0
+
+
+def _ensure_today() -> None:
+    today = datetime.date.today().isoformat()
+    if _stats["day"] != today:
+        _stats["day"] = today
+        _stats["warmed_today"] = 0
+        _stats["skipped_cache"] = 0
+        _stats["skipped_mem"] = 0
+        _stats["total_time"] = 0.0
+        _stats["total_warmed"] = 0
+
+
+def get_row_warm_stats() -> dict[str, Any]:
+    _ensure_today()
+    avg = (
+        (_stats["total_time"] / _stats["total_warmed"])
+        if _stats["total_warmed"] > 0
+        else 0.0
+    )
+    return {
+        "queue_len": len(_QUEUE),
+        "warmed_today": _stats["warmed_today"],
+        "skipped_cache": _stats["skipped_cache"],
+        "skipped_mem": _stats["skipped_mem"],
+        "avg_time": avg,
+    }
+
+
+async def is_in_cache(target: dict[str, Any]) -> bool:
+    cutoff = time.time() - (3 * 86400)
+    base_id = target.get("imdb") or target["media_id"].split(":")[0]
+    season = target.get("season")
+    episode = target.get("episode")
+    try:
+        if target.get("type") == "series" and season is not None and episode is not None:
+            row = await database.fetch_one(
+                """
+                SELECT 1 FROM torrents
+                WHERE media_id = :mid
+                  AND (
+                    (season = :s AND (episode = :e OR episode IS NULL))
+                    OR (season IS NULL AND episode IS NULL)
+                  )
+                  AND updated_at >= :cutoff
+                LIMIT 1
+                """,
+                {"mid": base_id, "s": season, "e": episode, "cutoff": cutoff},
+            )
+        else:
+            row = await database.fetch_one(
+                """
+                SELECT 1 FROM torrents
+                WHERE media_id = :mid AND updated_at >= :cutoff
+                LIMIT 1
+                """,
+                {"mid": base_id, "cutoff": cutoff},
+            )
+        return row is not None
+    except Exception as exc:
+        logger.debug(f"row_warm is_in_cache erro: {exc}")
+        return False
+
+
+async def resolve_target_from_catalog_item(
+    item: dict[str, Any],
+    catalog_id: str = "",
+    media_type: str = "",
+    session: aiohttp.ClientSession | None = None,
+    library: list[dict[str, Any]] | None = None,
+) -> dict[str, Any] | None:
+    raw_id = str(item.get("id") or "").strip()
+    mtype = str(item.get("type") or media_type or "").strip()
+
+    if mtype == "tv" or raw_id.startswith("cometlive:") or catalog_id in ("comet_livetv", "comet_livehome"):
+        return None
+
+    if raw_id.startswith("cometsaga:"):
+        try:
+            from comet.services.marathon import get_marathon_meta, is_marathon_id
+
+            if is_marathon_id(raw_id):
+                meta = await get_marathon_meta(raw_id)
+            else:
+                from comet.services.catalogs import get_saga_meta
+                meta = await get_saga_meta(raw_id)
+            if meta and isinstance(meta.get("videos"), list) and meta["videos"]:
+                first_vid = meta["videos"][0]
+                first_tt = first_vid.get("id")
+                if isinstance(first_tt, str) and first_tt.count(":") == 2 and first_tt.startswith("tt"):
+                    _imdb, _s, _e = first_tt.split(":")
+                    return {"type": "series", "imdb": _imdb, "season": int(_s), "episode": int(_e),
+                            "media_id": first_tt, "name": first_vid.get("title") or item.get("name") or ""}
+                if first_tt and isinstance(first_tt, str) and first_tt.startswith("tt"):
+                    return {
+                        "type": "movie",
+                        "imdb": first_tt,
+                        "season": None,
+                        "episode": None,
+                        "media_id": first_tt,
+                        "name": first_vid.get("title") or item.get("name") or "",
+                    }
+        except Exception as e:
+            logger.debug(f"row_warm resolver saga {raw_id} falhou: {e}")
+        return None
+
+    if mtype == "movie":
+        if not raw_id.startswith("tt"):
+            return None
+        return {
+            "type": "movie",
+            "imdb": raw_id,
+            "season": None,
+            "episode": None,
+            "media_id": raw_id,
+            "name": item.get("name") or "",
+        }
+
+    if mtype == "series":
+        imdb_id = raw_id.split(":")[0]
+        if not imdb_id.startswith("tt"):
+            return None
+
+        s: int | None = None
+        e: int | None = None
+
+        if catalog_id in ("comet_newep", "comet_week", "comet_dubready"):
+            text = f"{item.get('releaseInfo', '')} {item.get('description', '')}"
+            m = re.search(r"(?:[TtSs])(\d+)(?:[Ee]|EP)(\d+)", text)
+            if m:
+                s = int(m.group(1))
+                e = int(m.group(2))
+            elif catalog_id == "comet_dubready":
+                try:
+                    row = await database.fetch_one(
+                        """
+                        SELECT season, episode FROM dub_watch
+                        WHERE imdb = :imdb AND dub_ready = 1
+                        ORDER BY first_ready_at DESC
+                        LIMIT 1
+                        """,
+                        {"imdb": imdb_id},
+                    )
+                    if row and row["season"] is not None and row["episode"] is not None:
+                        s = int(row["season"])
+                        e = int(row["episode"])
+                except Exception as _swallowed_e:
+                    log_swallowed("row_warm.resolve_target_from_catalog_item", _swallowed_e)
+
+        if s is None or e is None:
+            auth_key = getattr(settings, "STREMIO_AUTH_KEY", None)
+            if auth_key:
+                if library is None:
+                    try:
+                        from comet.services.stremio_library import get_stremio_library
+
+                        library = await get_stremio_library(auth_key)
+                    except Exception:
+                        library = []
+                hist_item = next(
+                    (
+                        it
+                        for it in (library or [])
+                        if it.get("type") == "series"
+                        and (it.get("_id") == imdb_id or it.get("id") == imdb_id)
+                    ),
+                    None,
+                )
+                if hist_item:
+                    state = hist_item.get("state", {})
+                    hist_s = state.get("season")
+                    hist_e = state.get("episode")
+                    if (
+                        hist_s is None
+                        or hist_e is None
+                        or (int(hist_s) == 0 and int(hist_e) == 0)
+                    ) and state.get("video_id"):
+                        m_vid = re.search(r":(\d+):(\d+)$", str(state["video_id"]))
+                        if m_vid:
+                            hist_s = int(m_vid.group(1))
+                            hist_e = int(m_vid.group(2))
+
+                    if (
+                        hist_s is not None
+                        and hist_e is not None
+                        and int(hist_s) > 0
+                        and int(hist_e) > 0
+                    ):
+                        own_session = False
+                        if session is None:
+                            session = aiohttp.ClientSession(
+                                timeout=aiohttp.ClientTimeout(total=10.0)
+                            )
+                            own_session = True
+                        try:
+                            from comet.services.prefetch import (
+                                _find_next_episode,
+                                _get_series_videos,
+                            )
+
+                            videos = await _get_series_videos(session, imdb_id)
+                            if videos:
+                                next_target = _find_next_episode(
+                                    videos, int(hist_s), int(hist_e)
+                                )
+                                if next_target:
+                                    s, e = next_target
+                        except Exception as e_hist:
+                            logger.debug(f"row_warm historico {imdb_id} falhou: {e_hist}")
+                        finally:
+                            if own_session:
+                                await session.close()
+
+        if s is None or e is None:
+            s, e = 1, 1
+
+        ep_mid = f"{imdb_id}:{s}:{e}"
+        return {
+            "type": "series",
+            "imdb": imdb_id,
+            "season": s,
+            "episode": e,
+            "media_id": ep_mid,
+            "name": item.get("name") or "",
+        }
+
+    return None
+
+
+def enqueue_catalog_row(
+    catalog_id: str,
+    media_type: str,
+    b64config: str,
+    metas: list[dict[str, Any]],
+) -> None:
+    if not getattr(settings, "ROW_WARM", True):
+        return
+    if not metas or not b64config:
+        return
+
+    n = int(getattr(settings, "ROW_WARM_PER_ROW", 6) or 6)
+    slice_items = metas[:n]
+
+    new_entries = []
+    for item in slice_items:
+        new_entries.append({
+            "catalog_id": catalog_id,
+            "media_type": media_type,
+            "b64config": b64config,
+            "item": item,
+        })
+
+    global _QUEUE
+    _QUEUE = (new_entries + _QUEUE)[:60]
+    _NEW_ITEM_EVENT.set()
+    _ensure_worker_running()
+
+
+def _ensure_worker_running() -> None:
+    global _worker_task
+    if _worker_task is None or _worker_task.done():
+        try:
+            loop = asyncio.get_running_loop()
+            _worker_task = loop.create_task(_row_warm_loop())
+        except RuntimeError:
+            pass
+
+
+async def _row_warm_loop() -> None:
+    port = getattr(settings, "FASTAPI_PORT", 8000) or 8000
+    base_url = f"http://127.0.0.1:{port}"
+
+    while True:
+        while not _QUEUE:
+            _NEW_ITEM_EVENT.clear()
+            try:
+                await _NEW_ITEM_EVENT.wait()
+            except asyncio.CancelledError:
+                return
+
+        entry = _QUEUE.pop(0)
+        _ensure_today()
+
+        now = time.time()
+        if len(_DEDUPE) > 300:
+            expired = [k for k, ts in _DEDUPE.items() if now - ts >= _DEDUPE_TTL]
+            for k in expired:
+                _DEDUPE.pop(k, None)
+
+        try:
+            target = await resolve_target_from_catalog_item(
+                item=entry["item"],
+                catalog_id=entry["catalog_id"],
+                media_type=entry["media_type"],
+            )
+        except Exception as res_err:
+            logger.debug(f"row_warm resolver alvo falhou: {res_err}")
+            target = None
+
+        if not target:
+            continue
+
+        target_key = f"{target['type']}/{target['media_id']}"
+        if now - _DEDUPE.get(target_key, 0) < _DEDUPE_TTL:
+            continue
+        _DEDUPE[target_key] = now
+
+        mem_avail = _get_mem_available_mb()
+        if mem_avail < 700.0:
+            _stats["skipped_mem"] += 1
+            logger.warning(
+                f"🔥 row_warm {target['media_id']}: pulado (memória baixa: {mem_avail:.0f} MB < 700 MB)"
+            )
+            await asyncio.sleep(2.0)
+            continue
+
+        in_cache = await is_in_cache(target)
+        if in_cache:
+            _stats["skipped_cache"] += 1
+            logger.debug(f"🔥 row_warm {target['media_id']}: pulado (já em cache)")
+            await asyncio.sleep(2.0)
+            continue
+
+        b64 = entry["b64config"]
+        url = f"{base_url}/{b64}/stream/{target['type']}/{target['media_id']}.json"
+        t0 = time.monotonic()
+        timeout = aiohttp.ClientTimeout(total=90.0)
+
+        try:
+            async with aiohttp.ClientSession(timeout=timeout) as client:
+                async with client.get(url) as resp:
+                    elapsed = time.monotonic() - t0
+                    if resp.status == 200:
+                        data = await resp.json()
+                        streams = data.get("streams", []) if isinstance(data, dict) else []
+                        n_streams = len(streams)
+                        logger.info(
+                            f"🔥 aquecido {target['media_id']}: {n_streams} streams em {elapsed:.1f}s"
+                        )
+                        _stats["warmed_today"] += 1
+                        _stats["total_warmed"] += 1
+                        _stats["total_time"] += elapsed
+                    else:
+                        logger.warning(
+                            f"🔥 row_warm {target['media_id']} retornou HTTP {resp.status}"
+                        )
+        except asyncio.CancelledError:
+            return
+        except Exception as req_err:
+            logger.warning(f"🔥 row_warm {target['media_id']} falhou: {type(req_err).__name__}")
+
+        await asyncio.sleep(2.0)
+
+
+async def start_row_warm_service() -> None:
+    _ensure_worker_running()
+    if _worker_task:
+        try:
+            await _worker_task
+        except asyncio.CancelledError:
+            pass
