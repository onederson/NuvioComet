+++ b/comet/services/anime_canon.py
@@ -0,0 +1,76 @@
+"""Anime "só a história": tira os fillers de uma lista de vídeos do Cinemeta.
+
+Funções puras (sem rede). O mapa de filler vem de animefillerlist.com
+(comet/services/anime_filler.py): número absoluto -> tipo, com tipo em
+{"Manga Canon", "Mixed Canon/Filler", "Filler", "Anime Canon"}.
+Episódios sem tipo no mapa são mantidos (na dúvida, não esconder).
+"""
+
+FILLER = "Filler"
+MIXED = "Mixed Canon/Filler"
+MINUTES_PER_EPISODE = 23
+
+
+def _ep_num(video: dict) -> int:
+    ep = video.get("episode")
+    if ep is None:
+        ep = video.get("number")
+    return int(ep or 0)
+
+
+def _numbered(cinemeta_videos: list[dict]) -> list[tuple[int, dict]]:
+    """[(numero_absoluto, video)] sem a temporada 0, na ordem (season, episode)."""
+    regular = [v for v in cinemeta_videos if int(v.get("season") or 0) > 0]
+    regular.sort(key=lambda v: (int(v.get("season") or 0), _ep_num(v)))
+    return [(i, v) for i, v in enumerate(regular, start=1)]
+
+
+def _drop(kind: str | None, keep_mixed: bool) -> bool:
+    return kind == FILLER or (kind == MIXED and not keep_mixed)
+
+
+def canon_videos(cinemeta_videos: list[dict], filler_map: dict[int, str],
+                 keep_mixed: bool = True) -> list[dict]:
+    """Devolve os vídeos sem filler, renumerados como temporada única.
+
+    O `id` original ("tt:S:E") fica intacto: é ele que o player usa.
+    O título ganha o número absoluto original: "Ep. 54 · <título>".
+    """
+    out = []
+    for absolute, video in _numbered(cinemeta_videos):
+        if _drop(filler_map.get(absolute), keep_mixed):
+            continue
+        n = len(out) + 1
+        title = video.get("title") or video.get("name") or f"Episódio {absolute}"
+        new = dict(video)
+        new["season"] = 1
+        new["episode"] = n
+        new["number"] = n
+        new["title"] = f"Ep. {absolute} · {title}"
+        if "name" in video:
+            new["name"] = new["title"]
+        out.append(new)
+    return out
+
+
+def canon_stats(cinemeta_videos: list[dict], filler_map: dict[int, str],
+                keep_mixed: bool = True,
+                minutes_per_episode: int = MINUTES_PER_EPISODE) -> dict:
+    """Totais: episódios, removidos (filler e mixed) e horas economizadas."""
+    total = filler = mixed = 0
+    for absolute, _ in _numbered(cinemeta_videos):
+        total += 1
+        kind = filler_map.get(absolute)
+        if kind == FILLER:
+            filler += 1
+        elif kind == MIXED and not keep_mixed:
+            mixed += 1
+    removed = filler + mixed
+    return {
+        "total": total,
+        "kept": total - removed,
+        "removed": removed,
+        "filler_removed": filler,
+        "mixed_removed": mixed,
+        "hours_saved": round(removed * minutes_per_episode / 60, 1),
+    }
