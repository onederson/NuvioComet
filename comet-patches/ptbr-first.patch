+
+Banco: a tabela `play_log` é criada no primeiro uso (CREATE TABLE IF NOT EXISTS). Tipos escolhidos
+para funcionar em SQLite e PostgreSQL (id TEXT uuid, ts BIGINT em segundos unix).
+"""
+from __future__ import annotations
+
+import asyncio
+import datetime
+import re
+import time
+import uuid
+from typing import Any, Iterable
+
+from comet.core.database import database
+from comet.core.logger import logger
+
+# ───────────────────────── parâmetros ─────────────────────────
+
+DEDUP_SECONDS = 10 * 60
+EVAL_MIN_AGE = 6 * 3600           # só avalia plays com pelo menos 6 h
+UNCERTAIN_RETRY = 48 * 3600       # "incerto" antes disso fica NULL e é reavaliado no próximo ciclo
+ACTIVITY_WINDOW = 3 * 3600        # atividade além de 3 h após o play = nova sessão
+SHORT_WATCH_MS = 5 * 60 * 1000    # progresso < 5 min = largou
+DONE_RATIO = 0.85
+KEEP_DAYS = 180
+SCORES_TTL = 3600
+MIN_N = 2
+SMOOTH = 3
+
+W_GROUP, W_RES, W_SIZE = 0.6, 0.25, 0.15
+SIZE_BUCKETS = [(0, 3, "0-3 GB"), (3, 10, "3-10 GB"), (10, 30, "10-30 GB"), (30, None, "30+ GB")]
+
+_tables_ready = False
+_tables_lock = asyncio.Lock()
+_scores_cache: tuple[float, dict] | None = None
+
+
+async def _ensure_tables() -> None:
+    global _tables_ready
+    if _tables_ready:
+        return
+    async with _tables_lock:
+        if _tables_ready:
+            return
+        await database.execute(
+            """
+            CREATE TABLE IF NOT EXISTS play_log (
+                id TEXT PRIMARY KEY,
+                ts BIGINT NOT NULL,
+                media_id TEXT NOT NULL,
+                imdb TEXT NOT NULL,
+                season INTEGER,
+                episode INTEGER,
+                info_hash TEXT,
+                grp TEXT,
+                resolution TEXT,
+                size_gb DOUBLE PRECISION,
+                service TEXT,
+                is_pt INTEGER,
+                outcome TEXT
+            )
+            """
+        )
+        await database.execute(
+            "CREATE INDEX IF NOT EXISTS idx_play_log_dedup ON play_log (media_id, info_hash, ts)"
+        )
+        await database.execute("CREATE INDEX IF NOT EXISTS idx_play_log_outcome ON play_log (outcome, ts)")
+        _tables_ready = True
+
+
+# ───────────────────────── parsing ─────────────────────────
+
+_EXT_RE = re.compile(r"\.(mkv|mp4|avi|m4v|ts|m2ts|webm|mov|wmv)$", re.I)
+_SITE_RE = re.compile(r"(?:WWW\.)?([A-Z0-9]+)\.(?:COM|TV|ORG|NET|ME|IO|TO)(?:\.BR)?\b", re.I)
+_NOT_GROUPS = {
+    "DL", "RIP", "WEB", "DUAL", "AUDIO", "DUBLADO", "LEGENDADO", "NACIONAL", "X264", "X265", "H264",
+    "H265", "HEVC", "AAC", "AC3", "DTS", "HDR", "SDR", "REMUX", "BLURAY", "1080P", "720P", "2160P",
+    "480P", "4K", "MULTI", "SUBS", "SUB", "DUB", "PT", "BR", "PTBR", "EAC3", "DDP", "DD", "ATMOS",
+}
+
+
+def _clean_group(raw: str) -> str | None:
+    g = raw.strip().strip("[](){}. _").upper()
+    m = _SITE_RE.fullmatch(g)
+    if m:
+        g = m.group(1).upper()
+    g = re.sub(r"^WWW\.", "", g)
+    g = re.sub(r"\.(COM|TV|ORG|NET)(\.BR)?$", "", g)
+    g = g.strip(". _")
+    if not g or len(g) > 24 or g in _NOT_GROUPS or g.isdigit():
+        return None
+    if not re.fullmatch(r"[A-Z0-9][A-Z0-9._&-]*", g):
+        return None
+    return g
+
+
+def extract_group(name: str | None) -> str | None:
+    """Grupo de release a partir do nome do torrent/arquivo (normalizado em maiúsculas)."""
+    if not name:
+        return None
+    s = name.strip()
+    s = s.rsplit("/", 1)[-1].rsplit("\\", 1)[-1]
+    s = _EXT_RE.sub("", s).strip()
+    # [Grupo] Título ...  (anime)
+    m = re.match(r"^\[([^\]]+)\]", s)
+    if m:
+        g = _clean_group(m.group(1))
+        if g:
+            return g
+    # sufixos tipo "[rarbg]" / "(1)" no fim não são o grupo
+    s2 = re.sub(r"(\s*[\[(][^\])]*[\])])+$", "", s).strip()
+    if "-" in s2:
+        tail = s2.rsplit("-", 1)[1]
+        tail = re.split(r"\s", tail.strip())[0] if tail.strip() else ""
+        g = _clean_group(tail)
+        if g:
+            return g
+    # site no nome sem hífen (ex.: "Filme.2023.WWW.BLUDV.COM")
+    m = re.search(r"WWW\.([A-Z0-9]+)\.(?:COM|TV|ORG|NET)", s, re.I)
+    if m:
+        return _clean_group(m.group(1))
+    return None
+
+
+def _group_from(file_name: str | None, torrent_title: str | None) -> str | None:
+    return extract_group(file_name) or extract_group(torrent_title)
+
+
+def normalize_resolution(res: Any) -> str | None:
+    if not res:
+        return None
+    r = str(res).strip().lower()
+    if r in ("4k", "uhd", "2160", "2160p"):
+        return "2160p"
+    m = re.search(r"(\d{3,4})p?", r)
+    if m:
+        return f"{m.group(1)}p"
+    return r or None
+
+
+def size_bucket(size_bytes: Any = None, size_gb: Any = None) -> str | None:
+    try:
+        gb = float(size_gb) if size_gb is not None else float(size_bytes) / 1024**3
+    except (TypeError, ValueError):
+        return None
+    if gb <= 0:
+        return None
+    for lo, hi, label in SIZE_BUCKETS:
+        if gb >= lo and (hi is None or gb < hi):
+            return label
+    return None
+
+
+def _parse_media_id(media_id: str) -> tuple[str, int | None, int | None]:
+    parts = str(media_id).split(":")
+    imdb = parts[0]
+    if len(parts) >= 3:
+        try:
+            return imdb, int(parts[1]), int(parts[2])
+        except ValueError:
+            pass
+    return imdb, None, None
+
+
+def _to_epoch(val: Any) -> float | None:
+    """lastWatched pode vir em ISO ou em ms."""
+    if val is None or val == "":
+        return None
+    if isinstance(val, (int, float)):
+        return float(val) / 1000 if val > 1e11 else float(val)
+    s = str(val).strip()
+    if re.fullmatch(r"\d+(\.\d+)?", s):
+        return _to_epoch(float(s))
+    try:
+        dt = datetime.datetime.fromisoformat(s.replace("Z", "+00:00"))
+    except ValueError:
+        return None
+    if dt.tzinfo is None:
+        dt = dt.replace(tzinfo=datetime.timezone.utc)
+    return dt.timestamp()
+
+
+def _num(v: Any) -> float:
+    try:
+        return float(v or 0)
+    except (TypeError, ValueError):
+        return 0.0
+
+
+# ───────────────────────── 1. registrar ─────────────────────────
+
+async def record_play(media_id, info_hash, file_name, torrent_title, service, resolution, size_bytes, is_pt) -> None:
+    try:
+        await _ensure_tables()
+        now = int(time.time())
+        ih = (info_hash or "").lower() or None
+        dup = await database.fetch_one(
+            "SELECT id FROM play_log WHERE media_id = :m AND info_hash = :h AND ts >= :since",
+            {"m": str(media_id), "h": ih, "since": now - DEDUP_SECONDS},
+        )
+        if dup:
+            return
+        imdb, season, episode = _parse_media_id(media_id)
+        size_gb = None
+        try:
+            if size_bytes:
+                size_gb = round(float(size_bytes) / 1024**3, 3)
+        except (TypeError, ValueError):
+            pass
+        await database.execute(
+            """
+            INSERT INTO play_log (id, ts, media_id, imdb, season, episode, info_hash, grp, resolution,
+                                  size_gb, service, is_pt, outcome)
+            VALUES (:id, :ts, :m, :imdb, :s, :e, :h, :grp, :res, :gb, :svc, :pt, NULL)
+            """,
+            {
+                "id": uuid.uuid4().hex, "ts": now, "m": str(media_id), "imdb": imdb, "s": season,
+                "e": episode, "h": ih, "grp": _group_from(file_name, torrent_title),
+                "res": normalize_resolution(resolution), "gb": size_gb,
+                "svc": (service or None), "pt": 1 if is_pt else 0,
+            },
+        )
+    except Exception as e:  # nunca derrubar o playback
+        logger.warning(f"taste.record_play: {type(e).__name__}: {e}")
+
+
+# ───────────────────────── 2. avaliar ─────────────────────────
+
+def _index_library(library_items: Any) -> dict[str, dict]:
+    if isinstance(library_items, dict):
+        library_items = library_items.values()
+    idx: dict[str, dict] = {}
+    for it in library_items or []:
+        if isinstance(it, dict) and it.get("_id"):
+            idx[str(it["_id"])] = it
+    return idx
+
+
+def _progress(state: dict) -> tuple[float, float, float]:
+    """(timeOffset_ms, ratio_offset, ratio_watched)"""
+    off = _num(state.get("timeOffset"))
+    dur = _num(state.get("duration"))
+    watched = _num(state.get("timeWatched"))
+    if dur <= 0:
+        return off, 0.0, 0.0
+    return off, off / dur, watched / dur
+
+
+def _no_later_session(state: dict, play_ts: float) -> bool:
+    """lastWatched existe, é deste play (≥ play−10 min) e não passa de 3 h depois dele."""
+    lw = _to_epoch(state.get("lastWatched"))
+    if lw is None:
+        return False
+    return play_ts - 600 <= lw <= play_ts + ACTIVITY_WINDOW
+
+
+def _current_episode(state: dict) -> tuple[int, int] | None:
+    vid = state.get("video_id") or ""
+    parts = str(vid).split(":")
+    if len(parts) >= 3:
+        try:
+            return int(parts[-2]), int(parts[-1])
+        except ValueError:
+            pass
+    try:
+        if state.get("season") is not None and state.get("episode") is not None:
+            return int(state["season"]), int(state["episode"])
+    except (TypeError, ValueError):
+        pass
+    return None
+
+
+def classify(play: dict, item: dict | None) -> str:
+    if not item:
+        return "incerto"
+    state = item.get("state") or {}
+    play_ts = float(play["ts"])
+    off, r_off, r_watched = _progress(state)
+    done = r_off >= DONE_RATIO or r_watched >= DONE_RATIO
+
+    if play.get("season") is None:  # filme
+        if _num(state.get("timesWatched")) > 0 or bool(state.get("flaggedWatched")) or done:
+            return "completo"
+        if off < SHORT_WATCH_MS and _no_later_session(state, play_ts):
+            return "abandonado"
+        return "incerto"
+
+    played = (int(play["season"]), int(play["episode"]))
+    cur = _current_episode(state)
+    if cur is None:
+        return "incerto"
+    if cur > played:
+        return "completo"
+    if cur == played:
+        if done:
+            return "completo"
+        if off < SHORT_WATCH_MS and _no_later_session(state, play_ts):
+            return "abandonado"
+    return "incerto"
+
+
+async def evaluate(library_items, now=None) -> dict:
+    await _ensure_tables()
+    now = float(now if now is not None else time.time())
+    idx = _index_library(library_items)
+    rows = await database.fetch_all(
+        "SELECT id, ts, imdb, season, episode FROM play_log WHERE outcome IS NULL AND ts <= :lim ORDER BY ts",
+        {"lim": int(now - EVAL_MIN_AGE)},
+    )
+    counts = {"completo": 0, "abandonado": 0, "incerto": 0, "pendente": 0}
+    for r in rows:
+        play = {"ts": r["ts"], "season": r["season"], "episode": r["episode"]}
+        outcome = classify(play, idx.get(r["imdb"]))
+        if outcome == "incerto" and now - float(r["ts"]) < UNCERTAIN_RETRY:
+            counts["pendente"] += 1  # talvez ainda termine: tenta de novo no próximo ciclo
+            continue
+        await database.execute("UPDATE play_log SET outcome = :o WHERE id = :id", {"o": outcome, "id": r["id"]})
+        counts[outcome] += 1
+    if counts["completo"] or counts["abandonado"] or counts["incerto"]:
+        invalidate_scores()
+    counts["avaliados"] = counts["completo"] + counts["abandonado"] + counts["incerto"]
+    return counts
+
+
+# ───────────────────────── 3. pontuar ─────────────────────────
+
+def invalidate_scores() -> None:
+    global _scores_cache
+    _scores_cache = None
+
+
+def _aggregate(pairs: Iterable[tuple[str | None, str]]) -> dict[str, dict]:
+    acc: dict[str, dict] = {}
+    for key, outcome in pairs:
+        if not key:
+            continue
+        a = acc.setdefault(key, {"n": 0, "completos": 0, "abandonados": 0})
+        a["n"] += 1
+        if outcome == "completo":
+            a["completos"] += 1
+        elif outcome == "abandonado":
+            a["abandonados"] += 1
+    out = {}
+    for key, a in acc.items():
+        if a["n"] >= MIN_N:
+            a["score"] = round((a["completos"] - 2 * a["abandonados"]) / (a["n"] + SMOOTH), 4)
+            out[key] = a
+    return out
+
+
+async def taste_scores(force: bool = False) -> dict:
+    global _scores_cache
+    if not force and _scores_cache and time.time() - _scores_cache[0] < SCORES_TTL:
+        return _scores_cache[1]
+    await _ensure_tables()
+    rows = await database.fetch_all(
+        "SELECT grp, resolution, size_gb, outcome FROM play_log WHERE outcome IS NOT NULL"
+    )
+    rows = [(r["grp"], r["resolution"], r["size_gb"], r["outcome"]) for r in rows]
+    scores = {
+        "evaluated": len(rows),
+        "completos": sum(1 for r in rows if r[3] == "completo"),
+        "abandonados": sum(1 for r in rows if r[3] == "abandonado"),
+        "group": _aggregate((g, o) for g, _, _, o in rows),
+        "resolution": _aggregate((res, o) for _, res, _, o in rows),
+        "size": _aggregate((size_bucket(size_gb=gb) if gb else None, o) for _, _, gb, o in rows),
+    }
+    _scores_cache = (time.time(), scores)
+    return scores
+
+
+# ───────────────────────── 4. bônus ─────────────────────────
+
+def _component(table: dict, key: str | None) -> float:
+    if not key or not table or key not in table:
+        return 0.0
+    return max(-1.0, min(1.0, float(table[key].get("score", 0.0))))
+
+
+def bonus(scores, torrent_title, resolution, size_bytes) -> float:
+    """−1..+1; maior = mais a sua cara. Use `-bonus(...)` na chave de ordenação (crescente)."""
+    if not scores:
+        return 0.0
+    b = (
+        W_GROUP * _component(scores.get("group", {}), extract_group(torrent_title))
+        + W_RES * _component(scores.get("resolution", {}), normalize_resolution(resolution))
+        + W_SIZE * _component(scores.get("size", {}), size_bucket(size_bytes=size_bytes))
+    )
+    return max(-1.0, min(1.0, round(b, 4)))
+
+
+# ───────────────────────── 5. resumo (/gosto) ─────────────────────────
+
+def _plural(n: int, um: str, varios: str) -> str:
+    return f"{n} {um if n == 1 else varios}"
+
+
+async def summary_text() -> str:
+    s = await taste_scores(force=True)
+    total = s["evaluated"]
+    if total == 0:
+        return ("🎯 Seu gosto\n\nAinda não tenho plays avaliados. Cada play por uma fonte do Comet é "
+                "conferido no seu histórico do Stremio depois de 6 h.")
+    lines = [
+        "🎯 Seu gosto",
+        "",
+        f"{_plural(total, 'play avaliado', 'plays avaliados')}: "
+        f"{s['completos']} até o fim, {_plural(s['abandonados'], 'largado', 'largados')}, "
+        f"{_plural(total - s['completos'] - s['abandonados'], 'incerto', 'incertos')}.",
+    ]
+    groups = s["group"]
+    good = sorted((g for g in groups.items() if g[1]["score"] > 0 and g[1]["completos"] > 0),
+                  key=lambda kv: (-kv[1]["score"], -kv[1]["n"]))[:3]
+    bad = sorted((g for g in groups.items() if g[1]["abandonados"] > 0 and g[1]["score"] < 0),
+                 key=lambda kv: kv[1]["score"])[:3]
+    lines.append("")
+    if good:
+        lines.append("✅ Você assiste até o fim:")
+        for name, a in good:
+            lines.append(f"  • {name} — {a['completos']} de {a['n']}")
+    else:
+        lines.append("✅ Ainda sem grupo favorito (precisa de pelo menos 2 plays do mesmo grupo).")
+    if bad:
+        lines.append("⚠️ Você costuma largar:")
+        for name, a in bad:
+            lines.append(f"  • {name} — largou {a['abandonados']} de {a['n']}")
+    res = s["resolution"]
+    if res:
+        best = max(res.items(), key=lambda kv: (kv[1]["score"], kv[1]["n"]))
+        lines.append("")
+        lines.append(f"📺 Resolução preferida: {best[0]} ({best[1]['completos']} de {best[1]['n']} até o fim)")
+    size = s["size"]
+    if size:
+        best = max(size.items(), key=lambda kv: (kv[1]["score"], kv[1]["n"]))
+        lines.append(f"💾 Tamanho que mais funciona: {best[0]}")
+    return "\n".join(lines)
+
+
+# ───────────────────────── 6. serviço ─────────────────────────
+
+async def cleanup_old(now: float | None = None) -> None:
+    await _ensure_tables()
+    now = float(now if now is not None else time.time())
+    await database.execute("DELETE FROM play_log WHERE ts < :lim", {"lim": int(now - KEEP_DAYS * 86400)})
+
+
+async def run_once() -> dict | None:
+    from comet.core.models import settings
+    from comet.services.stremio_library import get_stremio_library
+
+    auth_key = getattr(settings, "STREMIO_AUTH_KEY", None)
+    result = None
+    if auth_key:
+        items = await get_stremio_library(auth_key)
+        if items:  # lista vazia = erro de rede/credencial: não marcar nada como incerto
+            result = await evaluate(items)
+            logger.info(f"Taste: {result}")
+    await cleanup_old()
+    return result
+
+
+async def start_taste_service() -> None:
+    await asyncio.sleep(15 * 60)
+    while True:
+        try:
+            await run_once()
+        except asyncio.CancelledError:
+            raise
+        except Exception as e:
+            logger.warning(f"Taste service: {type(e).__name__}: {e}")
+        await asyncio.sleep(6 * 3600)
