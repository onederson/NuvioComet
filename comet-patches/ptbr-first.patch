+# ---------------------------------------------------------------------------
+def build_candidates(raw: list[dict], max_total: int = MAX_CANDIDATES,
+                     per_state: int = PER_STATE, web_cap: int = WEB_CAP) -> list[dict]:
+    """Normaliza, deduplica e escolhe: Pernambuco inteiro + top de cada UF + completa por popularidade."""
+    recs: list[dict] = []
+    for st in raw:
+        cc = (st.get("countrycode") or "").upper()
+        if cc and cc != "BR":
+            continue
+        url = (st.get("url_resolved") or st.get("url") or "").strip()
+        uuid = (st.get("stationuuid") or "").strip()
+        if not url.lower().startswith(("http://", "https://")) or not UUID_RE.match(uuid):
+            continue
+        if st.get("lastcheckok") == 0:
+            continue
+        uf, city = detect_location(st)
+        recs.append({
+            "id": uuid,
+            "name": clean_name(st.get("name") or ""),
+            "nkey": norm_name(st.get("name") or "") or uuid,
+            "url": url,
+            "orig_url": (st.get("url") or "").strip(),
+            "uf": uf,
+            "city": city,
+            "region": UFS[uf][1] if uf else "",
+            "kinds": detect_kinds(st),
+            "tags": (st.get("tags") or "")[:200],
+            "codec": (st.get("codec") or "").upper().replace("UNKNOWN", ""),
+            "bitrate": int(st.get("bitrate") or 0),
+            "hls": bool(st.get("hls")),
+            "favicon_src": (st.get("favicon") or "").strip(),
+            "homepage": (st.get("homepage") or "").strip(),
+            "votes": int(st.get("votes") or 0),
+            "clickcount": int(st.get("clickcount") or 0),
+            "score": popularity(st),
+        })
+    recs.sort(key=lambda r: (-r["score"], r["name"]))
+    recs = dedupe(recs)
+
+    pe = [r for r in recs if is_pe(r)]
+    chosen: dict[str, dict] = {r["id"]: r for r in pe}
+    per_uf: dict[str, int] = {}
+    web = 0
+    for r in recs:
+        if r["id"] in chosen:
+            continue
+        if r["uf"]:
+            if per_uf.get(r["uf"], 0) < per_state:
+                per_uf[r["uf"]] = per_uf.get(r["uf"], 0) + 1
+                chosen[r["id"]] = r
+        elif web < min(web_cap, 15):
+            web += 1
+            chosen[r["id"]] = r
+    for r in recs:  # completa pela popularidade
+        if len(chosen) >= max_total:
+            break
+        if r["id"] in chosen:
+            continue
+        if not r["uf"]:
+            if web >= web_cap:
+                continue
+            web += 1
+        chosen[r["id"]] = r
+    out = list(chosen.values())
+    return order_default(out)
+
+
+def dedupe(recs: list[dict]) -> list[dict]:
+    """Recebe ordenado por popularidade. Mesma URL = duplicata; mesmo nome normalizado na mesma UF
+    (ou sem UF) = duplicata. Fica a mais popular; se a mantida é http e a duplicata é https, troca a URL."""
+    by_url: dict[str, dict] = {}
+    by_name: dict[tuple[str, str], dict] = {}
+    out: list[dict] = []
+    for r in recs:
+        ukey = re.sub(r"^https?://", "", r["url"].lower()).rstrip("/;")
+        nk = (r["nkey"], r["uf"])
+        keep = by_url.get(ukey) or by_name.get(nk) or (by_name.get((r["nkey"], "")) if r["uf"] else None)
+        if keep is not None:
+            if keep["url"].startswith("http://") and r["url"].startswith("https://") and nk == (keep["nkey"], keep["uf"]):
+                keep["alt_url"] = keep["url"]
+                keep["url"] = r["url"]
+            if not keep["uf"] and r["uf"]:
+                keep["uf"], keep["city"], keep["region"] = r["uf"], r["city"], r["region"]
+            if not keep["favicon_src"] and r["favicon_src"]:
+                keep["favicon_src"] = r["favicon_src"]
+            by_url.setdefault(ukey, keep)
+            continue
+        by_url[ukey] = r
+        by_name[nk] = r
+        out.append(r)
+    return out
+
+
+def order_default(recs: list[dict]) -> list[dict]:
+    return sorted(recs, key=lambda r: (0 if is_pe(r) else 1, -r["score"], r["name"]))
+
+
+def station_genres(r: dict) -> list[str]:
+    g: list[str] = []
+    if is_pe(r):
+        g.append(GENRE_PE)
+    g.append(r["region"] if r.get("region") else GENRE_WEB)
+    g.extend(r.get("kinds") or ["Música"])
+    return g
+
