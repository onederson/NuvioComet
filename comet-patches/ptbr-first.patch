+"""Bot do Telegram do Comet (link pessoal).
+
+- Pedidos em texto livre: "Duna 2 dublado", "The Last of Us T2E3".
+  Acha o título no TMDB, olha a lista de fontes e: avisa se já está pronto (🇧🇷 ⚡ ou link direto),
+  manda o debrid baixar o melhor 🇧🇷 não cacheado (e avisa quando ficar ⚡), ou diz o que existe.
+- /status, /ajuda.
+- send_telegram(text): usado por outros módulos (avisos).
+- Checagem diária de vencimento do Real-Debrid / TorBox.
+Só responde ao chat de TELEGRAM_CHAT_ID.
+"""
+from __future__ import annotations
+
+import asyncio
+import json
+import re
+import time
+import unicodedata
+from pathlib import Path
+
+import aiohttp
+
+from comet.core.logger import logger, log_swallowed
+from comet.core.models import settings
+
+_API = "https://api.telegram.org/bot{token}/{method}"
+_OFFSET_FILE = Path("/opt/comet/data/telegram_offset")
+_EXPIRY_FILE = Path("/opt/comet/data/telegram_expiry_check.json")
+_LOCAL = "http://127.0.0.1:8000"
+_TASKS: set = set()
+_WATCHING: set[str] = set()
+
+
+def _env(key: str) -> str | None:
+    val = getattr(settings, key, None)
+    if val:
+        return str(val)
+    try:
+        for line in open("/opt/comet/.env", encoding="utf-8"):
+            if line.startswith(key + "="):
+                v = line.split("=", 1)[1].strip().strip('"')
+                return v or None
+    except OSError:
+        pass
+    return None
+
+
+def _spawn(coro) -> None:
+    task = asyncio.create_task(coro)
+    _TASKS.add(task)
+    task.add_done_callback(_TASKS.discard)
+
+
+async def _call(session: aiohttp.ClientSession, method: str, payload: dict, timeout: float = 20.0) -> dict | None:
+    token = _env("TELEGRAM_BOT_TOKEN")
+    if not token:
+        return None
+    try:
+        async with session.post(_API.format(token=token, method=method), json=payload,
+                                timeout=aiohttp.ClientTimeout(total=timeout)) as r:
+            data = await r.json(content_type=None)
+            if not data.get("ok"):
+                logger.warning(f"Telegram {method}: {str(data.get('description'))[:120]}")
+            return data
+    except asyncio.CancelledError:
+        raise
+    except Exception as e:
+        logger.warning(f"Telegram {method} falhou: {type(e).__name__}")
+        return None
+
+
+async def send_telegram(text: str) -> bool:
+    """Manda uma mensagem para o dono. Seguro de chamar de qualquer lugar."""
+    chat = _env("TELEGRAM_CHAT_ID")
+    if not chat or not _env("TELEGRAM_BOT_TOKEN"):
+        return False
+    async with aiohttp.ClientSession() as s:
+        data = await _call(s, "sendMessage", {"chat_id": chat, "text": text[:4000], "disable_web_page_preview": True})
+    return bool(data and data.get("ok"))
+
+
+async def send_telegram_file(path: str | Path, caption: str = "", photo: bool = False) -> bool:
+    """Manda um arquivo (documento, ou foto se photo=True) para o dono. Limite do Telegram: 50 MB (foto: 10 MB)."""
+    chat, token = _env("TELEGRAM_CHAT_ID"), _env("TELEGRAM_BOT_TOKEN")
+    p = Path(path)
+    if not chat or not token or not p.is_file():
+        return False
+    method, field = ("sendPhoto", "photo") if photo else ("sendDocument", "document")
+    form = aiohttp.FormData()
+    form.add_field("chat_id", str(chat))
+    if caption:
+        form.add_field("caption", caption[:1000])
+    try:
+        with open(p, "rb") as fh:
+            form.add_field(field, fh, filename=p.name)
+            async with aiohttp.ClientSession() as s:
+                async with s.post(_API.format(token=token, method=method), data=form,
+                                  timeout=aiohttp.ClientTimeout(total=300)) as r:
+                    data = await r.json(content_type=None)
+        if not data.get("ok"):
+            logger.warning(f"Telegram {method}: {str(data.get('description'))[:120]}")
+        return bool(data.get("ok"))
+    except asyncio.CancelledError:
+        raise
+    except Exception as e:
+        logger.warning(f"Telegram {method} falhou: {type(e).__name__}")
+        return False
+
+
+# Módulos com comandos próprios. Cada um pode ter:
+#   async def handle_command(text: str) -> str | None   (None = não é comigo)
+#   HELP: str                                            (linhas para o /ajuda)
+#   async def status_lines() -> list[str]                (linhas extras no /status)
+_PLUGINS = ("comet.services.guardian", "comet.services.reminders",
+            "comet.services.evening", "comet.services.recap", "comet.services.trakt")
+
+
+def _plugin_modules() -> list:
+    import importlib
+    mods = []
+    for name in _PLUGINS:
+        try:
+            mods.append(importlib.import_module(name))
+        except Exception as e:
+            logger.debug(f"Telegram: módulo {name} indisponível: {type(e).__name__}")
+    return mods
+
+
+def _norm(t: str) -> str:
+    t = unicodedata.normalize("NFKD", t).encode("ascii", "ignore").decode().lower()
+    return re.sub(r"\s+", " ", t).strip()
+
+
+
+_NUM_WORDS = {
+    "1": {"1", "i", "um", "one"}, "2": {"2", "ii", "dois", "two"}, "3": {"3", "iii", "tres", "three"},
+    "4": {"4", "iv", "quatro", "four"}, "5": {"5", "v", "cinco", "five"}, "6": {"6", "vi", "seis", "six"},
+    "7": {"7", "vii", "sete", "seven"}, "8": {"8", "viii", "oito", "eight"}, "9": {"9", "ix", "nove", "nine"},
+}
+
+
+def _rank(r: dict, query: str, year: int | None, prefer_released: bool = True) -> tuple:
+    """Quantas palavras da busca aparecem no título (números valem por extenso/romano) + popularidade."""
+    title = _norm(" ".join(str(r.get(k) or "") for k in ("title", "name", "original_title", "original_name")))
+    words = set(re.findall(r"[a-z0-9]+", title))
+    q_tokens = [t for t in re.findall(r"[a-z0-9]+", _norm(query)) if t not in ("o", "a", "de", "do", "da", "the", "of")]
+    hits = sum(1 for t in q_tokens if (t in words) or (t in _NUM_WORDS and _NUM_WORDS[t] & words))
+    full = hits == len(q_tokens) and len(q_tokens) > 0
+    date = r.get("release_date") or r.get("first_air_date") or ""
+    year_ok = bool(year) and date.startswith(str(year))
+    released = bool(date) and date <= time.strftime("%Y-%m-%d")
+    if prefer_released:  # pedido para assistir agora: o que já saiu vem antes
+        return (year_ok, released, full, hits, float(r.get("popularity") or 0))
+    # lista de desejos: o nome exato vale mais, mesmo que ainda não tenha estreado
+    return (year_ok, full, hits, released, float(r.get("popularity") or 0))
+
+
+_GREETINGS = {"oi", "ola", "olá", "opa", "eai", "e ai", "bom dia", "boa tarde", "boa noite", "obrigado", "obrigada", "valeu", "vlw", "ok", "beleza", "blz", "teste"}
+
+_EP_RE = re.compile(r"\b(?:t|s|temporada\s*)(\d{1,2})\s*(?:e|ep|episodio\s*)(\d{1,3})\b", re.I)
+
+
+def parse_request(text: str) -> dict:
+    raw = text.strip()
+    n = _norm(raw)
+    season = episode = None
+    m = _EP_RE.search(n)
+    if m:
+        season, episode = int(m.group(1)), int(m.group(2))
+        n = (n[: m.start()] + " " + n[m.end():]).strip()
+    dub = bool(re.search(r"\b(dublad[oa]s?|dub|pt-?br|portugues)\b", n))
+    n = re.sub(r"\b(dublad[oa]s?|dub|pt-?br|portugues|legendad[oa]s?|filme|serie|o|a|de|do|da)\b", " ", n)
+    year = None
+    y = re.search(r"\b(19[2-9]\d|20[0-4]\d)\b", n)
+    if y:
+        year = int(y.group(1))
+        n = n.replace(y.group(1), " ")
+    query = re.sub(r"\s+", " ", n).strip()
+    return {"query": query, "season": season, "episode": episode, "dub": dub, "year": year}
+
+
+async def _tmdb_find(session: aiohttp.ClientSession, req: dict, prefer_released: bool = True) -> dict | None:
+    from comet.metadata.tmdb import TMDBApi
+    tmdb = TMDBApi(session)
+    q = req["query"]
+    if not q:
+        return None
+    want_tv = req["season"] is not None
+    from urllib.parse import quote
+    data = await tmdb._get_json(f"search/multi?query={quote(q)}&language=pt-BR&include_adult=false", f"tg search {q}")
+    results = [r for r in (data or {}).get("results", []) if r.get("media_type") in ("movie", "tv")]
+    if want_tv:
+        results = [r for r in results if r.get("media_type") == "tv"] or results
+    if not results:
+        return None
+    best = max(results[:12], key=lambda r: _rank(r, q, req.get("year"), prefer_released))
+    kind = best["media_type"]
+    ext = await tmdb._get_json(f"{kind}/{best['id']}/external_ids", f"tg ext {best['id']}")
+    imdb = (ext or {}).get("imdb_id")
+    if not imdb:
+        return None
+    name = best.get("title") or best.get("name") or q
+    year = (best.get("release_date") or best.get("first_air_date") or "")[:4]
+    return {"type": "movie" if kind == "movie" else "series", "imdb": imdb, "name": name, "year": year}
+
+
+async def _streams(session: aiohttp.ClientSession, stype: str, sid: str) -> list[dict]:
+    token = settings.PERSONAL_LINK_TOKEN
+    async with session.get(f"{_LOCAL}/{token}/stream/{stype}/{sid}.json",
+                           timeout=aiohttp.ClientTimeout(total=120)) as r:
+        if r.status != 200:
+            return []
+        data = await r.json(content_type=None)
+        return (data or {}).get("streams") or []
+
+
+def _summary(streams: list[dict]) -> tuple[str | None, str | None]:
+    """(linha do 🇧🇷 pronto, linha do melhor pronto sem PT)."""
+    pt_ready = other_ready = None
+    for s in streams:
+        name = str(s.get("name") or "")
+        if name.startswith("▶"):
+            continue
+        flat = name.replace("\n", " ")
+        if ("⚡" in name or "🌐" in name) and "🇧🇷" in name and not pt_ready:
+            pt_ready = flat
+        elif "⚡" in name and "🇧🇷" not in name and not other_ready:
+            other_ready = flat
+    return pt_ready, other_ready
+
+
+async def _trigger_download(session: aiohttp.ClientSession, choice: dict) -> int | None:
+    url = str(choice["stream"]["url"])
+    public = (getattr(settings, "PUBLIC_BASE_URL", None) or "").rstrip("/")
+    if public and url.startswith(public):
+        url = _LOCAL + url[len(public):]
+    try:
+        async with session.get(url, headers={"Range": "bytes=0-1", "User-Agent": "ExoPlayerLib/2.19.1"},
+                               allow_redirects=False, timeout=aiohttp.ClientTimeout(total=25)) as r:
+            return r.status
+    except Exception:
+        return None
+
+
+async def _watch_until_ready(stype: str, sid: str, label: str) -> None:
+    key = f"{stype}:{sid}"
+    if key in _WATCHING:
+        return
+    _WATCHING.add(key)
+    try:
+        deadline = time.time() + 4 * 3600
+        await asyncio.sleep(240)
+        async with aiohttp.ClientSession() as s:
+            while time.time() < deadline:
+                try:
+                    pt, _ = _summary(await _streams(s, stype, sid))
+                    if pt and "⚡" in pt:
+                        await send_telegram(f"⚡ Pronto pra assistir: {label}\n{pt}")
+                        return
+                except Exception as _e:
+                    log_swallowed("telegram_bot._watch_until_ready", _e)
+                await asyncio.sleep(300)
+        await send_telegram(f"⏳ {label} ainda não ficou pronto em 4 h. O Real-Debrid pode estar sem fontes rápidas para ele.")
+    finally:
+        _WATCHING.discard(key)
+
+
+async def handle_request(text: str) -> str:
+    from comet.services.prefetch import _pick_predownload
+    req = parse_request(text)
+    async with aiohttp.ClientSession(timeout=aiohttp.ClientTimeout(total=20)) as s:
+        found = await _tmdb_find(s, req)
+        if not found:
+            return f"🤔 Não achei \"{req['query'] or text}\". Tente com o nome do filme/série (pode ser em português)."
+        stype, imdb = found["type"], found["imdb"]
+        if stype == "series":
+            se, ep = req["season"] or 1, req["episode"] or 1
+            sid, label = f"{imdb}:{se}:{ep}", f"{found['name']} T{se}E{ep}"
+        else:
+            sid, label = imdb, f"{found['name']} ({found['year']})"
+        streams = await _streams(s, stype, sid)
+        if not streams:
+            return f"😕 {label}: nenhuma fonte encontrada agora."
+        pt, other = _summary(streams)
+        if pt:
+            return f"✅ {label} já está pronto dublado:\n{pt}\nÉ só abrir no Stremio."
+        choice = _pick_predownload(streams)
+        if choice:
+            st = await _trigger_download(s, choice)
+            if st is None:
+                return f"⚠️ {label}: achei dublado ({choice['res']}), mas o pedido ao {choice['service']} falhou."
+            _spawn(_watch_until_ready(stype, sid, label))
+            extra = "" if not other else f"\n(Legendado já pronto: {other})"
+            return f"📥 {label}: mandei o {choice['service']} baixar a versão dublada {choice['res']}. Te aviso aqui quando ficar ⚡ pronto.{extra}"
+        if other:
+            return f"🇬🇧 {label}: não achei dublado, mas tem legendado pronto:\n{other}"
+        return f"😕 {label}: só achei fontes que precisam baixar e nenhuma dublada."
+
+
+async def _status_text() -> str:
+    lines = ["📊 Comet do A71"]
+    try:
+        mem = {l.split(":")[0]: int(l.split()[1]) for l in open("/proc/meminfo") if l.split(":")[0] in ("MemAvailable", "SwapFree")}
+        lines.append(f"🧠 Memória livre: {mem.get('MemAvailable', 0) // 1024} MB · swap livre {mem.get('SwapFree', 0) // 1024} MB")
+    except Exception as _e:
+        log_swallowed("telegram_bot._status_text", _e)
+    try:
+        sm = json.loads(Path("/opt/comet/data/smoke_last.json").read_text())
+        lines.append(f"🧪 Teste automático: {'OK' if sm.get('ok') else 'FALHOU'} ({str(sm.get('ts', ''))[:16].replace('T', ' ')} UTC)")
+    except Exception:
+        lines.append("🧪 Teste automático: sem resultado")
+    try:
+        from comet.services.prefetch import get_predownload_summary
+        pd = get_predownload_summary()
+        lines.append(f"📥 Pré-downloads hoje: {pd['today']}")
+    except Exception as _e:
+        log_swallowed("telegram_bot._status_text", _e)
+    lines.append(f"👀 Pedidos em acompanhamento: {len(_WATCHING)}")
+    for mod in _plugin_modules():
+        fn = getattr(mod, "status_lines", None)
+        if fn:
+            try:
+                lines.extend(await asyncio.wait_for(fn(), 15))
+            except Exception as e:
+                logger.debug(f"status_lines {mod.__name__}: {type(e).__name__}")
+    return "\n".join(lines)
+
+
+_HELP = ("Me mande o que quer assistir, do jeito que falaria:\n"
+         "• Duna 2 dublado\n• The Last of Us T2E3\n• Matrix 1999\n\n"
+         "Eu procuro, e se o dublado não estiver pronto mando o Real-Debrid baixar e te aviso quando ficar ⚡.\n\n"
+         "/status — como está o A71\n/gosto — o que o Comet aprendeu do seu gosto\n/ajuda — esta mensagem")
+
+try:
+    from comet.services.wishlist import HELP_WISHLIST as _HW
+    _HELP = _HELP + "\n\n" + _HW
+except Exception as _e:
+    log_swallowed("telegram_bot.<module>", _e)
+
+
+def _full_help() -> str:
+    parts = [_HELP]
+    for mod in _plugin_modules():
+        h = getattr(mod, "HELP", None)
+        if h:
+            parts.append(str(h).strip())
+    return "\n\n".join(parts)
+
+
+async def _expiry_check(session: aiohttp.ClientSession) -> None:
+    """1x/dia: avisa se Real-Debrid ou TorBox vencem em ≤ 7 dias."""
+    try:
+        last = json.loads(_EXPIRY_FILE.read_text()).get("day")
+    except Exception:
+        last = None
+    today = time.strftime("%Y-%m-%d")
+    if last == today:
+        return
+    msgs = []
+    try:
+        from comet.core.config_validation import config_check
+        cfg = config_check(settings.PERSONAL_LINK_TOKEN) or {}
+        entries = cfg.get("debridServices") or cfg.get("_debridEntries") or []
+    except Exception:
+        entries = []
+    from datetime import datetime, timezone
+    for e in entries:
+        svc, key = e.get("service"), e.get("apiKey")
+        try:
+            if svc == "realdebrid" and key:
+                async with session.get("https://api.real-debrid.com/rest/1.0/user", headers={"Authorization": f"Bearer {key}"}) as r:
+                    d = await r.json(content_type=None)
+                exp = d.get("expiration")
+                if exp:
+                    days = (datetime.fromisoformat(exp.replace("Z", "+00:00")) - datetime.now(timezone.utc)).days
+                    if days <= 7:
+                        msgs.append(f"⚠️ Real-Debrid vence em {days} dia(s).")
+            elif svc == "torbox" and key:
+                async with session.get("https://api.torbox.app/v1/api/user/me",
+                                       headers={"Authorization": f"Bearer {key}", "User-Agent": "Comet-A71"}) as r:
+                    d = await r.json(content_type=None)
+                exp = (d.get("data") or {}).get("premium_expires_at")
+                if exp:
+                    days = (datetime.fromisoformat(exp.replace("Z", "+00:00")) - datetime.now(timezone.utc)).days
+                    if days <= 7:
+                        msgs.append(f"⚠️ TorBox vence em {days} dia(s).")
+        except Exception as ex:
+            logger.debug(f"checagem de vencimento {svc}: {ex}")
+    for m in msgs:
+        await send_telegram(m)
+    try:
+        _EXPIRY_FILE.write_text(json.dumps({"day": today, "alerts": len(msgs)}))
+    except Exception as _e:
+        log_swallowed("telegram_bot._expiry_check", _e)
+
+
+async def start_telegram_bot() -> None:
+    token, chat = _env("TELEGRAM_BOT_TOKEN"), _env("TELEGRAM_CHAT_ID")
+    if not token or not chat:
+        logger.info("Telegram: sem TELEGRAM_BOT_TOKEN/TELEGRAM_CHAT_ID, bot desligado")
+        return
+    try:
+        offset = int(_OFFSET_FILE.read_text().strip())
+    except Exception:
+        offset = 0
+    logger.info("🤖 Telegram: bot ligado")
+    last_expiry = 0.0
+    async with aiohttp.ClientSession() as s:
+        while True:
+            try:
+                if time.time() - last_expiry > 3600:
+                    last_expiry = time.time()
+                    _spawn(_expiry_check(s))
+                data = await _call(s, "getUpdates", {"offset": offset, "timeout": 50, "allowed_updates": ["message"]}, timeout=65)
+                if not data or not data.get("ok"):
+                    await asyncio.sleep(15)
+                    continue
+                for upd in data.get("result", []):
+                    offset = max(offset, upd["update_id"] + 1)
+                    msg = upd.get("message") or {}
+                    if str((msg.get("chat") or {}).get("id")) != str(chat):
+                        continue
+                    text = (msg.get("text") or "").strip()
+                    if not text:
+                        continue
+                    _spawn(_answer(s, chat, text))
+                try:
+                    _OFFSET_FILE.write_text(str(offset))
+                except Exception as _e:
+                    log_swallowed("telegram_bot.start_telegram_bot", _e)
+            except asyncio.CancelledError:
+                raise
+            except Exception as e:
+                logger.warning(f"Telegram: erro no loop: {type(e).__name__}")
+                await asyncio.sleep(15)
+
+
+async def _answer(session: aiohttp.ClientSession, chat: str, text: str) -> None:
+    low = text.lower()
+    try:
+        from comet.services.wishlist import handle_command
+        reply = await handle_command(text)
+        if reply is None and low.startswith("/"):
+            for mod in _plugin_modules():
+                fn = getattr(mod, "handle_command", None)
+                if not fn:
+                    continue
+                reply = await fn(text)
+                if reply is not None:
+                    break
+        if reply is not None:
+            pass
+        elif low.startswith("/start") or low.startswith("/ajuda") or low.startswith("/help"):
+            reply = "👋 Oi! Sou o Comet do A71.\n\n" + _full_help()
+        elif low.startswith("/gosto"):
+            from comet.services.taste import summary_text as _taste_summary
+            reply = await _taste_summary()
+        elif low.startswith("/status"):
+            reply = await _status_text()
+        elif _norm(text).strip(' !?.') in _GREETINGS or len(_norm(text)) < 3:
+            reply = "👋 Oi! Me diga o que quer assistir. Ex.: Duna 2 dublado, The Last of Us T2E3. /ajuda mostra tudo."
+        elif low.startswith("/"):
+            reply = "Não conheço esse comando. " + _full_help()
+        else:
+            await _call(session, "sendMessage", {"chat_id": chat, "text": "🔎 Procurando…"})
+            reply = await handle_request(text)
+        logger.info(f"🤖 Telegram: pedido \"{text[:60]}\" → {reply.splitlines()[0][:80]}")
+    except Exception as e:
+        logger.warning(f"Telegram: falha ao responder: {type(e).__name__}: {e}")
+        reply = "😵 Deu um erro aqui. Tenta de novo daqui a pouco."
+    await _call(session, "sendMessage", {"chat_id": chat, "text": reply[:4000], "disable_web_page_preview": True})
