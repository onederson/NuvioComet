+import asyncio
+import datetime
+import hashlib
+import json
+import os
+import re
+import time
+import urllib.parse
+import uuid
+
+import httpx
+
+from comet.core.logger import logger, log_swallowed
+from comet.core.models import settings
+from comet.services.direct_addons import _is_host_blocked_by_house_dns
+
+PLUTO_DEVICE_ID_FILE = "/opt/comet/data/pluto_device_id"
+PLUTO_ALIVE_FILE = "/opt/comet/data/pluto_alive.json"
+IPTV_ALIVE_FILE = "/opt/comet/data/iptv_alive.json"
+PLUTO_API_URL = "https://api.pluto.tv/v2/channels"
+IPTV_ORG_BR_URL = "https://iptv-org.github.io/iptv/countries/br.m3u"
+IPTV_ORG_POR_URL = "https://iptv-org.github.io/iptv/languages/por.m3u"  # Portugal, Angola, Moçambique... (o index.m3u mundial é pesado demais)
+
+BR_TZ = datetime.timezone(datetime.timedelta(hours=-3))
+KIDS_CATEGORIES = {"infantil", "nickelodeon", "kids", "animação", "animacao"}
+
+DEFAULT_PLUTO_CATEGORIES = [
+    "Filmes", "Retrô", "MTV", "Anime & Geek", "Natureza", "Infantil",
+    "Curiosidades", "Estilo de Vida", "Investigação", "Esportes", "Comédia",
+    "Novelas", "Star Trek", "Mistérios e Sobrenatural", "Séries", "Nickelodeon",
+    "Música", "Reality", "South Park br", "Notícias", "TV Brasileira"
+]
+
+_pluto_channels: list[dict] = []
+_pluto_channels_by_id: dict[str, dict] = {}
+_pluto_categories: list[str] = []
+_pluto_cache_time: float = 0.0
+_pluto_lock = asyncio.Lock()
+_pluto_alive_ids: set[str] | None = None
+_pluto_lang: dict[str, str] = {}
+_pluto_info_when: float = 0.0
+_LAST_LANG: dict[str, str] = {}
+_RESOLVE_CACHE: dict[str, tuple[str, float]] = {}
+PLUTO_INFO_FILE = "/opt/comet/data/pluto_info.json"
+LANG_PT = "🇧🇷 Em português"
+LANG_OTHER = "🌎 Outros idiomas"
+# Canais nacionais que o Pluto marca com áudio "en" por engano
+_FORCE_PT_WORDS = ("porta", "trapalh", "turma da m", "mundo do bita", "galinha pintadinha", "luccas", "chaves", "chapolin",
+                   "brasil", "portugu", "record", "jovem pan", "bm&c", "cnbc", "popeye", "salon line", "tiktok", "pegadinhas",
+                   "bob esponja", "nick", "avatar", "tartarugas")
+_FORCE_PT_CATS = ("tv brasileira", "novelas", "infantil", "nickelodeon", "south park br")
+_LANG_NAMES = {"en": "inglês", "es": "espanhol", "fr": "francês", "it": "italiano", "de": "alemão", "ja": "japonês", "ko": "coreano"}
+
+
+_LANG3 = {"por": "pt", "eng": "en", "spa": "es", "fra": "fr", "fre": "fr", "ita": "it", "deu": "de", "ger": "de", "jpn": "ja", "kor": "ko"}
+
+
+def _lang2(code: str) -> str:
+    c = (code or "").lower().split("-")[0]
+    return _LANG3.get(c, c[:2]) if len(c) == 3 else c[:2]
+
+
+def _audio_lang(master_txt: str) -> str:
+    """Idioma da faixa de áudio padrão anunciada no master HLS ('' se não houver)."""
+    first = ""
+    for line in master_txt.splitlines():
+        if line.startswith("#EXT-X-MEDIA:") and "TYPE=AUDIO" in line:
+            m = re.search(r'LANGUAGE="([A-Za-z-]+)"', line)
+            lang = _lang2((m.group(1) if m else ""))
+            if lang and not first:
+                first = lang
+            if lang and "DEFAULT=YES" in line:
+                return lang
+    return first
+
+
+def _norm_name(name: str) -> str:
+    n = (name or "").lower()
+    n = re.sub(r"\((?:\d{3,4}p|[^)]*)\)", " ", n)
+    n = n.replace("pluto tv", " ").replace("clássico", "classico").replace("’", "'")
+    return re.sub(r"[^a-z0-9]+", "", n)
+
+
+def _pluto_ch_lang(ch: dict) -> str:
+    name = (ch.get("name") or "").lower()
+    cat = (ch.get("category") or "").lower()
+    if cat in _FORCE_PT_CATS or any(w in name for w in _FORCE_PT_WORDS):
+        return "pt"
+    return _pluto_lang.get(ch.get("_id") or "", "") or "pt"
+
+
+def _iptv_lang(ch: dict) -> str:
+    """Lista do Brasil: o rótulo de áudio do HLS erra muito. Nome com BR/Brazil/termo nacional = PT."""
+    n = " " + (ch.get("name") or "").lower().replace("(", " ").replace(")", " ") + " "
+    if " br " in n or "brazil" in n or "brasil" in n or any(w in n for w in _FORCE_PT_WORDS):
+        return "pt"
+    return ch.get("lang") or "pt"
+
+
+def _lang_label(lang: str) -> str:
+    if not lang or lang == "pt":
+        return "🇧🇷 Em português"
+    return f"🌎 Áudio original em {_LANG_NAMES.get(lang, lang)} (legenda PT)"
+
+
+def _dedupe_pluto(chs: list[dict]) -> list[dict]:
+    """Mesmo canal em duas categorias (ou cópia antiga morta): fica um só, o com mais programação."""
+    best: dict[str, dict] = {}
+    order: list[str] = []
+    for ch in chs:
+        k = _norm_name(ch.get("name") or "") or ch.get("_id")
+        if k not in best:
+            best[k] = ch
+            order.append(k)
+        elif len(ch.get("timelines") or []) > len(best[k].get("timelines") or []):
+            best[k] = ch
+    return [best[k] for k in order]
+
+
+def _iptv_is_dup(ch: dict, pluto_names: set[str]) -> bool:
+    u = (ch.get("url") or "").lower()
+    n = (ch.get("name") or "").lower()
+    if "pluto.tv" in u or "jmp2.uk" in u or "pluto" in n:
+        return True
+    return _norm_name(ch.get("name") or "") in pluto_names
+
+
+def load_pluto_info():
+    global _pluto_lang, _pluto_info_when
+    try:
+        with open(PLUTO_INFO_FILE, "r", encoding="utf-8") as f:
+            d = json.load(f)
+        _pluto_lang = dict(d.get("lang") or {})
+        _pluto_info_when = float(d.get("when") or 0)
+    except Exception as _e:
+        log_swallowed("live_tv.load_pluto_info", _e)
+
+
+def _save_pluto_info(lang: dict[str, str]):
+    global _pluto_lang, _pluto_info_when
+    _pluto_lang = dict(lang)
+    _pluto_info_when = time.time()
+    try:
+        tmp = f"{PLUTO_INFO_FILE}.tmp.{os.getpid()}"
+        with open(tmp, "w", encoding="utf-8") as f:
+            json.dump({"when": _pluto_info_when, "lang": _pluto_lang}, f)
+        os.replace(tmp, PLUTO_INFO_FILE)
+    except Exception as e:
+        logger.warning(f"Error saving pluto_info.json: {e}")
+
+
+def _quick_ok(url: str, timeout: float = 5.0) -> bool:
+    """Teste rápido na hora do clique: master + variante com segmentos + 1º segmento responde."""
+    try:
+        with httpx.Client(headers={"User-Agent": "ExoPlayerLib/2.19.1"}, follow_redirects=True, timeout=timeout) as c:
+            r = c.get(url)
+            if r.status_code != 200 or "#EXTM3U" not in r.text[:200]:
+                return False
+            var = [l.strip() for l in r.text.splitlines() if l.strip() and not l.startswith("#")]
+            if not var:
+                return False
+            v = c.get(urllib.parse.urljoin(str(r.url), var[0]))
+            segs = [l.strip() for l in v.text.splitlines() if l.strip() and not l.startswith("#")]
+            if v.status_code != 200 or len(segs) < 2 or any("slate" in x.lower() for x in segs):
+                return False
+            with c.stream("GET", urllib.parse.urljoin(str(v.url), segs[-1])) as sr:
+                return sr.status_code == 200 and len(next(sr.iter_bytes(2048), b"")) >= 100
+    except Exception:
+        return False
+
+
+async def _fresh_pluto_session() -> dict | None:
+    """Sessão v4 exclusiva para uma abertura (não entra no cache compartilhado)."""
+    params = {
+        "appName": "web", "appVersion": "9.0.0", "deviceVersion": "122.0.0", "deviceModel": "web",
+        "deviceMake": "chrome", "deviceType": "web", "clientID": str(uuid.uuid4()),
+        "clientModelNumber": "1.0.0", "serverSideAds": "false",
+    }
+    try:
+        async with httpx.AsyncClient(timeout=8.0) as client:
+            resp = await client.get("https://boot.pluto.tv/v4/start?" + urllib.parse.urlencode(params))
+            if resp.status_code != 200:
+                return None
+            data = resp.json()
+            tok = data.get("sessionToken")
+            st = ((data.get("servers") or {}).get("stitcher") or "").rstrip("/")
+            if tok and st:
+                return {"sessionToken": tok, "stitcherParams": (data.get("stitcherParams") or "").lstrip("?&"), "stitcher": st}
+    except Exception as e:
+        logger.debug(f"Pluto: sessão nova falhou: {e}")
+    return None
+
+
+def _master_ok(url: str, timeout: float = 5.0) -> bool:
+    """Confere só o master e UMA variante (com segmentos) — sem baixar vídeo, para não gastar a sessão."""
+    try:
+        with httpx.Client(headers={"User-Agent": "ExoPlayerLib/2.19.1"}, follow_redirects=True, timeout=timeout) as c:
+            r = c.get(url)
+            if r.status_code != 200 or "#EXTM3U" not in r.text[:200]:
+                return False
+            var = [l.strip() for l in r.text.splitlines() if l.strip() and not l.startswith("#")]
+            if not var:
+                return False
+            v = c.get(urllib.parse.urljoin(str(r.url), var[0]))
+            segs = [l for l in v.text.splitlines() if l.strip() and not l.startswith("#")]
+            return v.status_code == 200 and len(segs) >= 2 and not any("slate" in x.lower() for x in segs)
+    except Exception:
+        return False
