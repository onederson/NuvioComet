+async def _top_backdrops(key: str, n: int = 6) -> list[str]:
+    """Fundos (TMDB) dos títulos em alta no serviço, para o destaque e o vídeo."""
+    from comet.services import catalogs as _cat
+    base = (getattr(settings, "PUBLIC_BASE_URL", None) or "").rstrip("/")
+    paths: list[str] = []
+    if key == FORYOU_ID:
+        sources = [("movie", "comet_trending"), ("series", "comet_trending")]
+        for mt, cid in sources:
+            try:
+                metas = await _cat.get_catalog(mt, cid, {}, base_url=base)
+            except Exception as e:
+                log_swallowed("streamings._top_backdrops", e)
+                metas = []
+            paths += [m.get("background") or "" for m in metas[:n]]
+    else:
+        for tab, mt in (("hots", "series"), ("hotm", "movie")):
+            try:
+                metas = await get_catalog(mt, CATALOG_PREFIX + tab, {"genre": key}, base)
+            except Exception as e:
+                log_swallowed("streamings._top_backdrops", e)
+                metas = []
+            paths += [m.get("background") or "" for m in metas[:n]]
+    out = []
+    for bg in paths:
+        mm = re.search(r"/t/p/\w+(/[A-Za-z0-9_-]+\.(?:jpg|png))", bg)
+        if mm and mm.group(1) not in out:
+            out.append(mm.group(1))
+    # alterna série e filme para o vídeo ficar variado
+    return out[: n]
