+"""Trakt como biblioteca (o Nuvio guarda lá a lista e o histórico).
+
+O Nuvio usa o Trakt como "Fonte para Biblioteca" e manda para lá o que você assiste. Este módulo
+lê a lista de desejos, o histórico e o progresso do Trakt e entrega tudo no MESMO formato dos
+itens da biblioteca do Stremio (`libraryItem`). Assim Minha lista, Novos episódios, Recomendados,
+Chegou dublado, Minha TV, gosto e aquecimento passam a seguir o que você vê no Nuvio sem mudar nada
+nesses módulos (ver `stremio_library.get_stremio_library`).
+
+Conexão (uma vez): crie um app em https://trakt.tv/oauth/applications (redirect
+`urn:ietf:wg:oauth:2.0:oob`), ponha TRAKT_CLIENT_ID no .env e mande /trakt no Telegram. O bot
+responde com um código para digitar em trakt.tv/activate. Apps novos do Trakt (PKCE) não têm
+secret; TRAKT_CLIENT_SECRET só é enviado se existir (apps antigos).
+"""
+from __future__ import annotations
+
+import asyncio
+import datetime
+import json
+import os
+import re
+import time
+from typing import Any
+
+import aiohttp
+
+from comet.core.logger import logger, log_swallowed
+from comet.core.models import settings
+
+API = "https://api.trakt.tv"
+TOKEN_PATH = "/opt/comet/data/trakt_token.json"
+OOB = "urn:ietf:wg:oauth:2.0:oob"
+CACHE_TTL = 10 * 60
+
+HELP = "/trakt — liga o Trakt (lista e histórico do Nuvio) às fileiras pessoais"
+
+_cache: tuple[float, list[dict]] = (0.0, [])
+_lock = asyncio.Lock()
+_device_task: asyncio.Task | None = None
+_last_error = ""
+
+
+def _client() -> tuple[str, str]:
+    return (str(getattr(settings, "TRAKT_CLIENT_ID", "") or ""),
+            str(getattr(settings, "TRAKT_CLIENT_SECRET", "") or ""))
+
+
+def _with_client(body: dict) -> dict:
+    """Junta client_id e, só se houver (apps antigos), client_secret. App PKCE não tem secret."""
+    cid, secret = _client()
+    body = {**body, "client_id": cid}
+    if secret:
+        body["client_secret"] = secret
+    return body
+
+
+def _load_token() -> dict:
+    try:
+        with open(TOKEN_PATH, encoding="utf-8") as f:
+            d = json.load(f)
+        return d if isinstance(d, dict) else {}
+    except Exception:
+        return {}
+
+
+def _save_token(d: dict) -> None:
+    d = dict(d)
+    d["saved_at"] = int(time.time())
+    tmp = TOKEN_PATH + ".tmp"
+    with open(tmp, "w", encoding="utf-8") as f:
+        json.dump(d, f)
+    os.chmod(tmp, 0o600)
+    os.replace(tmp, TOKEN_PATH)
+
+
+def is_connected() -> bool:
+    return bool(_client()[0] and _load_token().get("access_token"))
+
+
+def _headers(token: str | None = None) -> dict:
+    h = {"Content-Type": "application/json", "trakt-api-version": "2", "trakt-api-key": _client()[0],
+         "User-Agent": "Comet-A71/1.0"}
+    if token:
+        h["Authorization"] = f"Bearer {token}"
+    return h
+
+
+# ───────────────────────── conversão (funções puras) ─────────────────────────
+
+def _iso(v: Any) -> str | None:
+    if not v:
+        return None
+    try:
+        return datetime.datetime.fromisoformat(str(v).replace("Z", "+00:00")).astimezone(
+            datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%S.000Z")
+    except Exception:
+        return None
+
+
+def _imdb(obj: dict | None) -> str | None:
+    ids = (obj or {}).get("ids") or {}
+    i = str(ids.get("imdb") or "")
+    return i if re.fullmatch(r"tt\d+", i) else None
+
+
+def _base_item(imdb: str, kind: str, obj: dict) -> dict:
+    return {"_id": imdb, "type": kind, "name": obj.get("title") or "", "year": obj.get("year"),
+            "removed": True, "temp": True, "_ctime": None, "_mtime": None, "poster": "",
+            "state": {}, "source": "trakt"}
+
+
+def to_library(watchlist: list, watched_movies: list, watched_shows: list, playback: list) -> list[dict]:
+    """Respostas do Trakt → itens no formato `libraryItem` do Stremio.
+
+    - lista de desejos: salvo na biblioteca (removed=False), aparece em Minha lista;
+    - histórico: só conta como "assistido" (removed=True, temp=True, com state.lastWatched),
+      igual ao Stremio quando você assiste sem salvar;
+    - progresso pausado: timeOffset/duration (fração do Trakt) para a barra de progresso.
+    """
+    items: dict[str, dict] = {}
+
+    def get(imdb: str, kind: str, obj: dict) -> dict:
+        it = items.get(imdb)
+        if it is None:
+            it = items[imdb] = _base_item(imdb, kind, obj)
+        return it
+
+    for w in watchlist or []:
+        kind = "movie" if w.get("type") == "movie" else "series" if w.get("type") == "show" else None
+        obj = w.get("movie") if kind == "movie" else w.get("show")
+        imdb = _imdb(obj)
+        if not kind or not imdb:
+            continue
+        it = get(imdb, kind, obj)
+        it["removed"] = False
+        it["temp"] = False
+        it["_ctime"] = it["_mtime"] = _iso(w.get("listed_at"))
+
+    for m in watched_movies or []:
+        obj = m.get("movie") or {}
+        imdb = _imdb(obj)
+        if not imdb:
+            continue
+        it = get(imdb, "movie", obj)
+        lw = _iso(m.get("last_watched_at"))
+        st = it["state"]
+        st.update({"lastWatched": lw, "timesWatched": int(m.get("plays") or 1), "flaggedWatched": 1,
+                   "video_id": imdb})
+        it["_mtime"] = max(filter(None, [it["_mtime"], lw]), default=None)
+
+    for s in watched_shows or []:
+        obj = s.get("show") or {}
+        imdb = _imdb(obj)
+        if not imdb:
+            continue
+        best = None  # (last_watched_at, season, episode)
+        plays = 0
+        for se in s.get("seasons") or []:
+            for ep in se.get("episodes") or []:
+                plays += int(ep.get("plays") or 0)
+                key = (str(ep.get("last_watched_at") or ""), int(se.get("number") or 0), int(ep.get("number") or 0))
+                if se.get("number") and (best is None or key > best):
+                    best = key
+        it = get(imdb, "series", obj)
+        lw = _iso(s.get("last_watched_at")) or (_iso(best[0]) if best else None)
+        st = it["state"]
+        st.update({"lastWatched": lw, "timesWatched": plays or int(s.get("plays") or 0)})
+        if best:
+            st.update({"season": best[1], "episode": best[2], "video_id": f"{imdb}:{best[1]}:{best[2]}"})
+        it["_mtime"] = max(filter(None, [it["_mtime"], lw]), default=None)
+
+    for p in playback or []:
+        if p.get("type") == "movie":
+            obj, kind, ep = p.get("movie") or {}, "movie", None
+        elif p.get("type") == "episode":
+            obj, kind, ep = p.get("show") or {}, "series", p.get("episode") or {}
+        else:
+            continue
+        imdb = _imdb(obj)
+        if not imdb:
+            continue
+        it = get(imdb, kind, obj)
+        paused = _iso(p.get("paused_at"))
+        st = it["state"]
+        if paused and (not st.get("lastWatched") or paused >= st["lastWatched"]):
+            frac = max(0.0, min(100.0, float(p.get("progress") or 0))) / 100.0
+            st.update({"lastWatched": paused, "duration": 100000, "timeOffset": int(frac * 100000),
+                       "timeWatched": int(frac * 100000)})
+            if ep and ep.get("season") and ep.get("number"):
+                st.update({"season": int(ep["season"]), "episode": int(ep["number"]),
+                           "video_id": f"{imdb}:{int(ep['season'])}:{int(ep['number'])}"})
+            it["_mtime"] = max(filter(None, [it["_mtime"], paused]), default=None)
+    return list(items.values())
+
+
+def merge(stremio_items: list[dict], trakt_items: list[dict]) -> list[dict]:
+    """Junta as duas bibliotecas por IMDb: salvo em qualquer uma = salvo; vale o histórico mais novo."""
+    out: dict[str, dict] = {}
+    order: list[str] = []
+    for it in stremio_items or []:
+        k = str(it.get("_id") or "")
+        if k and k not in out:
+            out[k] = it
+            order.append(k)
+    for t in trakt_items or []:
+        k = t["_id"]
+        cur = out.get(k)
+        if cur is None:
+            out[k] = t
+            order.append(k)
+            continue
+        merged = dict(cur)
+        if not t.get("removed"):
+            merged["removed"] = False
+            merged["temp"] = False
+        cs, ts = cur.get("state") or {}, t.get("state") or {}
+        if str(ts.get("lastWatched") or "") > str(cs.get("lastWatched") or ""):
+            merged["state"] = {**cs, **ts}
+        merged["_mtime"] = max(filter(None, [str(cur.get("_mtime") or ""), str(t.get("_mtime") or "")]), default=None)
+        out[k] = merged
+    return [out[k] for k in order]
+
+
+# ───────────────────────── rede ─────────────────────────
+
+async def _refresh_if_needed(session: aiohttp.ClientSession) -> str | None:
+    tok = _load_token()
+    if not tok.get("access_token"):
+        return None
+    exp = float(tok.get("created_at") or 0) + float(tok.get("expires_in") or 0)
+    if exp and time.time() < exp - 3600:
+        return tok["access_token"]
+    if not (_client()[0] and tok.get("refresh_token")):
+        return tok["access_token"]
+    body = _with_client({"refresh_token": tok["refresh_token"], "redirect_uri": OOB,
+                         "grant_type": "refresh_token"})
+    async with session.post(f"{API}/oauth/token", json=body, headers=_headers()) as r:
+        if r.status != 200:
+            logger.warning(f"Trakt: renovação do acesso falhou (HTTP {r.status})")
+            return tok["access_token"] if time.time() < exp else None
+        new = await r.json()
+    _save_token(new)
+    logger.info("🎬 Trakt: acesso renovado")
+    return new.get("access_token")
+
+
+async def _get(session: aiohttp.ClientSession, token: str, path: str) -> list:
+    async with session.get(f"{API}{path}", headers=_headers(token)) as r:
+        if r.status != 200:
+            raise RuntimeError(f"{path} HTTP {r.status}")
+        data = await r.json()
+        return data if isinstance(data, list) else []
+
+
+async def library_items(force: bool = False) -> list[dict]:
+    """Itens no formato do Stremio (cache de 10 min). Sem Trakt ligado: lista vazia."""
+    global _cache, _last_error
+    if not is_connected():
+        return []
+    ts, items = _cache
+    if not force and time.time() - ts < CACHE_TTL:
+        return items
+    async with _lock:
+        ts, items = _cache
+        if not force and time.time() - ts < CACHE_TTL:
+            return items
+        try:
+            async with aiohttp.ClientSession(timeout=aiohttp.ClientTimeout(total=20)) as s:
+                token = await _refresh_if_needed(s)
+                if not token:
+                    return items
+                wl, wm, ws, pb = await asyncio.gather(
+                    _get(s, token, "/sync/watchlist"),
+                    _get(s, token, "/sync/watched/movies"),
+                    _get(s, token, "/sync/watched/shows"),
+                    _get(s, token, "/sync/playback?limit=100"),
+                )
+            items = to_library(wl, wm, ws, pb)
+            _cache = (time.time(), items)
+            _last_error = ""
+        except Exception as e:
+            _last_error = f"{type(e).__name__}: {e}"[:120]
+            logger.warning(f"Trakt: leitura falhou ({_last_error})")
+            _cache = (time.time() - CACHE_TTL + 120, items)  # tenta de novo em 2 min
+        return items
+
+
+# ───────────────────────── conexão pelo Telegram ─────────────────────────
+
+async def _poll_device(code: dict) -> None:
+    from comet.services.telegram_bot import send_telegram
+    interval = max(5, int(code.get("interval") or 5))
+    deadline = time.time() + int(code.get("expires_in") or 600)
+    body = _with_client({"code": code["device_code"]})
+    async with aiohttp.ClientSession(timeout=aiohttp.ClientTimeout(total=20)) as s:
+        while time.time() < deadline:
+            await asyncio.sleep(interval)
+            try:
+                async with s.post(f"{API}/oauth/device/token", json=body, headers=_headers()) as r:
+                    if r.status == 200:
+                        _save_token(await r.json())
+                        items = await library_items(force=True)
+                        await send_telegram(f"✅ Trakt conectado. {len(items)} títulos da sua lista e histórico "
+                                            "já entram nas fileiras pessoais.")
+                        return
+                    if r.status == 429:
+                        interval += 5
+                    elif r.status in (404, 409, 410, 418):
+                        await send_telegram("❌ Trakt: o código expirou ou foi recusado. Mande /trakt de novo.")
+                        return
+            except Exception as e:
+                log_swallowed("trakt._poll_device", e)
+    await send_telegram("⌛ Trakt: o código expirou. Mande /trakt de novo.")
+
+
+async def handle_command(text: str) -> str | None:
+    global _device_task
+    m = re.match(r"^/trakt(?:@\w+)?\s*(.*)$", (text or "").strip(), re.I)
+    if not m:
+        return None
+    arg = m.group(1).strip().lower()
+    cid = _client()[0]
+    if not cid:
+        return ("🎬 Trakt ainda sem chave de app. Crie um app em https://trakt.tv/oauth/applications "
+                f"(Redirect URI: {OOB}) e ponha TRAKT_CLIENT_ID no .env.")
+    if arg in ("status", "estado") or (is_connected() and arg != "reconectar"):
+        items = await library_items(force=True)
+        saved = sum(1 for i in items if not i.get("removed"))
+        seen = sum(1 for i in items if (i.get("state") or {}).get("lastWatched"))
+        extra = f"\n⚠️ Último erro: {_last_error}" if _last_error else ""
+        return (f"🎬 Trakt conectado: {saved} na lista, {seen} com histórico."
+                f"\nPara refazer a conexão: /trakt reconectar{extra}")
+    try:
+        async with aiohttp.ClientSession(timeout=aiohttp.ClientTimeout(total=20)) as s:
+            async with s.post(f"{API}/oauth/device/code", json={"client_id": cid}, headers=_headers()) as r:
+                if r.status != 200:
+                    return f"❌ Trakt recusou o pedido de código (HTTP {r.status}). Confira TRAKT_CLIENT_ID."
+                code = await r.json()
+    except Exception as e:
+        return f"❌ Trakt fora do ar agora ({type(e).__name__}). Tente de novo daqui a pouco."
+    if _device_task and not _device_task.done():
+        _device_task.cancel()
+    _device_task = asyncio.create_task(_poll_device(code))
+    mins = int(code.get("expires_in") or 600) // 60
+    return (f"🎬 Abra {code.get('verification_url') or 'https://trakt.tv/activate'} e digite o código:\n\n"
+            f"{code.get('user_code')}\n\nVale por {mins} min. Eu aviso aqui quando conectar.")
+
+
+async def status_lines() -> list[str]:
+    if not _client()[0]:
+        return []
+    if not is_connected():
+        return ["🎬 Trakt: não conectado (mande /trakt)"]
+    _, items = _cache
+    line = f"🎬 Trakt: conectado ({len(items)} títulos)"
+    return [line + (f" · erro: {_last_error}" if _last_error else "")]
diff --git a/comet/services/warmup.py b/comet/services/warmup.py
new file mode 100644
index 0000000..dc477e6
--- /dev/null
+++ b/comet/services/warmup.py
@@ -0,0 +1,106 @@
+import asyncio
+import os
+import time
+
+import aiohttp
+
+from comet.core.logger import logger
+from comet.core.models import settings
+from comet.services.catalogs import get_catalog
+
+from comet.utils.bounded import trim
+
+_WARMED_IDS: dict[str, float] = {}
+
+
+async def run_warmup_cycle():
+    token = settings.PERSONAL_LINK_TOKEN
+    config = settings.PERSONAL_LINK_CONFIG
+    if not token or not config:
+        return
+
+    port = getattr(settings, "FASTAPI_PORT", 8000) or 8000
+    base_url = f"http://127.0.0.1:{port}"
+
+    try:
+        top_mov = await get_catalog("movie", "comet_top10")
+        top_ser = await get_catalog("series", "comet_top10")
+        trend_mov = (await get_catalog("movie", "comet_trending"))[:20]
+        trend_ser = (await get_catalog("series", "comet_trending"))[:20]
+    except Exception as e:
+        logger.warning(f"Error fetching catalogs for warmup: {e}")
+        return
+
+    candidates: list[tuple[str, str]] = []
+    seen = set()
+
+    for item in top_mov + trend_mov:
+        mid = item.get("id")
+        if mid and isinstance(mid, str) and mid.startswith("tt") and ("movie", mid) not in seen:
+            seen.add(("movie", mid))
+            candidates.append(("movie", mid))
+
+    for item in top_ser + trend_ser:
+        mid = item.get("id")
+        if mid and isinstance(mid, str) and mid.startswith("tt") and ("series", mid) not in seen:
+            seen.add(("series", mid))
+            candidates.append(("series", mid))
+
+    total_n = len(candidates)
+    now = time.time()
+
+    new_candidates = [
+        (mtype, mid)
+        for (mtype, mid) in candidates
+        if (now - _WARMED_IDS.get(f"{mtype}:{mid}", 0)) >= 86400
+    ]
+    new_m = len(new_candidates)
+
+    logger.info(f"🔥 Pré-aquecimento: {total_n} títulos ({new_m} novos)")
+
+    if not new_candidates:
+        return
+
+    timeout = aiohttp.ClientTimeout(total=120.0)
+    async with aiohttp.ClientSession(timeout=timeout) as session:
+        for mtype, mid in new_candidates:
+            if mtype == "movie":
+                url = f"{base_url}/{token}/stream/movie/{mid}.json"
+            else:
+                url = f"{base_url}/{token}/stream/series/{mid}:1:1.json"
+
+            try:
+                async with session.get(url) as resp:
+                    await resp.read()
+            except asyncio.CancelledError:
+                raise
+            except Exception as e:
+                logger.warning(f"Pré-aquecimento error on {mtype} {mid}: {type(e).__name__}")
+
+            _WARMED_IDS[f"{mtype}:{mid}"] = time.time()
+            trim(_WARMED_IDS, 5000)
+
+            try:
+                await asyncio.sleep(20)
+            except asyncio.CancelledError:
+                raise
+
+
+async def start_catalog_warmup():
+    try:
+        initial_delay_raw = os.getenv("WARMUP_INITIAL_DELAY", "300")
+        try:
+            initial_delay = float(initial_delay_raw)
+        except ValueError:
+            initial_delay = 300.0
+
+        if initial_delay > 0:
+            await asyncio.sleep(initial_delay)
+
+        while True:
+            await run_warmup_cycle()
+            await asyncio.sleep(12 * 3600)
+    except asyncio.CancelledError:
+        pass
+    except Exception as e:
+        logger.warning(f"Pré-aquecimento task encountered error: {e}")
