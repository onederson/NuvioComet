+++ b/comet/services/failed_sources.py
@@ -0,0 +1,101 @@
+"""Fonte que falhou perde a vez no ▶ Assistir.
+
+Se você dá play numa fonte e, em até 1 minuto, dá play em OUTRA fonte do mesmo filme ou
+episódio, a primeira provavelmente não funcionou (travou, áudio errado, arquivo ruim). Ela fica
+marcada para aquele título e o ▶ Assistir passa a preferir outra. A marca some se você voltar a
+tocar a mesma fonte por escolha própria, ou depois de 30 dias.
+"""
+from __future__ import annotations
+
+import json
+import os
+import threading
+import time
+
+from comet.core.logger import log_swallowed, logger
+
+PATH = "/opt/comet/data/failed_sources.json"
+WINDOW_S = 60
+TTL_S = 30 * 86400
+_MAX_TITLES = 2000
+
+_lock = threading.Lock()
+_last: dict[str, tuple[str, float]] = {}  # título -> (hash, quando deu play)
+_failed: dict[str, dict[str, float]] | None = None  # título -> {hash: quando marcou}
+
+
+def _load() -> dict[str, dict[str, float]]:
+    global _failed
+    if _failed is None:
+        try:
+            with open(PATH, encoding="utf-8") as f:
+                data = json.load(f)
+            _failed = {k: dict(v) for k, v in data.items() if isinstance(v, dict)}
+        except FileNotFoundError:
+            _failed = {}
+        except Exception as e:
+            log_swallowed("failed_sources._load", e)
+            _failed = {}
+    return _failed
+
+
+def _save(data: dict) -> None:
+    try:
+        tmp = PATH + ".tmp"
+        with open(tmp, "w", encoding="utf-8") as f:
+            json.dump(data, f)
+        os.replace(tmp, PATH)
+    except Exception as e:
+        log_swallowed("failed_sources._save", e)
+
+
+def _prune(data: dict, now: float) -> None:
+    for key in list(data):
+        hashes = {h: t for h, t in data[key].items() if now - t < TTL_S}
+        if hashes:
+            data[key] = hashes
+        else:
+            del data[key]
+    if len(data) > _MAX_TITLES:
+        for key in sorted(data, key=lambda k: max(data[k].values()))[: len(data) - _MAX_TITLES]:
+            del data[key]
+    if len(_last) > _MAX_TITLES:
+        for key in sorted(_last, key=lambda k: _last[k][1])[: len(_last) - _MAX_TITLES]:
+            del _last[key]
+
+
+def note_play(media_key: str, info_hash: str, now: float | None = None) -> str | None:
+    """Registra um play. Devolve o hash que acabou de ser marcado como falho, se houver."""
+    if not media_key or not info_hash:
+        return None
+    now = time.time() if now is None else now
+    media_key = media_key[:80]
+    info_hash = info_hash.lower()[:64]
+    marked = None
+    with _lock:
+        data = _load()
+        changed = False
+        prev = _last.get(media_key)
+        if prev and prev[0] != info_hash and 0 <= now - prev[1] <= WINDOW_S:
+            data.setdefault(media_key, {})[prev[0]] = now
+            marked = prev[0]
+            changed = True
+        # tocar de novo uma fonte marcada, por escolha própria, tira a marca
+        if info_hash in data.get(media_key, {}) and marked != info_hash:
+            del data[media_key][info_hash]
+            changed = True
+        _last[media_key] = (info_hash, now)
+        if changed:
+            _prune(data, now)
+            _save(data)
+    if marked:
+        logger.log("PLAYBACK", f"👎 Fonte trocada em menos de {WINDOW_S}s: {marked[:8]} perde a vez no Assistir ({media_key})")
+    return marked
+
+
+def failed_hashes(media_key: str) -> set[str]:
+    if not media_key:
+        return set()
+    with _lock:
+        now = time.time()
+        return {h for h, t in _load().get(media_key, {}).items() if now - t < TTL_S}
