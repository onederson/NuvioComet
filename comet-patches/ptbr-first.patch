+++ b/comet/services/extra_rows.py
@@ -0,0 +1,110 @@
+"""Fileiras extras (futebol, sessão da noite, Minha TV, retrospectiva).
+
+Cada módulo segue o mesmo protocolo (ROWS, row_visible, catalog_items, ID_PREFIX, get_meta, get_streams, router).
+Este arquivo só despacha: catálogo, meta e stream chamam `catalog`, `meta` e `streams` daqui.
+Módulo ausente ou com erro é ignorado (o resto do Comet segue normal).
+"""
+from __future__ import annotations
+
+import asyncio
+import importlib
+
+from comet.core.logger import logger
+
+# (módulo, onde a fileira entra no manifesto: "top" = logo depois do Top 10 / datas comemorativas, "end" = no fim)
+_MODULES = (
+    ("comet.services.evening", "top"),
+    ("comet.services.football", "top"),
+    ("comet.services.mytv", "top"),
+    ("comet.services.recap", "end"),
+)
+
+
+def _mods() -> list[tuple[object, str]]:
+    out = []
+    for name, where in _MODULES:
+        try:
+            out.append((importlib.import_module(name), where))
+        except Exception as e:
+            logger.debug(f"extra_rows: {name} indisponível ({type(e).__name__}: {e})")
+    return out
+
+
+def manifest_rows() -> tuple[list[dict], list[dict]]:
+    """(fileiras do topo, fileiras do fim). Sempre presentes: fileira vazia some sozinha no app,
+    e manter o manifesto estável evita que o Nuvio/Stremio reordene as fileiras."""
+    top, end = [], []
+    for mod, where in _mods():
+        for row in getattr(mod, "ROWS", None) or []:
+            entry = {"type": row["type"], "id": row["id"], "name": row["name"],
+                     "extra": [{"name": "skip", "isRequired": False}]}
+            (top if where == "top" else end).append(entry)
+    return top, end
+
+
+def _owner_of_catalog(catalog_id: str):
+    for mod, _ in _mods():
+        if any(r.get("id") == catalog_id for r in (getattr(mod, "ROWS", None) or [])):
+            return mod
+    return None
+
+
+def is_extra_catalog(catalog_id: str) -> bool:
+    return _owner_of_catalog(catalog_id) is not None
+
+
+async def catalog(catalog_id: str, base_url: str, skip: int = 0) -> list[dict]:
+    mod = _owner_of_catalog(catalog_id)
+    if mod is None or skip:
+        return []
+    try:
+        vis = getattr(mod, "row_visible", None)
+        if vis and not vis(catalog_id):
+            return []
+        return await asyncio.wait_for(mod.catalog_items(catalog_id, base_url), 25) or []
+    except Exception as e:
+        logger.warning(f"extra_rows: catálogo {catalog_id} falhou: {type(e).__name__}: {e}")
+        return []
+
+
+def _owner_of_id(media_id: str):
+    for mod, _ in _mods():
+        prefix = getattr(mod, "ID_PREFIX", None)
+        if prefix and media_id.startswith(prefix):
+            return mod
+    return None
+
+
+def owns(media_id: str) -> bool:
+    return _owner_of_id(media_id) is not None
+
+
+async def meta(media_id: str, base_url: str) -> dict | None:
+    mod = _owner_of_id(media_id)
+    if mod is None:
+        return None
+    try:
+        return await asyncio.wait_for(mod.get_meta(media_id, base_url), 25)
+    except Exception as e:
+        logger.warning(f"extra_rows: meta {media_id} falhou: {type(e).__name__}: {e}")
+        return None
+
+
+async def streams(media_id: str, base_url: str) -> list[dict]:
+    mod = _owner_of_id(media_id)
+    if mod is None:
+        return []
+    try:
+        return await asyncio.wait_for(mod.get_streams(media_id, base_url), 90) or []
+    except Exception as e:
+        logger.warning(f"extra_rows: streams {media_id} falhou: {type(e).__name__}: {e}")
+        return []
+
+
+def routers() -> list:
+    out = []
+    for mod, _ in _mods():
+        r = getattr(mod, "router", None)
+        if r is not None:
+            out.append(r)
+    return out
