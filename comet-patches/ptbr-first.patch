+CHANNEL_NAME = "📺 Minha TV"
+
+MIN_SERIES = 3
+LOOKBACK_DAYS = 120
+RECENT_DAYS = 30           # episódios vistos há menos que isso são evitados
+DEFAULT_RUNTIME = 45
+MAX_SERIES = 30
+DAY_MIN = 24 * 60
+
+router = APIRouter()
+
+_STATE: dict = {"day": None, "series": None, "schedule": None, "n": None, "retry": 0.0}
+_RUNTIMES: dict[tuple[str, int], dict[int, int]] = {}   # (imdb, temporada) -> {episódio: min}
+_TMDB_IDS: dict[str, int | None] = {}
+_JPG: dict[int, bytes] = {}
+_lock = asyncio.Lock()
