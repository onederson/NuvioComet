+_UF_CODE_RE = re.compile(r"\b(" + "|".join(UFS) + r")\b")
+_UF_IN_NAME_RE = re.compile(r"(?:[,\-/(|]|\s-\s)\s*(" + "|".join(UFS) + r")\s*\)?(?=$|[\s,)\]/|-])")
+
+
+def _find_city(text_norm: str, name_mode: bool) -> Optional[tuple[str, str]]:
+    for cn, c, uf, safe in _CITIES_SORTED:
+        if name_mode and not safe:
+            continue
+        if re.search(r"\b" + re.escape(cn) + r"\b", text_norm):
+            return c, uf
+    return None
