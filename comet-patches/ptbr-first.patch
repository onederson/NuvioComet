new file mode 100644
index 0000000..02f015a
--- /dev/null
+++ b/comet/services/sub_translate.py
@@ -0,0 +1,307 @@
+import asyncio
+import hashlib
+import os
+import re
+import time
+import urllib.parse
+from curl_cffi.requests import AsyncSession
+
+from comet.core.logger import logger, record_source_error, record_source_success, log_swallowed
+from comet.core.models import settings
+
+_TRANSLATE_LOCKS: dict[str, asyncio.Lock] = {}
+_LOCKS_MUTEX = asyncio.Lock()
+
+
+def parse_srt_cues(srt_text: str) -> list[dict]:
+    lines = srt_text.replace("\r\n", "\n").replace("\r", "\n").splitlines()
+    cues = []
+    i = 0
+    n = len(lines)
+    auto_idx = 1
+    while i < n:
+        line = lines[i].strip()
+        if not line:
+            i += 1
+            continue
+        if "-->" in line:
+            idx_str = str(auto_idx)
+            time_str = lines[i].strip()
+            i += 1
+        elif i + 1 < n and "-->" in lines[i + 1]:
+            idx_str = line
+            time_str = lines[i + 1].strip()
+            i += 2
+        else:
+            i += 1
+            continue
+        text_lines = []
+        while i < n:
+            cur = lines[i]
+            cur_strip = cur.strip()
+            if not cur_strip:
+                i += 1
+                break
+            if cur_strip.isdigit() and i + 1 < n and "-->" in lines[i + 1]:
+                break
+            if "-->" in cur:
+                break
+            text_lines.append(cur_strip)
+            i += 1
+        cues.append({
+            "index": idx_str,
+            "time": time_str,
+            "text": "\n".join(text_lines),
+        })
+        auto_idx += 1
+    return cues
+
+
+def clean_cue_text(text: str) -> str:
+    t = re.sub(r"<[^>]+>", "", text)
+    t = re.sub(r"\{[^}]*\}", "", t)
+    t = t.replace("\r\n", " ").replace("\r", " ").replace("\n", " ")
+    t = re.sub(r"[ \t]+", " ", t).strip()
+    return t
+
+
+def wrap_line_42(text: str) -> str:
+    t = text.strip()
+    if len(t) <= 42:
+        return t
+    mid = len(t) / 2
+    spaces = [i for i, c in enumerate(t) if c == " "]
+    if not spaces:
+        return t
+    best_space = min(spaces, key=lambda i: abs(i - mid))
+    line1 = t[:best_space].strip()
+    line2 = t[best_space + 1:].strip()
+    return f"{line1}\n{line2}"
+
+
+async def fetch_gtx(
+    text_query: str,
+    sl: str = "en",
+    tl: str = "pt",
+    session: AsyncSession | None = None,
+) -> str | None:
+    if not text_query:
+        return ""
+    url = (
+        f"https://translate.googleapis.com/translate_a/single?client=gtx&sl={sl}&tl={tl}&dt=t&q="
+        + urllib.parse.quote(text_query)
+    )
+    should_close = False
+    if session is None:
+        session = AsyncSession(impersonate="chrome")
+        should_close = True
+    try:
+        for attempt in range(2):
+            try:
+                r = await session.get(url, timeout=10.0)
+                if r.status_code == 200:
+                    data = r.json()
+                    if data and isinstance(data, list) and data[0]:
+                        return "".join(
+                            seg[0] for seg in data[0] if seg and seg[0]
+                        )
+                    return ""
+                elif r.status_code == 429:
+                    if attempt == 0:
+                        await asyncio.sleep(2.0)
+                        continue
+                    logger.warning("Tradutor: HTTP 429 ratelimit")
+                    return None
+                else:
+                    if attempt == 0:
+                        await asyncio.sleep(2.0)
+                        continue
+                    logger.warning(f"Tradutor: HTTP {r.status_code}")
+                    return None
+            except Exception as e:
+                if attempt == 0:
+                    await asyncio.sleep(2.0)
+                    continue
+                logger.warning(f"Tradutor: erro ({type(e).__name__}): {e}")
+                return None
+        return None
+    finally:
+        if should_close:
+            await session.close()
+
+
+async def translate_srt(srt_text: str) -> str | None:
+    if not srt_text or not srt_text.strip():
+        return None
+
+    if len(srt_text) > settings.AUTO_TRANSLATE_MAX_CHARS:
+        logger.warning(
+            f"Tradutor: SRT ({len(srt_text)} chars) excede AUTO_TRANSLATE_MAX_CHARS ({settings.AUTO_TRANSLATE_MAX_CHARS})"
+        )
+        record_source_error("Tradutor", "SRT muito grande")
+        return None
+
+    cues = parse_srt_cues(srt_text)
+    if not cues:
+        return None
+
+    t0 = time.time()
+    cleaned_texts = [clean_cue_text(c["text"]) for c in cues]
+
+    batches: list[list[int]] = []
+    curr_batch: list[int] = []
+    curr_len = 0
+    for idx, text in enumerate(cleaned_texts):
+        line_len = len(text) + 1
+        if curr_batch and (curr_len + line_len > 4500):
+            batches.append(curr_batch)
+            curr_batch = [idx]
+            curr_len = line_len
+        else:
+            curr_batch.append(idx)
+            curr_len += line_len
+    if curr_batch:
+        batches.append(curr_batch)
+
+    batch_sem = asyncio.Semaphore(3)
+
+    async with AsyncSession(impersonate="chrome") as session:
+        async def _fetch_gtx(text_query: str) -> str | None:
+            return await fetch_gtx(text_query, sl="en", tl="pt", session=session)
+
+        async def process_batch(b_indices: list[int]) -> list[str] | None:
+            b_lines = [cleaned_texts[i] for i in b_indices]
+            if not any(b_lines):
+                return [""] * len(b_lines)
+
+            payload = "\n".join(b_lines)
+            async with batch_sem:
+                raw_res = await _fetch_gtx(payload)
+
+            if raw_res is None:
+                return None
+
+            lines = raw_res.split("\n")
+            if len(lines) == len(b_lines) + 1 and lines[-1] == "":
+                lines = lines[:-1]
+
+            if len(lines) == len(b_lines):
+                return lines
+
+            cue_sem = asyncio.Semaphore(4)
+
+            async def translate_single(cue_line: str) -> str | None:
+                if not cue_line.strip():
+                    return ""
+                async with cue_sem:
+                    single_res = await _fetch_gtx(cue_line)
+                if single_res is None:
+                    return None
+                return single_res.replace("\n", " ").strip()
+
+            tasks = [translate_single(line) for line in b_lines]
+            results = await asyncio.gather(*tasks)
+            if any(r is None for r in results):
+                return None
+            return list(results)
+
+        batch_tasks = [process_batch(b) for b in batches]
+        batch_results = await asyncio.gather(*batch_tasks)
+
+        if any(res is None for res in batch_results):
+            record_source_error("Tradutor", "Falha na tradução")
+            return None
+
+        translated_lines: list[str] = []
+        for b_res in batch_results:
+            translated_lines.extend(b_res)
+
+    if len(translated_lines) != len(cues):
+        record_source_error("Tradutor", "Contagem de falas divergente")
+        logger.warning(
+            f"Tradutor: contagem divergente ({len(translated_lines)} != {len(cues)})"
+        )
+        return None
+
+    out_blocks = []
+    for c, tl in zip(cues, translated_lines):
+        wrapped = wrap_line_42(tl)
+        out_blocks.append(f"{c['index']}\n{c['time']}\n{wrapped}")
+
+    final_srt = "\n\n".join(out_blocks) + "\n"
+    elapsed = time.time() - t0
+    logger.info(f"🤖 Legenda traduzida: {len(cues)} falas em {elapsed:.1f}s")
+    record_source_success("Tradutor")
+    return final_srt
+
+
+async def _get_translate_lock(key: str) -> asyncio.Lock:
+    async with _LOCKS_MUTEX:
+        if key not in _TRANSLATE_LOCKS:
+            _TRANSLATE_LOCKS[key] = asyncio.Lock()
+        return _TRANSLATE_LOCKS[key]
+
+
+async def ensure_auto_translated(
+    provider: str,
+    sub_id: str,
+    season: int,
+    episode: int,
+) -> bytes | None:
+    from comet.services.subtitles import (
+        DISK_CACHE_TTL,
+        SUBS_CACHE_DIR,
+        fetch_subtitle,
+    )
+
+    os.makedirs(SUBS_CACHE_DIR, exist_ok=True)
+    cache_key_str = f"{provider}:{sub_id}:{season}:{episode}"
+    cache_hash = hashlib.sha1(cache_key_str.encode("utf-8")).hexdigest()
+    cache_file = os.path.join(SUBS_CACHE_DIR, f"auto-{cache_hash}.srt")
+
+    if os.path.exists(cache_file):
+        try:
+            mtime = os.path.getmtime(cache_file)
+            if (time.time() - mtime) < DISK_CACHE_TTL:
+                with open(cache_file, "rb") as f:
+                    return f.read()
+        except Exception as _e:
+            log_swallowed("sub_translate.ensure_auto_translated", _e)
+
+    lock = await _get_translate_lock(cache_key_str)
+    async with lock:
+        if os.path.exists(cache_file):
+            try:
+                mtime = os.path.getmtime(cache_file)
+                if (time.time() - mtime) < DISK_CACHE_TTL:
+                    with open(cache_file, "rb") as f:
+                        return f.read()
+            except Exception as _e:
+                log_swallowed("sub_translate.ensure_auto_translated", _e)
+
+        sub_bytes = await fetch_subtitle(
+            provider=provider,
+            sub_id=sub_id,
+            season=season,
+            episode=episode,
+        )
+        if not sub_bytes:
+            return None
+
+        try:
+            srt_text = sub_bytes.decode("utf-8", errors="replace")
+        except Exception:
+            return None
+
+        translated_srt = await translate_srt(srt_text)
+        if not translated_srt:
+            return None
+
+        out_bytes = translated_srt.encode("utf-8")
+        try:
+            with open(cache_file, "wb") as f:
+                f.write(out_bytes)
+        except Exception as e:
+            logger.warning(f"Erro ao gravar cache de legenda traduzida: {e}")
+
+        return out_bytes
diff --git a/comet/services/subtitle_sync.py b/comet/services/subtitle_sync.py
new file mode 100644
index 0000000..114c872
--- /dev/null
+++ b/comet/services/subtitle_sync.py
@@ -0,0 +1,188 @@
+import re
+
+SPEED_RATIOS = (
+    1.0,
+    25 / 23.976,
+    23.976 / 25,
+    24 / 23.976,
+    23.976 / 24,
+    25 / 24,
+    24 / 25,
+)
+
+
+def _parse_time(t_str: str) -> int | None:
+    t_str = t_str.strip().replace(".", ",")
+    parts = t_str.split(":")
+    try:
+        if len(parts) == 3:
+            h = int(parts[0])
+            m = int(parts[1])
+            s, ms = parts[2].split(",")
+            return (h * 3600 + m * 60 + int(s)) * 1000 + int((ms + "000")[:3])
+        elif len(parts) == 2:
+            m = int(parts[0])
+            s, ms = parts[1].split(",")
+            return (m * 60 + int(s)) * 1000 + int((ms + "000")[:3])
+    except Exception:
+        return None
+    return None
+
+
+def _format_time(ms: int) -> str:
+    h = ms // 3600000
+    ms %= 3600000
+    m = ms // 60000
+    ms %= 60000
+    s = ms // 1000
+    ms %= 1000
+    return f"{h:02d}:{m:02d}:{s:02d},{ms:03d}"
+
+
+def parse_srt(srt_text: str) -> list[tuple[int, int, str]]:
+    lines = srt_text.replace("\r\n", "\n").replace("\r", "\n").splitlines()
+    blocks = []
+    i = 0
+    n = len(lines)
+    while i < n:
+        line = lines[i].strip()
+        if not line:
+            i += 1
+            continue
+        if "-->" in line:
+            time_line = line
+            i += 1
+        elif i + 1 < n and "-->" in lines[i + 1]:
+            time_line = lines[i + 1].strip()
+            i += 2
+        else:
+            i += 1
+            continue
+
+        parts = time_line.split("-->")
+        if len(parts) != 2:
+            continue
+        start_str = parts[0].strip().split()[0]
+        end_str = parts[1].strip().split()[0]
+        start_ms = _parse_time(start_str)
+        end_ms = _parse_time(end_str)
+        if start_ms is None or end_ms is None or start_ms >= end_ms:
+            continue
+
+        text_lines = []
+        while i < n and lines[i].strip() and "-->" not in lines[i]:
+            if i + 1 < n and "-->" in lines[i + 1] and lines[i].strip().isdigit():
+                break
+            text_lines.append(lines[i].strip())
+            i += 1
+        blocks.append((start_ms, end_ms, "\n".join(text_lines)))
+    return blocks
+
+
+def build_bitmask(intervals: list[tuple[int, int]], bin_ms: int) -> int:
+    mask = 0
+    for start_ms, end_ms in intervals:
+        start_bin = max(0, start_ms // bin_ms)
+        end_bin = max(start_bin, (end_ms + bin_ms - 1) // bin_ms)
+        span = end_bin - start_bin
+        if span > 0:
+            mask |= ((1 << span) - 1) << start_bin
+    return mask
+
+
+def align_srt_detail(
+    target_srt: str, reference_srt: str
+) -> tuple[str | None, dict]:
+    target_blocks = parse_srt(target_srt)
+    ref_blocks = parse_srt(reference_srt)
+    if not target_blocks or not ref_blocks:
+        return None, {"ratio": 1.0, "offset_ms": 0, "before": 0.0, "after": 0.0}
+
+    ref_intervals = [(s, e) for s, e, _ in ref_blocks]
+    ref_mask_100 = build_bitmask(ref_intervals, 100)
+
+    best_count = -1
+    best_ratio = 1.0
+    best_k_100 = 0
+
+    for ratio in SPEED_RATIOS:
+        scaled = [
+            (int(round(s * ratio)), int(round(e * ratio)))
+            for s, e, _ in target_blocks
+        ]
+        target_mask_100 = build_bitmask(scaled, 100)
+        for k in range(-1200, 1201):
+            shifted = (
+                (target_mask_100 << k)
+                if k >= 0
+                else (target_mask_100 >> (-k))
+            )
+            c = (ref_mask_100 & shifted).bit_count()
+            if c > best_count:
+                best_count = c
+                best_ratio = ratio
+                best_k_100 = k
+
+    ref_mask_20 = build_bitmask(ref_intervals, 20)
+    scaled_best = [
+        (int(round(s * best_ratio)), int(round(e * best_ratio)))
+        for s, e, _ in target_blocks
+    ]
+    target_mask_20 = build_bitmask(scaled_best, 20)
+
+    center_k_20 = best_k_100 * 5
+    best_count_20 = -1
+    best_k_20 = center_k_20
+    for k_20 in range(center_k_20 - 10, center_k_20 + 11):
+        shifted = (
+            (target_mask_20 << k_20)
+            if k_20 >= 0
+            else (target_mask_20 >> (-k_20))
+        )
+        c = (ref_mask_20 & shifted).bit_count()
+        if c > best_count_20:
+            best_count_20 = c
+            best_k_20 = k_20
+
+    best_offset_ms = best_k_20 * 20
+
+    ref_fala_20 = ref_mask_20.bit_count()
+    target_mask_20_r1 = build_bitmask([(s, e) for s, e, _ in target_blocks], 20)
+    denom_before = min(ref_fala_20, target_mask_20_r1.bit_count())
+    overlap_antes = (
+        ((ref_mask_20 & target_mask_20_r1).bit_count() / denom_before)
+        if denom_before > 0
+        else 0.0
+    )
+
+    denom_after = min(ref_fala_20, target_mask_20.bit_count())
+    overlap_depois = (best_count_20 / denom_after) if denom_after > 0 else 0.0
+
+    stats = {
+        "ratio": best_ratio,
+        "offset_ms": best_offset_ms,
+        "before": round(overlap_antes, 4),
+        "after": round(overlap_depois, 4),
+    }
+
+    if overlap_depois < 0.55 or overlap_depois < (overlap_antes + 0.05):
+        return None, stats
+
+    new_blocks = []
+    for idx, (s, e, text) in enumerate(target_blocks, 1):
+        ns = max(0, int(round(s * best_ratio + best_offset_ms)))
+        ne = max(0, int(round(e * best_ratio + best_offset_ms)))
+        if ne <= ns:
+            ne = ns + max(1, e - s)
+        new_blocks.append(
+            f"{idx}\n{_format_time(ns)} --> {_format_time(ne)}\n{text}\n"
+        )
+    new_srt = "\n".join(new_blocks) + "\n"
+    return new_srt, stats
+
+
+def align_srt(target_srt: str, reference_srt: str) -> tuple[str, dict] | None:
+    res_srt, stats = align_srt_detail(target_srt, reference_srt)
+    if res_srt is None:
+        return None
+    return res_srt, stats
